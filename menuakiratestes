local function makeTextBtn(parent, text, bg, fg, onClick)
    local b = Instance.new("TextButton", parent)
    b.BackgroundColor3 = bg
    b.Font = Enum.Font.GothamBold
    b.Text = text
    b.TextColor3 = fg
    b.TextSize = 8
    b.BorderSizePixel = 0
    b.AutoButtonColor = true
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
    b.MouseButton1Click:Connect(onClick)
    return b
end

function refreshDataList()
    for _, child in ipairs(DataScroll:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
    end
    local names = {}
    for n in pairs(savedRoutes) do table.insert(names, n) end
    table.sort(names)

    if #names == 0 then
        local empty = Instance.new("TextLabel", DataScroll)
        empty.Size = UDim2.new(1, 0, 0, 60)
        empty.BackgroundTransparency = 1
        empty.Font = Enum.Font.Gotham
        empty.Text = "◦ sem rotas guardadas\n\ngrave uma rota e toque\nem 💾 guardar"
        empty.TextColor3 = C_TXT_DIM
        empty.TextSize = 9
        empty.TextWrapped = true
        DataScroll.CanvasSize = UDim2.new(0, 0, 0, 60)
        return
    end

    for i, name in ipairs(names) do
        local entry = savedRoutes[name]

        -- Item mais alto pra caber nome + info + 3 botões
        local item = Instance.new("Frame", DataScroll)
        item.Size = UDim2.new(1, 0, 0, 52)
        item.BackgroundColor3 = C_BG_2
        item.BorderSizePixel = 0
        item.LayoutOrder = i
        Instance.new("UICorner", item).CornerRadius = UDim.new(0, 6)
        local s = Instance.new("UIStroke", item)
        s.Color = C_BG_3
        s.Thickness = 1

        -- Nome (largura total)
        local nameLbl = Instance.new("TextLabel", item)
        nameLbl.Size = UDim2.new(1, -12, 0, 13)
        nameLbl.Position = UDim2.new(0, 6, 0, 4)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.Text = name
        nameLbl.TextColor3 = C_TXT
        nameLbl.TextSize = 9
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        nameLbl.TextTruncate = Enum.TextTruncate.AtEnd

        -- Info
        local infoLbl = Instance.new("TextLabel", item)
        infoLbl.Size = UDim2.new(1, -12, 0, 10)
        infoLbl.Position = UDim2.new(0, 6, 0, 17)
        infoLbl.BackgroundTransparency = 1
        infoLbl.Font = Enum.Font.Code
        infoLbl.Text = string.format("%.2fs  ·  %d pts", entry.Duracao, entry.Pontos)
        infoLbl.TextColor3 = C_TURQ
        infoLbl.TextSize = 8
        infoLbl.TextXAlignment = Enum.TextXAlignment.Left

        -- ===== 3 BOTÕES DE TEXTO =====
        local btnY = 30
        local btnH = 18
        local pad = 4
        local available = 144 - pad * 2  -- 144 = largura interna
        local btnW = (available - pad * 2) / 3

        -- Testar
        local testBtn = makeTextBtn(item, "testar",
            Color3.fromRGB(30, 80, 130), Color3.fromRGB(200, 230, 255),
            function() playRoute(entry.Data) end)
        testBtn.Size = UDim2.new(0, btnW, 0, btnH)
        testBtn.Position = UDim2.new(0, pad, 0, btnY)

        -- Copiar
        local copyBtn = makeTextBtn(item, "copiar",
            C_BG_3, C_TXT,
            function()
                local result = string.format("-- ⚡ angel • %s (%.3fs)\nreturn {\n", name, entry.Duracao)
                for _, node in ipairs(entry.Data) do
                    local cfStr = table.concat(node.CF, ", ")
                    local velStr = table.concat(node.Velocity, ", ")
                    local stateName = typeof(node.State) == "EnumItem" and node.State.Name or "Running"
                    local animStr = ""
                    if node.Animations and #node.Animations > 0 then
                        local parts = {}
                        for _, a in ipairs(node.Animations) do
                            table.insert(parts, string.format(
                                "{Id=\"%s\",Speed=%.3f,Weight=%.3f,Priority=\"%s\"}",
                                a.Id, a.Speed, a.Weight, a.Priority))
                        end
                        animStr = ",Animations={" .. table.concat(parts, ",") .. "}"
                    else
                        animStr = ",Animations={}"
                    end
                    result = result .. string.format(
                        "{Time=%.3f,CF={%s},Velocity={%s},State=Enum.HumanoidStateType.%s%s},\n",
                        node.Time, cfStr, velStr, stateName, animStr)
                end
                result = result .. "}"
                if setclipboard then
                    setclipboard(result)
                    StatusLabel.Text = "◦ copiado"
                else
                    print(result)
                end
            end)
        copyBtn.Size = UDim2.new(0, btnW, 0, btnH)
        copyBtn.Position = UDim2.new(0, pad + btnW + pad, 0, btnY)

        -- Apagar
        local delBtn = makeTextBtn(item, "apagar",
            Color3.fromRGB(120, 35, 45), Color3.fromRGB(255, 200, 210),
            function()
                savedRoutes[name] = nil
                StatusLabel.Text = "◦ apagado: " .. name
                refreshDataList()
            end)
        delBtn.Size = UDim2.new(0, btnW, 0, btnH)
        delBtn.Position = UDim2.new(0, pad + (btnW + pad) * 2, 0, btnY)
    end
end

