local Log = { lines = {}, hook = nil }
local function log(msg)
    local line = string.format("[%s] %s", os.date("%H:%M:%S"), tostring(msg))
    Log.lines[#Log.lines + 1] = line
    if #Log.lines > 80 then table.remove(Log.lines, 1) end
    if writefile then pcall(writefile, "AngelExecutor_log.txt", table.concat(Log.lines, "\n")) end
    if Log.hook then pcall(Log.hook) end
end

