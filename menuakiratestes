local function makeDraggable(handle, target, onTap)
	local dragging, dragInput, startPos, startUI, moved = false, nil, nil, nil, false
	bind(handle.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true; moved = false; dragInput = i
			startPos = i.Position; startUI = target.Position
			local c
			c = i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					dragging = false
					c:Disconnect()
					if not moved and onTap then onTap() end
				end
			end)
		end
	end)
	bind(UIS.InputChanged, function(i)
		if not dragging then return end
		if i == dragInput or i.UserInputType == Enum.UserInputType.MouseMovement then
			local d = i.Position - startPos
			if d.Magnitude > 6 then moved = true end
			if moved then
				target.Position = UDim2.new(startUI.X.Scale, startUI.X.Offset + d.X, startUI.Y.Scale, startUI.Y.Offset + d.Y)
			end
		end
	end)
end

