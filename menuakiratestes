    local owner = type(s.owner) == "table" and s.owner.username or nil

    label(c, "🎮 " .. title, 11, Color3.fromRGB(255,255,255), Enum.Font.GothamBold,
        UDim2.new(0, 8, 0, 6), UDim2.new(1, -98, 0, 14))
