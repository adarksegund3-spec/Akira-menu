local function getHumanoid()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function getHRP()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function applySpeed()
    local hum = getHumanoid()
    if not hum then return end
    hum.WalkSpeed = Config.SpeedEnabled and Config.SpeedValue or MovementState.OrigWalk
end

local function applyJump()
    local hum = getHumanoid()
    if not hum then return end
    hum.UseJumpPower = true
    hum.JumpPower = Config.JumpEnabled and Config.JumpValue or MovementState.OrigJump
end

local function setInfJump(on)
    if on then
        if MovementState.InfJumpConn then return end
        MovementState.InfJumpConn = UserInputService.JumpRequest:Connect(function()
            if Config.InfJump then
                local hum = getHumanoid()
                if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
            end
        end)
    else
        if MovementState.InfJumpConn then
            MovementState.InfJumpConn:Disconnect()
            MovementState.InfJumpConn = nil
        end
    end
end

local function setBhop(on)
    if on then
        if MovementState.BhopConn then return end
        MovementState.BhopConn = RunService.Heartbeat:Connect(function()
            if not Config.Bhop then return end
            local hum = getHumanoid()
            if not hum then return end
            if hum:GetState() == Enum.HumanoidStateType.Landed
            or hum:GetState() == Enum.HumanoidStateType.Running then
                hum.Jump = true
            end
        end)
    else
        if MovementState.BhopConn then
            MovementState.BhopConn:Disconnect()
            MovementState.BhopConn = nil
        end
    end
end

local function setNoclip(on)
    if on then
        if MovementState.NoclipConn then return end
        MovementState.NoclipConn = RunService.Stepped:Connect(function()
            if not Config.Noclip then return end
            local char = LocalPlayer.Character
            if not char then return end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end)
    else
        if MovementState.NoclipConn then
            MovementState.NoclipConn:Disconnect()
            MovementState.NoclipConn = nil
        end
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
        end
    end
end

local function setFly(on)
    if on then
        local hrp = getHRP()
        if not hrp then return end
        if not MovementState.FlyBV then
            MovementState.FlyBV = Instance.new("BodyVelocity")
            MovementState.FlyBV.Name = "AKZ_FlyBV"
            MovementState.FlyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            MovementState.FlyBV.Velocity = Vector3.zero
            MovementState.FlyBV.Parent = hrp
        end
        if not MovementState.FlyBG then
            MovementState.FlyBG = Instance.new("BodyGyro")
            MovementState.FlyBG.Name = "AKZ_FlyBG"
            MovementState.FlyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            MovementState.FlyBG.P = 10000
            MovementState.FlyBG.D = 500
            MovementState.FlyBG.Parent = hrp
        end
    else
        if MovementState.FlyBV then MovementState.FlyBV:Destroy(); MovementState.FlyBV = nil end
        if MovementState.FlyBG then MovementState.FlyBG:Destroy(); MovementState.FlyBG = nil end
    end
end

