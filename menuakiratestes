function Audio.download(url, path, validator)
	local res, err = Http.raw(url)
	if not res then return nil, err end
	if res.StatusCode == 401 or res.StatusCode == 403 then return nil, "AUTH" end
	if res.StatusCode == 429 then return nil, "RATE" end
	if res.StatusCode == 404 or res.StatusCode == 400 then return nil, "UNAVAILABLE" end
	if res.StatusCode >= 500 then return nil, "SERVER" end
	local body = res.Body
	if res.StatusCode ~= 200 or type(body) ~= "string" or #body < 2048 then return nil, "UNAVAILABLE" end
	if validator and not validator(body) then return nil, "INVALID" end
	local ok = pcall(writefile, path, body)
	if not ok then return nil, "NOAUDIO" end
	return true
end

---------------------------------------------------------------- Img (capas)
local Img = { cache = {}, active = 0 }
function Img.apply(label, track)
	if not (Audio.supported and track.art) then return end
	local key = "art_" .. track.id
	if Img.cache[key] then label.Image = Img.cache[key] return end
	task.spawn(function()
		while Img.active >= 4 do task.wait(0.15) end
		if not label.Parent then return end
		Img.active += 1
		ensureFolders()
		local path = ("%s/cache/%s.jpg"):format(CFG.FOLDER, key)
		local ok = type(isfile) == "function" and fsOk(isfile, path)
		if not ok then ok = Audio.download(track.art, path, nil) end
		Img.active -= 1
		if ok then
			local s, asset = pcall(getAsset, path)
			if s and asset then
				Img.cache[key] = asset
				if label.Parent then label.Image = asset end
			end
		end
	end)
end

---------------------------------------------------------------- Store (persistência)
local Store = { data = { fav = {}, playlists = {}, recent = {}, volume = 0.7 }, dirty = false }
local DATA_PATH = CFG.FOLDER .. "/data.json"
function Store.load()
	if type(readfile) ~= "function" or not (type(isfile) == "function" and fsOk(isfile, DATA_PATH)) then return end
	local ok, d = pcall(function() return HttpService:JSONDecode(readfile(DATA_PATH)) end)
	if ok and type(d) == "table" then
		Store.data.fav = type(d.fav) == "table" and d.fav or {}
		Store.data.playlists = type(d.playlists) == "table" and d.playlists or {}
		Store.data.recent = type(d.recent) == "table" and d.recent or {}
		Store.data.volume = tonumber(d.volume) or 0.7
		local function keep(list)
			local o = {}
			for _, t in ipairs(type(list) == "table" and list or {}) do
				if type(t) == "table" and t.uri then table.insert(o, t) end
			end
			return o
		end
		Store.data.fav = keep(Store.data.fav)
		Store.data.recent = keep(Store.data.recent)
		for _, pl in ipairs(Store.data.playlists) do if type(pl) == "table" then pl.tracks = keep(pl.tracks) end end
	end
end
function Store.save()
	if Store.dirty or type(writefile) ~= "function" then return end
	Store.dirty = true
	task.delay(1, function()
		Store.dirty = false
		ensureFolders()
		pcall(function() writefile(DATA_PATH, HttpService:JSONEncode(Store.data)) end)
	end)
end
function Store.isFav(id) for _, t in ipairs(Store.data.fav) do if t.id == id then return true end end return false end
function Store.toggleFav(track)
	for i, t in ipairs(Store.data.fav) do
		if t.id == track.id then table.remove(Store.data.fav, i); Store.save(); Bus.fire("favs"); return false end
	end
	table.insert(Store.data.fav, 1, track); Store.save(); Bus.fire("favs"); return true
end
function Store.addRecent(track)
	local r = Store.data.recent
	for i, t in ipairs(r) do if t.id == track.id then table.remove(r, i) break end end
	table.insert(r, 1, track)
	while #r > 40 do table.remove(r) end
	Store.save()
end
function Store.newPlaylist(name)
	local p = { id = HttpService:GenerateGUID(false), name = name, tracks = {} }
	table.insert(Store.data.playlists, p); Store.save(); Bus.fire("playlists")
	return p
end
function Store.playlistAdd(p, track)
	for _, t in ipairs(p.tracks) do if t.id == track.id then return false end end
	table.insert(p.tracks, track); Store.save(); Bus.fire("playlists"); return true
end

---------------------------------------------------------------- Player (controle remoto do Spotify)
local Player = { state = "IDLE", queue = {}, index = 0, base = 1, shuffle = false, repeatMode = 0, token = 0, msg = "",
	pos = 0, len = 0, playing = false, stamp = 0, hold = 0, volHold = 0, modeHold = 0, curUri = "", cleared = false, alive = true }
Maid.add(function() Player.alive = false end)
local REPEAT = { [0] = "off", [1] = "context", [2] = "track" }

function Player.setState(s, msg)
	Player.state, Player.msg = s, msg or ""
	Bus.fire("state")
end
function Player.current() return Player.queue[Player.index] end
function Player.position()
	local p = Player.pos
	if Player.playing then p += os.clock() - Player.stamp end
	if Player.len > 0 then p = math.min(p, Player.len) end
	return p
end
local function fail(err) Player.setState("ERROR", errText(err)) end

-- PUT /play; se não há dispositivo ativo, ativa o primeiro disponível e tenta de novo
local function sendPlay(body)
	local ok, err = Sp.call("PUT", "/v1/me/player/play", nil, body)
	if not ok and err == "NODEVICE" then
		local id = Sp.firstDevice()
		if id then ok, err = Sp.call("PUT", "/v1/me/player/play", { device_id = id }, body) end
	end
	return ok, err
end
function Player.pollSoon(d)
	task.delay(d or 0.8, function() if Player.alive then pcall(Player.poll) end end)
end

function Player.playQueue(list, start)
	Player.queue = {}
	for _, t in ipairs(list) do table.insert(Player.queue, t) end
	Bus.fire("queue")
	if #Player.queue > 0 then
		Player.playIndex(Player.shuffle and start == nil and math.random(#Player.queue) or (start or 1))
	end
end
function Player.playIndex(i, posMs)
	local track = Player.queue[i]
	if not track then return end
	Player.token += 1
	local my = Player.token
	local wasPaused = posMs ~= nil and Player.state == "PAUSED"
	Player.index = i
	Player.cleared = false
	Bus.fire("queue"); Bus.fire("track")
	if track.streamable == false then fail("UNAVAILABLE") return end
	Player.setState("LOADING")
	task.spawn(function()
		local n = #Player.queue
		local base = n <= 100 and 1 or i
		local uris = {}
		for j = base, math.min(n, base + 99) do
			local t = Player.queue[j]
			if t and t.uri then table.insert(uris, t.uri) end
		end
		local body = { uris = uris, offset = { position = i - base } }
		if posMs then body.position_ms = posMs end
		local ok, err = sendPlay(body)
		if my ~= Player.token then return end
		if not ok then fail(err) return end
		Player.base, Player.curUri = base, track.uri
		Player.pos, Player.len, Player.playing, Player.stamp = (posMs or 0) / 1000, track.duration, true, os.clock()
		Player.hold = os.clock() + 1.2
		Store.addRecent(track)
		Player.setState("PLAYING")
		Sp.call("PUT", "/v1/me/player/shuffle", { state = tostring(Player.shuffle) })
		Sp.call("PUT", "/v1/me/player/repeat", { state = REPEAT[Player.repeatMode] })
		if wasPaused then
			Sp.call("PUT", "/v1/me/player/pause")
			Player.playing = false; Player.setState("PAUSED")
		end
		Player.pollSoon(1.3)
	end)
end
-- toca uma playlist/álbum/cantor inteiro direto no Spotify (quando não dá para listar as faixas)
function Player.playContext(uri)
	if type(uri) ~= "string" or uri == "" then return end
	Player.token += 1
	local my = Player.token
	Player.cleared = false
	Player.setState("LOADING")
	task.spawn(function()
		local ok, err = sendPlay({ context_uri = uri })
		if my ~= Player.token then return end
		if not ok then fail(err) return end
		Player.playing, Player.stamp = true, os.clock()
		Player.setState("PLAYING")
		Player.pollSoon(0.9)
	end)
end
function Player.enqueue(track)
	if not track or not track.uri then return end
	table.insert(Player.queue, track); Bus.fire("queue")
	if Player.state == "IDLE" and Player.index == 0 then Player.playIndex(#Player.queue) return end
	task.spawn(function()
		local ok, err = Sp.call("POST", "/v1/me/player/queue", { uri = track.uri })
		if not ok then Bus.fire("toast", errText(err), true) end
	end)
end
function Player.removeAt(i)
	if not Player.queue[i] then return end
	local cur = Player.index
	table.remove(Player.queue, i)
	if i < cur then
		Player.index = cur - 1; Bus.fire("queue")
	elseif i == cur then
		if #Player.queue == 0 then Player.clear() return end
		Player.playIndex(math.min(i, #Player.queue))
	else
		Bus.fire("queue")
		if Player.state ~= "LOADING" then Player.playIndex(Player.index, math.floor(Player.position() * 1000)) end
	end
end
function Player.clear()
	Player.token += 1
	Player.queue, Player.index, Player.curUri, Player.playing, Player.cleared = {}, 0, "", false, true
	Player.setState("IDLE"); Bus.fire("queue")
	task.spawn(function() Sp.call("PUT", "/v1/me/player/pause") end)
end

function Player.toggle()
	local s = Player.state
	if s == "PLAYING" then
		Player.pos = Player.position(); Player.playing = false; Player.hold = os.clock() + 1.2
		Player.setState("PAUSED")
		task.spawn(function()
			local ok, err = Sp.call("PUT", "/v1/me/player/pause")
			if not ok and err ~= "FORBIDDEN" then fail(err) end
			Player.pollSoon(1.3)
		end)
	elseif s == "PAUSED" then
		Player.playing, Player.stamp, Player.hold = true, os.clock(), os.clock() + 1.2
		Player.setState("PLAYING")
		task.spawn(function()
			local ok, err = sendPlay(nil)
			if not ok and err ~= "FORBIDDEN" then fail(err) end
			Player.pollSoon(1.3)
		end)
	elseif s ~= "LOADING" then
		if #Player.queue > 0 then
			Player.playIndex(Player.index > 0 and Player.index or 1)
		else
			task.spawn(function()
				local ok, err = sendPlay(nil)
				if not ok then fail(err) else Player.pollSoon(0.8) end
			end)
		end
	end
end
local function skip(dir)
	task.spawn(function()
		local path = "/v1/me/player/" .. dir
		local ok, err = Sp.call("POST", path)
		if not ok and err == "NODEVICE" then
			local id = Sp.firstDevice()
			if id then ok, err = Sp.call("POST", path, { device_id = id }) end
		end
		if not ok then
			if err ~= "FORBIDDEN" then fail(err) end
			return
		end
		Player.cleared = false
		Player.pollSoon(0.7)
	end)
end
function Player.next() skip("next") end
function Player.seekTo(sec)
	sec = math.max(0, sec)
	Player.pos, Player.stamp, Player.hold = sec, os.clock(), os.clock() + 1.5
	Player.seekTok = (Player.seekTok or 0) + 1
	local my = Player.seekTok
	task.delay(0.25, function() -- só envia quando o dedo para de arrastar
		if my ~= Player.seekTok then return end
		local ok, err = Sp.call("PUT", "/v1/me/player/seek", { position_ms = math.floor(sec * 1000) })
		if not ok and err ~= "FORBIDDEN" then fail(err) end
		Player.pollSoon(1.0)
	end)
end
function Player.prev()
	if Player.position() > 3 then Player.seekTo(0) return end
	skip("previous")
end
function Player.seek(r)
	if Player.len > 0 and (Player.state == "PLAYING" or Player.state == "PAUSED") then
		Player.seekTo(math.clamp(r, 0, 1) * Player.len)
	end
end
function Player.setShuffle(v)
	Player.shuffle = v; Player.modeHold = os.clock() + 2; Bus.fire("mode")
	task.spawn(function() Sp.call("PUT", "/v1/me/player/shuffle", { state = tostring(v) }) end)
end
function Player.cycleRepeat()
	Player.repeatMode = (Player.repeatMode + 1) % 3; Player.modeHold = os.clock() + 2; Bus.fire("mode")
	local mode = Player.repeatMode
	task.spawn(function() Sp.call("PUT", "/v1/me/player/repeat", { state = REPEAT[mode] }) end)
end
function Player.setVolume(v)
	v = math.clamp(v, 0, 1)
	Store.data.volume = v; Store.save(); Bus.fire("volume")
	Player.volHold = os.clock() + 4
	Player.volTok = (Player.volTok or 0) + 1
	local my = Player.volTok
	task.delay(0.3, function()
		if my ~= Player.volTok then return end
		local ok, err = Sp.call("PUT", "/v1/me/player/volume", { volume_percent = math.floor(v * 100 + 0.5) })
		if not ok and err == "NOVOLUME" then Bus.fire("toast", "Este aparelho não aceita volume pelo app.", true)
		elseif not ok and err ~= "FORBIDDEN" then Bus.fire("toast", errText(err), true) end
	end)
end

-- lê o estado real do Spotify (faixa, tempo, play/pausa, aleatório, repetir, volume)
local function matchQueue(uri)
	local q = Player.queue
	for j = Player.base, #q do if q[j] and q[j].uri == uri then return j end end
	for j = 1, #q do if q[j] and q[j].uri == uri then return j end end
end
function Player.poll()
	local d, e = Sp.call("GET", "/v1/me/player", { additional_types = "track,episode" })
	if os.clock() < Player.hold then return end
	if d == nil then
		if (e == "TOKEN" or e == "SCOPE") and Player.lastErr ~= e then
			Player.lastErr = e; Bus.fire("toast", errText(e), true)
		end
		return
	end
	Player.lastErr = nil
	if d == true or type(d.item) ~= "table" then
		if Player.state == "PLAYING" or Player.state == "PAUSED" then Player.playing = false; Player.setState("IDLE") end
		return
	end
	if Player.cleared then
		if d.is_playing == true then Player.cleared = false else return end
	end
	local item = d.item
	local tr = spTrack(item)
	if not tr and item.type == "episode" and item.id then
		tr = { id = tostring(item.id), uri = tostring(item.uri), title = tostring(item.name or "Episódio"),
			artist = type(item.show) == "table" and tostring(item.show.name or "Podcast") or "Podcast",
			duration = (tonumber(item.duration_ms) or 0) / 1000, art = spImage(item.images, 64), streamable = true, source = "spotify" }
	end
	if not tr then return end
	if tr.uri ~= Player.curUri then
		Player.curUri = tr.uri
		local j = matchQueue(tr.uri)
		if j then Player.index = j else Player.queue, Player.index, Player.base = { tr }, 1, 1 end
		Bus.fire("queue"); Bus.fire("track")
		Store.addRecent(Player.queue[Player.index])
	end
	Player.len = (tonumber(item.duration_ms) or 0) / 1000
	Player.pos = (tonumber(d.progress_ms) or 0) / 1000
	Player.playing = d.is_playing == true
	Player.stamp = os.clock()
	local st = Player.playing and "PLAYING" or "PAUSED"
	if Player.state ~= st then Player.setState(st) end
	if os.clock() > Player.modeHold then
		local sh = d.shuffle_state == true
		local rm = d.repeat_state == "track" and 2 or (d.repeat_state == "context" and 1 or 0)
		if sh ~= Player.shuffle or rm ~= Player.repeatMode then Player.shuffle, Player.repeatMode = sh, rm; Bus.fire("mode") end
	end
	if type(d.device) == "table" then
		Player.device = d.device.name
		local vp = tonumber(d.device.volume_percent)
		if vp and os.clock() > Player.volHold and math.abs(vp / 100 - Store.data.volume) > 0.02 then
			Store.data.volume = vp / 100; Bus.fire("volume")
		end
	end
end

