-- BUSCA (mini abas: Tudo | Músicas | Cantores | Playlists | Álbuns)
do
	local p = makePage("Busca")
	local box = new("TextBox", { Size = UDim2.new(1, -62, 0, 30), BackgroundColor3 = C.black2, TextColor3 = C.white, PlaceholderText = "Música, cantor, playlist, álbum…",
		PlaceholderColor3 = C.gray, Text = "", ClearTextOnFocus = false, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
		Parent = p.frame }, { corner(15), new("UIPadding", { PaddingLeft = UDim.new(0, 12) }) })
	local go = button({ Text = "Buscar", Size = UDim2.fromOffset(56, 30), Position = UDim2.new(1, -56, 0, 0), BackgroundColor3 = C.green, TextColor3 = C.black, TextSize = 11, Radius = 15, Parent = p.frame })
	local chips = new("ScrollingFrame", { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 34), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X, Parent = p.frame },
		{ new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center }) })
	p.scroll = newScroll(p.frame, UDim2.fromOffset(0, 62), UDim2.new(1, 0, 1, -62))

	local MODES = { "Tudo", "Músicas", "Cantores", "Playlists", "Álbuns" }
	local mode = "Tudo"            -- padrão: pesquisa tudo
	local res = nil                -- últimos resultados (já filtrados por relevância)
	local token = 0
	local chipBtns = {}
	local renderResults, search

	local function paintChips()
		for n, b in pairs(chipBtns) do
			local on = n == mode
			b.BackgroundColor3 = on and C.green or C.dgreen
			b.TextColor3 = on and C.black or C.white
		end
	end
	local function fmtNum(n)
		if n >= 1000000 then return string.format("%.1fM", n / 1000000) end
		if n >= 1000 then return string.format("%.1fk", n / 1000) end
		return tostring(n)
	end
	local function sectionTitle(text, order)
		label({ Text = text, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = C.aqua, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = order, Parent = p.scroll })
	end
	local function infoRow(order, title, sub, btnText, cb)
		local row = new("Frame", { Size = UDim2.new(1, -4, 0, 40), BackgroundColor3 = C.black2, BackgroundTransparency = 0.35, LayoutOrder = order, Parent = p.scroll }, { corner(10) })
		label({ Text = title, Font = Enum.Font.GothamBold, TextSize = 11, Size = UDim2.new(1, -76, 0, 16), Position = UDim2.fromOffset(10, 4), Parent = row })
		label({ Text = sub, TextColor3 = C.gray, TextSize = 9, Size = UDim2.new(1, -76, 0, 13), Position = UDim2.fromOffset(10, 21), Parent = row })
		button({ Text = btnText, Size = UDim2.fromOffset(52, 26), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), TextSize = 10, Radius = 13, Tap = true, Parent = row }, cb)
	end

	-- abre uma lista de faixas (playlist, álbum ou músicas de um cantor)
	local function showTracksView(fetch, ctxUri)
		token += 1; local my = token
		clearList(p.scroll); infoLabel(p.scroll, "Carregando…")
		task.spawn(function()
			local tr, err = fetch()
			if my ~= token then return end
			clearList(p.scroll)
			local bar = new("Frame", { Size = UDim2.new(1, -4, 0, 28), BackgroundTransparency = 1, LayoutOrder = 0, Parent = p.scroll },
				{ new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4) }) })
			button({ Text = "← Resultados", Size = UDim2.fromOffset(86, 26), TextSize = 10, Radius = 13, Parent = bar }, function() renderResults() end)
			button({ Text = "Tocar tudo", Size = UDim2.fromOffset(76, 26), TextSize = 10, Radius = 13, Parent = bar },
				function() if tr and #tr > 0 then Player.playQueue(tr, 1) elseif ctxUri and ctxUri ~= "" then Player.playContext(ctxUri) end end)
			if not tr then infoLabel(p.scroll, errText(err), C.red) return end
			if #tr == 0 then infoLabel(p.scroll, "Nada por aqui.") return end
			renderTracks(p.scroll, tr, { baseOrder = 1 })
		end)
	end

	function renderResults()
		token += 1
		clearList(p.scroll)
		if not res then return end
		local all = mode == "Tudo"
		local lim = all and 5 or 1000
		local shown = 0
		local function slice(list, n)
			if #list <= n then return list end
			local o = {}
			for i = 1, n do o[i] = list[i] end
			return o
		end
		if all or mode == "Músicas" then
			local list = slice(res.tracks, all and 6 or 1000)
			if #list > 0 then
				shown += #list
				if all then sectionTitle("Músicas", 0) end
				renderTracks(p.scroll, list, { baseOrder = 1 })
			end
		end
		if all or mode == "Cantores" then
			local list = slice(res.artists, all and 3 or 1000)
			if #list > 0 then
				shown += #list
				sectionTitle("Cantores", 1000)
				for i, u in ipairs(list) do
					infoRow(1000 + i, u.name, (u.followers > 0 and (fmtNum(u.followers) .. " seguidores") or "Cantor"), "Abrir",
						function() showTracksView(function() return Api.artistTracks(u) end, u.uri) end)
				end
			end
		end
		if all or mode == "Playlists" then
			local list = slice(res.playlists, all and 3 or 1000)
			if #list > 0 then
				shown += #list
				sectionTitle("Playlists", 2000)
				for i, pl in ipairs(list) do
					infoRow(2000 + i, pl.name, (pl.owner ~= "" and pl.owner .. " · " or "") .. (pl.count > 0 and (pl.count .. " faixas") or (pl.isAlbum and "Álbum" or "Playlist")), "Abrir",
						function() showTracksView(function() return Api.playlistTracks(pl) end, pl.uri) end)
				end
			end
		end
		if all or mode == "Álbuns" then
			local list = slice(res.albums, all and 3 or 1000)
			if #list > 0 then
				shown += #list
				sectionTitle("Álbuns", 3000)
				for i, pl in ipairs(list) do
					infoRow(3000 + i, pl.name, (pl.owner ~= "" and pl.owner .. " · " or "") .. (pl.count > 0 and (pl.count .. " faixas") or (pl.isAlbum and "Álbum" or "Playlist")), "Abrir",
						function() showTracksView(function() return Api.albumTracks(pl) end, pl.uri) end)
				end
			end
		end
		if shown == 0 then infoLabel(p.scroll, "Nada com “" .. res.q .. "”. Tente outra palavra ou outra aba.") end
	end

	function search()
		local text = box.Text:gsub("^%s+", ""):gsub("%s+$", "")
		if text == "" then return end
		token += 1; local my = token
		clearList(p.scroll); infoLabel(p.scroll, "Buscando…")
		go.Text = "…"
		task.spawn(function()
			local data, err = Api.search(text)
			if my ~= token then return end -- resposta antiga ignorada
			go.Text = "Buscar"
			if not data then clearList(p.scroll); infoLabel(p.scroll, errText(err or "NETWORK"), C.red) return end
			-- pesquisa afiada: só fica o que contém a frase (ou algo bem parecido)
			res = {
				q = text,
				tracks = Txt.filter(data.tracks, text, function(t) return t.title .. " " .. t.artist end, function(t) return t.title end),
				artists = Txt.filter(data.artists, text, function(u) return u.name end, function(u) return u.name end),
				playlists = Txt.filter(data.playlists, text, function(x) return x.name .. " " .. x.owner end, function(x) return x.name end),
				albums = Txt.filter(data.albums, text, function(x) return x.name .. " " .. x.owner end, function(x) return x.name end),
			}
			renderResults()
		end)
	end

	for i, n in ipairs(MODES) do
		local b = button({ Text = n, Size = UDim2.new(0, 0, 1, -2), AutomaticSize = Enum.AutomaticSize.X, TextSize = 10, LayoutOrder = i, Radius = 12, Tap = true, Parent = chips },
			function()
				mode = n; paintChips()
