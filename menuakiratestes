-- Mapa de acentos -> ASCII (para "PRISÃO" == "prisao")
local ACCENTS = {
	["ã"] = "a", ["á"] = "a", ["à"] = "a", ["â"] = "a", ["ä"] = "a",
	["Ã"] = "a", ["Á"] = "a", ["À"] = "a", ["Â"] = "a", ["Ä"] = "a",
	["é"] = "e", ["ê"] = "e", ["è"] = "e", ["É"] = "e", ["Ê"] = "e", ["È"] = "e",
	["í"] = "i", ["Í"] = "i",
	["ó"] = "o", ["ô"] = "o", ["õ"] = "o", ["Ó"] = "o", ["Ô"] = "o", ["Õ"] = "o",
	["ú"] = "u", ["ü"] = "u", ["Ú"] = "u", ["Ü"] = "u",
	["ç"] = "c", ["Ç"] = "c",
}

-- Remove tags RichText, tira acentos e põe em minúsculas
local function normalize(s)
	s = tostring(s or "")
	if string.find(s, "<", 1, true) then
		s = string.gsub(s, "<[^>]+>", "")
	end
	if string.find(s, "[\128-\255]") then
		s = string.gsub(s, utf8.charpattern, function(c) return ACCENTS[c] or c end)
	end
	return string.lower(s)
end

-- Texto "limpo" para exibição (sem tags RichText, sem espaços sobrando)
local function cleanText(s)
	s = tostring(s or "")
	s = string.gsub(s, "<[^>]+>", "")
	s = string.gsub(s, "%s+", " ")
	return (string.gsub(s, "^%s*(.-)%s*$", "%1"))
end

local function clip(s, n)
	s = tostring(s)
	if #s > n then return string.sub(s, 1, n) .. "…[truncado]" end
	return s
end

-- Retorna a lista de termos (de 'list') encontrados no texto normalizado
local function findHits(norm, list)
	local out = {}
	for _, k in ipairs(list) do
		if string.find(norm, k, 1, true) then table.insert(out, k) end
	end
	return out
end

local function numbersIn(text)
	local seen, out = {}, {}
	for n in string.gmatch(text, "%d+[%.,]?%d*") do
		if not seen[n] then seen[n] = true; table.insert(out, n) end
	end
	return out
end

