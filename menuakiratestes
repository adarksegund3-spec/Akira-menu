local url = "https://raw.githubusercontent.com/adarksegund3-spec/Akira-menu/main/menuakiratestes"
local ok, res = pcall(function() return game:HttpGet(url) end)
if not ok then
    warn("❌ ERRO ao baixar: " .. tostring(res))
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "AKIRA MENU",
        Text = "Falha ao baixar o script: " .. tostring(res),
        Duration = 10
    })
    return
end
print("✅ Link OK — Tamanho:", #res, "caracteres")
print("---- Primeiras 400 letras ----")
print(res:sub(1, 400))
print("------------------------------")

-- Testa se compila sem executar
local fn, err = loadstring(res)
if not fn then
    warn("❌ ERRO DE SINTAXE: " .. tostring(err))
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "AKIRA MENU",
        Text = "Erro de sintaxe: " .. tostring(err),
        Duration = 15
    })
    return
end
print("✅ Script compilou sem erro de sintaxe!")

-- Agora executa de verdade com captura de erro
local ok2, err2 = pcall(fn)
if not ok2 then
    warn("❌ ERRO ao executar: " .. tostring(err2))
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "AKIRA MENU",
        Text = "Erro: " .. tostring(err2),
        Duration = 15
    })
else
    print("✅ AKIRA MENU executado com sucesso!")
end