    local UPC = { ["ç"] = "Ç", ["ã"] = "Ã", ["õ"] = "Õ", ["á"] = "Á", ["à"] = "À", ["â"] = "Â", ["é"] = "É",
        ["ê"] = "Ê", ["í"] = "Í", ["ó"] = "Ó", ["ô"] = "Ô", ["ú"] = "Ú" }
    local function upperPT(s)
        s = s:upper()
        for a, b in pairs(UPC) do s = s:gsub(a, b) end
        return s
    end
    local function translate(t)
        if type(t) ~= "string" or #t > 40 then return nil end
        local trimmed = t:match("^%s*(.-)%s*$")
        if trimmed == "" then return nil end
        local key = trimmed:lower()
        local suffix, tr = "", PT[key]
        if not tr then
            local base, suf = key:match("^(.-)([:%.]+)$")
            if base and PT[base] then tr, suffix = PT[base], suf end
        end
        if not tr then return nil end
        tr = tr .. suffix
        if trimmed:upper() == trimmed and trimmed:lower() ~= trimmed then
            tr = upperPT(tr)
        elseif trimmed:lower() == trimmed then
            tr = tr:gsub("^%u", string.lower)
        end
        return tr
    end
    local function isTitle(t)
        local l = t:lower():match("^%s*(.-)%s*$")
        if l == "neo" then return true end
        return #l <= 24 and l:find("arceus", 1, true) ~= nil
    end

    local function skTint(c, kind)
        local h, s, v = c:ToHSV()
        if s >= 0.25 then
            local th = T.h
            if h > 0.22 and h < 0.45 and not (th > 0.22 and th < 0.45) then return c end -- verde (status) fica
            local nv = (kind == "text") and math.max(v, 0.85) or math.max(v, 0.5)
            return Color3.fromHSV(th, math.clamp(s, 0.55, 1) * T.accF, math.min(nv, 1))
        end
        if kind ~= "bg" or v > 0.85 then return c end
        return Color3.fromHSV(T.h, T.tintS, math.clamp(v * T.vMul, 0, 1))
    end

    local function skSet(inst, prop, val)
        local o = SK.orig[inst]
        if not o then o = {} SK.orig[inst] = o end
        if o[prop] == nil then
            local ok, old = pcall(function() return inst[prop] end)
            if ok then o[prop] = old end
        end
        local l = SK.last[inst]
        if not l then l = {} SK.last[inst] = l end
        l[prop] = val
        pcall(function() inst[prop] = val end)
    end
    local function skOrig(inst, prop)
        local o = SK.orig[inst]
        if o and o[prop] ~= nil then return o[prop] end
        return inst[prop]
    end

    local skReprop
    local function skWatch(inst, prop)
        local ok, sig = pcall(function() return inst:GetPropertyChangedSignal(prop) end)
        if not ok then return end
        SK.conns[#SK.conns + 1] = sig:Connect(function()
            if not SK.on then return end
            local cur
            pcall(function() cur = inst[prop] end)
            local l = SK.last[inst]
            if cur == nil or (l and l[prop] == cur) then return end
            local p = SK.pend[inst]
            if not p then p = {} SK.pend[inst] = p end
            if p[prop] then return end
            p[prop] = true
            task.defer(function()
                p[prop] = nil
                if not SK.on or not inst.Parent then return end
                local cur2
                pcall(function() cur2 = inst[prop] end)
                local l2 = SK.last[inst]
                if cur2 == nil or (l2 and l2[prop] == cur2) then return end
                if SK.orig[inst] then SK.orig[inst][prop] = cur2 end -- o Arceus mudou: vira o novo "original"
                pcall(skReprop, inst, prop)
            end)
        end)
    end

    skReprop = function(inst, prop)
        if prop == "BackgroundColor3" then
            skSet(inst, prop, skTint(inst[prop], "bg"))
        elseif prop == "TextColor3" then
            if SK.titled[inst] then return end
            skSet(inst, prop, skTint(inst[prop], "text"))
        elseif prop == "ImageColor3" then
            skSet(inst, prop, skTint(inst[prop], "image"))
        elseif prop == "Text" then
            local cur = inst.Text
            if inst:IsA("TextLabel") and isTitle(cur) then
                SK.titled[inst] = true
                skSet(inst, "Text", "Angel executor")
                skSet(inst, "Font", T.titleFont)
                skSet(inst, "TextScaled", true)
                skSet(inst, "TextColor3", T.light)
            else
                local tr = translate(cur)
                if tr then skSet(inst, "Text", tr) end
            end
        end
    end

    local function skInst(inst)
        if not SK.on or inst:GetAttribute("AngelOwned") then return end
        if inst:IsA("UIStroke") then
            skSet(inst, "Color", T.accent)
        elseif inst:IsA("UIGradient") then
            local o = skOrig(inst, "Color")
            local pts = {}
            for _, k in ipairs(o.Keypoints) do
                pts[#pts + 1] = ColorSequenceKeypoint.new(k.Time, skTint(k.Value, "bg"))
            end
            if #pts >= 2 then skSet(inst, "Color", ColorSequence.new(pts)) end
        elseif inst:IsA("UICorner") then
            local o = skOrig(inst, "CornerRadius")
            if o.Scale < 0.4 then
                skSet(inst, "CornerRadius", UDim.new(o.Scale, math.clamp(math.floor(o.Offset * T.rScale + 0.5), 0, 40)))
            end
        elseif inst:IsA("GuiObject") then
            local bt = skOrig(inst, "BackgroundTransparency")
            if bt < 0.98 then
                skSet(inst, "BackgroundColor3", skTint(skOrig(inst, "BackgroundColor3"), "bg"))
                if (inst:IsA("Frame") or inst:IsA("ScrollingFrame")) and bt < 0.2 then
                    local a = inst.AbsoluteSize
                    if a.X > 120 and a.Y > 60 then skSet(inst, "BackgroundTransparency", 0.2) end
                end
            end
            local isText = inst:IsA("TextLabel") or inst:IsA("TextButton")
            if isText or inst:IsA("TextBox") then
                local tc = skTint(skOrig(inst, "TextColor3"), "text")
                if tc ~= skOrig(inst, "TextColor3") then skSet(inst, "TextColor3", tc) end
                if isText then
                    local cur = skOrig(inst, "Text")
                    if inst:IsA("TextLabel") and isTitle(cur) then
                        SK.titled[inst] = true
                        skSet(inst, "Text", "Angel executor")
                        skSet(inst, "Font", T.titleFont)
                        skSet(inst, "TextScaled", true)
                        skSet(inst, "TextColor3", T.light)
                    else
                        local tr = translate(cur)
                        if tr then skSet(inst, "Text", tr) end
                    end
                else
                    local tr = translate(skOrig(inst, "PlaceholderText"))
                    if tr then skSet(inst, "PlaceholderText", tr) end
                end
            end
            if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
                local ic = skTint(skOrig(inst, "ImageColor3"), "image")
                if ic ~= skOrig(inst, "ImageColor3") then skSet(inst, "ImageColor3", ic) end
            end
            if not SK.sig[inst] then
                SK.sig[inst] = true
                skWatch(inst, "BackgroundColor3")
                if isText then
                    skWatch(inst, "TextColor3") skWatch(inst, "Text")
                elseif inst:IsA("TextBox") then
                    skWatch(inst, "TextColor3")
                end
                if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then skWatch(inst, "ImageColor3") end
            end
        end
    end

    function SK.apply(root)
        SK.on = true
        SK.token = SK.token + 1
        local tok = SK.token
        SK.conns[#SK.conns + 1] = root.DescendantAdded:Connect(function(d)
            if not SK.on then return end
            task.defer(function()
                if d.Parent then pcall(skInst, d) end
            end)
        end)
        task.spawn(function()
            pcall(skInst, root)
            local n = 0
            for _, d in ipairs(root:GetDescendants()) do
                if tok ~= SK.token then return end
                pcall(skInst, d)
                n = n + 1
                if n % 150 == 0 then task.wait() end
            end
        end)
    end

    function SK.restore()
        SK.token = SK.token + 1
        SK.on = false
        for _, c in ipairs(SK.conns) do pcall(function() c:Disconnect() end) end
        SK.conns = {}
        for inst, props in pairs(SK.orig) do
            for prop, val in pairs(props) do pcall(function() inst[prop] = val end) end
        end
        for _, o in ipairs(SK.created) do pcall(function() o:Destroy() end) end
        SK.created = {}
        SK.orig, SK.last, SK.sig, SK.pend, SK.titled = weakT(), weakT(), weakT(), weakT(), weakT()
    end

    ------------------------------------------------------------
    -- Detecção do Arceus
    ------------------------------------------------------------
    local BLACK = {
        RobloxGui = true, TopBarApp = true, PlayerList = true, Chat = true, BubbleChat = true,
        ThemeProvider = true, PurchasePromptApp = true, DevConsoleMaster = true,
        RobloxNetworkPauseNotification = true, InGameMenu = true, ControlGui = true, TouchGui = true,
        Freecam = true, ExperienceChat = true, VoiceChat = true, RobloxPromptGui = true,
    }
    local function huiC()
        if gethui then
            local ok, h = pcall(gethui)
            if ok and h then return h end
        end
    end
    local function containers()
        local t, h = {}, huiC()
        if h then t[#t + 1] = h end
        t[#t + 1] = CoreGui
        local pg = LP:FindFirstChild("PlayerGui")
        if pg then t[#t + 1] = pg end
        return t, h
    end
    local function arceusScore(gui)
        local s, n = 0, gui.Name:lower()
        for _, k in ipairs({ "arceus", "executor", "neo" }) do
            if n:find(k, 1, true) then s = s + 3 break end
        end
        local c, hasBox, hasExec = 0, false, false
        for _, d in ipairs(gui:GetDescendants()) do
            c = c + 1
            if c > 700 then break end
            if d:IsA("TextBox") then
                hasBox = true
            elseif d:IsA("TextLabel") or d:IsA("TextButton") then
                local t = d.Text:lower()
                if t:find("arceus", 1, true) then s = s + 2
                elseif t:find("execut", 1, true) then
                    s = s + 1
                    if d:IsA("TextButton") then hasExec = true end
                elseif t == "neo" then s = s + 1 end
            end
        end
        if hasBox and hasExec then s = s + 2 end
        return s
    end

    function Bridge.scan(fallback)
        local list, h = containers()
        local function eligible(gui)
            return gui:IsA("ScreenGui") and gui ~= Gui and not gui:GetAttribute("AngelOwned")
                and not BLACK[gui.Name] and not Bridge.roots[gui]
        end
        for _, cont in ipairs(list) do
            for _, gui in ipairs(cont:GetChildren()) do
                if eligible(gui) then
                    local ok, sc = pcall(arceusScore, gui)
                    if ok and sc >= 3 then Bridge.roots[gui] = true end
                end
            end
        end
        -- plano B: nada com cara de Arceus; aceita a primeira UI de executor do gethui
        if fallback and h and next(Bridge.roots) == nil then
            for _, gui in ipairs(h:GetChildren()) do
                if eligible(gui) and not gui.Name:lower():find("angel", 1, true) and #gui:GetDescendants() >= 8 then
                    Bridge.roots[gui] = true
                    break
                end
            end
        end
    end

    function Bridge.refreshCands()
        local vp, list = vpSize(), {}
        for root in pairs(Bridge.roots) do
            if root.Parent then
                for _, d in ipairs(root:GetDescendants()) do
                    if (d:IsA("Frame") or d:IsA("ImageLabel") or d:IsA("CanvasGroup")) and not d:GetAttribute("AngelOwned") then
                        local a = approx(d)
                        if a.X > 200 and a.Y > 120 and not (a.X >= vp.X * 0.97 and a.Y >= vp.Y * 0.97) then
                            list[#list + 1] = { d = d, area = a.X * a.Y }
                        end
                    end
                end
            end
        end
        table.sort(list, function(x, y) return x.area > y.area end)
        Bridge.cands = {}
        for i = 1, math.min(#list, 6) do Bridge.cands[i] = list[i].d end
    end

    ------------------------------------------------------------
    -- Janela do Arceus: pegar, encaixar, devolver
    ------------------------------------------------------------
    function Bridge.applyHide()
        for root in pairs(Bridge.roots) do
            if root.Parent then
                if Bridge.en[root] == nil then Bridge.en[root] = root.Enabled end
                if Bridge.hide then root.Enabled = false else root.Enabled = Bridge.en[root] end
            end
        end
    end

    function Bridge.setMain(m)
        local a = approx(m)
        Bridge.o = { parent = m.Parent, anchor = m.AnchorPoint, pos = m.Position, size = m.Size, vis = m.Visible }
        Bridge.aw, Bridge.ah = math.max(a.X, 200), math.max(a.Y, 120)
        Bridge.main = m
        SK.apply(m)
        Bridge.applyHide()
    end

    function Bridge.forget()
        SK.restore()
        Bridge.main, Bridge.fit = nil, nil
    end

    function Bridge.pick()
        if Bridge.main then
            if Bridge.main.Parent then return Bridge.main end
            Bridge.forget()
        end
        Bridge.refreshCands()
        local m = Bridge.cands[Bridge.ci] or Bridge.cands[1]
        if m then Bridge.setMain(m) end
        return Bridge.main
    end

    function Bridge.giveBack()
        local m, o = Bridge.main, Bridge.o
        SK.restore()
        if m and m.Parent then
            if Bridge.fit then pcall(function() Bridge.fit:Destroy() end) end
            if o then
                pcall(function()
                    m.AnchorPoint = o.anchor
                    m.Position = o.pos
                    m.Size = o.size
                    m.Visible = o.vis
                    if o.parent and o.parent.Parent then m.Parent = o.parent end
                end)
            end
        end
        Bridge.main, Bridge.fit, Bridge.o = nil, nil, nil
    end

    function Bridge.nextCand()
        Bridge.giveBack()
        Bridge.refreshCands()
        if #Bridge.cands > 0 then Bridge.ci = (Bridge.ci % #Bridge.cands) + 1 end
        return Bridge.pick()
    end

    function Bridge.detach()
        local m = Bridge.main
        if m and m.Parent and m.Parent ~= Parking then
            if not (Parking and Parking.Parent) then
                Parking = Instance.new("Frame")
                Parking.Name = "Estacionamento"
                Parking.Visible = false
                Parking.BackgroundTransparency = 1
                Parking.Size = UDim2.fromOffset(1, 1)
                Parking:SetAttribute("AngelOwned", true)
                Parking.Parent = Gui
            end
            m.Parent = Parking
        end
    end

    function Bridge.embed(host, hw, hh)
        local m = Bridge.main
        if not (m and m.Parent) then return false end
        m.Parent = host
        m.AnchorPoint = Vector2.new(0.5, 0.5)
        m.Position = UDim2.fromScale(0.5, 0.5)
        m.Size = UDim2.fromOffset(Bridge.aw, Bridge.ah)
        m.Visible = true
        if not (Bridge.fit and Bridge.fit.Parent == m) then
            Bridge.fit = Instance.new("UIScale")
            Bridge.fit.Name = "AngelFit"
            Bridge.fit:SetAttribute("AngelOwned", true)
            Bridge.fit.Parent = m
        end
        Bridge.fit.Scale = math.clamp(math.min(hw / Bridge.aw, hh / Bridge.ah, 1.3), 0.2, 1.3)
        Bridge.scale = Bridge.fit.Scale
        return true
    end

    function Bridge.center()
        if Bridge.main then Bridge.main.Position = UDim2.fromScale(0.5, 0.5) end
    end

    function Bridge.retheme()
        if Bridge.main then
            SK.restore()
            SK.apply(Bridge.main)
        end
    end

    function Bridge.shutdown()
        Bridge.giveBack()
        for root, en in pairs(Bridge.en) do
            pcall(function() root.Enabled = en end)
        end
    end

    function Bridge.status()
        if Bridge.main then
            return string.format("Arceus conectado  ·  escala %d%%", math.floor(Bridge.scale * 100 + 0.5))
        elseif next(Bridge.roots) then
            return "Arceus achado, mas sem janela visível"
        end
        return "Arceus não encontrado ainda"
    end

    ------------------------------------------------------------
    -- Página "Arceus"
    ------------------------------------------------------------
    Pages.arceus = function(p)
        if not Bridge.main then Bridge.scan(true) end
        local m = Bridge.pick()

        local r = row(p, 30)
        local bs = UDim2.new(0.25, -5, 1, 0)
        button(r, "↻ Achar", false, function()
