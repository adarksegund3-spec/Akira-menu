function pickPlaylist(track)
	local ov = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.black, BackgroundTransparency = 0.35, Text = "", AutoButtonColor = false, ZIndex = 40, Parent = body })
	local panel = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(280, 260),
		BackgroundColor3 = C.black2, ZIndex = 41, Parent = ov }, { corner(14), new("UIStroke", { Color = C.aqua, Transparency = 0.5 }) })
	label({ Text = "Adicionar à playlist", Font = Enum.Font.GothamBold, TextSize = 14, Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(12, 6), ZIndex = 42, Parent = panel })
	local sc = newScroll(panel, UDim2.fromOffset(10, 36), UDim2.new(1, -20, 1, -82))
	local function close() ov:Destroy() end
	local function add(pl)
		Toast(Store.playlistAdd(pl, track) and ("Adicionado a " .. pl.name) or "Já está na playlist")
		close()
	end
	for i, pl in ipairs(Store.data.playlists) do
		button({ Text = pl.name, Size = UDim2.new(1, -4, 0, 30), LayoutOrder = i, TextSize = 12, ZIndex = 42, Parent = sc }, function() add(pl) end)
	end
	button({ Text = "+ Nova playlist", Size = UDim2.new(1, -4, 0, 30), LayoutOrder = 999, BackgroundColor3 = C.green, TextColor3 = C.black, ZIndex = 42, Parent = sc },
		function() add(Store.newPlaylist("Playlist " .. (#Store.data.playlists + 1))) end)
	button({ Text = "Cancelar", Size = UDim2.new(1, -20, 0, 28), Position = UDim2.new(0, 10, 1, -36), ZIndex = 42, Parent = panel }, close)
	for _, d in ipairs(panel:GetDescendants()) do if d:IsA("GuiObject") then d.ZIndex = math.max(d.ZIndex, 42) end end
end

