local function hoverFX(b, hv, pr)
    local st = b:FindFirstChildOfClass("UIStroke")
    local base = b.BackgroundColor3
    b.MouseEnter:Connect(function()
        tween(b, 0.12, {BackgroundColor3 = hv or Color3.fromRGB(40,10,10)})
        if st then tween(st, 0.12, {Transparency = 0.15}) end
    end)
    b.MouseLeave:Connect(function()
        tween(b, 0.12, {BackgroundColor3 = base})
        if st then tween(st, 0.12, {Transparency = 0.4}) end
    end)
    b.MouseButton1Down:Connect(function() tween(b, 0.08, {BackgroundColor3 = pr or Color3.fromRGB(60,15,15)}) end)
    b.MouseButton1Up:Connect(function() tween(b, 0.12, {BackgroundColor3 = base}) end)
end

