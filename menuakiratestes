local function startShimmer(grad, period)
	grad.Rotation = 0
	local tw = TweenService:Create(grad, TweenInfo.new(period, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), { Rotation = 360 })
	tw:Play()
	return Maid.add(tw)
end

-- Arrastar genérico: o delta vem do próprio dedo (sem salto, sem atraso)
local function dragger(hit, onStart, onMove, onEnd)
	local active, inp, s = false, nil, nil
	Maid.add(hit.InputBegan:Connect(function(i)
		if active or not isPress(i) then return end
		active, inp = true, i
		s = Vector2.new(i.Position.X, i.Position.Y)
		onStart()
	end))
	Maid.add(UIS.InputChanged:Connect(function(i)
		if not active then return end
		if inp.UserInputType == Enum.UserInputType.Touch then
			if i ~= inp then return end
		elseif i.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end
		onMove(Vector2.new(i.Position.X, i.Position.Y) - s)
	end))
	Maid.add(UIS.InputEnded:Connect(function(i)
		if not active then return end
		if i == inp or (inp.UserInputType == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseButton1) then
			active = false
			if onEnd then onEnd() end
		end
	end))
end

---------------------------------------------------------------- Ícones desenhados (sem caracteres que podem bugar)
local function mkIcon(parent, w, h, z)
	local ic = { parts = {}, strokes = {}, texts = {} }
	ic.frame = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(w, h), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), ZIndex = z or 9, Parent = parent })
	return ic
end
local function icRect(ic, x, y, w, h, rot, centered)
	local f = new("Frame", { Size = UDim2.fromOffset(w, h), BackgroundColor3 = C.white, BorderSizePixel = 0,
		ZIndex = ic.frame.ZIndex, Rotation = rot or 0, Parent = ic.frame })
	if centered then f.AnchorPoint = Vector2.new(0.5, 0.5) end
	f.Position = UDim2.fromOffset(x, y)
	table.insert(ic.parts, f)
	return f
end
local function icTri(ic, x, y, w, h, right) -- triângulo por faixas de 1px
	for i = 0, h - 1 do
		local t = 1 - math.abs((2 * i + 1) / h - 1)
		local sw = math.max(1, math.floor(w * t + 0.5))
		icRect(ic, right and x or (x + w - sw), y + i, sw, 1)
	end
end
local function icSet(ic, col)
	for _, p in ipairs(ic.parts) do p.BackgroundColor3 = col end
	for _, s in ipairs(ic.strokes) do s.Color = col end
	for _, t in ipairs(ic.texts) do t.TextColor3 = col end
end

