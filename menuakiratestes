local wasESP = false

RunService.RenderStepped:Connect(function(dt)
    -- FOV circle
    local showFov = Config.AimbotEnabled and Config.AimbotShowFOV
    if showFov then
        fovCircle.Visible = true
        fovCircle.Position = UDim2.fromOffset(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    else
        fovCircle.Visible = false
    end

    -- ESP
    if not Config.ESPEnabled then
        if wasESP then clearAllESP() end
        wasESP = false
    else
        wasESP = true
        for _, p in ipairs(Players:GetPlayers()) do
            updateESP(p)
        end
    end

    -- Aimbot
    if Config.AimbotEnabled and Config.Aiming then
        local t = findTarget()
        if t then lockOn(t) end
    elseif not Config.AimbotEnabled then
        Config.LockedTarget = nil
    end

    -- FOV visual
    if Config.FOVEnabled then
        Camera.FieldOfView = Config.FOVValue
    end

    -- Weapon mods (a cada 0.2s)
    weaponTick = weaponTick + dt
    if weaponTick >= 0.2 then
        weaponTick = 0
        if Config.NoRecoil or Config.NoSpread then
            applyWeaponMods()
        end
    end
end)

