
        -- reaplica o visual da aba selecionada
        local cur = currentTab
        currentTab = nil
        if cur then selectTab(cur) end
    end

    -- novos elementos (ex.: lista do catálogo) já nascem no tema ativo
    ScreenGui.DescendantAdded:Connect(function(i)
        if not dark then return end
        task.defer(function()
            if i.Parent then themeInst(i) end
        end)
    end)
    ToastGui.DescendantAdded:Connect(function(i)
        if not dark then return end
        task.defer(function()
            if not i.Parent then return end
            if i:IsA("UIGradient") then
                i.Enabled = false
            elseif i:IsA("Frame") and i.Parent == TC then
                i.BackgroundColor3 = mapColor(i, "BackgroundColor3", i.BackgroundColor3)
            end
        end)
    end)

    -- ───────── UI: botão "mudar tema ^" dentro da aba Principal ─────────
    local Card, Holder = State.themeCard, State.themeHolder
    local CLOSED_H, OPEN_H = 44, 102
    local open = false

    local ThemeBtn = Instance.new("TextButton", Card)
    ThemeBtn.Name = "ThemeBtn"
    ThemeBtn.Font = Enum.Font.Gotham
    ThemeBtn.Text = "  mudar tema ^"
    ThemeBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
    ThemeBtn.TextSize = 11
    ThemeBtn.TextXAlignment = Enum.TextXAlignment.Left
    ThemeBtn.BackgroundColor3 = Color3.fromRGB(20, 5, 5)
    ThemeBtn.BackgroundTransparency = 0.35
    ThemeBtn.BorderSizePixel = 0
    ThemeBtn.AutoButtonColor = false
    ThemeBtn.Position = UDim2.new(0, 8, 0, 8)
    ThemeBtn.Size = UDim2.new(1, -16, 0, 28)
    ThemeBtn.ZIndex = 4
    Instance.new("UICorner", ThemeBtn).CornerRadius = UDim.new(0, 6)
    local TBS = Instance.new("UIStroke", ThemeBtn)
    TBS.Color = Color3.fromRGB(80, 20, 20); TBS.Thickness = 1; TBS.Transparency = 0.4
    hoverFX(ThemeBtn)

    local CurLbl = Instance.new("TextLabel", ThemeBtn)
    CurLbl.Font = Enum.Font.GothamMedium
    CurLbl.TextSize = 10
    CurLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
    CurLbl.BackgroundTransparency = 1
    CurLbl.TextXAlignment = Enum.TextXAlignment.Right
    CurLbl.AnchorPoint = Vector2.new(1, 0.5)
    CurLbl.Position = UDim2.new(1, -10, 0.5, 0)
    CurLbl.Size = UDim2.new(0, 90, 0, 14)
    CurLbl.ZIndex = 5

    local rows = {}
    local function refreshRows()
        for n, row in pairs(rows) do
            local sel = ((n == "Dark clean") == dark)
            row.Text = (sel and "●  " or "    ") .. n
            row.TextColor3 = sel and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 150)
            tween(row, 0.15, {
                BackgroundTransparency = sel and 0.35 or 1,
                BackgroundColor3 = Color3.fromRGB(80, 15, 15),
            })
        end
        CurLbl.Text = dark and "Dark clean" or "Original"
    end

    local function setOpen(v)
        open = v
        local h = v and OPEN_H or CLOSED_H
        if v then for _, r in pairs(rows) do r.Visible = true end end
        tween(Card, 0.18, { Size = UDim2.new(1, -16, 0, h) })
        tween(Holder, 0.18, { Position = UDim2.new(0, 0, 0, State.themeCardY + h + 8) })
        if not v then
            task.delay(0.2, function()
                if not open then for _, r in pairs(rows) do r.Visible = false end end
            end)
        end
    end

    local function setTheme(name)
        if name == "Dark clean" then
            if not dark then applyDark() end
        else
            if dark then applyOriginal() end
        end
        refreshRows()
        setOpen(false)
        showToast("Tema: " .. name, "info")
    end

    for idx, name in ipairs({ "Original", "Dark clean" }) do
        local row = Instance.new("TextButton", Card)
        row.Name = name
        row.Font = Enum.Font.GothamMedium
        row.TextSize = 10
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.BackgroundColor3 = Color3.fromRGB(80, 15, 15)
        row.BackgroundTransparency = 1
        row.BorderSizePixel = 0
        row.AutoButtonColor = false
        row.Position = UDim2.new(0, 8, 0, 42 + (idx - 1) * 26)
        row.Size = UDim2.new(1, -16, 0, 24)
        row.ZIndex = 4
        row.Visible = false
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 5)
        rows[name] = row
        row.MouseButton1Click:Connect(function() setTheme(name) end)
    end
    refreshRows()

    ThemeBtn.MouseButton1Click:Connect(function() setOpen(not open) end)
end)()

