-- MÓDULO RSCRIPTS API
-- ══════════════════════════════════════════════════════════
local RScripts = {}
RScripts.Cache = {}
RScripts.State = {
    query="", page=1, totalPages=1, total=0, hasNext=false, hasPrev=false,
    filters = { noKey=true, mobile=false, free=false },
    sort = "recommended", loading=false, debounceId=0,
}

function RScripts.buildURL(q, f, p)
    local params = {}
    if q and q ~= "" then table.insert(params, "q=" .. HttpService:UrlEncode(q)) end
    table.insert(params, "page=" .. tostring(p or 1))
    table.insert(params, "limit=" .. tostring(Config.ResultsPerPage))
    table.insert(params, "includeScript=true")
    if f.noKey then table.insert(params, "noKeySystem=true") end
    if f.mobile then table.insert(params, "mobileOnly=true") end
    if f.free then table.insert(params, "freeOnly=true") end
    local sortMap = { recommended="recommended", newest="newest", most_likes="most-likes",
                      most_views="most-views", trending="trending" }
    table.insert(params, "sort=" .. (sortMap[RScripts.State.sort] or "recommended"))
    return Config.RScriptsBaseURL .. "?" .. table.concat(params, "&")
end

function RScripts.cacheKey(q, f, p)
    return string.format("%s|nk=%s|mob=%s|free=%s|sort=%s|pg=%d",
        q or "", tostring(f.noKey), tostring(f.mobile), tostring(f.free),
        RScripts.State.sort, p or 1)
end

function RScripts.fetch(q, f, p, cb)
    local key = RScripts.cacheKey(q, f, p)
    local now = tick()
    for k, v in pairs(RScripts.Cache) do
        if now - v.time > Config.CacheDuration then RScripts.Cache[k] = nil end
    end
    if RScripts.Cache[key] then cb(RScripts.Cache[key].data, nil) return end

    local url = RScripts.buildURL(q, f, p)
    local headers = { ["Authorization"] = "Bearer " .. Config.RScriptsAPIKey, ["Accept"] = "application/json" }
    local ok, response = pcall(function() return game:HttpGet(url, true, headers) end)
    if not ok then
        cb(nil, {code="CONNECTION", message="⚠ Não foi possível conectar à API."})
        return
    end
    local decoded
    local dok, d = pcall(function() return HttpService:JSONDecode(response) end)
    if not dok or not d then
        cb(nil, {code="PARSE", message="⚠ Resposta inválida da API."})
        return
    end
    decoded = d

    if decoded.success == false then
        local err = decoded.error or {}
        local code = err.code or "UNKNOWN"
        local msgs = {
            UNAUTHORIZED = "⚠ API Key inválida.",
            RATE_LIMITED = "⚠ Muitas requisições. Aguarde.",
            NOT_FOUND    = "⚠ Recurso não encontrado.",
            FORBIDDEN    = "⚠ Acesso negado.",
            BAD_REQUEST  = "⚠ Requisição inválida.",
            SERVER_ERROR = "⚠ Servidor indisponível.",
        }
        cb(nil, {code=code, message=msgs[code] or ("⚠ Erro: " .. (err.message or "?"))})
        return
    end

    RScripts.Cache[key] = {data=decoded, time=tick()}
    local meta = decoded.meta or {}
    local pag = meta.pagination or {}
    RScripts.State.page       = pag.page or p or 1
    RScripts.State.totalPages = pag.totalPages or 1
    RScripts.State.total      = pag.total or 0
    RScripts.State.hasNext    = pag.hasNextPage or false
    RScripts.State.hasPrev    = pag.hasPrevPage or false
    cb(decoded, nil)
end

function RScripts.execute(s)
    local code = s.script
    if not code and s.rawScript then
        local ok, f = pcall(function() return game:HttpGet(s.rawScript) end)
        if ok and f and #f > 10 then code = f end
    end
    if not code or code == "" then return false, "⚠ Sem código disponível." end
    local ok, err = pcall(function() loadstring(code)() end)
    if ok then return true, "✓ Executado!" end
    return false, "⚠ Erro: " .. tostring(err)
end

