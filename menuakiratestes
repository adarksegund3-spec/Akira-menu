-- BUSCA
do
	local p = makePage("Busca")
	local box = new("TextBox", { Size = UDim2.new(1, -74, 0, 32), BackgroundColor3 = C.black2, TextColor3 = C.white, PlaceholderText = "Música, artista, playlist…",
		PlaceholderColor3 = C.gray, Text = "", ClearTextOnFocus = false, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
		Parent = p.frame }, { corner(8), new("UIPadding", { PaddingLeft = UDim.new(0, 10) }) })
	local go = button({ Text = "Buscar", Size = UDim2.fromOffset(68, 32), Position = UDim2.new(1, -68, 0, 0), BackgroundColor3 = C.green, TextColor3 = C.black, Parent = p.frame })
	p.scroll = newScroll(p.frame, UDim2.fromOffset(0, 38), UDim2.new(1, 0, 1, -38))
	local token = 0
	local function showPlaylist(pl)
		token += 1; local my = token
		clearList(p.scroll); infoLabel(p.scroll, "Carregando playlist…")
		task.spawn(function()
			local tr, err = Api.playlistTracks(pl.id)
			if my ~= token then return end
			clearList(p.scroll)
			button({ Text = "← Voltar aos resultados   |   Tocar playlist", Size = UDim2.new(1, -4, 0, 30), LayoutOrder = 0, TextSize = 11, Parent = p.scroll },
				function() if tr and #tr > 0 then Player.playQueue(tr, 1) end end)
			if not tr then infoLabel(p.scroll, errText(err), C.red) return end
			if #tr == 0 then infoLabel(p.scroll, "Playlist vazia.") return end
			renderTracks(p.scroll, tr, { baseOrder = 1 })
		end)
	end
	local lastResult
	local function render(tracks, pls)
		clearList(p.scroll)
		if #tracks == 0 and #pls == 0 then infoLabel(p.scroll, "Nenhum resultado encontrado.") return end
		renderTracks(p.scroll, tracks, { baseOrder = 0 })
		if #pls > 0 then
			label({ Text = "Playlists", Font = Enum.Font.GothamBold, TextSize = 13, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 100, Parent = p.scroll })
			for i, pl in ipairs(pls) do
				local row = new("Frame", { Size = UDim2.new(1, -4, 0, 44), BackgroundColor3 = C.black2, BackgroundTransparency = 0.35, LayoutOrder = 100 + i, Parent = p.scroll }, { corner(10) })
				label({ Text = pl.name, Font = Enum.Font.GothamBold, Size = UDim2.new(1, -90, 0, 18), Position = UDim2.fromOffset(10, 5), Parent = row })
				label({ Text = (pl.owner ~= "" and pl.owner .. " · " or "") .. pl.count .. " faixas", TextColor3 = C.gray, TextSize = 10,
					Size = UDim2.new(1, -90, 0, 14), Position = UDim2.fromOffset(10, 24), Parent = row })
				button({ Text = "Abrir", Size = UDim2.fromOffset(60, 28), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), TextSize = 11, Parent = row },
					function() showPlaylist(pl) end)
			end
		end
	end
	local function search()
		local text = box.Text:gsub("^%s+", ""):gsub("%s+$", "")
		if text == "" then return end
		token += 1; local my = token
		clearList(p.scroll); infoLabel(p.scroll, "Buscando…")
		go.Text = "…"
		task.spawn(function()
			local tracks, err = Api.searchTracks(text)
			local pls = Api.searchPlaylists(text) or {}
			if my ~= token then return end -- resposta antiga ignorada
			go.Text = "Buscar"
			if not tracks then clearList(p.scroll); infoLabel(p.scroll, errText(err), C.red) return end
			lastResult = { tracks, pls }
			render(tracks, pls)
		end)
	end
	Maid.add(go.Activated:Connect(search))
	Maid.add(box.FocusLost:Connect(function(enter) if enter then search() end end))
	p.show = function() end
end

