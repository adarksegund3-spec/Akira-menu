            end

            sg = Instance.new("ScreenGui")
            sg.Name = "AKZSplash"; sg.ResetOnSpawn = false; sg.IgnoreGuiInset = true
            sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling; sg.DisplayOrder = 1000
