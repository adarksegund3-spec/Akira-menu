                Position = UDim2.new((index - 1) / 3, (index - 1) * 2, 0, 0),
                BackgroundColor3 = color,
                Font = Enum.Font.GothamBold,
                Text = text,
                TextColor3 = C.Text,
                TextSize = 10,
                BorderSizePixel = 0,
                AutoButtonColor = true,
            }, row)
            corner(b, 6)
            track(b.MouseButton1Click:Connect(function() onClick(b) end))
            return b
        end

        rowBtn("Testar", C.AccentDark, 1, function()
            if isRecording then setStatus("Pare a gravação antes", "warn") return end
            MainFrame.Visible = true
            playRoute(entry.Data)
        end)

        rowBtn("Copiar", C.Bg3, 2, function()
            if setclipboard then
                local ok = pcall(function() setclipboard(buildCopyText(name, entry)) end)
                setStatus(ok and ("Copiado: " .. name) or "Falha ao copiar", ok and "ok" or "warn")
            else
                setStatus("Sem clipboard neste executor", "warn")
            end
        end)

        local confirmAt = 0
        rowBtn("Apagar", Color3.fromRGB(150, 44, 60), 3, function(btn)
            if os.clock() - confirmAt < 2.5 then
                deleteFromDisk(entry)
                savedRoutes[name] = nil
                setStatus("Apagada: " .. name, "warn")
                refreshDataList()
            else
                confirmAt = os.clock()
                btn.Text = "Certeza?"
                task.delay(2.5, function()
                    if btn and btn.Parent then btn.Text = "Apagar" end
                end)
            end
