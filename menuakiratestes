local function shimmerGradient()
	return new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, C.dgreen), ColorSequenceKeypoint.new(0.15, C.aqua),
			ColorSequenceKeypoint.new(0.3, C.dgreen), ColorSequenceKeypoint.new(0.65, C.dgreen),
			ColorSequenceKeypoint.new(0.8, C.aqua), ColorSequenceKeypoint.new(1, C.dgreen) }),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(0.15, 0),
			NumberSequenceKeypoint.new(0.3, 0.7), NumberSequenceKeypoint.new(0.65, 0.7),
			NumberSequenceKeypoint.new(0.8, 0), NumberSequenceKeypoint.new(1, 0.7) }),
	})
