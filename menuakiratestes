    local portasVipGuardadas={}
    local function removerPortaVIP()
        portasVipGuardadas={}
        local nomesPossiveis={"PASSE LIVRE","PasseLivre","Passe_Livre","PortaVIP","Porta_VIP","PortaVip","VIPDoor","Porta VIP","Laser","Lazer","Door","Porta","Portão","Portao"}
        local count=0
        for _,obj in ipairs(workspace:GetDescendants()) do
            local nomeObj=obj.Name:lower()
            local nomePai=obj.Parent and obj.Parent.Name:lower() or ""
            local deveRemover=false
            for _,nome in ipairs(nomesPossiveis) do if nomeObj:find(nome:lower(),1,true) or nomePai:find(nome:lower(),1,true) then deveRemover=true; break end end
            if deveRemover then
                local isBasePart=obj:IsA("BasePart")
                table.insert(portasVipGuardadas,{obj=obj,transparency=isBasePart and obj.Transparency or nil,canCollide=isBasePart and obj.CanCollide or nil})
                if isBasePart then obj.Transparency=1; obj.CanCollide=false; obj.CanQuery=false; obj.CanTouch=false
                elseif obj:IsA("Decal") or obj:IsA("Texture") then obj.Transparency=1
                elseif obj:IsA("SurfaceGui") or obj:IsA("BillboardGui") then obj.Enabled=false
                elseif obj:IsA("Beam") then obj.Enabled=false
                elseif obj:IsA("Model") then
                    for _,p in ipairs(obj:GetDescendants()) do
                        if p:IsA("BasePart") then p.Transparency=1; p.CanCollide=false; p.CanQuery=false; p.CanTouch=false
                        elseif p:IsA("Decal") or p:IsA("Texture") then p.Transparency=1
                        elseif p:IsA("SurfaceGui") or p:IsA("BillboardGui") then p.Enabled=false
                        elseif p:IsA("Beam") then p.Enabled=false end
                    end
                end
                count=count+1
            end
        end
        return count
    end
    local function restaurarPortaVIP()
        for _,dados in ipairs(portasVipGuardadas) do
            pcall(function()
                local obj=dados.obj
                if obj and obj.Parent then
                    if obj:IsA("BasePart") then
                        if dados.transparency~=nil then obj.Transparency=dados.transparency end
                        if dados.canCollide~=nil then obj.CanCollide=dados.canCollide end
                        obj.CanQuery=true; obj.CanTouch=true
                    elseif obj:IsA("Decal") or obj:IsA("Texture") then obj.Transparency=0
                    elseif obj:IsA("SurfaceGui") or obj:IsA("BillboardGui") then obj.Enabled=true
                    elseif obj:IsA("Beam") then obj.Enabled=true
                    elseif obj:IsA("Model") then
                        for _,p in ipairs(obj:GetDescendants()) do
                            if p:IsA("BasePart") then p.Transparency=0; p.CanCollide=true; p.CanQuery=true; p.CanTouch=true
                            elseif p:IsA("Decal") or p:IsA("Texture") then p.Transparency=0
                            elseif p:IsA("SurfaceGui") or p:IsA("BillboardGui") then p.Enabled=true
                            elseif p:IsA("Beam") then p.Enabled=true end
                        end
                    end
                end
            end)
        end
        portasVipGuardadas={}
    end
