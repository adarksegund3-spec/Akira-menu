local function messageCard(parent, title, getText, extra)
    local c = card(parent, title)
    local msg = label(c, "", 11)
    local r = row(c)
    local sendBtn = button(r, "ENVIAR", function()
        local t = getText(); if t then sendAction(t, title) end
    end)
    for _, e in ipairs(extra or {}) do button(r, e[1], e[2]) end
    button(r, "COPIAR", function()
        local t = getText(); if t then copyText(t) end
    end)
    local function update()
        local t = getText()
        msg.Text = t or "TEMPO NÃO CONFIGURADO"
        msg.TextColor3 = t and C.text or KIND_COLOR.warn
        setEnabled(sendBtn, t ~= nil)
    end
    update()
    return update
end

local function buildMsg()
    local p = newPage()
    -- Apresentação
    local cur = math.random(#PRESENTATIONS)
    local upd
    upd = messageCard(p, "APRESENTAÇÃO", function() return presentationText(cur) end, {
        { "OUTRA VERSÃO", function()
            local n
            repeat n = math.random(#PRESENTATIONS) until n ~= cur
            cur = n
            upd()
        end },
    })
    -- Marcha
    local m = card(p, "MARCHA")
