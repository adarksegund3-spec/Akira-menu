-- toque "limpo": só dispara se o dedo não arrastou (não conflita com rolagem)
local function tap(hit, cb)
	local startPos
	hit.InputBegan:Connect(function(i)
		if isPress(i) then startPos = Vector2.new(i.Position.X, i.Position.Y) end
	end)
	hit.InputEnded:Connect(function(i)
		if startPos and isPress(i) then
			local d = (Vector2.new(i.Position.X, i.Position.Y) - startPos).Magnitude
			startPos = nil
			if d < 10 then cb() end
		end
	end)
end

local function button(props, cb)
	local p = { BackgroundColor3 = C.dgreen, BackgroundTransparency = 0.2, Font = Enum.Font.GothamBold, TextColor3 = C.white,
		TextSize = 12, AutoButtonColor = true, BorderSizePixel = 0 }
	local tapMode, rad = props.Tap, props.Radius or 8
	for k, v in pairs(props) do if k ~= "Tap" and k ~= "Radius" then p[k] = v end end
	local b = new("TextButton", p, { corner(rad) })
	if cb then
		if tapMode then tap(b, cb) else b.Activated:Connect(cb) end
	end
	return b
end

