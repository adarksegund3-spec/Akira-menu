	btn.MouseButton1Up:Connect(function() tw(bsc, 0.25, {Scale = 1}, Enum.EasingStyle.Back) end)
	btn.MouseLeave:Connect(function() tw(bsc, 0.2, {Scale = 1}) end)
	btn.MouseButton1Click:Connect(function() toggleItem(def) end)
	card.MouseEnter:Connect(function() tw(cs, 0.25, {Transparency = 0.45, Color = def.c1}) end)
	card.MouseLeave:Connect(function() tw(cs, 0.25, {Transparency = 0.9, Color = WHT}) end)
	floaters[#floaters + 1] = {icon = icon, g = sg, ph = n * 1.7}
	task.delay((n - 1) * 0.07, function()
		if card.Parent then tw(card, 0.4, {GroupTransparency = 0}); tw(csc, 0.5, {Scale = 1}, Enum.EasingStyle.Back) end
	end)
end

local function setTab(i)
	curTab = i
	for _, c in ipairs(Body:GetChildren()) do if c:IsA("CanvasGroup") then c:Destroy() end end
	floaters, setters = {}, {}
	local n = 0
	for _, def in ipairs(D) do if def.tab == i then n = n + 1; buildCard(def, n) end end
	sub.Text = TABS[i][1] .. "  ·  " .. n .. " itens"
	Body.CanvasPosition = Vector2.zero
	tw(Sel, 0.45, {Position = UDim2.fromOffset(13, 9 + (i - 1) * 41)}, Enum.EasingStyle.Back)
	for k, b in ipairs(tabBtns) do tw(b, 0.3, {TextTransparency = k == i and 0 or 0.45}) end
end

for i, t in ipairs(TABS) do
	local b = new("TextButton", {Position = UDim2.fromOffset(15, 11 + (i - 1) * 41), Size = UDim2.fromOffset(36, 36), BackgroundTransparency = 1, Text = t[2], TextSize = 18,
		TextTransparency = 0.45, AutoButtonColor = false, ZIndex = 3}, Rail)
	b.MouseButton1Click:Connect(function() if curTab ~= i then setTab(i) end end)
	tabBtns[i] = b
end

local function fit()
	local v = cam.ViewportSize
	fitScale = math.clamp(math.min((v.X - 16) / 590, (v.Y - 16) / 370), 0.45, 1.15)
	if isOpen then sc.Scale = fitScale end
end
fit()
local vc = cam:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
onKill(function() vc:Disconnect() end)

local function setOpen(v)
	if v == isOpen then return end
	isOpen = v
	if v then
		setTab(curTab)
		Root.Visible = true; Root.GroupTransparency = 1; sc.Scale = fitScale * 0.86
		tw(sc, 0.5, {Scale = fitScale}, Enum.EasingStyle.Back); tw(Root, 0.3, {GroupTransparency = 0}); tw(blur, 0.4, {Size = 12})
		tw(pill, 0.25, {GroupTransparency = 1}); task.delay(0.25, function() if isOpen then pill.Visible = false end end)
	else
		tw(sc, 0.3, {Scale = fitScale * 0.9}); tw(Root, 0.28, {GroupTransparency = 1}); tw(blur, 0.3, {Size = 0})
		pill.Visible = true; pill.GroupTransparency = 1; tw(pill, 0.35, {GroupTransparency = 0})
		task.delay(0.3, function() if not isOpen then Root.Visible = false end end)
	end
end
close.MouseButton1Click:Connect(function() setOpen(false) end)
