	local hr = K.c:FindFirstChild("HumanoidRootPart")
	local root = new("Part", {Size = Vector3.one * 0.4, Transparency = 1, Anchored = true, CanCollide = false, CanQuery = false, CFrame = hr.CFrame * CFrame.new(3, 4.5, 0)}, junk)
	K.add(root); K.base, K.parent = root, junk
	local main = cinema and rgb(255, 140, 40) or rgb(26, 27, 33)
	local carbon, green, red = rgb(44, 46, 56), rgb(60, 255, 120), rgb(255, 50, 60)
	K.part(Vector3.new(1.3, 0.34, 1.7), CFrame.new(), main, M.Metal)
	K.part(Vector3.new(1, 0.22, 1.3), CFrame.new(0, 0.26, 0), carbon)
	K.part(Vector3.new(1.02, 0.03, 0.12), CFrame.new(0, 0.38, -0.5), rgb(0, 230, 255), M.Neon)
	K.ball(0.5, CFrame.new(0, -0.35, -0.55), BLK)
	K.ball(0.22, CFrame.new(0, -0.35, -0.8), rgb(80, 180, 255), M.Neon)
	K.light(K.ball(0.1, CFrame.new(0, -0.35, -0.85), WHT, M.Neon, {Transparency = 1}), rgb(120, 200, 255), 14, 1.5)
	for _, x in ipairs({-0.6, 0.6}) do
		K.rod(Vector3.new(x, -0.15, -0.7), Vector3.new(x, -0.15, 0.7), 0.06, carbon, M.Metal)
		K.rod(Vector3.new(x, -0.15, -0.5), Vector3.new(x, 0, -0.3), 0.06, carbon, M.Metal)
	end
	local props, leds = {}, {}
	for _, sg in ipairs({{-1, -1}, {1, -1}, {-1, 1}, {1, 1}}) do
		local x, z = sg[1] * 1.5, sg[2] * 1.5
		K.rod(Vector3.new(sg[1] * 0.4, 0, sg[2] * 0.4), Vector3.new(x, 0.05, z), 0.13, carbon, M.Metal)
		K.cyl(0.3, 0.38, CFrame.new(x, 0.12, z), main, M.Metal)
		K.cyl(0.02, 1.75, CFrame.new(x, 0.34, z), rgb(220, 230, 255), nil, {Transparency = 0.82})
		local _, w1 = K.part(Vector3.new(1.7, 0.025, 0.16), CFrame.new(), rgb(30, 30, 34), M.Metal)
		local _, w2 = K.part(Vector3.new(1.7, 0.025, 0.16), CFrame.new(), rgb(30, 30, 34), M.Metal)
		props[#props + 1] = {w1, w2, x, z, sg[1] * sg[2]}
		leds[#leds + 1] = K.ball(0.14, CFrame.new(x, 0, z), sg[2] < 0 and green or red, M.Neon)
	end
	local pos, prev, view = root.Position, root.Position, false
	local function setView(v)
		view = v
		local h = hum()
		if h then cam.CameraSubject = v and root or h end
	end
	K.add(function() setView(false) end)
	K.setView = function() setView(not view) end
	if cinema then task.defer(function() setView(true) end) end
	K.loop(function(t, dt)
		local r = K.c:FindFirstChild("HumanoidRootPart"); if not r then return end
		local look = r.CFrame.LookVector
		local target = r.Position + r.CFrame.RightVector * 3.2 + Vector3.new(0, 4.6 + math.sin(t * 1.4) * 0.25, 0) - look * 1.2
		if cinema then target = r.Position + Vector3.new(math.cos(t * 0.4) * 9, 7 + math.sin(t) * 0.5, math.sin(t * 0.4) * 9) end
		pos = pos:Lerp(target, 1 - math.exp(-dt * 3.5))
		local vel = (pos - prev) / math.max(dt, 1e-3); prev = pos
		local fl = Vector3.new(look.X, 0, look.Z)
		local face = CFrame.lookAt(Vector3.zero, cinema and (r.Position - pos) * Vector3.new(1, 0, 1) + Vector3.new(0, 0, 1e-3) or (fl.Magnitude > 0 and fl or -Vector3.zAxis))
		local loc = face:VectorToObjectSpace(vel)
		root.CFrame = CFrame.new(pos) * face * CFrame.Angles(math.clamp(loc.Z * 0.02, -0.4, 0.4), 0, math.clamp(-loc.X * 0.02, -0.4, 0.4))
		for _, p in ipairs(props) do
			local a = t * 60 * p[5]
			p[1].C0 = CFrame.new(p[3], 0.3, p[4]) * CFrame.Angles(0, a, 0)
			p[2].C0 = CFrame.new(p[3], 0.3, p[4]) * CFrame.Angles(0, a + math.pi / 2, 0)
		end
		for i, l in ipairs(leds) do l.Transparency = (math.sin(t * 8 + i * 1.6) > 0) and 0 or 0.7 end
	end)
end
