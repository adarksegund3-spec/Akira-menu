            Instance.new("UICorner", hpFill).CornerRadius = UDim.new(1,0)
            local distLbl = Instance.new("TextLabel")
            distLbl.Name = "DistLbl"
            distLbl.Size = UDim2.new(1, 0, 0, 14)
            distLbl.Position = UDim2.new(0, 0, 0, 28)
            distLbl.BackgroundTransparency = 1
            distLbl.Font = Enum.Font.GothamMedium
            distLbl.TextSize = 10
            distLbl.TextColor3 = TEXT_DIM
            distLbl.TextStrokeTransparency = 0
            distLbl.TextStrokeColor3 = Color3.new(0,0,0)
            distLbl.Parent = bb
            cache.billboard = bb
        end
        local bb = cache.billboard
        bb.NameLbl.Text = player.DisplayName
        bb.NameLbl.TextColor3 = cor
        bb.NameLbl.Visible = Config.ESPName
        bb.HPBar.Visible = Config.ESPHealth
        bb.DistLbl.Visible = Config.ESPDistance
        if Config.ESPHealth then
            local hp = hum.Health / math.max(hum.MaxHealth, 1)
            bb.HPBar.HPFill.Size = UDim2.new(math.clamp(hp, 0, 1), 0, 1, 0)
            bb.HPBar.HPFill.BackgroundColor3 = Color3.fromRGB(255 * (1-hp), 255 * hp, 60)
        end
        if Config.ESPDistance then
            local dist = (Camera.CFrame.Position - char:GetPivot().Position).Magnitude
            bb.DistLbl.Text = string.format("[%d studs]", math.floor(dist))
        end
    elseif cache.billboard then
        cache.billboard:Destroy(); cache.billboard = nil
    end

    -- Drawing (Box + Tracer)
    if hasDrawing then
        local top, bottom = get2DBounds(char)
        if Config.ESPBox and top and bottom then
            if not cache.drawings.box then
                local sq = Drawing.new("Square")
                sq.Thickness = 1
                sq.Filled = false
                sq.Transparency = 1
