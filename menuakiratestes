local capturedTop = {}       -- path -> entrada visível na faixa superior
local hooked = setmetatable({}, { __mode = "k" })
local pending = setmetatable({}, { __mode = "k" })

local function isOwnGui(obj) return obj:IsDescendantOf(screenGui) end
local function isTextObject(obj)
	return obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")
end

--=====================================================================
-- 4. ANÁLISE DE ELEMENTOS DE TEXTO
--=====================================================================
-- Visível de verdade? (considera Visible dos ancestrais, Enabled da ScreenGui e transparência)
local function isEffectivelyVisible(obj)
	local cur = obj
	while cur and cur ~= game do
		if cur:IsA("GuiObject") and not cur.Visible then return false end
		if cur:IsA("LayerCollector") and not cur.Enabled then return false end
		cur = cur.Parent
	end
	if obj.TextTransparency >= 1 or obj.Text == "" then return false end
	return true
end

-- Posição vertical relativa na tela (0 = topo, 1 = base)
local function screenPosition(obj)
	local cam = Workspace.CurrentCamera
	if not (obj:IsA("GuiObject") and cam) then return nil, "indeterminada" end
	local lc = obj:FindFirstAncestorWhichIsA("LayerCollector")
	if lc and not lc:IsA("ScreenGui") then
		return nil, "mundo 3D (" .. lc.ClassName .. ")"
	end
	local vp = cam.ViewportSize
	local ratio = (obj.AbsolutePosition.Y + obj.AbsoluteSize.Y / 2) / math.max(vp.Y, 1)
	local region = "centro"
	if ratio < CONFIG.TOP_BAND_RATIO then region = "SUPERIOR"
	elseif ratio > 0.75 then region = "inferior" end
	return ratio, region
end

local function describeTextObject(obj)
	local norm = normalize(obj.Text)
	local ratio, region = screenPosition(obj)
	local lc = obj:FindFirstAncestorWhichIsA("LayerCollector")
	return {
		path = obj:GetFullName(),
		class = obj.ClassName,
		text = cleanText(obj.Text),
		visible = isEffectivelyVisible(obj),
		ratio = ratio,
		region = region,
		gui = lc and lc:GetFullName() or "?",
		hits = findHits(norm, KEYWORDS),
		ruleHits = findHits(norm, RULE_WORDS),
	}
end

-- Guarda a entrada mantendo até 5 textos anteriores (ex.: contador que muda)
local function store(tbl, e)
	local prior = tbl[e.path]
	e.history = prior and prior.history or {}
	if prior and prior.text ~= e.text then
		table.insert(e.history, prior.text)
		if #e.history > 5 then table.remove(e.history, 1) end
	end
	e.seenAt = os.date("%H:%M:%S")
	tbl[e.path] = e
end

local function recordObject(obj)
	if not obj.Parent or isOwnGui(obj) or obj.Text == "" then return end
	local e = describeTextObject(obj)
	if #e.hits > 0 then store(captured, e) end
	if e.visible and e.ratio and e.ratio < CONFIG.TOP_BAND_RATIO then store(capturedTop, e) end
end

-- Escuta mudanças de Text/Visible (com debounce de 0.2s)
local function hookText(obj)
	if hooked[obj] or isOwnGui(obj) then return end
	hooked[obj] = true
	local function schedule()
		if pending[obj] then return end
		pending[obj] = true
		task.delay(0.2, function()
			pending[obj] = nil
			recordObject(obj)
		end)
	end
	obj:GetPropertyChangedSignal("Text"):Connect(schedule)
	obj:GetPropertyChangedSignal("Visible"):Connect(schedule)
	recordObject(obj)
end

-- Vigia permanente: pega textos que aparecem quando o jogador é preso
task.spawn(function()
	playerGui.DescendantAdded:Connect(function(d)
		if isTextObject(d) then task.defer(hookText, d) end
	end)
	for i, d in ipairs(playerGui:GetDescendants()) do
		if i % CONFIG.YIELD_EVERY == 0 then task.wait() end
		if isTextObject(d) then hookText(d) end
	end
end)

-- Varredura completa do PlayerGui
local function scanPlayerGui()
	local result = { total = 0, hits = {}, top = {}, ruleTexts = {} }
	for i, obj in ipairs(playerGui:GetDescendants()) do
		if i % CONFIG.YIELD_EVERY == 0 then task.wait() end
		if obj.Parent and isTextObject(obj) and not isOwnGui(obj) then
			result.total += 1
			hookText(obj)
			if obj.Text ~= "" then
				local e = describeTextObject(obj)
				if #e.hits > 0 then table.insert(result.hits, e) end
				if e.visible and e.ratio and e.ratio < CONFIG.TOP_BAND_RATIO then table.insert(result.top, e) end
				if #e.ruleHits > 0 then table.insert(result.ruleTexts, e) end
			end
		end
	end
	return result
end

