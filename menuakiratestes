        Text    = Color3.fromRGB(240, 240, 243),
        Sub     = Color3.fromRGB(125, 127, 133),
        Accent  = Color3.fromRGB(235, 236, 240),
        AccentD = Color3.fromRGB(140, 142, 150),
    }

    if SplashCfg.Enabled then
        local sg, blur
        local ok, err = pcall(function()
            local TS = TweenService
            local function tw(o, t, p, style, dir)
                local x = TS:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), p)
