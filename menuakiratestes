-- WEAPON MODS (reflection)
-- ═══════════════════════════════════════════════════════════════
local WeaponTick = 0

local function applyWeaponMods()
    local char = LocalPlayer.Character
    if not char then return end

    -- Varre Tools no character + backpack
    local containers = { char, LocalPlayer:FindFirstChildOfClass("Backpack") }
    for _, container in ipairs(containers) do
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") then
                    -- Verifica NumberValues/IntValues
                    for _, desc in ipairs(tool:GetDescendants()) do
                        if desc:IsA("NumberValue") or desc:IsA("IntValue") then
                            local n = desc.Name:lower()
                            if Config.NoRecoil and (n:find("recoil") or n:find("kick") or n:find("camerarecoil")) then
                                pcall(function() desc.Value = 0 end)
                            end
                            if Config.NoSpread and (n:find("spread") or n:find("deviation") or n:find("bulletspread")) then
                                pcall(function() desc.Value = 0 end)
                            end
                            if Config.InfAmmo and (n:find("ammo") or n:find("magazine") or n:find("clip")) and not n:find("max") and not n:find("stored") then
                                pcall(function()
                                    if desc.Value < 999 then desc.Value = 999 end
                                end)
                            end
                            if Config.FastReload and (n:find("reload") or n:find("reloadtime")) then
                                pcall(function()
                                    if desc.Value > 0 then desc.Value = 0.1 end
                                end)
                            end
                        end
                    end
                    -- Verifica propriedades diretas no Tool
                    if Config.NoRecoil then
                        for _, prop in ipairs({"Recoil", "Kick", "CameraRecoil", "RecoilAmount"}) do
                            pcall(function() tool[prop] = 0 end)
                        end
                    end
                    if Config.NoSpread then
                        for _, prop in ipairs({"Spread", "Deviation", "BulletSpread"}) do
                            pcall(function() tool[prop] = 0 end)
                        end
                    end
                end
            end
        end
    end
end

