local function runScript(src)
    if src:gsub("%s", "") == "" then return false, "O editor está vazio." end
    if not loadstring then return false, "Este executor não suporta loadstring." end
    local fn, err = loadstring(src)
    if not fn then return false, "Erro de sintaxe: " .. tostring(err) end
    local ok, e = pcall(fn)
    if not ok then return false, "Erro ao executar: " .. tostring(e) end
    return true, "Script executado com sucesso."
end

