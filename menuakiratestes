-- ---------- LISTENER CENTRAL ----------
-- Toda mudança de seleção passa por aqui → atualiza TUDO de uma vez
State:onChange(function(route)
    if route then
        -- atualiza painel de detalhes
        local events = route.data.events
        local moveCount, jumpCount, animCount, clickCount, nonReplay = 0, 0, 0, 0, 0
        for _, e in ipairs(events) do
            if e.type == EventType.MOVE_CFRAME then moveCount = moveCount + 1
            elseif e.type == EventType.JUMP_START then jumpCount = jumpCount + 1
            elseif e.type == EventType.ANIM_START then animCount = animCount + 1
            elseif e.type == EventType.CLICK_DETECT then clickCount = clickCount + 1
            end
            if NON_REPLAYABLE[e.type] then nonReplay = nonReplay + 1 end
        end
        lblDetails:Set(string.format(
            "Nome: %s | Duração: %.2fs\nEventos: %d (Mov: %d | Saltos: %d | Anims: %d | Cliques: %d)\nIncompatíveis: %d",
            route.name, route.data.duration or 0, #events,
            moveCount, jumpCount, animCount, clickCount, nonReplay
        ))
        lblSelected:Set("Selecionada: " .. route.name)
        -- sincroniza dropdown do histórico
        dropdownRoutes:Set(route.name)
    else
        lblDetails:Set("Nenhuma rota selecionada")
        lblSelected:Set("Nenhuma rota selecionada")
    end
end)

