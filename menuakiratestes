local function dress(name)
	local c = char(); if not c then return end
	local p = presets[name]
	restoreOutfit()
	local bc = c:FindFirstChildOfClass("BodyColors") or Instance.new("BodyColors", c)
	saved.bc = {HeadColor3 = bc.HeadColor3, TorsoColor3 = bc.TorsoColor3, LeftArmColor3 = bc.LeftArmColor3,
		RightArmColor3 = bc.RightArmColor3, LeftLegColor3 = bc.LeftLegColor3, RightLegColor3 = bc.RightLegColor3}
	saved.cloth = {}
	for _, o in ipairs(c:GetChildren()) do
		if o:IsA("Shirt") or o:IsA("Pants") or o:IsA("ShirtGraphic") then table.insert(saved.cloth, o); o.Parent = nil end
	end
	if p.head then bc.HeadColor3 = p.head end
	bc.TorsoColor3, bc.LeftArmColor3, bc.RightArmColor3, bc.LeftLegColor3, bc.RightLegColor3 = p.torso, p.arms, p.arms, p.legs, p.legs
	local head = c:FindFirstChild("Head")
	local f = head and head:FindFirstChild("face")
	if f then f.Transparency = 1 end
	if head then p.extra(c, head.Size) end
	notify("Traje: " .. name)
end

