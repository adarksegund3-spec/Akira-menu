	local parts = {}
	for k, v in pairs(params or {}) do
		table.insert(parts, HttpService:UrlEncode(tostring(k)) .. "=" .. HttpService:UrlEncode(tostring(v)))
	end
	local url = "https://api.deezer.com" .. path .. (#parts > 0 and ("?" .. table.concat(parts, "&")) or "")
