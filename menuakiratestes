local function new(class, props, parent)
	local o = Instance.new(class)
	if props then for k, v in pairs(props) do o[k] = v end end
	if parent then o.Parent = parent end
	return o
end

local function corner(o, r, scale)
	return new("UICorner", {CornerRadius = scale and UDim.new(r, 0) or UDim.new(0, r)}, o)
end
local function ustroke(o, col, th, tr)
	return new("UIStroke", {Color = col, Thickness = th or 1, Transparency = tr or 0}, o)
end

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = false; p.CanCollide = false; p.CanTouch = false; p.CanQuery = false
	p.Massless = true; p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = Vector3.new(1, 1, 1)
	for k, v in pairs(props or {}) do p[k] = v end
	return p
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a; w.Part1 = b; w.Parent = a
	return w
end

