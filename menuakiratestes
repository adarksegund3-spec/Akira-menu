-- faixas de um cantor (jmu-), álbum (jma-) ou playlist (jmp-) do Jamendo
function Api.jamendoTracksFor(id)
	local kind, num = tostring(id):match("^jm([upa])%-(%d+)$")
	if not kind then return nil, "INVALID" end
	if kind == "u" then
		local d, e = jmGet("tracks/", { artist_id = num, limit = 50, order = "popularity_total" })
		if not d then return nil, e end
		return jmList(d)
	elseif kind == "a" then
		local d, e = jmGet("tracks/", { album_id = num, limit = 100 })
		if not d then return nil, e end
		return jmList(d)
	end
	local d, e = jmGet("playlists/tracks/", { id = num })
	if not d then return nil, e end
	local first = d[1]
	return jmList(type(first) == "table" and type(first.tracks) == "table" and first.tracks or {})
end
-- mistura duas listas alternando os itens (Audius, Jamendo, Audius, Jamendo...)
function Api.interleave(a, b)
	local out, seen = {}, {}
	a, b = a or {}, b or {}
	for i = 1, math.max(#a, #b) do
		for _, t in ipairs({ a[i], b[i] }) do
			if t and not seen[t.id] then seen[t.id] = true; table.insert(out, t) end
		end
	end
	return out
end
