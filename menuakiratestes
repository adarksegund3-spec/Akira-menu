-- Paginação
local function applyPagination(pag)
    CatalogState.totalPages = pag.totalPages or 1
    CatalogState.hasNext = pag.hasNextPage or false
    CatalogState.hasPrev = pag.hasPrevPage or false
    prevBtn.BackgroundColor3 = CatalogState.hasPrev and Color3.fromRGB(60,15,15) or Color3.fromRGB(30,8,8)
    nextBtn.BackgroundColor3 = CatalogState.hasNext and Color3.fromRGB(60,15,15) or Color3.fromRGB(30,8,8)
    pageLabel.Text = tostring(CatalogState.page) .. " / " .. tostring(CatalogState.totalPages)
end

-- Busca principal
local function DoSearch(query, page, skipCache)
    if CatalogState.loading then return end
    query = query or CatalogState.query
    page = page or CatalogState.page
    CatalogState.query = query
    CatalogState.page = page

    local cacheKey = (query or "") .. "|" .. tostring(CatalogState.filters.noKey)
        .. "|" .. tostring(CatalogState.filters.mobile)
        .. "|" .. tostring(CatalogState.filters.free)
        .. "|" .. tostring(page) .. "|" .. CatalogState.sort

    if Config.CacheEnabled and not skipCache then
        local cached = Cache[cacheKey]
        if cached and (tick() - cached.time) < Config.CacheDuration then
            RenderResults(cached.data)
            local pag = cached.data.meta and cached.data.meta.pagination
                and cached.data.meta.pagination.scripts or {}
            applyPagination(pag)
            local count = #((cached.data.data and cached.data.data.scripts) or {})
            statusLabel.Text = "Cache • " .. tostring(count) .. " resultados"
            return
        end
    end

    CatalogState.loading = true
    statusLabel.Text = "⏳ Pesquisando scripts..."
    for _, c in ipairs(resultScroll:GetChildren()) do
        if c:IsA("Frame") or c:IsA("TextLabel") or c:IsA("TextButton") then c:Destroy() end
    end
    local loading = Instance.new("TextLabel", resultScroll)
    loading.Name = "Loading"
    loading.Text = "⏳ Carregando..."; loading.Font = Enum.Font.Gotham; loading.TextSize = 11
    loading.TextColor3 = Color3.fromRGB(200,200,200); loading.BackgroundTransparency = 1
    loading.Position = UDim2.new(0,0,0,40); loading.Size = UDim2.new(1,0,0,20)

    task.spawn(function()
        local url = BuildURL(query, CatalogState.filters, page, CatalogState.sort)
        local data, err = FetchScripts(url)
        CatalogState.loading = false

        if loading and loading.Parent then loading:Destroy() end

        if not data then
            statusLabel.Text = err or "⚠ Falha na requisição"
            statusLabel.TextColor3 = Color3.fromRGB(220,80,80)
            local retry = Instance.new("TextButton", resultScroll)
            retry.Text = "↻ TENTAR NOVAMENTE"
            retry.Font = Enum.Font.GothamBold; retry.TextSize = 10
            retry.TextColor3 = Color3.fromRGB(255,255,255); retry.BackgroundColor3 = Color3.fromRGB(140,25,25)
            retry.BorderSizePixel = 0; retry.AutoButtonColor = false
            retry.Position = UDim2.new(0.5,-70,0,60); retry.Size = UDim2.new(0,140,0,28)
            Instance.new("UICorner", retry).CornerRadius = UDim.new(0,5)
            retry.MouseButton1Click:Connect(function()
                retry:Destroy()
                DoSearch(query, page, true)
            end)
            return
        end

        statusLabel.TextColor3 = Color3.fromRGB(180,180,180)
        local scripts = (data.data and data.data.scripts) or {}
        local pag = (data.meta and data.meta.pagination and data.meta.pagination.scripts) or {}
        applyPagination(pag)
        statusLabel.Text = tostring(#scripts) .. " resultados • Página " .. page .. "/" .. CatalogState.totalPages

        if Config.CacheEnabled then
            Cache[cacheKey] = { data = data, time = tick() }
        end
        RenderResults(data)
    end)
end

