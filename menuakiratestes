-- CFrame cujo -Z aponta para a normal n
local function faceCF(p, n)
	local up = (math.abs(n.Y) > 0.98) and Vector3.new(0, 0, 1) or Vector3.new(0, 1, 0)
	return CFrame.lookAt(p, p + n, up)
end
local function lookCF(from, to)
	local d = to - from
	local up = (d.Magnitude > 0 and math.abs(d.Unit.Y) > 0.97) and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
	return CFrame.lookAt(from, to, up)
end

