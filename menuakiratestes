            tw(blur, SplashCfg.IntroTime, {Size = 10})
            tw(box, SplashCfg.IntroTime, {Size = UDim2.new(0, W, 0, 260)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out).Completed:Wait()

            for _, c in ipairs(box:GetDescendants()) do
                if c:IsA("TextLabel") then tw(c, 0.35, {TextTransparency = 0})
                elseif c:IsA("ImageLabel") then tw(c, 0.35, {ImageTransparency = 0})
                elseif c:IsA("Frame") then tw(c, 0.35, {BackgroundTransparency = (c == shine) and 0.6 or 0})
                elseif c:IsA("UIStroke") then tw(c, 0.35, {Transparency = (c == glow) and 1 or 0.2}) end
                task.wait(0.015)
            end

            -- brilho correndo na barra
            local done = false
            task.spawn(function()
                while not done and box.Parent do
                    shine.Position = UDim2.new(-0.4, 0, 0, 0)
                    tw(shine, 1.2, {Position = UDim2.new(1.4, 0, 0, 0)}, Enum.EasingStyle.Linear)
                    task.wait(1.5)
                end
            end)

            -- progresso
            local cur = 0
            local function setProgress(target, dur)
                local nv = Instance.new("NumberValue"); nv.Value = cur
                local ti = TweenInfo.new(dur, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
                TS:Create(fill, ti, {Size = UDim2.new(target / 100, 0, 1, 0)}):Play()
                nv.Changed:Connect(function(v)
                    cur = math.clamp(v, 0, 100); pct.Text = math.floor(cur) .. "%"
                end)
                TS:Create(nv, ti, {Value = target}):Play()
                task.delay(dur + 0.1, function() nv:Destroy() end)
            end
            local function setStatus(t)
                tw(status, 0.1, {TextTransparency = 1}); task.wait(0.1)
                status.Text = t
                tw(status, 0.1, {TextTransparency = 0})
            end

            local n = #SplashCfg.Messages
            local step = SplashCfg.LoadTime / n
            for i, msg in ipairs(SplashCfg.Messages) do
                setStatus(msg)
                setProgress(i / n * 100, step * 0.85)
                task.wait(step)
            end
            done = true
            tw(shine, 0.2, {BackgroundTransparency = 1})
            pct.Text = "100%"
            setStatus("Pronto!")

            -- flash de sucesso
            tw(glow, 0.25, {Transparency = 0.5})
            tw(logo, 0.3, {Size = UDim2.new(0, 78, 0, 78)}, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
