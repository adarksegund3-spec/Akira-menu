--  GEOMETRIA / VISUAL COMPARTILHADO
--====================================================================
local function newWedge(col, mat, tr)
	local w = Instance.new("WedgePart")
	w.Anchored = false; w.CanCollide = false; w.CanTouch = false; w.CanQuery = false
	w.Massless = true; w.CastShadow = false
	w.Color = col; w.Material = mat; w.Transparency = tr
	w.TopSurface = Enum.SurfaceType.Smooth; w.BottomSurface = Enum.SurfaceType.Smooth
	return w
end

-- triangulo suave feito com 2 wedges (coordenadas locais do host)
local function tri(host, parent, a, b, c, col, mat, tr)
	local R = host.CFrame
	a, b, c = R * a, R * b, R * c
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local cr = ac:Cross(ab)
	if cr.Magnitude < 1e-3 then return end
	local right = cr.Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	local w1, w2 = newWedge(col, mat, tr), newWedge(col, mat, tr)
	w1.Size = Vector3.new(0.05, math.max(0.02, height), math.max(0.02, math.abs(ab:Dot(back))))
	w1.CFrame = CFrame.fromMatrix((a + b) / 2, right, up, back)
	w2.Size = Vector3.new(0.05, math.max(0.02, height), math.max(0.02, math.abs(ac:Dot(back))))
	w2.CFrame = CFrame.fromMatrix((a + c) / 2, -right, up, -back)
	w1.Parent = parent; w2.Parent = parent
	weld(host, w1); weld(host, w2)
end

-- tubo (cilindro) entre dois pontos locais do host
local function tube(host, parent, a, b, r, col, mat)
	local R = host.CFrame
	local wa, wb = R * a, R * b
	local len = (wb - wa).Magnitude
	if len < 0.05 then return end
	local p = part({
		Shape = Enum.PartType.Cylinder, Size = Vector3.new(len, r * 2, r * 2),
		CFrame = lookCF((wa + wb) / 2, wb) * CFrame.Angles(0, math.pi / 2, 0),
		Color = col, Material = mat, Parent = parent,
	})
	weld(host, p)
end

-- anel (contorno) desenhado com SurfaceGui nas duas faces do bloco fino (eixo X)
local function addRing(p, col, thick, canvas)
	local strokes = {}
	for _, face in ipairs({Enum.NormalId.Right, Enum.NormalId.Left}) do
		local sg = new("SurfaceGui", {
			Face = face, SizingMode = Enum.SurfaceGuiSizingMode.FixedSize,
			CanvasSize = canvas, LightInfluence = 0, AlwaysOnTop = false,
		}, p)
		local fr = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1}, sg)
		corner(fr, 0.5, true)
		table.insert(strokes, ustroke(fr, col, thick, 0))
	end
	return strokes
end

local function shake(power)
	task.spawn(function()
		local hum = getHum()
		if not hum then return end
		local t0 = os.clock()
		while alive and os.clock() - t0 < 0.45 do
			local k = (1 - (os.clock() - t0) / 0.45) * power
			hum.CameraOffset = Vector3.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
			RS.RenderStepped:Wait()
		end
		hum.CameraOffset = Vector3.zero
	end)
end

local function shockwave(pos, n, power)
	local function ring(delay, col, thick)
		task.delay(delay, function()
			if not alive then return end
			local p = part({
				Anchored = true, Transparency = 1, Size = Vector3.new(0.1, 4, 4),
				CFrame = faceCF(pos + n * 0.25, n) * CFrame.Angles(0, math.pi / 2, 0), Parent = FX,
			})
			local strokes = addRing(p, col, thick, Vector2.new(400, 400))
			TS:Create(p, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{Size = Vector3.new(0.1, 38 * power, 38 * power)}):Play()
			for _, s in ipairs(strokes) do
				TS:Create(s, TweenInfo.new(0.6), {Transparency = 1}):Play()
			end
			Debris:AddItem(p, 0.8)
		end)
	end
	ring(0, WHITE, 26)
	ring(0.09, T.acc2, 16)
	local d = part({Anchored = true, Transparency = 1, Size = Vector3.new(1, 1, 1), Position = pos + Vector3.new(0, 0.6, 0), Parent = FX})
	local em = new("ParticleEmitter", {
		Texture = SMOKE, Rate = 0, Lifetime = NumberRange.new(0.6, 1.1), Speed = NumberRange.new(14, 26),
		SpreadAngle = Vector2.new(80, 80), Size = NS(NSK(0, 2), NSK(1, 6)),
		Transparency = NS(NSK(0, 0.4), NSK(1, 1)), Color = ColorSequence.new(Color3.fromRGB(190, 190, 200)),
	}, d)
	em:Emit(math.floor(30 * power))
	Debris:AddItem(d, 1.5)
	shake(0.9 * power)
end

