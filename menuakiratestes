local recordedData = {}
local isRecording = false
local recordingConnection = nil
local playbackConnection = nil
local playingBusy = false
local startTime = 0
local antigravidade = nil
local originalCollides = {}
local animationCache = {}
local animationCacheOwner = nil
local activeTracks = {}
local preWalkTracks = {}

local DEFAULT_WALKSPEED = 16
local savedWalkSpeed = nil

-- carrega a track uma vez só e reaproveita (antes criava uma nova a cada uso)
local function getOrLoadTrack(animator, animationId)
    if animationCacheOwner ~= animator then
        animationCache = {}
        animationCacheOwner = animator
    end
    local cached = animationCache[animationId]
    if cached ~= nil then return cached or nil end
    local anim = Instance.new("Animation")
    anim.AnimationId = animationId
    local ok, trackObj = pcall(function() return animator:LoadAnimation(anim) end)
    if ok and trackObj then
        animationCache[animationId] = trackObj
        return trackObj
    end
    animationCache[animationId] = false
    return nil
end

local function getStartAnimations(data)
    if #data == 0 then return {} end
    local counts = {}
    local sampleCount = math.min(30, #data)
    for i = 1, sampleCount do
        local anims = data[i].Animations
        if anims then
            for _, a in ipairs(anims) do
                if not counts[a.Id] then counts[a.Id] = { anim = a, count = 0 } end
                counts[a.Id].count = counts[a.Id].count + 1
            end
        end
    end
    local result = {}
    local threshold = math.max(2, sampleCount * 0.3)
    for _, info in pairs(counts) do
        if info.count >= threshold then table.insert(result, info.anim) end
    end
    local prioOrder = { Action = 4, Action2 = 4, Action3 = 4, Action4 = 4, Movement = 3, Idle = 2, Core = 1 }
    table.sort(result, function(a, b)
        return (prioOrder[a.Priority] or 0) > (prioOrder[b.Priority] or 0)
    end)
    return result
end

local function stopPreWalkAnimations()
    for _, t in ipairs(preWalkTracks) do
        pcall(function() t:Stop(0.1) end)
    end
    preWalkTracks = {}
end

local function restoreWalkSpeed()
    if savedWalkSpeed then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        if hum then hum.WalkSpeed = savedWalkSpeed end
        savedWalkSpeed = nil
    end
end

local function stopPlayback()
    if playbackConnection then
        playbackConnection:Disconnect()
        playbackConnection = nil
    end
    playingBusy = false
    stopPreWalkAnimations()
    restoreWalkSpeed()

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if antigravidade then antigravidade:Destroy() antigravidade = nil end
    if hum then hum.AutoRotate = true end
    for _, t in pairs(activeTracks) do
        pcall(function() t:Stop(0.1) end)
    end
    activeTracks = {}
    for parte, status in pairs(originalCollides) do
        if parte and parte.Parent then parte.CanCollide = status end
    end
    table.clear(originalCollides)
end

local function toStateEnum(s)
    if typeof(s) == "EnumItem" then return s end
    if type(s) == "string" then
        local ok, e = pcall(function() return Enum.HumanoidStateType[s] end)
        if ok then return e end
    end
    return nil
end

local function playRoute(data)
    if #data == 0 then setStatus("Nada gravado", "warn") return end
    if playbackConnection then
        stopPlayback()
        stopTimer()
        setStatus("Cancelado", "warn")
        return
    end
    if playingBusy then return end
    playingBusy = true

    task.spawn(function()
        setStatus("Indo para o início...", "play")
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        if not hrp or not hum then
            playingBusy = false
            setStatus("Sem personagem", "warn")
            return
        end

        savedWalkSpeed = hum.WalkSpeed

        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then animator = Instance.new("Animator", hum) end

        -- pré-carrega (sem esperar) as animações da rota enquanto o boneco anda até o início
        local warmed = {}
        for _, p in ipairs(data) do
            if p.Animations then
                for _, a in ipairs(p.Animations) do
                    if a.Id and a.Id ~= "" and not warmed[a.Id] then
                        warmed[a.Id] = true
                        getOrLoadTrack(animator, a.Id)
                    end
                end
            end
        end

        local animateScript = char:FindFirstChild("Animate")
        local animateWasDisabled = false
        if animateScript and animateScript:IsA("BaseScript") then
            animateScript.Disabled = true
            animateWasDisabled = true
        end

        local detectedAnims = getStartAnimations(data)
        preWalkTracks = {}
        for _, animData in ipairs(detectedAnims) do
            local trackObj = getOrLoadTrack(animator, animData.Id)
            if trackObj then
                pcall(function()
                    trackObj.Priority = Enum.AnimationPriority[animData.Priority] or Enum.AnimationPriority.Movement
                    trackObj.Looped = true
                    trackObj:Play(0.1)
                    trackObj:AdjustSpeed(animData.Speed or 1)
                end)
                table.insert(preWalkTracks, trackObj)
            end
        end

        hum.WalkSpeed = DEFAULT_WALKSPEED

        local startCF = CFrame.new(unpack(data[1].CF))
        hum:MoveTo(startCF.Position)

        local reached = false
        local conn
        conn = hum.MoveToFinished:Connect(function()
            reached = true
            if conn then conn:Disconnect() end
        end)
        local timeout = tick() + 5
        while not reached and tick() < timeout do task.wait(0.1) end
        if conn then conn:Disconnect() end

        stopPreWalkAnimations()
        restoreWalkSpeed()

        if animateWasDisabled and animateScript then
            pcall(function() animateScript.Disabled = false end)
        end

        hum.AutoRotate = false
        antigravidade = Instance.new("BodyForce", hrp)

        local totalMass = 0
        for _, parte in ipairs(char:GetChildren()) do
            if parte:IsA("BasePart") then
                originalCollides[parte] = parte.CanCollide
                parte.CanCollide = false
                totalMass = totalMass + parte:GetMass()
            end
        end
        antigravidade.Force = Vector3.new(0, totalMass * workspace.Gravity, 0)

        local pstartTime = os.clock()
        local totalPoints = #data
        local currentIndex = 1
        local lastState = nil
        activeTracks = {}

        setStatus("Reproduzindo...", "play")
        startTimer()

        playbackConnection = RunService.Heartbeat:Connect(function()
            local elapsedTime = os.clock() - pstartTime
            while currentIndex < totalPoints and elapsedTime >= data[currentIndex + 1].Time do
                currentIndex = currentIndex + 1
            end
            if currentIndex >= totalPoints then
                stopPlayback()
                stopTimer()
                setStatus(string.format("Concluído em %.2fs", timerFrozen), "ok")
                return
            end

            local p0 = data[currentIndex]
            local p1 = data[currentIndex + 1]
            local alpha = (p1.Time - p0.Time > 0)
                and math.clamp((elapsedTime - p0.Time) / (p1.Time - p0.Time), 0, 1) or 1

            local cf0 = CFrame.new(unpack(p0.CF))
            local cf1 = CFrame.new(unpack(p1.CF))
            hrp.CFrame = cf0:Lerp(cf1, alpha)

            if p1.Velocity then
                hrp.AssemblyLinearVelocity = Vector3.new(p1.Velocity[1], p1.Velocity[2], p1.Velocity[3])
            end

            if p0.State and p0.State ~= lastState then
                lastState = p0.State
                local st = toStateEnum(p0.State)
                if st then pcall(function() hum:ChangeState(st) end) end
            end

            if p1.Animations then
                local wanted = {}
                for _, animData in ipairs(p1.Animations) do
                    wanted[animData.Id] = animData
                    local trackObj = activeTracks[animData.Id]
                    if not trackObj then
                        trackObj = getOrLoadTrack(animator, animData.Id)
                        if trackObj then
                            pcall(function()
                                trackObj.Priority = Enum.AnimationPriority[animData.Priority] or Enum.AnimationPriority.Movement
                                trackObj.Looped = (animData.Looped ~= false)
                                trackObj:Play(0.05)
                            end)
                            activeTracks[animData.Id] = trackObj
                        end
                    end
                    local t = activeTracks[animData.Id]
                    if t then pcall(function() t:AdjustSpeed(animData.Speed) end) end
                end
                for id, trackObj in pairs(activeTracks) do
                    if not wanted[id] then
                        pcall(function() trackObj:Stop(0.1) end)
                        activeTracks[id] = nil
                    end
                end
            end
        end)
    end)
end

local function resetRecordButton()
