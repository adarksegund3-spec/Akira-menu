-- Atualização periódica do status ao vivo
function UI.startStatusLoop()
    task.spawn(function()
        while UI.gui and UI.gui.Parent and not UI.dead do
            if State.mode == "rec" then
                local ms = math.floor((os.clock() - Recorder.t0) * 1000)
                UI.statusLbl.Text = string.format("Gravando... %s | %d ações", fmtTime(ms), #Recorder.events)
                UI.statusLbl.TextColor3 = C.danger
            elseif State.mode == "replay" then
                local r = Replay.route
                UI.statusLbl.Text = "Reproduzindo: " .. (r and r.name or "")
                UI.statusLbl.TextColor3 = C.accent2
            else
                UI.statusLbl.Text = "Pronto"
                UI.statusLbl.TextColor3 = C.text
            end
            task.wait(0.2)
        end
    end)
end

--[[ === SEÇÃO 10: ATALHOS, RESPAWN E LIMPEZA === ]]
local function bindShortcuts()
    -- Ctrl+Shift+D: revela o botão de diagnóstico e executa a varredura silenciosa
    track(UIS.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Enum.KeyCode.D and UIS:IsKeyDown(Enum.KeyCode.LeftControl)
            and UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
            UI.revealDiag()
            Diag.run()
        end
    end))

    -- Respawn: reconecta os hooks do personagem durante a gravação
    track(LocalPlayer.CharacterAdded:Connect(function(char)
        if Recorder.active then
            task.spawn(Recorder.bindCharacter, char)
        end
        if Replay.running then
            local hum = char:WaitForChild("Humanoid", 5)
            if hum then RS.origWS = hum.WalkSpeed end
        end
    end))
end

Cleanup = function()
    UI.dead = true
    pcall(function() if Recorder.active then Recorder.stop() end end)
    pcall(function() Replay.cancel = true end)
    pcall(function() RunService:UnbindFromRenderStep("RouteHubReplay") end)
    for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
    Conns = {}
    pcall(function() genv.RouteHubRemoteLogger = nil end) -- o hook permanece inerte sem logger
    pcall(function()
        local b = Lighting:FindFirstChild("RouteHubBlur")
        if b then b:Destroy() end
    end)
    pcall(function() if UI.gui then UI.gui:Destroy() end end)
    genv.RouteHubCleanup = nil
end

