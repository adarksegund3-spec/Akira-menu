        local cr = Home:FindFirstChildOfClass("UICorner")
        if cr then put(cr, "CornerRadius", UDim.new(0, 14)) end

        Shine.Visible = true
    end

    local function applyOriginal()
        dark = false
        for i, t in pairs(Orig) do
            for k, v in pairs(t) do
                pcall(function() i[k] = v end)
            end
        end
        for i in pairs(Orig) do Orig[i] = nil end
        Shine.Visible = false

        -- reaplica o visual da aba selecionada
        local cur = currentTab
        currentTab = nil
        if cur then selectTab(cur) end
    end

    -- novos elementos (ex.: lista do catálogo) já nascem no tema ativo
    ScreenGui.DescendantAdded:Connect(function(i)
        if not dark then return end
        task.defer(function()
            if i.Parent then themeInst(i) end
