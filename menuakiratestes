local function defineFeature(name, startFn, stopFn)
	local f = {on = false, cons = {}, objs = {}, ks = {}}
	f.c = function(sig, fn) local c = sig:Connect(fn); table.insert(f.cons, c); return c end
	f.o = function(inst) table.insert(f.objs, inst); return inst end
	f.x = function(fn) table.insert(f.ks, fn) end
	f.start = function() startFn(f) end
	f.stop = function()
		for _, k in ipairs(f.ks) do pcall(k) end
		f.ks = {}
		for _, c in ipairs(f.cons) do pcall(function() c:Disconnect() end) end
		f.cons = {}
		for _, o in ipairs(f.objs) do pcall(function() o:Destroy() end) end
		f.objs = {}
		f.reapply = nil
		if stopFn then pcall(stopFn, f) end
	end
	Features[name] = f
	return f
end

local function setFeature(name, on)
	local f = Features[name]
	if not f or f.on == on then return end
	f.on = on
	if on then
		task.spawn(function()
			local ok = pcall(f.start)
			if not ok then
				f.stop(); f.on = false
				if f.setUI then f.setUI(false) end
				toast("Nao foi possivel ativar")
			end
		end)
	else
		f.stop()
	end
end

local function restartFeature(name)
	local f = Features[name]
	if not f or not f.on then return end
	f.stop()
	task.spawn(function() pcall(f.start) end)
end

local function defineTool(name, build)
	return defineFeature(name, function(f)
		local bp = LP:WaitForChild("Backpack", 8)
		if not bp then return end
		local tool = f.o(build(f))
		tool.Parent = bp
	end)
end

