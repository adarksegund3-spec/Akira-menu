if old then old:Destroy() end

--=====================================================================
-- CONFIG
--=====================================================================
local LOGO_ICON = "🔍"
local TOP_BAND = 0.25 -- "parte superior" = 25% de cima da tela
local KEYWORDS = { "prison", "prisao", "preso", "jail", "cell", "cela", "sentence", "detention", "cadeia", "arrest" }
local RULE_WORDS = { "minut", "minute", "segundo", "second", "remov", "reduz", "jj", "jack", "polichinelo", "tempo" }
local COLORS = {
	panel = Color3.fromRGB(24, 26, 33), panel2 = Color3.fromRGB(16, 17, 22),
	accent = Color3.fromRGB(88, 101, 242), btn = Color3.fromRGB(52, 56, 72),
