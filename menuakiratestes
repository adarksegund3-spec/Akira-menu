        local np = {}
        for k, v in pairs(p) do
            if COLOR_KEYS[k] and typeof(v) == "Color3" then
                local t = Orig[o]
                if not t then t = {}; Orig[o] = t end
                t[k] = v
                np[k] = mapColor(o, k, v)
            else
                np[k] = v
            end
        end
        return np
    end

    local function themeInst(i)
        if i:IsA("GuiObject") then
            recolor(i, "BackgroundColor3")
            if hasText(i) then recolor(i, "TextColor3") end
            if i:IsA("ScrollingFrame") then recolor(i, "ScrollBarImageColor3") end
        elseif i:IsA("UIStroke") then
            recolor(i, "Color")
        elseif i:IsA("UIGradient") and i.Name ~= "ShimmerGradient" then
