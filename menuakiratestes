                        if nx and ny and nz then f[#f+1]={p={nx,ny,nz},t=tonumber(t) or 0} end
                    end
                end
                if #f>=2 then out[#out+1]={nome=n,frames=prepararFrames(f)} end
            end
        end
        return out
    end

