------------------------------------------------------------------ sistema de Tools
local function findTool(id)
	for _, par in ipairs({lp:FindFirstChildOfClass("Backpack"), lp.Character}) do
		if par then for _, t in ipairs(par:GetChildren()) do if t:IsA("Tool") and t:GetAttribute("AngelItem") == id then return t end end end
	end
end
local function mkTool(def)
	local tool = Instance.new("Tool")
	tool.Name, tool.RequiresHandle, tool.CanBeDropped, tool.ToolTip = def.name, false, false, def.desc
	tool:SetAttribute("AngelItem", def.id)
	local K
	tool.Equipped:Connect(function()
		local c = lp.Character; if not c then return end
		if K then K.clean() end
		K = ctx(c)
		local ok, e = pcall(def.build, K)
		if not ok then warn("[AngelHub] " .. def.name .. ": " .. tostring(e)); K.clean(); K = nil end
	end)
	tool.Unequipped:Connect(function() if K then K.clean(); K = nil end end)
	tool.Destroying:Connect(function() if K then K.clean(); K = nil end end)
	tool.Activated:Connect(function()
		if K and def.act then local ok, e = pcall(def.act, K); if not ok then warn("[AngelHub] " .. tostring(e)) end end
	end)
	return tool
end
onKill(function()
	for _, d in ipairs(D) do local t = findTool(d.id); if t then t:Destroy() end end
end)

