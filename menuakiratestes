local toastToken = 0
local function showToast(text, color)
	toastToken += 1
	local my = toastToken
	toast.Text = text
	toast.BackgroundColor3 = color
	toast.BackgroundTransparency = 0.05
	toast.TextTransparency = 0
	task.delay(2.4, function()
		if my ~= toastToken then return end
		local info = TweenInfo.new(0.3)
		TweenService:Create(toast, info, { BackgroundTransparency = 1, TextTransparency = 1 }):Play()
	end)
end

-- Abrir / fechar com animação suave
local menuOpen = false
local TWEEN_FADE_IN = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TWEEN_SCALE_IN = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TWEEN_OUT = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

local function setMenu(open)
	if open == menuOpen then return end
	menuOpen = open
	if open then
		menu.Visible = true
		TweenService:Create(menu, TWEEN_FADE_IN, { GroupTransparency = 0 }):Play()
		TweenService:Create(menuScale, TWEEN_SCALE_IN, { Scale = 1 }):Play()
	else
		local t = TweenService:Create(menu, TWEEN_OUT, { GroupTransparency = 1 })
		TweenService:Create(menuScale, TWEEN_OUT, { Scale = 0.9 }):Play()
		t:Play()
		t.Completed:Once(function()
			if not menuOpen then menu.Visible = false end
		end)
	end
end

