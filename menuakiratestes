defineTool("hook", function(f)
	local tool = new("Tool", {Name = "Gancho Teia", ToolTip = "Toque em uma superficie para ser puxado", RequiresHandle = false, CanBeDropped = false})
	local hooking, target, t0 = false, nil, 0
	local rope, anchor, a0
	local function release()
		hooking = false
		if rope then rope:Destroy(); rope = nil end
		if a0 then a0:Destroy(); a0 = nil end
		if anchor then anchor:Destroy(); anchor = nil end
	end
	tool.Activated:Connect(function()
		local hrp, hum = getHRP(), getHum()
		if not hrp or not hum then return end
		local o, d = aimRay()
		local res = cast(o, d * 260)
		if not res then toast("Mire em uma superficie"); return end
		release()
		target = res.Position; t0 = os.clock(); hooking = true
		anchor = part({Anchored = true, Transparency = 1, Size = Vector3.new(0.4, 0.4, 0.4), Position = target, Parent = FX})
		local a1 = new("Attachment", {}, anchor)
		a0 = new("Attachment", {Position = Vector3.new(0.7, 0.5, 0)}, hrp)
		rope = new("Beam", {
			Attachment0 = a0, Attachment1 = a1, Width0 = 0.14, Width1 = 0.14, LightEmission = 1, FaceCamera = true,
			Segments = 14, Color = ColorSequence.new(T.acc2, T.acc1),
		}, anchor)
		local em = new("ParticleEmitter", {
			Texture = SPARK, Rate = 0, Lifetime = NumberRange.new(0.3, 0.6), Speed = NumberRange.new(8, 16),
			SpreadAngle = Vector2.new(180, 180), Size = NS(NSK(0, 0.7), NSK(1, 0)), LightEmission = 1,
			Color = ColorSequence.new(T.acc2),
		}, anchor)
		em:Emit(26)
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
	end)
	f.c(RS.Heartbeat, function(dt)
		if not hooking then return end
		local hrp = getHRP()
		if not hrp then release(); return end
		local to = target - hrp.Position
		local dist = to.Magnitude
		if dist < 7 or os.clock() - t0 > 3 then
			release()
			hrp.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity + Vector3.new(0, 18, 0)
			return
		end
		local want = to.Unit * math.clamp(40 + dist * 1.2, 50, 120)
		hrp.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity:Lerp(want, math.clamp(dt * 5, 0, 1))
		if rope then
			rope.CurveSize0 = math.sin(os.clock() * 18) * math.max(0, 1 - (os.clock() - t0) * 3) * 2
		end
	end)
	tool.Unequipped:Connect(release)
	f.x(release)
	return tool
end)

