-- 6. RELATÓRIO
--=====================================================================
local function fmtEntry(e, idx, funcNote)
	local pos = e.ratio and string.format("%s (%.0f%% da altura)", e.region, e.ratio * 100) or e.region
	local lines = {
		string.format("[%d] %s", idx, e.path),
		string.format("    Classe: %s | Visível agora: %s | Região: %s", e.class, e.visible and "sim" or "não", pos),
	}
	if e.source then table.insert(lines, "    Origem: " .. e.source) end
	table.insert(lines, '    Texto: "' .. clip(e.text, CONFIG.MAX_TEXT_LEN) .. '"')
	if e.hits and #e.hits > 0 then table.insert(lines, "    Termos encontrados: " .. table.concat(e.hits, ", ")) end
	if e.history and #e.history > 0 then
		local h = {}
		for _, t in ipairs(e.history) do table.insert(h, '"' .. clip(t, 120) .. '"') end
		table.insert(lines, "    Variações anteriores observadas: " .. table.concat(h, " | "))
	end
	if funcNote then table.insert(lines, "    ↳ Função: " .. funcNote) end
	return table.concat(lines, "\n")
end

local function scoreEntry(e)
	local s = #e.hits * 3
	if e.visible then s += 4 end
	if e.ratio and e.ratio < CONFIG.TOP_BAND_RATIO then s += 4 end
	if string.find(e.text, "%d") then s += 2 end
	if #e.ruleHits > 0 then s += 3 end
	if #e.text > 20 then s += 1 end
	return s
end

local function buildReport(gui, world, pdata, startedAt, elapsed)
	local R = {}
	local function add(s) table.insert(R, s) end
	local function section(title)
		add("")
		add(string.rep("=", 60))
		add(title)
		add(string.rep("=", 60))
	end

	add("RELATÓRIO DE DIAGNÓSTICO — MECÂNICA DE PRISÃO")
	add("Gerado em: " .. startedAt .. " | Duração: " .. string.format("%.1fs", elapsed))
	add("PlaceId: " .. tostring(game.PlaceId) .. " | Jogador: " .. player.Name)

	-- Mescla textos atuais com os capturados em tempo real
	local all = {}
	for _, e in ipairs(gui.hits) do
		e.source = "encontrado na varredura atual"
		if captured[e.path] then e.history = captured[e.path].history end
		all[e.path] = e
	end
	for path, e in pairs(captured) do
		if not all[path] then
			e.source = "capturado em tempo real (pode não estar mais na tela)"
			all[path] = e
		end
	end
	local candidates = {}
	for _, e in pairs(all) do table.insert(candidates, e) end
	table.sort(candidates, function(a, b) return scoreEntry(a) > scoreEntry(b) end)

	-- 1. STATUS
	section("1. STATUS DA ANÁLISE")
	add("Concluída. Textos analisados no PlayerGui: " .. gui.total)
	add("Instâncias analisadas fora do PlayerGui: " .. world.scanned)
	add("Textos com termo de prisão: " .. #candidates)
	add("Obs.: este relatório só descreve o que o CLIENTE consegue ver. Não é possível")
	add("afirmar se o jogador está preso neste momento.")
	add("Termos buscados: " .. table.concat(KEYWORDS_REQUESTED, ", ")
		.. " (extras: " .. table.concat(KEYWORDS_EXTRA, ", ") .. ")")

	-- 2. MENSAGEM
	section("2. MENSAGEM DE PRISÃO IDENTIFICADA")
	local best = candidates[1]
	if best then
		local inTop = best.ratio and best.ratio < CONFIG.TOP_BAND_RATIO
		local conf
		if best.visible and inTop then
			conf = "ALTA — visível agora na faixa superior e contém termo de prisão."
		elseif best.visible then
			conf = "MÉDIA — visível agora, porém fora da faixa superior."
		elseif inTop then
			conf = "MÉDIA — vista na faixa superior durante a sessão, mas não visível agora."
		else
			conf = "BAIXA — o texto existe, mas não está visível nem no topo (pode ser modelo oculto até a prisão)."
		end
		add("Melhor candidato (texto literal, sem alterações):")
		add('"' .. clip(best.text, CONFIG.MAX_TEXT_LEN) .. '"')
		add("Confiança: " .. conf)
		add("↳ Função: texto da interface com termo de prisão; provável mensagem ao jogador.")
		add("   Confirme lendo o texto acima: nada foi presumido.")
		if #candidates > 1 then
			add("")
			add("Outros candidatos:")
			for i = 2, math.min(#candidates, 4) do
				add(string.format('  - "%s"  (%s)', clip(candidates[i].text, 200), candidates[i].path))
			end
		end
	else
		add("NÃO ENCONTRADA. Nenhum texto com os termos buscados foi visto na interface.")
		add("Possíveis motivos: o jogador não está preso agora; a mensagem usa outras palavras;")
		add("o texto é uma imagem; ou é montado fora do alcance do cliente.")
		add("Sugestão: deixe o script ativo, seja preso e rode o Diagnóstico de novo.")
	end

	-- 3. LOCALIZAÇÃO
	section("3. LOCALIZAÇÃO DO TEXTO NA INTERFACE")
	if best then
		add(fmtEntry(best, 1, "indica onde o texto está na hierarquia de GUI e em que parte da tela aparece."))
		add("    ScreenGui pai: " .. best.gui)
	else
		add("Sem texto de prisão para localizar.")
	end
	add("")
	add("Textos visíveis na faixa superior da tela (podem ou não ser da prisão):")
	local topAll, seenTop = {}, {}
	for _, e in ipairs(gui.top) do seenTop[e.path] = true; e.source = "visível agora"; table.insert(topAll, e) end
	for path, e in pairs(capturedTop) do
		if not seenTop[path] then e.source = "visto durante a sessão"; table.insert(topAll, e) end
	end
	if #topAll == 0 then
		add("  (nenhum encontrado)")
	else
		for i, e in ipairs(topAll) do
			if i > 15 then add("  ... (+" .. (#topAll - 15) .. " omitidos)"); break end
			add(string.format('  [%d] "%s"  (%s)', i, clip(e.text, 160), e.path))
		end
		add("↳ Função: mensagens fixas no topo costumam ser avisos/status; confira se alguma é a de prisão.")
	end

	-- 4. REFERÊNCIAS
	section("4. REFERÊNCIAS A PRISÃO ENCONTRADAS")
	add("-- 4.1 Textos de interface (PlayerGui) --")
	if #candidates == 0 then add("  (nenhum)") end
	for i, e in ipairs(candidates) do
		if i > CONFIG.MAX_ENTRIES then break end
		add(fmtEntry(e, i, "texto de interface que cita prisão (mensagem, título ou rótulo)."))
	end

	add("")
	add("-- 4.2 Objetos com nome relacionado --")
	local remotes, others = {}, {}
	for _, n in ipairs(world.names) do
		table.insert(REMOTE_CLASSES[n.class] and remotes or others, n)
	end
	add("Remotes/Bindables:")
	if #remotes == 0 then add("  (nenhum)") end
	for i, n in ipairs(remotes) do
		add(string.format("  [%d] %s (%s) termos: %s", i, n.path, n.class, table.concat(n.hits, ", ")))
	end
	if #remotes > 0 then
		add("  ↳ Função: canal cliente↔servidor. Só o NOME é visível; dados e lógica ficam no servidor (não acessados).")
	end
	add("Outros objetos:")
	if #others == 0 then add("  (nenhum)") end
	for i, n in ipairs(others) do
		add(string.format("  [%d] %s (%s) termos: %s", i, n.path, n.class, table.concat(n.hits, ", ")))
	end
	if #others > 0 then
		add("  ↳ Função: objeto cujo nome cita prisão (pasta, cela, área, script...). Papel exato não confirmado.")
	end

	add("")
	add("-- 4.3 Valores e atributos replicados ao cliente --")
	if #pdata == 0 then add("  (nenhum)") end
	for i, v in ipairs(pdata) do
		add(string.format("  [%d] %s em %s: %s = %s", i, v.kind, v.where, v.name, v.value))
	end
	if #pdata > 0 then
		add("  ↳ Função: dado replicado com nome/valor relacionado; pode refletir estado ou tempo de pena (não confirmado).")
	end

	add("")
	add("-- 4.4 Textos fora do PlayerGui (modelos/3D) e ProximityPrompts --")
	if #world.otherText == 0 and #world.prompts == 0 then add("  (nenhum)") end
	for i, t in ipairs(world.otherText) do
		add(string.format('  [T%d] %s (%s): "%s"', i, t.path, t.class, clip(t.text, 200)))
	end
	for i, p in ipairs(world.prompts) do
		add(string.format('  [P%d] %s — Ação: "%s" | Objeto: "%s"', i, p.path, p.action, p.object))
	end
	if #world.otherText + #world.prompts > 0 then
		add("  ↳ Função: textos de modelos ainda não exibidos, placas 3D ou interações relacionadas à prisão.")
	end

	-- 5. REGRAS
	section("5. REGRAS E REQUISITOS PARA REDUZIR A SENTENÇA")
	local guisWithHits = {}
	for _, e in ipairs(candidates) do guisWithHits[e.gui] = true end
	local ruleList, seenRule = {}, {}
	local function consider(e)
		if #e.ruleHits > 0 and not seenRule[e.path] then
			if #e.hits > 0 or guisWithHits[e.gui] or (e.visible and e.ratio and e.ratio < CONFIG.TOP_BAND_RATIO) then
				seenRule[e.path] = true
				table.insert(ruleList, e)
			end
		end
	end
	for _, e in ipairs(candidates) do consider(e) end
	for _, e in ipairs(gui.ruleTexts) do consider(e) end
	if #ruleList == 0 then
		add("NÃO ENCONTRADO. Nenhum texto com termos de tempo/ação (minutos, remover, reduzir, JJ...)")
		add("foi visto junto da interface de prisão. A regra pode estar no servidor ou só aparecer")
		add("durante a prisão.")
	else
		for i, e in ipairs(ruleList) do
			if i > 25 then break end
			add(string.format('[%d] "%s"', i, clip(e.text, CONFIG.MAX_TEXT_LEN)))
			add("    Local: " .. e.path)
			add("    Termos de regra: " .. table.concat(e.ruleHits, ", "))
			local nums = numbersIn(e.text)
			if #nums > 0 then add("    Números no texto: " .. table.concat(nums, ", ")) end
			add("    ↳ Função: texto com termos de tempo/ação; o significado exato é o do texto literal (nada inferido).")
		end
	end

	-- 6. LIMITAÇÕES
	section("6. LIMITAÇÕES DA ANÁLISE")
	add("• Scripts de servidor e ServerStorage/ServerScriptService não são acessíveis ao cliente.")
	add("• CoreGui (interface do próprio Roblox) não é acessível a LocalScripts normais.")
	if world.sourceBlocked or world.scriptsReadable == 0 then
		add(string.format("• Código-fonte ILEGÍVEL: %d scripts vistos, 0 legíveis (esperado em jogos normais).", world.scriptsSeen))
	else
		add(string.format("• Código-fonte legível em %d de %d scripts vistos.", world.scriptsReadable, world.scriptsSeen))
	end
	add("• Mensagens montadas no servidor só aparecem enquanto exibidas; o vigia só registra o que ocorreu")
	add("  desde que este script iniciou. Se um painel apenas ficou visível (sem mudar o texto), rode o")
	add("  Diagnóstico enquanto a mensagem estiver na tela.")
	add("• Busca por substring: pode haver falsos positivos (ex.: 'cell' em 'cellphone').")
	add("• Mensagens em imagem, com outro idioma ou outras palavras não são detectadas.")
	add("• Para concluir: rodar com o jogador preso, ou ter acesso (como desenvolvedor) ao código da")
	add("  interface de prisão e aos Remotes/ModuleScripts relacionados.")

	-- 7. CÓDIGO
	section("7. TRECHOS RELEVANTES DE CÓDIGO ACESSÍVEL")
	if #world.snippets == 0 then
		add("Nenhum trecho acessível (Source não está disponível ao cliente neste jogo).")
	else
		for i, s in ipairs(world.snippets) do
			add(string.format("[%d] %s", i, s.path))
			add("    " .. s.line)
			add("    -- ↳ Função: linha que cita " .. table.concat(s.hits, ", ") .. "; a lógica completa exige ler o script inteiro.")
		end
	end

	return table.concat(R, "\n")
end

local function runDiagnostic()
	local t0 = os.clock()
	local startedAt = os.date("%Y-%m-%d %H:%M:%S")
	local gui = scanPlayerGui()
	local world = scanWorld()
	local pdata = scanPlayerData()
	return buildReport(gui, world, pdata, startedAt, os.clock() - t0)
end

