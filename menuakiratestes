local function stopRecording(silent)
    if recConn then recConn:Disconnect() recConn = nil end
    local r = rec
    rec = nil
    RecordBtn.Text = "🔴 Gravar"
    RecordBtn.BackgroundColor3 = C.TurqDark
    RecordBtn.TextColor3 = C.TurqBright
    TimerStroke.Color = C.Amber
    if not r then return end
    r.duration = os.clock() - r.t0
    if silent and r.frames < 5 then return end
    local info = TABS[r.tabIndex]
    results[info.key] = buildResult(info, r)
    if r.tabIndex == currentTab then
        PreviewText.Text = results[info.key].preview
        Preview.CanvasPosition = Vector2.new(0, 0)
    end
    setStatus(string.format("Gravado: %d animacao(oes)", (function()
        local n = 0
        for _ in pairs(r.stats) do n = n + 1 end
        return n
    end)()), "ok")
end

local function startRecording()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local animator = hum and getAnimator(hum)
    if not hum or not hrp or not animator then
        setStatus("Personagem sem Animator", "warn")
        return
    end

    local jumpName, jumpValue = "JumpPower", hum.JumpPower
    if hum.UseJumpPower == false then jumpName, jumpValue = "JumpHeight", hum.JumpHeight end

    rec = {
        tabIndex = currentTab, char = char, rig = hum.RigType.Name,
        t0 = os.clock(), frames = 0, stats = {}, states = {},
        speedSum = 0, speedMax = 0, walkStart = hum.WalkSpeed, walkMax = hum.WalkSpeed,
        jumpName = jumpName, jumpValue = jumpValue, lastUI = 0, duration = 0,
    }

    RecordBtn.Text = "🛑 Parar"
    RecordBtn.BackgroundColor3 = C.Red
    RecordBtn.TextColor3 = Color3.fromRGB(255, 225, 230)
    TimerStroke.Color = C.Turq
    setStatus("Gravando...", "rec")

    recConn = RunService.Heartbeat:Connect(function()
        local r = rec
        if not r then return end
        r.frames = r.frames + 1
        local now = os.clock() - r.t0
        TimerLabel.Text = formatTime(now)

        local v = hrp.AssemblyLinearVelocity
        local sp = Vector3.new(v.X, 0, v.Z).Magnitude
        r.speedSum = r.speedSum + sp
        if sp > r.speedMax then r.speedMax = sp end
        if hum.WalkSpeed > r.walkMax then r.walkMax = hum.WalkSpeed end

        local st = hum:GetState().Name
        r.states[st] = (r.states[st] or 0) + 1

        for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
            local a = tr.Animation
            if a and a.AnimationId ~= "" and tr.WeightCurrent > 0.01 then
                local id = a.AnimationId
                local s = r.stats[id]
                if not s then
                    s = {
                        Id = id, Nome = a.Name, TrackName = tr.Name, Priority = tr.Priority.Name,
                        Looped = tr.Looped, Length = tr.Length, count = 0,
                        minSpeed = math.huge, maxSpeed = -math.huge, maxWeight = 0,
                    }
                    r.stats[id] = s
                end
                s.count = s.count + 1
                if tr.Length > s.Length then s.Length = tr.Length end
                if tr.Speed < s.minSpeed then s.minSpeed = tr.Speed end
                if tr.Speed > s.maxSpeed then s.maxSpeed = tr.Speed end
                if tr.WeightCurrent > s.maxWeight then s.maxWeight = tr.WeightCurrent end
            end
        end

        if now - r.lastUI > 0.3 then
            r.lastUI = now
            local n = 0
            for _ in pairs(r.stats) do n = n + 1 end
            StatusLabel.Text = string.format("Gravando... %d animacao(oes)", n)
        end
    end)
end

