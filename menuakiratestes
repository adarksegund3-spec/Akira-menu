local pickPlaylist -- definida adiante

local function trackRow(parent, track, ctx)
	local isCur = ctx.highlight
	local row = new("Frame", { Size = UDim2.new(1, -4, 0, 52), BackgroundColor3 = isCur and C.dgreen or C.black2,
		BackgroundTransparency = isCur and 0.1 or 0.35, BorderSizePixel = 0, LayoutOrder = ctx.order or 0, Parent = parent },
		{ corner(10) })
	local cover = new("ImageLabel", { Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(6, 6), BackgroundColor3 = C.black,
		Image = CFG.LOGO, ScaleType = Enum.ScaleType.Crop, Parent = row }, { corner(6) })
	Img.apply(cover, track)
	local nb = ctx.onRemove and 5 or 4
	local bw = nb * 27
	label({ Text = track.title, Font = Enum.Font.GothamBold, TextSize = 12, Size = UDim2.new(1, -(56 + bw), 0, 18),
		Position = UDim2.fromOffset(52, 8), TextTransparency = track.streamable and 0 or 0.5, Parent = row })
	label({ Text = track.artist .. "  ·  " .. fmt(track.duration) .. (track.streamable and "" or "  ·  indisponível"), TextSize = 10,
		TextColor3 = C.gray, Size = UDim2.new(1, -(56 + bw), 0, 14), Position = UDim2.fromOffset(52, 27), Parent = row })
	local btns = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(bw, 40), AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -4, 0.5, 0), Parent = row },
		{ new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 2) }) })
	local function mini(text, cb, col)
		return button({ Text = text, Size = UDim2.fromOffset(25, 30), TextSize = 14, TextColor3 = col or C.white, Parent = btns }, cb)
	end
	mini("▶", function() ctx.play() end, C.green)
	local fav = mini(Store.isFav(track.id) and "♥" or "♡", nil, C.aqua)
	Maid.add(fav.Activated:Connect(function()
		local on = Store.toggleFav(track)
		fav.Text = on and "♥" or "♡"
		Toast(on and "Adicionado aos favoritos" or "Removido dos favoritos")
	end))
	mini("+", function() Player.enqueue(track); Toast("Adicionado à fila") end)
	mini("≡", function() pickPlaylist(track) end)
	if ctx.onRemove then mini("✕", ctx.onRemove, C.red) end
	return row
end

local function renderTracks(scroll, tracks, opts)
	opts = opts or {}
	for i, t in ipairs(tracks) do
		trackRow(scroll, t, {
			order = (opts.baseOrder or 0) + i, highlight = opts.highlight and opts.highlight(i, t),
			play = function() if opts.onPlay then opts.onPlay(i) else Player.playQueue(tracks, i) end end,
			onRemove = opts.onRemove and function() opts.onRemove(i, t) end or nil,
		})
	end
end

local function newScroll(parent, pos, size)
	return new("ScrollingFrame", { Position = pos, Size = size, BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 3, ScrollBarImageColor3 = C.aqua, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y, Parent = parent },
		{ new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) })
end
local function infoLabel(parent, text, col)
	return label({ Text = text, TextColor3 = col or C.gray, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -4, 0, 40), TextSize = 12, LayoutOrder = -1, Parent = parent })
end

