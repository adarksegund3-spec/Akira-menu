---------------------------------------------------------------- Abrir / fechar com animação
local animating = false
local function bubbleCenter() return bubble.AbsolutePosition + bubble.AbsoluteSize / 2 end

local function openWindow()
	if animating or windowOpen then return end
	animating = true
	applyWin()
	local bc = bubbleCenter()
	window.Position = UDim2.fromOffset(bc.X, bc.Y)
	window.Size = UDim2.fromOffset(winW * 0.35, winH * 0.35)
	body.GroupTransparency = 1; glow.BackgroundTransparency = 1; border2.Visible = true
	shimmerStroke.Transparency = 1; borderBase.Transparency = 1
	window.Visible = true; windowOpen = true
	winShimmerTween:Play()
	tween(glow, 0.9, { BackgroundTransparency = 0 })                       -- degradê surge progressivamente
	tween(body, 0.35, { GroupTransparency = 0 })
	tween(shimmerStroke, 0.5, { Transparency = 0 }); tween(borderBase, 0.5, { Transparency = 0.75 })
	tween(window, 0.4, { Position = UDim2.fromOffset(winCenter.X, winCenter.Y), Size = UDim2.fromOffset(winW, winH) }, Enum.EasingStyle.Quint)
	tween(bubble, 0.25, { BackgroundTransparency = 1 })
	bubble.Visible = false
	task.delay(0.45, function() animating = false; if windowOpen then applyWin() end end)
	if not currentTab then selectTab("Início") end
end
local function closeWindow()
	if animating or not windowOpen then return end
	animating = true
	local bc = bubbleCenter()
	bubble.Visible = true; bubble.BackgroundTransparency = 0
	volPop.Visible = false
	tween(body, 0.3, { GroupTransparency = 1 })
	tween(shimmerStroke, 0.25, { Transparency = 1 }); tween(borderBase, 0.25, { Transparency = 1 })
	tween(window, 0.3, { Position = UDim2.fromOffset(bc.X, bc.Y), Size = UDim2.fromOffset(winW * 0.2, winH * 0.2) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.32, function()
		window.Visible = false; windowOpen = false; animating = false
		winShimmerTween:Pause()  -- sem animação de borda enquanto minimizado
	end)
end
