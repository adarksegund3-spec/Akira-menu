    label(c, table.concat(l2, " • "), 9, COL_DIM, Enum.Font.Gotham, UDim2.new(0, 8, 0, 22), UDim2.new(1, -16, 0, 12))

    -- Badges: só o que a API confirma (nada é marcado manualmente).
    local b = {}
    if hasMobileTag(s) then b[#b + 1] = "📱 Mobile" end
    if s.key == false then b[#b + 1] = "🔑 No Key" elseif s.key == true then b[#b + 1] = "🔑 Key" end
    if s.scriptType == "free" then b[#b + 1] = "🆓 Free" elseif s.scriptType == "paid" then b[#b + 1] = "💰 Paid" end
    if s.verified == true then b[#b + 1] = "✓ Verificado" end
    if s.patched == true then b[#b + 1] = "⚠ Patched" end
    local otherGame = type(s.game) == "table" and tonumber(s.game.placeId) ~= nil
        and tonumber(s.game.placeId) ~= game.PlaceId
    if otherGame then b[#b + 1] = "↪ Outro jogo" end
    label(c, table.concat(b, " • "), 9, Color3.fromRGB(215,175,175), Enum.Font.Gotham,
        UDim2.new(0, 8, 0, 35), UDim2.new(1, -16, 0, 12))

    local sp = {}
    local lk, vw, dt = fmtNum(s.likeCount), fmtNum(s.views), fmtDate(s.updatedAt)
    if lk then sp[#sp + 1] = "👍 " .. lk end
    if vw then sp[#sp + 1] = "👁 " .. vw end
    if dt then sp[#sp + 1] = "🕒 " .. dt end
    label(c, table.concat(sp, "  "), 8, Color3.fromRGB(140,140,140), Enum.Font.Gotham,
        UDim2.new(0, 8, 0, 48), UDim2.new(1, -16, 0, 12))

    local dsc = label(c, tostring(s.description or ""), 8, Color3.fromRGB(150,150,150), Enum.Font.Gotham,
        UDim2.new(0, 8, 0, 61), UDim2.new(1, -16, 0, 22))
    dsc.TextWrapped = true; dsc.TextYAlignment = Enum.TextYAlignment.Top

    local paid = s.scriptType == "paid"
    local eb = mk("TextButton", {
        Text = paid and "🛒 PAGO" or "▶ EXECUTAR", Font = Enum.Font.GothamBold, TextSize = 11,
        TextColor3 = Color3.fromRGB(255,255,255), BackgroundColor3 = COL_RED, BorderSizePixel = 0,
        AutoButtonColor = false, Position = UDim2.new(0, 8, 1, -30), Size = UDim2.new(1, -16, 0, 24),
    }, c)
    corner(eb, 5)
    eb.MouseEnter:Connect(function() tween(eb, 0.12, {BackgroundColor3 = COL_REDH}) end)
    eb.MouseLeave:Connect(function() tween(eb, 0.12, {BackgroundColor3 = COL_RED}) end)

    local function setStatus(txt, col) status.Text = txt; status.TextColor3 = col end
    local running, confirmTok = false, 0
    local label0 = eb.Text

    eb.MouseButton1Click:Connect(function()
        if running then showToast("⏳ Já está carregando...", "warning"); return end

        if paid then -- scripts pagos não são executados; copia o link de compra, se existir
            local url = s.marketplaceUrl
            if type(url) == "string" and url ~= "" and setclipboard then
                pcall(setclipboard, url); showToast("🛒 Link de compra copiado", "success")
            else
                showToast("🛒 Script pago — sem execução pelo catálogo", "warning")
            end
            return
        end

        -- Confirmação em 2 toques SÓ para script marcado como patched (não verificado executa direto).
        local risky = CatalogConfig.ConfirmPatched and not bi and s.patched == true
        if risky and confirmTok == 0 then
            confirmTok = os.clock()
            local my = confirmTok
            eb.Text = "⚠ CONFIRMAR"
            setStatus("⚠ PATCHED?", COL_WARN)
            showToast("Marcado como patched. Toque de novo para executar.", "warning")
            task.delay(3, function()
                if confirmTok == my and not running then
                    confirmTok = 0; eb.Text = label0; setStatus("● DISPONÍVEL", COL_OK)
                end
            end)
            return
        end
        confirmTok = 0

        running = true
        eb.Text = "⏳"; setStatus("⏳ CARREGANDO...", COL_WARN)
        task.spawn(function()
            local ok, why = Catalog.execute(s)
            if ok then
                setStatus("✓ EXECUTADO", COL_OK)
                showToast("▶ " .. title .. " executado", "success")
            else
                setStatus("⚠ ERRO", COL_ERR)
                showToast("⚠ " .. tostring(why or "falha") .. (otherGame and " • feito p/ outro jogo" or ""), "error")
            end
            task.wait(0.8)
            eb.Text = label0; running = false
        end)
    end)
end

local function renderResults(list)
    clearResults()
    local st = Catalog.state
    local shown = 0
    for _, s in ipairs(list) do
        -- Guarda extra: só mostra o que é compatível com os filtros ativos.
        local skip = (st.noKey and s.key == true)
            or (st.free and s.scriptType == "paid")
            or (st.hidePatched and s.patched == true)
            or (st.mobile and not s._builtin and not hasMobileTag(s))
        if not skip then
            shown = shown + 1
            createCard(s, shown)
        end
    end
    if shown == 0 then showEmpty() end
    return shown
end

-- ── Modo "Integrados" (lista original do hub, agora paginada) ──
local function renderBuiltin(page)
    local st = Catalog.state
    local q = st.query:lower():gsub("^%s+", ""):gsub("%s+$", "")
    local all = {}
    for _, g in ipairs(GameModule.games) do
        if q == "" or g.name:lower():find(q, 1, true) or (g.desc or ""):lower():find(q, 1, true) then
            all[#all + 1] = {
                title = g.name, description = g.desc, key = false, scriptType = "free",
                game = {name = g.name}, _builtin = g,
            }
        end
    end
    local rpp = CatalogConfig.ResultsPerPage
    local tp = math.max(1, math.ceil(#all / rpp))
    page = math.clamp(page, 1, tp)
    local slice = {}
    for i = (page - 1) * rpp + 1, math.min(#all, page * rpp) do slice[#slice + 1] = all[i] end
    st.page, st.totalPages, st.total, st.hasNext, st.busy = page, tp, #all, page < tp, false
    infoLbl.Text = #slice .. " SCRIPTS INTEGRADOS • PÁGINA " .. page .. "/" .. tp
    -- Integrados ignoram filtros da API (são curados pelo hub): renderiza direto.
    clearResults()
    if #slice == 0 then showEmpty() else for i, s in ipairs(slice) do createCard(s, i) end end
    setPager()
end

local function applyResult(res, page)
    local st = Catalog.state
    st.busy = false
    st.page, st.totalPages, st.total, st.hasNext = res.page, res.totalPages, res.total, res.hasNext
    local n = renderResults(res.scripts)
    infoLbl.Text = n .. " SCRIPTS • PÁGINA " .. st.page .. "/" .. st.totalPages .. " • " .. st.total .. " NO TOTAL"
    setPager()
end

loadPage = function(page)
    local st = Catalog.state
    if st.builtin then renderBuiltin(page); return end
    Catalog.reqId = Catalog.reqId + 1
    local my = Catalog.reqId
    local url, sig = Catalog.buildRequest(st, page)
    local key = sig .. "|" .. page

    local cached = cacheGet(key)
    if cached then applyResult(cached, page); return end

    if os.clock() < Catalog.blockedUntil then
        showError(errMsg(429, Catalog.blockedUntil - os.clock()))
        return
    end

    st.busy = true
    showLoading()
    task.spawn(function()
        local data, err = Catalog.apiGet(url)
        if my ~= Catalog.reqId then return end -- resposta antiga: descartada
        if not data then
            if err.code == 404 and url:find("/games/", 1, true) then
                data = {result = {scripts = {}, total = 0, totalPages = 1}}
            else
                showError(errMsg(err.code, err.retry)); return
            end
        end
        local res = normalize(data, page)
        cacheSet(key, res)
        applyResult(res, page)
    end)
end

-- ── Debounce, paginação, limpar, atualizar ─────────────────
schedule = function(delay)
    Catalog.dbToken = Catalog.dbToken + 1
    local tok = Catalog.dbToken
    task.delay(delay, function()
        if tok ~= Catalog.dbToken then return end
        Catalog.state.page = 1
        loadPage(1)
    end)
end

searchInput:GetPropertyChangedSignal("Text"):Connect(function()
    local t = (searchInput.Text:gsub("^%s+", ""):gsub("%s+$", ""))
    if t == Catalog.state.query then return end
    Catalog.state.query = t
    Catalog.state.page = 1
    schedule(CatalogConfig.SearchDebounce)
end)
searchInput.FocusLost:Connect(function(enter)
    if enter then
        Catalog.dbToken = Catalog.dbToken + 1 -- cancela o debounce pendente
        Catalog.state.page = 1
        loadPage(1)
    end
end)

local function goPage(delta)
    local st = Catalog.state
    if st.busy or (os.clock() - Catalog.lastClick) < 0.25 then return end
    local np = st.page + delta
    if np < 1 or (delta > 0 and not st.hasNext) then return end
    Catalog.lastClick = os.clock()
    st.page = np
    loadPage(np)
end
