-- ── Gravador de itens: alimenta as UIs alternativas com o menu completo ──
do
    State.spec = {}
    local function tabOf(p)
        while p do
            local n = State.tabFrames and State.tabFrames[p]
            if n then return n end
            p = p.Parent
        end
    end
    local function rec(parent, it)
        if State.specFrozen then return end
        local n = tabOf(parent)
        if not n then return end
        local l = State.spec[n]
        if not l then l = {}; State.spec[n] = l end
        l[#l + 1] = it
    end
    local oSec, oTog, oBtn, oSli, oInp = C.section, C.toggle, C.button, C.slider, C.input

    C.section = function(parent, title, y)
        rec(parent, {k = "section", title = title})
        return oSec(parent, title, y)
    end
    C.button = function(parent, text, y, cb, opt)
        rec(parent, {k = "button", text = text, cb = function()
            if not cb then return end
            showToast("▶ " .. text, "info")
            local ok, err = pcall(cb)
            if not ok then
                warn("[AKZ] Erro em '" .. text .. "': " .. tostring(err))
                showToast("⚠ Falha em " .. text, "error")
            end
        end})
        return oBtn(parent, text, y, cb, opt)
    end
    C.toggle = function(parent, text, y, default, cb)
        local it = {k = "toggle", text = text, state = default or false}
        it.cb = function(v)
            it.state = v
            if cb then pcall(cb, v) end
        end
        it.btn = oTog(parent, text, y, default, it.cb)
        rec(parent, it)
        return it.btn
    end
    C.slider = function(parent, label, min, max, default, y, cb)
        local it = {k = "slider", text = label, min = min, max = max, val = default}
        it.cb = function(v)
            it.val = v
            if cb then pcall(cb, v) end
        end
        it.frame = oSli(parent, label, min, max, default, y, it.cb)
        rec(parent, it)
    end
    C.input = function(parent, placeholder, y, default, cb)
        local it = {k = "input", text = placeholder, val = default}
        it.cb = function(t)
            it.val = t
            if cb then pcall(cb, t) end
        end
        local box = oInp(parent, placeholder, y, default, it.cb)
        rec(parent, it)
        return box
    end
end

-- Fling real: gruda no alvo girando rápido por 0.5s e volta para a posição original.
local function flingPlayer(plr)
    local my = getHRP()
    local th = plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not (my and th) then return false end
    local origin = my.CFrame
    State.flinging = true
    local t0 = os.clock()
    while Alive and os.clock() - t0 < 0.5 and my.Parent and th.Parent do
        State.lastTp = os.clock()
        my.CFrame = th.CFrame
        my.AssemblyAngularVelocity = Vector3.new(0, 20000, 0)
        my.AssemblyLinearVelocity = Vector3.new(20000, 20000, 20000)
        RunService.Heartbeat:Wait()
    end
    if my.Parent then
        my.AssemblyAngularVelocity = Vector3.zero
        my.AssemblyLinearVelocity = Vector3.zero
        State.lastTp = os.clock()
        my.CFrame = origin
    end
    State.flinging = false
    return true
end

local function nearestPlayer()
    local my, best, bd = getHRP(), nil, math.huge
    if not my then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        local hrp = p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local d = (hrp.Position - my.Position).Magnitude
            if d < bd then best, bd = p, d end
        end
    end
    return best
end

-- Log de chat (últimas 50 mensagens) + Chat Mimic
local ChatLog = {}
local function pushChat(name, text)
    if type(text) ~= "string" or text == "" then return end
    local last = ChatLog[#ChatLog]
    if last and last.name == name and last.text == text and os.clock() - last.t < 1 then return end
    table.insert(ChatLog, {name = name, text = text, t = os.clock()})
    if #ChatLog > 50 then table.remove(ChatLog, 1) end
    if State.mimic and name ~= LP.Name then
        local p = Players:FindFirstChild(name)
        if p and p == nearestPlayer() then chat(text) end
    end
end
local function hookChatter(p)
    addConn("chat_" .. p.UserId, p.Chatted:Connect(function(m) pushChat(p.Name, m) end))
end
for _, p in ipairs(Players:GetPlayers()) do hookChatter(p) end
addConn("chatAdded", Players.PlayerAdded:Connect(hookChatter))
