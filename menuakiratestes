local function new(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    if parent then inst.Parent = parent end
    return inst
end
local function corner(i, r) return new("UICorner", { CornerRadius = UDim.new(0, r) }, i) end
local function stroke(i, c, t, tr)
    return new("UIStroke", { Color = c, Thickness = t or 1, Transparency = tr or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, i)
end
local function lighten(c, a)
    return Color3.new(math.min(c.R + a, 1), math.min(c.G + a, 1), math.min(c.B + a, 1))
end
local function gradient(i, c1, c2, rot)
    return new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rot or 90 }, i)
end
local function makeButton(parent, text, color, textColor, size, pos, ts)
    local b = new("TextButton", {
        Size = size, Position = pos, BackgroundColor3 = color,
        Font = Enum.Font.GothamBold, Text = text, TextColor3 = textColor or C.Text,
        TextSize = ts or 13, BorderSizePixel = 0, AutoButtonColor = true,
    }, parent)
    corner(b, 8)
    gradient(b, lighten(color, 0.08), color, 90)
    return b
end

