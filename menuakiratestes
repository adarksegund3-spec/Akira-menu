        Messages  = {
            "Conectando...", "Carregando módulos...", "Montando interface...",
            "Aplicando tema Dark clean...", "Finalizando...",
        },
    }
    local T = {   -- paleta Dark clean (a mesma do tema do hub)
        Bg      = Color3.fromRGB(10, 11, 13),
