RecordBtn.MouseButton1Click:Connect(function()
    if playbackConnection then stopPlayback() end
    isRecording = not isRecording

    if isRecording then
        recordedData = {}
        startTime = os.clock()
        startTimer()
        RecordBtn.Text = "✧  parar"
        RecordBtn.BackgroundColor3 = Color3.fromRGB(140, 40, 55)
        RecordBtn.TextColor3 = Color3.fromRGB(255, 210, 220)
        StatusLabel.Text = "◦ gravando..."

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        if not hrp or not hum then
            isRecording = false
            stopTimer()
            RecordBtn.Text = "✦  gravar"
            RecordBtn.BackgroundColor3 = C_TURQ_DARK
            RecordBtn.TextColor3 = C_TURQ_BRIGHT
            StatusLabel.Text = "◦ sem personagem"
            return
        end

        recordingConnection = RunService.Heartbeat:Connect(function()
            local currentTime = os.clock() - startTime
            local cf = hrp.CFrame
            local vel = hrp.AssemblyLinearVelocity
            local state = hum:GetState()
            local anims = {}
            local animator = hum:FindFirstChildOfClass("Animator")
            if animator then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    if track.Animation and track.WeightCurrent > 0.01 then
                        table.insert(anims, {
                            Id = track.Animation.AnimationId,
                            Speed = track.Speed,
                            Weight = track.WeightCurrent,
                            Priority = track.Priority.Name
                        })
                    end
                end
            end
            table.insert(recordedData, {
                Time = currentTime,
                CF = {cf:GetComponents()},
                Velocity = {vel.X, vel.Y, vel.Z},
                State = state,
                Animations = anims
            })
        end)
    else
        if recordingConnection then
            recordingConnection:Disconnect()
            recordingConnection = nil
        end
        stopTimer()
        RecordBtn.Text = "✦  gravar"
        RecordBtn.BackgroundColor3 = C_TURQ_DARK
        RecordBtn.TextColor3 = C_TURQ_BRIGHT
        StatusLabel.Text = string.format("◦ %.2fs • %d pts", timerFrozen, #recordedData)
    end
end)

