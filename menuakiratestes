-- ======================================================================== --
-- TIMER DE ALTA PRECISÃO
-- ======================================================================== --

local timerStartTime = 0
local timerFrozen = 0
local timerRunning = false
local timerConnection = nil

local function formatTime(t)
    if t < 0 then t = 0 end
    local mins = math.floor(t / 60)
    local secs = t - mins * 60
    return string.format("%02d:%06.3f", mins, secs)
end

local function updateTimerDisplay()
    local elapsed = timerRunning and (os.clock() - timerStartTime) or timerFrozen
    TimerLabel.Text = formatTime(elapsed)
end

local function startTimer()
    timerStartTime = os.clock()
    timerRunning = true
    timerFrozen = 0
    if timerConnection then timerConnection:Disconnect() end
    timerConnection = RunService.RenderStepped:Connect(updateTimerDisplay)
    TimerFrameStroke.Color = Color3.fromRGB(0, 255, 120)
    TimerLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
end

local function stopTimer()
    if timerRunning then
        timerFrozen = os.clock() - timerStartTime
    end
    timerRunning = false
    if timerConnection then
        timerConnection:Disconnect()
        timerConnection = nil
    end
    updateTimerDisplay()
    TimerFrameStroke.Color = Color3.fromRGB(255, 180, 0)
    TimerLabel.TextColor3 = Color3.fromRGB(255, 180, 0)
end

local function resetTimer()
    if timerConnection then
        timerConnection:Disconnect()
        timerConnection = nil
    end
    timerRunning = false
    timerFrozen = 0
    TimerLabel.Text = "00:00.000"
    TimerFrameStroke.Color = Color3.fromRGB(0, 170, 0)
    TimerLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
end

ResetTimerBtn.MouseButton1Click:Connect(function()
    resetTimer()
    StatusLabel.Text = "Timer resetado"
end)

-- ======================================================================== --
-- GRAVAÇÃO / REPRODUÇÃO (CFrame direto - sem stealth)
-- ======================================================================== --

local recordedData = {}
local isRecording = false
local recordingConnection = nil
local playbackConnection = nil
local startTime = 0
local antigravidade = nil
local originalCollides = {}
local animationCache = {}
local activeTracks = {}

local function getOrLoadTrack(animator, animationId)
    if animationCache[animationId] and animationCache[animationId].Parent == animator then
        return animationCache[animationId]
    end
    local anim = Instance.new("Animation")
    anim.AnimationId = animationId
    local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
    if ok and track then
        animationCache[animationId] = track
        return track
    end
    return nil
end

local function stopPlayback()
    if playbackConnection then
        playbackConnection:Disconnect()
        playbackConnection = nil
    end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if antigravidade then
        antigravidade:Destroy()
        antigravidade = nil
    end
    if hum then hum.AutoRotate = true end
    for _, track in pairs(activeTracks) do
        pcall(function() track:Stop(0.1) end)
    end
    activeTracks = {}
    for parte, status in pairs(originalCollides) do
        if parte and parte.Parent then
            parte.CanCollide = status
        end
    end
    table.clear(originalCollides)
end

-- ===== GRAVAÇÃO =====
RecordBtn.MouseButton1Click:Connect(function()
    if playbackConnection then stopPlayback() end
    isRecording = not isRecording

    if isRecording then
        recordedData = {}
        startTime = os.clock()
        startTimer()
        RecordBtn.Text = "PARAR GRAVAÇÃO"
        RecordBtn.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
        StatusLabel.Text = "Gravando..."

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")

        if not hrp or not hum then
            isRecording = false
            stopTimer()
            RecordBtn.Text = "INICIAR GRAVAÇÃO"
            RecordBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
            StatusLabel.Text = "Sem personagem!"
            return
        end

        recordingConnection = RunService.Heartbeat:Connect(function()
            local currentTime = os.clock() - startTime
            local cf = hrp.CFrame
            local vel = hrp.AssemblyLinearVelocity
            local state = hum:GetState()

            local anims = {}
            local animator = hum:FindFirstChildOfClass("Animator")
            if animator then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    if track.Animation and track.WeightCurrent > 0.01 then
                        table.insert(anims, {
                            Id = track.Animation.AnimationId,
                            Speed = track.Speed,
                            Weight = track.WeightCurrent,
                            Priority = track.Priority.Name
                        })
                    end
                end
            end

            table.insert(recordedData, {
                Time = currentTime,
                CF = {cf:GetComponents()},
                Velocity = {vel.X, vel.Y, vel.Z},
                State = state,
                Animations = anims
            })
        end)
    else
        if recordingConnection then
            recordingConnection:Disconnect()
            recordingConnection = nil
        end
        stopTimer()
        RecordBtn.Text = "INICIAR GRAVAÇÃO"
        RecordBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        StatusLabel.Text = string.format("OK! %d pts", #recordedData)
    end
end)

-- ===== REPRODUÇÃO (CFrame direto - MÉTODO QUE FUNCIONA NO DELTA) =====
TestBtn.MouseButton1Click:Connect(function()
    if isRecording then
        StatusLabel.Text = "Pare gravação primeiro!"
        return
    end
    if #recordedData == 0 then
        StatusLabel.Text = "Nada gravado!"
        return
    end
    if playbackConnection then
        stopPlayback()
        stopTimer()
        StatusLabel.Text = "Teste cancelado"
        return
    end

    StatusLabel.Text = "Reproduzindo..."
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not hrp or not hum then return end

    local startCF = CFrame.new(unpack(recordedData[1].CF))
    hum.WalkSpeed = 22
    hum:MoveTo(startCF.Position)

    local reached = false
    local conn
    conn = hum.MoveToFinished:Connect(function()
        reached = true
        if conn then conn:Disconnect() end
    end)

    local timeout = tick() + 4
    while not reached and tick() < timeout do
        task.wait(0.1)
    end
    if conn then conn:Disconnect() end

    hum.AutoRotate = false
    antigravidade = Instance.new("BodyForce", hrp)
    antigravidade.Force = Vector3.new(0, 0, 0)

    for _, parte in ipairs(char:GetChildren()) do
        if parte:IsA("BasePart") then
            originalCollides[parte] = parte.CanCollide
            parte.CanCollide = false
        end
    end

    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then animator = Instance.new("Animator", hum) end

    local pstartTime = os.clock()
    local totalPoints = #recordedData
    local currentIndex = 1
    activeTracks = {}

    startTimer()

    playbackConnection = RunService.Heartbeat:Connect(function()
        local elapsedTime = os.clock() - pstartTime
        while currentIndex < totalPoints and elapsedTime >= recordedData[currentIndex + 1].Time do
            currentIndex = currentIndex + 1
        end
        if currentIndex >= totalPoints then
            stopPlayback()
            stopTimer()
            StatusLabel.Text = string.format("OK! (%s)", formatTime(timerFrozen))
            return
        end

        local p0 = recordedData[currentIndex]
        local p1 = recordedData[currentIndex + 1]
        local alpha = (p1.Time - p0.Time > 0) and math.clamp((elapsedTime - p0.Time) / (p1.Time - p0.Time), 0, 1) or 1

        local cf0 = CFrame.new(unpack(p0.CF))
        local cf1 = CFrame.new(unpack(p1.CF))
        hrp.CFrame = cf0:Lerp(cf1, alpha)

        local totalMass = 0
        for _, parte in ipairs(char:GetChildren()) do
            if parte:IsA("BasePart") then
                totalMass = totalMass + parte:GetMass()
            end
        end
        if antigravidade and antigravidade.Parent then
            antigravidade.Force = Vector3.new(0, totalMass * workspace.Gravity, 0)
        end
        if p1.Velocity then
            hrp.AssemblyLinearVelocity = Vector3.new(p1.Velocity[1], p1.Velocity[2], p1.Velocity[3])
        end
        if p0.State then
            pcall(function() hum:ChangeState(p0.State) end)
        end

        -- Sincronização de animações
        if p1.Animations then
            local wanted = {}
            for _, animData in ipairs(p1.Animations) do
                wanted[animData.Id] = animData
                local track = activeTracks[animData.Id]
                if not track then
                    track = getOrLoadTrack(animator, animData.Id)
                    if track then
                        pcall(function()
                            track.Priority = Enum.AnimationPriority[animData.Priority] or Enum.AnimationPriority.Movement
                            track.Looped = true
                            track:Play(0.05)
                        end)
                        activeTracks[animData.Id] = track
                    end
                end
                local t = activeTracks[animData.Id]
                if t then
                    pcall(function() t:AdjustSpeed(animData.Speed) end)
                end
            end
            for id, track in pairs(activeTracks) do
                if not wanted[id] then
                    pcall(function() track:Stop(0.1) end)
                    activeTracks[id] = nil
                end
            end
        end
    end)
end)

