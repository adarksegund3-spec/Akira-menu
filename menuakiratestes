local function CreateIcon(parent, key, size, pos, opts)
    opts = opts or {}
    local def = iconDef(key)
    if not def then return nil end
    size = math.clamp(size or 18, 14, 28)
    local img = Instance.new("ImageLabel")
    img.Name = "Icon_" .. key
    img.Image = "rbxassetid://" .. def.id
    img.ScaleType = Enum.ScaleType.Fit
    img.BorderSizePixel = 0
    img.Active = false
    img.AnchorPoint = opts.anchor or Vector2.new(0, 0)
    img.Position = pos or UDim2.new(0, 0, 0, 0)
    img.Size = UDim2.new(0, size, 0, size)
    img.ZIndex = opts.z or 5
    if def.chip then
        img.BackgroundColor3 = def.bg or ICON_BG
        img.BackgroundTransparency = 0
        local cr = Instance.new("UICorner", img)
        cr.CornerRadius = UDim.new(0.28, 0)
        local st = Instance.new("UIStroke", img)
        st.Color = Color3.fromRGB(120, 25, 25); st.Thickness = 1; st.Transparency = 0.6
    else
        img.BackgroundTransparency = 1
    end
    img.Parent = parent
    if def.decal then   -- ID de Decal: converte para o ID da imagem (se o executor suportar GetObjects)
        task.spawn(function()
            if def.resolved == nil then
                local ok, tex = pcall(function()
                    local o = game:GetObjects("rbxassetid://" .. def.id)[1]
                    local d = o and (o:IsA("Decal") and o or o:FindFirstChildWhichIsA("Decal", true))
                    return d and d.Texture
                end)
                def.resolved = (ok and type(tex) == "string" and tex ~= "") and tex or false
            end
            if def.resolved and img.Parent then img.Image = def.resolved end
        end)
    end
    if opts.fade ~= false then
        img.ImageTransparency = 1
        tween(img, 0.35, {ImageTransparency = 0})
    end
    return img
end

local function makeDraggable(handle, target, onClick)
    target = target or handle
    local dragging, moved, dragInput, dragStart, startPos = false, false
    local THRESH = 5
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging, moved = true, false
            dragStart, startPos = i.Position, target.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if not moved and onClick then onClick() end
                end
            end)
        end
    end)
    handle.InputChanged:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch then dragInput = i end
    end)
    UIS.InputChanged:Connect(function(i)
        if i == dragInput and dragging then
            local d = i.Position - dragStart
            if math.abs(d.X) > THRESH or math.abs(d.Y) > THRESH then moved = true end
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

