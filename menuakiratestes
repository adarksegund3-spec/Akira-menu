local Drag = { update = nil, finish = nil }
conn(UIS.InputChanged:Connect(function(i)
    if Drag.update and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        Drag.update(i.Position)
    end
end))
conn(UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        local f = Drag.finish
        Drag.update, Drag.finish = nil, nil
        if f then pcall(f) end
    end
end))

local function onScreen(obj)
    local cam = workspace.CurrentCamera
    if not cam then return true end
    local vp = cam.ViewportSize
    local c = obj.AbsolutePosition + obj.AbsoluteSize / 2
    return c.X > 0 and c.X < vp.X and c.Y > 0 and c.Y < vp.Y
end

local function makeDraggable(handle, target, onTap, onMove, resetPos)
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            local start, sp, moved = i.Position, target.Position, false
            Drag.update = function(p)
                local d = p - start
                if d.Magnitude > 6 then moved = true end
                if moved then
                    target.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
                end
            end
            Drag.finish = function()
                if not moved then
                    if onTap then onTap() end
                    return
                end
                if not onScreen(target) then target.Position = resetPos end
                if onMove then onMove(target.Position) end
            end
        end
    end)
end

