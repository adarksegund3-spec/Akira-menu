local function cardLabel(m)
	return string.format("%s • %s • %d ev • %s%s #%s", m.name, fmt(m.dur), m.n or 0,
		(m.partial and "incompleta") or ((m.na or 0) > 0 and "parcial") or "ok", m.run and " • correr" or "", m.id:sub(1, 3))
end
function UI.details()
	local m = UI.sel and History.byId[UI.sel]
	if not m then
		pcall(function() detPara:Set({ Title = "Detalhes", Content = "Nenhuma rota selecionada." }) end)
		return
	end
	History.getEvents(m.id)
	local runTxt = m.run and string.format("sim (velocidade %s → %s)", tostring(m.wsMin), tostring(m.wsMax)) or "não"
	local txt = string.format("Nome: %s\nData: %s\nDuração: %s • Eventos: %d\nSaltos: %d • Interações: %d\nCorrer: %s\nAnimação de andar: %s\nCompatibilidade: %d%%\nEstado: %s%s",
		m.name, os.date("%d/%m/%Y %H:%M", m.created), fmt(m.dur), m.n or 0, m.jumps or 0, m.inter or 0, runTxt,
		tostring(m.loco or "padrão"), compatPct(m), statusOf(m), m.partial and ("\nMotivo: " .. tostring(m.partial)) or "")
	pcall(function() detPara:Set({ Title = "Detalhes", Content = txt }) end)
end
function UI.refresh()
	if not alive then return end
	local items = History.sorted()
	UI.map = {}
	local labels, selLabel = {}, nil
	for _, m in ipairs(items) do
		local lb = cardLabel(m)
		UI.map[lb] = m.id
		labels[#labels + 1] = lb
		if m.id == UI.sel then selLabel = lb end
	end
	pcall(function() countLbl:Set("Rotas: " .. #items) end)
	if #labels == 0 then labels = { "(nenhuma rota)" } end
	pcall(function() routeDD:Refresh(labels) end)
	if not selLabel and UI.sel and not History.byId[UI.sel] then UI.sel = nil end
	if not selLabel and #items > 0 and not UI.sel then UI.sel = items[1].id selLabel = labels[1] end
	if selLabel then pcall(function() routeDD:Set({ selLabel }) end) end
	UI.details()
end
function UI.showSection()
	local lines = Scan.sections[UI.section]
	if not lines then return end
	local out = {}
	for i = 1, math.min(#lines, 45) do out[i] = lines[i] end
	if #lines > 45 then out[#out + 1] = string.format("... +%d linhas (relatório completo no arquivo/cópia)", #lines - 45) end
	if #out == 0 then out[1] = "(vazio)" end
	pcall(function() secPara:Set({ Title = UI.section, Content = table.concat(out, "\n") }) end)
end
function UI.updateScan()
	pcall(function() scanPara:Set({ Title = "Resultado da leitura", Content = Scan.summary }) end)
	pcall(function() secDD:Refresh(Scan.order) end)
	UI.section = Scan.order[1] or "Jogo"
	pcall(function() secDD:Set({ UI.section }) end)
	UI.showSection()
end
