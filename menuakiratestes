local KIND_COLOR = {
    success = Color3.fromRGB(120, 220, 160), warn = Color3.fromRGB(255, 205, 100),
    error = Color3.fromRGB(255, 120, 120), info = C.baby,
}
local activeNotifs = {}

notify = function(kind, title, msg, duration)
    local key = tostring(title) .. "|" .. tostring(msg)
    if activeNotifs[key] then return end -- sem duplicadas
    activeNotifs[key] = true
    duration = duration or 3
    local accent = KIND_COLOR[kind] or C.baby

    local wrap = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y }, notifyHolder)
    local box = new("CanvasGroup", { BackgroundColor3 = Color3.fromRGB(8, 8, 10), Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.fromOffset(0, -12), GroupTransparency = 1 }, wrap)
    corner(box, 10)
    new("UIGradient", { Rotation = 20, Color = ColorSequence.new(Color3.fromRGB(8, 8, 10), Color3.fromRGB(38, 72, 92)) }, box)
    local st = stroke(box, accent, 0.6, 1)
    new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
        PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, box)
    new("UIListLayout", { Padding = UDim.new(0, 2) }, box)
    new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = accent,
        TextXAlignment = Enum.TextXAlignment.Left, Text = string.upper(title), Size = UDim2.new(1, 0, 0, 14) }, box)
    new("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = C.text,
        TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, Text = msg,
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, box)

    local info = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(box, info, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }):Play()
    TweenService:Create(st, TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 1, true),
        { Transparency = 0.1 }):Play() -- brilho discreto

    task.delay(duration, function()
        if not box.Parent then activeNotifs[key] = nil; return end
        local t = TweenService:Create(box, TweenInfo.new(0.35), { GroupTransparency = 1, Position = UDim2.fromOffset(0, -8) })
        t:Play(); t.Completed:Wait()
        wrap:Destroy()
        activeNotifs[key] = nil
    end)
end

