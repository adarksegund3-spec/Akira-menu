	warn = Color3.fromRGB(200, 140, 40),
}

--=====================================================================
-- UTILITÁRIOS
--=====================================================================
local ACCENTS = {
	["ã"] = "a", ["á"] = "a", ["à"] = "a", ["â"] = "a", ["Ã"] = "a", ["Á"] = "a", ["Â"] = "a",
	["é"] = "e", ["ê"] = "e", ["É"] = "e", ["Ê"] = "e", ["í"] = "i", ["Í"] = "i",
	["ó"] = "o", ["ô"] = "o", ["õ"] = "o", ["Ó"] = "o", ["Ô"] = "o", ["Õ"] = "o",
	["ú"] = "u", ["Ú"] = "u", ["ç"] = "c", ["Ç"] = "c",
}

-- minúsculas, sem acentos e sem tags RichText ("PRISÃO" == "prisao")
local function normalize(s)
	s = tostring(s or "")
	s = string.gsub(s, "<[^>]+>", "")
	if string.find(s, "[\128-\255]") then
		s = string.gsub(s, utf8.charpattern, function(c) return ACCENTS[c] or c end)
	end
	return string.lower(s)
end

local function cleanText(s)
	s = string.gsub(tostring(s or ""), "<[^>]+>", "")
	s = string.gsub(s, "%s+", " ")
	return (string.gsub(s, "^%s*(.-)%s*$", "%1"))
end

local function findHits(norm, list)
	local out = {}
	for _, k in ipairs(list) do
		if string.find(norm, k, 1, true) then table.insert(out, k) end
	end
	return out
end

local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do inst[k] = v end
	inst.Parent = parent
	return inst
end

local screenGui = new("ScreenGui", {
	Name = "PrisonTextUI", ResetOnSpawn = false, IgnoreGuiInset = true,
	DisplayOrder = 999, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, playerGui)

local function isText(obj) return obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") end

--=====================================================================
-- DETECÇÃO DO TEXTO
--=====================================================================
-- Visível de verdade? (ancestrais, ScreenGui.Enabled e transparência)
local function isVisible(obj)
	local cur = obj
	while cur and cur ~= game do
		if cur:IsA("GuiObject") and not cur.Visible then return false end
		if cur:IsA("LayerCollector") and not cur.Enabled then return false end
		cur = cur.Parent
	end
	return obj.TextTransparency < 1 and obj.Text ~= ""
end

-- Posição vertical relativa (0 = topo, 1 = base)
local function verticalRatio(obj)
	local cam = Workspace.CurrentCamera
	if not (cam and obj:IsA("GuiObject")) then return nil end
	return (obj.AbsolutePosition.Y + obj.AbsoluteSize.Y / 2) / math.max(cam.ViewportSize.Y, 1)
end

local hiddenByUs = {}   -- [obj] = conexão que mantém o texto oculto
local hiddenKeys = {}   -- ["NomeDoLabel|NomeDoPai"] = true (para textos recriados pelo jogo)

-- Procura o melhor candidato à "mensagem de prisão"
-- Pontuação: termos de prisão + visível + topo da tela + números + palavras de regra
local function detect()
	local best, bestScore = nil, -1
	for i, obj in ipairs(playerGui:GetDescendants()) do
		if i % 400 == 0 then task.wait() end
		if obj.Parent and isText(obj) and not obj:IsDescendantOf(screenGui) and obj.Text ~= "" then
			local norm = normalize(obj.Text)
			local hits = findHits(norm, KEYWORDS)
			if #hits > 0 then
				local ratio = verticalRatio(obj)
				local visible = isVisible(obj) or hiddenByUs[obj] ~= nil -- oculto por nós ainda conta
				local score = #hits * 3
				if visible then score += 4 end
				if ratio and ratio < TOP_BAND then score += 4 end
				if string.find(norm, "%d") then score += 2 end
				if #findHits(norm, RULE_WORDS) > 0 then score += 3 end
				if #obj.Text > 20 then score += 1 end
				if score > bestScore then
					bestScore = score
					best = { obj = obj, text = cleanText(obj.Text), path = obj:GetFullName(),
						visible = visible, ratio = ratio, hits = hits }
				end
			end
		end
	end
	return best
end

local function buildReport(best)
	local L = { "DIAGNÓSTICO — TEXTO DA PRISÃO", "Gerado em: " .. os.date("%Y-%m-%d %H:%M:%S"), "" }
	if not best then
		table.insert(L, "Mensagem: NÃO ENCONTRADA")
		table.insert(L, "Nenhum texto com os termos buscados na interface.")
		table.insert(L, "Fique preso (mensagem na tela) e rode de novo.")
		return table.concat(L, "\n")
	end
	local inTop = best.ratio and best.ratio < TOP_BAND
	local conf = (best.visible and inTop) and "ALTA (visível e na faixa superior)"
		or best.visible and "MÉDIA (visível, fora do topo)"
		or "BAIXA (não visível agora)"
	table.insert(L, 'Mensagem: "' .. best.text .. '"')
	table.insert(L, "Local: " .. best.path)
	table.insert(L, string.format("Posição: %s%s", inTop and "SUPERIOR" or "outra região",
		best.ratio and string.format(" (%.0f%% da altura)", best.ratio * 100) or ""))
	table.insert(L, "Confiança: " .. conf)
	table.insert(L, "Termos: " .. table.concat(best.hits, ", "))
	table.insert(L, "Texto na tela: " .. (hiddenByUs[best.obj] and "APAGADO por você" or "visível"))
	return table.concat(L, "\n")
end

--=====================================================================
-- REMOÇÃO DO TEXTO (somente no cliente)
--=====================================================================
local function keyOf(obj) return obj.Name .. "|" .. (obj.Parent and obj.Parent.Name or "") end

-- Oculta o label e o mantém oculto se o jogo tentar reexibi-lo
local function hideLabel(obj)
	if hiddenByUs[obj] then return end
	obj.Visible = false
	hiddenByUs[obj] = obj:GetPropertyChangedSignal("Visible"):Connect(function()
		if obj.Visible then obj.Visible = false end
	end)
end

local function restoreAll()
	for obj, conn in pairs(hiddenByUs) do
		conn:Disconnect()
		if obj.Parent then obj.Visible = true end
	end
	hiddenByUs = {}
	hiddenKeys = {}
end

-- Se o jogo recriar o texto (ex.: nova prisão), oculta de novo
playerGui.DescendantAdded:Connect(function(d)
	if isText(d) and next(hiddenKeys) then
		task.defer(function()
			if d.Parent and hiddenKeys[keyOf(d)] then hideLabel(d) end
		end)
	end
end)

-- Oculta a mensagem detectada e labels equivalentes (mesmo nome e mesmo pai)
local function hideMessage(best)
	local key = keyOf(best.obj)
	hiddenKeys[key] = true
	local n = 0
	for _, obj in ipairs(playerGui:GetDescendants()) do
		if isText(obj) and not obj:IsDescendantOf(screenGui) and keyOf(obj) == key then
			hideLabel(obj)
			n += 1
		end
	end
	return n
end

--=====================================================================
-- INTERFACE (logo + menu arrastáveis, com animação)
--=====================================================================
local function makeDraggable(handle, target, onTap)
	local dragging, moved, startInput, startMouse, startCenter = false, false, nil, nil, nil
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, moved, startInput = true, false, input
			startMouse = input.Position
			startCenter = target.AbsolutePosition + target.AbsoluteSize * target.AnchorPoint
			local conn
			conn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					conn:Disconnect()
					if not moved and onTap then onTap() end
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		local isMove = input.UserInputType == Enum.UserInputType.MouseMovement
		local isTouch = input.UserInputType == Enum.UserInputType.Touch and input == startInput
		if not (isMove or isTouch) then return end
		local delta = input.Position - startMouse
		if delta.Magnitude > 6 then moved = true end
		if moved then
			local screen, size, a = screenGui.AbsoluteSize, target.AbsoluteSize, target.AnchorPoint
			local x = math.clamp(startCenter.X + delta.X, size.X * a.X, screen.X - size.X * (1 - a.X))
			local y = math.clamp(startCenter.Y + delta.Y, size.Y * a.Y, screen.Y - size.Y * (1 - a.Y))
			target.Position = UDim2.fromOffset(x, y)
		end
	end)
end

