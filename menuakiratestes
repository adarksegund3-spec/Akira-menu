local function tokens(name)
	local set = {}
	local ok = pcall(function()
		local s = name:gsub("(%l)(%u)", "%1 %2"):lower()
		for tok in s:gmatch("[^%s%p%d]+") do
			set[tok] = true
			local sg = tok:gsub("s$", "")
			set[sg] = true
		end
	end)
	if not ok then
		return {}
	end
	return set
end

