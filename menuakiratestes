-- Detecta se o jogo atual tem suporte
function GameModule.getCurrentGame()
    for _, g in ipairs(GameModule.games) do
        if g.name:lower():find(game.PlaceId.."") then return g end
    end
    -- Verifica pelo nome do jogo
    local ok, info = pcall(function()
        return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
    end)
    if ok and info then
        local jn = info.Name:lower()
        for _, g in ipairs(GameModule.games) do
            if jn:find(g.id:lower()) or jn:find(g.name:lower():split(" — ")[1]) then
                return g
            end
        end
    end
    return nil
end

-- Executa script com fallback de fontes
function GameModule.execute(gameData, onStatus)
    onStatus("⏳ Carregando...", "loading")
    local sources = {gameData.script}
    if gameData.sources then
        for _, s in ipairs(gameData.sources) do table.insert(sources, s) end
    end
    for i, url in ipairs(sources) do
        local ok, err = pcall(function()
            local code = game:HttpGet(url)
            if not code or #code < 20 then
                error("Resposta vazia ou inválida")
            end
            loadstring(code)()
        end)
        if ok then
            onStatus("✓ Executado!", "success")
            showToast("▶ "..gameData.name.." executado", "success")
            return true
        else
            warn("[AKZ] Fonte "..i.." falhou: "..tostring(err))
        end
    end
    onStatus("⚠ Falhou", "error")
    showToast("⚠ Falha em "..gameData.name, "error")
    return false
end

