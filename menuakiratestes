-- ============================================
-- BOTÃO NOCLIP
-- ============================================
NoclipBtn.MouseButton1Click:Connect(function()
    noclipAtivo = not noclipAtivo

    if noclipAtivo then
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        NoclipBtn.Text = "Noclip: ON"
        
        noclipConnection = RunService.Stepped:Connect(function()
            if not noclipAtivo then return end
            local char = LocalPlayer.Character
            if not char then return end
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end)
    else
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
        NoclipBtn.Text = "Noclip: OFF"
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end)

-- ============================================
-- BOTÃO ANTI-TP (BYPASS + DETECTOR DE TEXTO)
-- ============================================
BypassBtn.MouseButton1Click:Connect(function()
    bypassAtivo = not bypassAtivo

    if bypassAtivo then
        BypassBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        BypassBtn.Text = "Anti-TP: ON"
        
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            ultimaPosicao = hrp.CFrame
        end

        -- Anti-Teleporte (Heartbeat, como era antes e funcionava)
        antiTpConnection = RunService.Heartbeat:Connect(function()
            if not bypassAtivo then return end
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp or not ultimaPosicao then return end

            local dist = (hrp.Position - ultimaPosicao.Position).Magnitude
            
            if dist > 30 then
                hrp.CFrame = ultimaPosicao
            else
                ultimaPosicao = hrp.CFrame
            end
        end)

        -- Detector de Texto da Prisão
        local function normalizar(s)
            s = string.gsub(tostring(s), "<[^>]+>", "")
            s = string.gsub(s, "ã", "a")
            s = string.gsub(s, "Ã", "a")
            return string.lower(s)
        end

        local function contem(texto, palavra)
            return string.find(texto, palavra, 1, true) ~= nil
        end

        local function ehMensagemDePrisao(obj)
            local t = normalizar(obj.Text)
            local prisao = contem(t, "prisao") or contem(t, "preso") or contem(t, "prison") or contem(t, "jail")
            local regra = contem(t, "polichinelo") or contem(t, "minut")
            return prisao and regra
        end

        local function apagar(obj)
            if textosOcultos[obj] ~= nil then return end
            textosOcultos[obj] = obj.Visible
            obj.Visible = false
            table.insert(textoConnections, obj:GetPropertyChangedSignal("Visible"):Connect(function()
                if bypassAtivo and obj.Visible then obj.Visible = false end
            end))
        end

        local function verificar(obj)
            if ehMensagemDePrisao(obj) then apagar(obj) end
        end

        local function observar(obj)
            if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and not obj:IsDescendantOf(ScreenGui) then
                verificar(obj)
                table.insert(textoConnections, obj:GetPropertyChangedSignal("Text"):Connect(function()
                    verificar(obj)
                end))
            end
        end

        local playerGui = LocalPlayer:WaitForChild("PlayerGui")
        for _, d in ipairs(playerGui:GetDescendants()) do
            observar(d)
        end
        table.insert(textoConnections, playerGui.DescendantAdded:Connect(observar))

    else
        BypassBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
        BypassBtn.Text = "Anti-TP: OFF"
        
        if antiTpConnection then
            antiTpConnection:Disconnect()
            antiTpConnection = nil
        end
        ultimaPosicao = nil

        for _, c in ipairs(textoConnections) do
            c:Disconnect()
        end
        textoConnections = {}
        for obj, visivelOriginal in pairs(textosOcultos) do
            if obj.Parent then obj.Visible = visivelOriginal end
        end
        textosOcultos = {}
    end
end)