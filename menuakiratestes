local rainbowOn = false
local rainbowHue = 0
local rainbowConn = nil

local function startRainbow()
    rainbowHue = 0
    if rainbowConn then rainbowConn:Disconnect() end
    rainbowConn = RunService.RenderStepped:Connect(function(dt)
        rainbowHue = (rainbowHue + dt * 0.35) % 1
        local c1 = Color3.fromHSV(rainbowHue, 0.75, 1)
        local c2 = Color3.fromHSV((rainbowHue + 0.5) % 1, 0.75, 1)
        FloatStroke.Color = c1
        MainStroke.Color = c1
        RainbowStroke.Color = c1
        RainbowDot.BackgroundColor3 = c1
        FloatInnerStroke.Color = c2
        FloatInnerStroke.Transparency = 0.4
        RainbowBtn.TextColor3 = c1
    end)
end

local function stopRainbow()
    if rainbowConn then
        rainbowConn:Disconnect()
        rainbowConn = nil
    end
    FloatStroke.Color = C_TURQ
    MainStroke.Color = C_TURQ
    FloatInnerStroke.Color = Color3.fromRGB(255, 255, 255)
    FloatInnerStroke.Transparency = 0.75
    RainbowStroke.Color = C_BG_3
    RainbowDot.BackgroundColor3 = C_TXT_DIM
    RainbowBtn.TextColor3 = C_TXT_DIM
end

RainbowBtn.MouseButton1Click:Connect(function()
    rainbowOn = not rainbowOn
    if rainbowOn then
        RainbowBtn.Text = "rainbow  •  on"
        RainbowDot.BackgroundColor3 = C_TURQ
        startRainbow()
    else
        RainbowBtn.Text = "rainbow  •  off"
        stopRainbow()
    end
end)

-- ======================================================================== --
-- TIMER
-- ======================================================================== --
local timerStartTime, timerFrozen, timerRunning, timerConnection = 0, 0, false, nil

local function formatTime(t)
    if t < 0 then t = 0 end
    local mins = math.floor(t / 60)
    local secs = t - mins * 60
    return string.format("%02d:%06.3f", mins, secs)
end

local function updateTimerDisplay()
    local elapsed = timerRunning and (os.clock() - timerStartTime) or timerFrozen
    TimerLabel.Text = formatTime(elapsed)
end

local function startTimer()
    timerStartTime = os.clock()
    timerRunning = true
    timerFrozen = 0
    if timerConnection then timerConnection:Disconnect() end
    timerConnection = RunService.RenderStepped:Connect(updateTimerDisplay)
    TimerStroke.Color = C_TURQ
    TimerLabel.TextColor3 = C_TURQ_BRIGHT
end

local function stopTimer()
    if timerRunning then timerFrozen = os.clock() - timerStartTime end
    timerRunning = false
    if timerConnection then timerConnection:Disconnect() timerConnection = nil end
    updateTimerDisplay()
    TimerStroke.Color = Color3.fromRGB(160, 120, 60)
    TimerLabel.TextColor3 = Color3.fromRGB(255, 200, 130)
end

local function resetTimer()
    if timerConnection then timerConnection:Disconnect() timerConnection = nil end
    timerRunning = false
    timerFrozen = 0
    TimerLabel.Text = "00:00.000"
    TimerStroke.Color = C_TURQ_DARK
    TimerLabel.TextColor3 = C_TURQ_BRIGHT
end

