local activeTab = nil

local function selectTab(name)
    if activeTab == name then return end
    if activeTab and Tabs[activeTab] then
        Tabs[activeTab].content.Visible = false
        Tabs[activeTab].indicator.BackgroundTransparency = 1
        Tabs[activeTab].button.TextColor3 = TEXT_DIM
    end
    activeTab = name
    Tabs[name].content.Visible = true
    Tabs[name].indicator.BackgroundTransparency = 0
    Tabs[name].button.TextColor3 = Color3.fromRGB(255,255,255)
end

