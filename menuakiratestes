local espEnabled = false
local ballESP = {}

local function createESP(m)
    if not espEnabled or not m.Parent then return end
    if ballESP[m] then return end
    local hl = Instance.new("Highlight")
    hl.Name = "AkiraBallESP"
    hl.Adornee = m
    hl.FillColor = Color3.fromRGB(0, 255, 100)
    hl.FillTransparency = 0.5
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.OutlineTransparency = 0
    hl.Parent = m
    ballESP[m] = hl
end

local function removeESP(m)
    if ballESP[m] then ballESP[m]:Destroy(); ballESP[m] = nil end
end

