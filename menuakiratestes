-- Construção da URL
local function BuildURL(query, filters, page, sort)
    local parts = {}
    if query and query ~= "" then
        table.insert(parts, "q=" .. HttpService:UrlEncode(query))
    end
    table.insert(parts, "page=" .. tostring(page))
    table.insert(parts, "limit=" .. tostring(Config.ResultsPerPage))
    table.insert(parts, "sort=" .. (sort or "recommended"))
    if filters.noKey then table.insert(parts, "noKeySystem=true") end
    if filters.mobile then table.insert(parts, "mobileOnly=true") end
    if filters.free then table.insert(parts, "freeOnly=true") end
    return Config.APIEndpoint .. "?" .. table.concat(parts, "&")
end

-- Requisição HTTP com tratamento de erros
local function FetchScripts(url)
    local headers = {
        ["Authorization"] = "Bearer " .. Config.RScriptsAPI,
        ["Accept"] = "application/json",
    }
    local ok, response = pcall(function()
        return HttpService:RequestAsync({
            Url = url,
            Method = "GET",
            Headers = headers,
        })
    end)
    if not ok or not response then
        return nil, "connection"
    end
    local code = response.StatusCode
    if code == 200 then
        local ok2, data = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if ok2 and data then return data, nil end
        return nil, "parse"
    elseif code == 400 then return nil, "⚠ Requisição inválida (400)."
    elseif code == 401 then return nil, "⚠ API Key inválida (401)."
    elseif code == 403 then return nil, "⚠ Acesso negado (403)."
    elseif code == 404 then return nil, "⚠ Recurso não encontrado (404)."
    elseif code == 429 then return nil, "⚠ Muitas requisições. Aguarde alguns segundos (429)."
    elseif code >= 500 then return nil, "⚠ Servidor temporariamente indisponível ("..code..")."
    else return nil, "⚠ Erro HTTP "..code end
end

-- Execução segura do script
local function ExecuteCatalogScript(rawScript, scriptInline)
    local source = nil
    if scriptInline and scriptInline ~= "" then
        source = scriptInline
    elseif rawScript and rawScript ~= "" then
        local ok, fetched = pcall(function()
            return game:HttpGet(rawScript)
        end)
        if ok and fetched and #fetched > 10 then source = fetched end
    end
    if not source then
        showToast("⚠ Nenhum código executável disponível", "warning")
        return false
    end
    local ok, err = pcall(function()
        loadstring(source)()
    end)
    if ok then
        showToast("✓ Script executado!", "success")
        return true
    else
        warn("[AKZ] Erro ao executar script: " .. tostring(err))
        showToast("⚠ Falha ao executar script", "error")
        return false
    end
end

