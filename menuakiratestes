-- ═══════════════════════════ LOOP PRINCIPAL ═══════════════════════════
local wasESPEnabled = false
local weaponTick = 0

RunService.RenderStepped:Connect(function(dt)
    -- FOV Circle
    local showFov = Config.AimbotEnabled or Config.SilentAimEnabled
    local centro = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    if AimFovDrawing then
        AimFovDrawing.Visible = showFov
        AimFovDrawing.Position = centro
        AimFovDrawing.Radius = Config.AimbotEnabled and Config.AimbotFOV or Config.SilentAimFOV
        fovCircle.Visible = false
    else
        fovCircle.Visible = showFov
        if showFov then fovCircle.Position = UDim2.fromOffset(centro.X, centro.Y) end
    end

    -- ESP
    if not Config.ESPEnabled then
        if wasESPEnabled then clearAllESP() end
        wasESPEnabled = false
    else
        wasESPEnabled = true
        for _, player in ipairs(Players:GetPlayers()) do
            updatePlayerESP(player)
        end
    end

    -- Aimbot
    if Config.AimbotEnabled and Config.Aiming then
        local target = getAimbotTarget()
        if target then lockOn(target) end
    end

    -- Silent Aim (aplica no momento do clique — implementação básica)
    if Config.SilentAimEnabled and Config.Aiming then
        if math.random(1, 100) <= Config.SilentAimHitChance then
            local target = getAimbotTarget()
            if target then
                -- Redireciona a mira para o alvo
                local camPos = Camera.CFrame.Position
                local dir = target.Position - camPos
                if dir.Magnitude > 0.01 then
                    Camera.CFrame = CFrame.lookAt(camPos, camPos + dir.Unit)
                end
            end
        end
    end

    -- Movimento
    updateMovement()

    -- FOV visual
    if Config.FOVEnabled then
        Camera.FieldOfView = Config.FOVValue
    end

    -- Armas (aplica a cada 0.2s para performance)
    weaponTick = weaponTick + dt
    if weaponTick >= 0.2 then
        weaponTick = 0
        if Config.NoRecoil or Config.NoSpread or Config.InfiniteAmmo then
            applyWeaponMods()
        end
    end
end)

