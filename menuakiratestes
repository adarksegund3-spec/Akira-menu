-- peça ancorada no mundo
local function wpart(size, col, mat, o)
	local p = Instance.new("Part")
	p.Size, p.Color, p.Material = size, col, mat or M.SmoothPlastic
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	if o then for k, v in pairs(o) do p[k] = v end end
	if not p.Parent then p.Parent = junk end
	return p
end
local function dirCF(a, b)
	local d = b - a
	if d.Magnitude < 1e-4 then return CFrame.new(a) end
	local up = math.abs(d.Unit.Y) > 0.99 and Vector3.zAxis or Vector3.yAxis
	return CFrame.lookAt((a + b) / 2, b, up) * CFrame.Angles(0, math.pi / 2, 0)
end
local function triCF(a, b, c)
	local ab, ac, bc = b - a, c - a, c - b
	if ac:Cross(ab).Magnitude < 1e-3 then return end
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then c, a = a, c elseif acd > bcd and acd > abd then a, b = b, a end
	ab, ac, bc = b - a, c - a, c - b
	local right = ac:Cross(ab).Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local h = math.abs(ab:Dot(up))
	return Vector3.new(0.03, h, math.abs(ab:Dot(back))), CFrame.fromMatrix((a + b) / 2, right, up, back),
		Vector3.new(0.03, h, math.abs(ac:Dot(back))), CFrame.fromMatrix((a + c) / 2, -right, up, -back)
end
local function ring(pos, col, size, t)
	t = t or 0.8
	local p = wpart(Vector3.new(0.2, 1, 1), col, M.Neon, {Shape = Enum.PartType.Cylinder, CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2), Transparency = 0.25})
	tw(p, t, {Size = Vector3.new(0.2, size, size), Transparency = 1})
	Debris:AddItem(p, t + 0.1)
end
local function shake(a)
	local h = hum(); if not h then return end
	task.spawn(function()
		for _ = 1, 8 do h.CameraOffset = Vector3.new(rnd(-a, a), rnd(-a, a), 0); task.wait(0.025) end
		h.CameraOffset = Vector3.zero
	end)
end
local function fadeOut(inst, t)
	for _, d in ipairs(inst:GetDescendants()) do if d:IsA("BasePart") then tw(d, t, {Transparency = 1}) end end
	Debris:AddItem(inst, t + 0.1)
end

------------------------------------------------------------------ contexto de item
local live = {}
local function ctx(c)
	local K = {c = c, items = {}, last = 0, parent = c}
	K.rp = RaycastParams.new(); K.rp.FilterDescendantsInstances = {c}
	live[K] = true
	function K.add(x) K.items[#K.items + 1] = x return x end
	function K.clean()
		live[K] = nil
		for i = #K.items, 1, -1 do
			local x, t = K.items[i], typeof(K.items[i])
			if t == "RBXScriptConnection" then x:Disconnect()
			elseif t == "Instance" then x:Destroy()
			elseif t == "function" then pcall(x) end
		end
		K.items = {}
	end
	function K.loop(f)
		local t0 = os.clock()
		return K.add(RS.RenderStepped:Connect(function(dt) f(os.clock() - t0, dt) end))
	end
	function K.part(size, cf, col, mat, o, class)
		local p = Instance.new(class or "Part")
		p.Size, p.Color, p.Material = size, col, mat or M.SmoothPlastic
		p.CanCollide, p.CanQuery, p.CanTouch, p.Massless, p.CastShadow = false, false, false, true, false
		if o then for k, v in pairs(o) do p[k] = v end end
		p.Parent = K.parent
		local w = Instance.new("Weld"); w.Part0, w.Part1, w.C0 = K.base, p, cf; w.Parent = p
		K.add(p) return p, w
	end
	function K.cyl(len, dia, cf, col, mat, o)
		o = o or {}; o.Shape = Enum.PartType.Cylinder
		return K.part(Vector3.new(len, dia, dia), cf * CFrame.Angles(0, 0, math.pi / 2), col, mat, o)
	end
	function K.cylZ(len, dia, cf, col, mat, o)
		o = o or {}; o.Shape = Enum.PartType.Cylinder
		return K.part(Vector3.new(len, dia, dia), cf * CFrame.Angles(0, math.pi / 2, 0), col, mat, o)
	end
	function K.ball(d, cf, col, mat, o)
		o = o or {}; o.Shape = Enum.PartType.Ball
		return K.part(Vector3.new(d, d, d), cf, col, mat, o)
	end
	function K.rod(a, b, th, col, mat, o)
		o = o or {}; o.Shape = Enum.PartType.Cylinder
		return K.part(Vector3.new((b - a).Magnitude, th, th), dirCF(a, b), col, mat, o)
	end
	function K.moveRod(p, w, a, b)
		p.Size = Vector3.new(math.max((b - a).Magnitude, 0.05), p.Size.Y, p.Size.Z); w.C0 = dirCF(a, b)
	end
	function K.tri(col, mat, o)
		local p1, w1 = K.part(Vector3.new(0.05, 1, 1), CFrame.new(), col, mat, o, "WedgePart")
		local p2, w2 = K.part(Vector3.new(0.05, 1, 1), CFrame.new(), col, mat, o, "WedgePart")
		return {p1 = p1, w1 = w1, p2 = p2, w2 = w2}
	end
	function K.setTri(T, a, b, c)
		local s1, c1, s2, c2 = triCF(a, b, c)
		if not s1 then return end
		T.p1.Size, T.w1.C0, T.p2.Size, T.w2.C0 = s1, c1, s2, c2
	end
	function K.on(p, fn) local o = K.base; K.base = p; fn(); K.base = o end
	function K.light(par, col, range, br)
		local l = Instance.new("PointLight"); l.Color, l.Range, l.Brightness = col, range, br; l.Parent = par
		K.add(l) return l
	end
	function K.emit(par, pr)
		local e = Instance.new("ParticleEmitter")
		for k, v in pairs(pr) do e[k] = v end
		e.Parent = par; K.add(e) return e
	end
	function K.torso()
		K.base = c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso"); return K.base
	end
	function K.hand()
		local h = c:FindFirstChild("RightHand") or c:FindFirstChild("Right Arm")
		if not h then error("sem mão direita") end
		local a = Instance.new("Part")
		a.Size, a.Transparency, a.CanCollide, a.CanQuery, a.CanTouch, a.Massless, a.CastShadow = Vector3.one * 0.2, 1, false, false, false, true, false
		a.Parent = c
		local w = Instance.new("Weld")
		w.Part0, w.Part1 = h, a
		w.C0 = CFrame.new(0, h.Name == "RightHand" and -0.2 or -0.95, 0) * CFrame.Angles(-math.pi / 2, 0, 0)
		w.Parent = a
		K.add(a); K.base = a; return a
	end
	return K
end
onKill(function() for K in pairs(live) do K.clean() end end)

-- troca de roupa (restaura ao soltar o item)
local function outfit(K, cfg)
	local c = K.c
	local bc = c:FindFirstChildOfClass("BodyColors")
	local made = false
	if not bc then bc = Instance.new("BodyColors"); bc.Parent = c; made = true end
	local old = {HeadColor3 = bc.HeadColor3, TorsoColor3 = bc.TorsoColor3, LeftArmColor3 = bc.LeftArmColor3,
		RightArmColor3 = bc.RightArmColor3, LeftLegColor3 = bc.LeftLegColor3, RightLegColor3 = bc.RightLegColor3}
	local cloth = {}
	for _, o in ipairs(c:GetChildren()) do
		if o:IsA("Shirt") or o:IsA("Pants") or o:IsA("ShirtGraphic") then cloth[#cloth + 1] = o; o.Parent = nil end
	end
	local head = c:FindFirstChild("Head")
	local face = head and head:FindFirstChild("face")
	if face then face.Transparency = 1 end
	if cfg.head then bc.HeadColor3 = cfg.head end
	bc.TorsoColor3, bc.LeftArmColor3, bc.RightArmColor3 = cfg.torso, cfg.arms, cfg.arms
	bc.LeftLegColor3, bc.RightLegColor3 = cfg.legs, cfg.legs
	K.add(function()
		if made then bc:Destroy() else for k, v in pairs(old) do bc[k] = v end end
		for _, o in ipairs(cloth) do o.Parent = c end
		if face then face.Transparency = 0 end
	end)
end

local function feet(c)
	local r = {}
	for _, n in ipairs({"LeftFoot", "RightFoot"}) do
		local p = c:FindFirstChild(n); if p then r[#r + 1] = {p = p, h = p.Size.Y, y = 0} end
	end
	if #r == 0 then
		for _, n in ipairs({"Left Leg", "Right Leg"}) do
			local p = c:FindFirstChild(n); if p then r[#r + 1] = {p = p, h = 0.8, y = -(p.Size.Y / 2 - 0.4)} end
		end
	end
	return r
end

-- raio da mira
local function aim(K, dist)
	local r = mouse.UnitRay
	local res = Workspace:Raycast(r.Origin, r.Direction * (dist or 250), K.rp)
	return res, res and res.Position or (r.Origin + r.Direction * 80)
end

------------------------------------------------------------------ efeitos de mundo
local function bolt(a, b, col)
	local n = math.clamp(math.floor((b - a).Magnitude / 3.5), 6, 20)
	local pts = {a}
	for i = 1, n - 1 do pts[#pts + 1] = a + (b - a) * (i / n) + Vector3.new(rnd(-1, 1), rnd(-1, 1), rnd(-1, 1)) * 1.3 end
	pts[#pts + 1] = b
	local f = new("Folder", {}, junk)
	local function seg(p1, p2, th, c, tr)
		local s = wpart(Vector3.new((p2 - p1).Magnitude, th, th), c, M.Neon, {Shape = Enum.PartType.Cylinder, CFrame = dirCF(p1, p2), Transparency = tr, Parent = f})
		tw(s, 0.35, {Transparency = 1, Size = Vector3.new(s.Size.X, th * 0.3, th * 0.3)})
	end
	for i = 1, #pts - 1 do seg(pts[i], pts[i + 1], 0.38, col, 0.4); seg(pts[i], pts[i + 1], 0.12, WHT, 0) end
	for _ = 1, 2 do
		local q = pts[math.random(2, #pts - 1)]
		for _ = 1, 3 do local nq = q + Vector3.new(rnd(-3, 3), rnd(-3, 3), rnd(-3, 3)); seg(q, nq, 0.14, col, 0.3); q = nq end
	end
	local e = wpart(Vector3.one * 0.5, col, M.Neon, {Transparency = 1, Position = b, Parent = f})
	local l = new("PointLight", {Color = col, Range = 26, Brightness = 6}, e); tw(l, 0.35, {Brightness = 0})
	new("ParticleEmitter", {Speed = NumberRange.new(20, 40), SpreadAngle = Vector2.new(180, 180), Lifetime = NumberRange.new(0.3, 0.5),
		Size = NumberSequence.new(0.5, 0), LightEmission = 1, Color = ColorSequence.new(col), Rate = 0}, e):Emit(24)
	Debris:AddItem(f, 0.7)
	shake(0.25)
end

local sprayF
local sprays = {}
local function doSpray(K, mode, text)
	if os.clock() - K.last < 0.4 then return end
	K.last = os.clock()
	local res = aim(K, 220)
	K.hue = (K.hue + 0.13) % 1
	local col = Color3.fromHSV(K.hue, 0.85, 1)
	if K.label then tw(K.label, 0.3, {Color = col}) end
	if K.mist then K.mist.Color = ColorSequence.new(col); K.mist:Emit(28) end
	if not res then return end
	if not sprayF or not sprayF.Parent then sprayF = new("Folder", {Name = "AngelSprays"}, Workspace) end
	local n, pos = res.Normal, res.Position
	local up = math.abs(n.Y) > 0.9 and Vector3.zAxis or Vector3.yAxis
	local base = CFrame.lookAt(pos + n * 0.03, pos + n * 1.03, up)
	K.rp.FilterDescendantsInstances = {K.c, sprayF}
	local function reg(i) sprays[#sprays + 1] = i; if #sprays > 100 then local o = table.remove(sprays, 1); if o and o.Parent then o:Destroy() end end end
	local mp = wpart(Vector3.one * 0.2, col, M.Neon, {Transparency = 1, Position = pos + n * 0.4, Parent = sprayF})
	new("ParticleEmitter", {Color = ColorSequence.new(col), Rate = 0, Lifetime = NumberRange.new(0.4, 0.7), Speed = NumberRange.new(3, 7),
		SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new(0.3, 1.6), Transparency = NumberSequence.new(0.3, 1), LightEmission = 0.4}, mp):Emit(16)
	Debris:AddItem(mp, 1)
	local function drips(spread, count)
		if math.abs(n.Y) > 0.6 then return end
		for _ = 1, count do
			local x, L = rnd(-spread, spread), rnd(0.8, 2.4)
			local d = wpart(Vector3.new(0.12, 0.05, 0.04), col, M.Neon, {CFrame = base * CFrame.new(x, -0.4, 0), Parent = sprayF}); reg(d)
			task.delay(rnd(0.3, 0.9), function()
				if d.Parent then tw(d, rnd(1.2, 2.4), {Size = Vector3.new(0.12, L, 0.04), CFrame = base * CFrame.new(x, -0.4 - L / 2, 0)}, Enum.EasingStyle.Quad) end
			end)
		end
	end
	if mode == "splat" then
		for i = 1, 9 do
			local s = i == 1 and rnd(3, 4.5) or rnd(0.3, 1.2)
			local off = i == 1 and Vector3.zero or Vector3.new(rnd(-2, 2), rnd(-2, 2), 0)
			local d = wpart(Vector3.new(0.04, 0.2, 0.2), col, M.Neon, {CFrame = base * CFrame.new(off.X, off.Y, -i * 0.003) * CFrame.Angles(0, math.pi / 2, 0), Shape = Enum.PartType.Cylinder, Parent = sprayF})
			reg(d); tw(d, 0.3, {Size = Vector3.new(0.04, s, s)}, Enum.EasingStyle.Back)
		end
		drips(1.6, 3)
	else
		local sz = mode == "heart" and Vector3.new(2.8, 2.8, 0.05) or Vector3.new(5.4, 1.9, 0.05)
		local p = wpart(Vector3.new(0.2, 0.1, 0.05), col, nil, {Transparency = 1, CFrame = base, Parent = sprayF}); reg(p)
		local sg = new("SurfaceGui", {Face = Enum.NormalId.Front, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 60, LightInfluence = 0}, p)
		local l = new("TextLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = text, Font = Enum.Font.PermanentMarker,
			TextScaled = true, TextColor3 = col, TextTransparency = 0.7, Rotation = -5}, sg)
		new("UIStroke", {Thickness = 2.5, Color = BLK}, l)
		tw(p, 0.35, {Size = sz}, Enum.EasingStyle.Back); tw(l, 0.35, {TextTransparency = 0})
		drips(sz.X * 0.35, 3)
	end
end

local function webSplat(pos, n)
	local m = new("Model", {}, junk)
	local up = math.abs(n.Y) > 0.9 and Vector3.zAxis or Vector3.yAxis
	local cf = CFrame.lookAt(pos + n * 0.05, pos + n * 1.05, up)
	local function rod(a, b, th) wpart(Vector3.new((b - a).Magnitude, th, th), rgb(250, 250, 255), M.SmoothPlastic, {Shape = Enum.PartType.Cylinder, CFrame = dirCF(a, b), Transparency = 0.1, Parent = m}) end
	local function at(a, r) return (cf * CFrame.new(math.cos(a) * r, math.sin(a) * r, 0)).Position end
	for i = 1, 8 do
		local a, a2 = i / 8 * math.pi * 2, (i % 8 + 1) / 8 * math.pi * 2
		rod(pos + n * 0.05, at(a, 1.4), 0.04); rod(at(a, 0.7), at(a2, 0.7), 0.03); rod(at(a, 1.1), at(a2, 1.1), 0.025)
	end
	return m
end

