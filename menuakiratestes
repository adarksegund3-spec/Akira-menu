    State.uiNames, State.uiTags = {}, {}
    for _, u in ipairs(UIL) do
        State.uiNames[#State.uiNames + 1] = u.name
        State.uiTags[u.name] = u.tag
    end

    -- ───────── troca de interface ─────────
    local function snapshot()
        local set = {}
        for _, root in ipairs(guiRoots()) do
            local ok, ch = pcall(function() return root:GetChildren() end)
            if ok then for _, c in ipairs(ch) do set[c] = true end end
        end
        return set
    end
    local function newGuis(before)
        local out = {}
        for _, root in ipairs(guiRoots()) do
            local ok, ch = pcall(function() return root:GetChildren() end)
            if ok then
                for _, c in ipairs(ch) do
                    if not before[c] and c:IsA("ScreenGui") and c ~= ScreenGui and c ~= ToastGui then
                        out[#out + 1] = c
                    end
                end
            end
        end
        return out
    end
    local function destroyExt()
        for _, d in ipairs(ext.destroyers) do pcall(d) end
        for _, g in ipairs(ext.gui) do pcall(function() g:Destroy() end) end
        ext.gui, ext.destroyers, ext.hidden = {}, {}, false
    end
    local function syncNative()   -- devolve ao menu original os estados mexidos na outra UI
        for _, list in pairs(State.spec) do
            for _, it in ipairs(list) do
                if it.k == "toggle" and it.btn and State.toggleSet and State.toggleSet[it.btn] then
                    pcall(State.toggleSet[it.btn], it.state)
                elseif it.k == "slider" and it.frame and State.sliderSet and State.sliderSet[it.frame] then
                    pcall(State.sliderSet[it.frame], it.val)
                end
            end
        end
    end

    State.destroyExt = destroyExt
    State.extToggle = function()
        ext.hidden = not ext.hidden
        for _, g in ipairs(ext.gui) do pcall(function() g.Enabled = not ext.hidden end) end
    end

    State.uiSwitch = function(name)
        if busy or name == curUI then return end
        local entry
        for _, u in ipairs(UIL) do if u.name == name then entry = u end end
        if not entry then return end
        busy = true
        task.spawn(function()
            destroyExt()
            if name == NATIVE then
                syncNative()
                Home.Visible = true
                State.extActive = false
                curUI = NATIVE
                showToast("Interface: " .. NATIVE, "info")
            else
                showToast("Carregando " .. name .. "...", "info")
                local before = snapshot()
                local ok, err = pcall(entry.build, buildTabs(name))
                task.wait(0.3)
                ext.gui = newGuis(before)
                if ok and #ext.gui > 0 then
                    Home.Visible = false
                    State.extActive = true
                    curUI = name
                    showToast("✓ " .. name .. " (use o botão flutuante para ocultar/mostrar)", "success")
                else
                    warn("[AKZ HUB] UI " .. name .. ": " .. tostring(ok and "janela não apareceu" or err))
                    destroyExt()
                    Home.Visible = true
                    State.extActive = false
                    curUI = NATIVE
                    showToast("⚠ " .. name .. " falhou — voltando ao AKZ HUB", "error")
                end
            end
            if State.uiLabel then State.uiLabel(curUI) end
            busy = false
        end)
    end
end

