local HttpService = game:GetService("HttpService")
local IDS_FOLDER = "AngelAnimId"
local IDS_FILE = IDS_FOLDER .. "/ids.json"
local canFS = (writefile and readfile and isfile and makefolder and isfolder) and true or false

local savedIds = {}
local testTrack, testConn = nil, nil
local testToken = 0
local testPlaying = false
local loopOn = true
local PRIOS = { "Core", "Idle", "Movement", "Action", "Action2", "Action3", "Action4" }
local prioIndex = 7

local function normalizeId(text)
    local digits = tostring(text or ""):match("%d+")
    if not digits or #digits < 3 then return nil end
    return "rbxassetid://" .. digits
end

local function saveIdsToDisk()
    if not canFS then return end
    pcall(function()
        if not isfolder(IDS_FOLDER) then makefolder(IDS_FOLDER) end
        writefile(IDS_FILE, HttpService:JSONEncode(savedIds))
    end)
end

local function loadIdsFromDisk()
    if not canFS then return end
    pcall(function()
        if isfile(IDS_FILE) then
            local data = HttpService:JSONDecode(readfile(IDS_FILE))
            if type(data) == "table" then
                for _, e in ipairs(data) do
                    if type(e) == "table" and type(e.id) == "string" then
                        table.insert(savedIds, { id = e.id, ok = e.ok, len = e.len })
                    end
                end
            end
        end
    end)
end

local refreshIdList
refreshIdList = function()
    for _, ch in ipairs(IdList:GetChildren()) do
        if ch:IsA("Frame") or ch:IsA("TextLabel") then ch:Destroy() end
    end
    if #savedIds == 0 then
        new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Font = Enum.Font.Gotham,
            Text = "Nenhum ID gravado ainda", TextColor3 = C.TextDim, TextSize = 10,
        }, IdList)
        return
    end
    for i, e in ipairs(savedIds) do
        local icon = "⚪"
        if e.ok == true then icon = "✅" elseif e.ok == false then icon = "❌" end
        local digits = e.id:match("%d+") or e.id
        local lenText = e.len and string.format("  %.1fs", e.len) or ""

        local row = new("Frame", {
            Size = UDim2.new(1, -4, 0, 28), BackgroundColor3 = C.Bg2,
            BorderSizePixel = 0, LayoutOrder = i,
        }, IdList)
        corner(row, 7)

        local main = new("TextButton", {
            Size = UDim2.new(1, -34, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.Code,
            Text = icon .. " " .. digits .. lenText, TextColor3 = C.Text, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
            AutoButtonColor = false,
        }, row)
        new("UIPadding", { PaddingLeft = UDim.new(0, 8) }, main)
        track(main.MouseButton1Click:Connect(function()
            IdBox.Text = e.id
            testStatus("ID carregado na caixa", nil)
        end))

        local del = new("TextButton", {
            Size = UDim2.new(0, 26, 0, 22), Position = UDim2.new(1, -30, 0.5, -11),
            BackgroundColor3 = Color3.fromRGB(125, 38, 50), Font = Enum.Font.GothamBold,
            Text = "🗑️", TextSize = 11, BorderSizePixel = 0, AutoButtonColor = true,
        }, row)
        corner(del, 6)
        track(del.MouseButton1Click:Connect(function()
            for idx, item in ipairs(savedIds) do
                if item == e then table.remove(savedIds, idx) break end
            end
            saveIdsToDisk()
            refreshIdList()
        end))
    end
end

local function markResult(id, ok, len)
    for _, e in ipairs(savedIds) do
        if e.id == id then
            e.ok = ok
            if len then e.len = len end
        end
    end
    saveIdsToDisk()
    refreshIdList()
end

local function stopTest()
    testToken = testToken + 1
    if testConn then testConn:Disconnect() testConn = nil end
    if testTrack then
        pcall(function() testTrack:Stop(0.1) end)
        testTrack = nil
    end
    testPlaying = false
    PlayBtn.Text = "▶️ Reproduzir"
    PlayBtn.BackgroundColor3 = C.Blue
end

local function playTest()
    local id = normalizeId(IdBox.Text)
    if not id then testStatus("ID invalido (cole so os numeros)", "warn") return end
    IdBox.Text = id

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local animator = hum and getAnimator(hum)
    if not animator then testStatus("Personagem sem Animator", "warn") return end

    stopTest()
    testPlaying = true
    local myToken = testToken
    PlayBtn.Text = "🛑 Parar"
    PlayBtn.BackgroundColor3 = C.Red
    testStatus("Carregando...", "play")

    task.spawn(function()
        local anim = Instance.new("Animation")
        anim.AnimationId = id
        local ok, tr = pcall(function() return animator:LoadAnimation(anim) end)
        if myToken ~= testToken then return end
        if not ok or not tr then
            stopTest()
            testStatus("Falhou: nao foi possivel carregar", "warn")
            markResult(id, false)
            return
        end

        testTrack = tr
        tr.Priority = Enum.AnimationPriority[PRIOS[prioIndex]]
        tr.Looped = loopOn
        tr:Play(0.1)

        local t0 = os.clock()
        while tr.Length == 0 and os.clock() - t0 < 3 do task.wait(0.1) end
        if myToken ~= testToken then return end

        if tr.Length == 0 then
            stopTest()
            testStatus("Falhou: ID invalido ou sem acesso", "warn")
            markResult(id, false)
            return
        end

        testStatus(string.format("Funcionando | %.2fs | %s", tr.Length, PRIOS[prioIndex]), "ok")
        markResult(id, true, tr.Length)

        testConn = tr.Stopped:Connect(function()
            if myToken == testToken then
                stopTest()
                testStatus("Terminou (funcionou)", "ok")
            end
        end)
    end)
end

track(PlayBtn.MouseButton1Click:Connect(function()
    if testPlaying then
        stopTest()
        testStatus("Parado", nil)
    else
        playTest()
    end
end))

track(SaveIdBtn.MouseButton1Click:Connect(function()
    local id = normalizeId(IdBox.Text)
