local function mountGui(gui)
    local parent
    if API.gethui then
        local ok, h = pcall(API.gethui)
        if ok and h then parent = h end
    end
    parent = parent or CoreGui
    local ok = pcall(function() gui.Parent = parent end)
    if not ok or not gui.Parent then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
end

local MENU_W, MENU_H = 440, 320
local LOGO = 56

function UI.clampMenu()
    local m = UI.menu
    if not m then return end
    local vp = cam().ViewportSize
    local x = math.clamp(m.Position.X.Offset, 0, math.max(vp.X - m.AbsoluteSize.X, 0))
    local y = math.clamp(m.Position.Y.Offset, 0, math.max(vp.Y - 60, 0))
    m.Position = UDim2.fromOffset(x, y)
end

function UI.clampLogo(save)
    local lg = UI.logo
    if not lg then return end
    local vp = cam().ViewportSize
    local x = math.clamp(lg.Position.X.Offset, 6, math.max(vp.X - LOGO - 6, 6))
    local y = math.clamp(lg.Position.Y.Offset, 6, math.max(vp.Y - LOGO - 6, 6))
    tween(lg, 0.18, { Position = UDim2.fromOffset(x, y) })
    if save then
        S.logoX, S.logoY = x / vp.X, y / vp.Y
        saveAll()
    end
end

function UI.toggleMenu(show)
    local m = UI.menu
    if show == nil then show = not m.Visible end
    if show then
        m.Visible = true
        UI.clampMenu()
        UI.scale.Scale = 0.9
        tween(UI.scale, 0.15, { Scale = 1 })
    else
        m.Visible = false
    end
end

