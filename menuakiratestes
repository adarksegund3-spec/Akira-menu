local function setMenuTransparent(on)
    Config.MenuTransparent = on
    if on then
        for _, d in ipairs(menuFrame:GetDescendants()) do
            if d:IsA("GuiObject") then
                if d:GetAttribute("AKZ_OrigBT") == nil then
                    d:SetAttribute("AKZ_OrigBT", d.BackgroundTransparency)
                end
                local orig = d:GetAttribute("AKZ_OrigBT") or 0
                if orig < 0.85 then
                    d.BackgroundTransparency = math.min(0.75, orig + 0.4)
                end
            end
        end
        menuFrame.BackgroundTransparency = 0.4
    else
        for _, d in ipairs(menuFrame:GetDescendants()) do
            if d:IsA("GuiObject") then
                local orig = d:GetAttribute("AKZ_OrigBT")
                if orig then
                    d.BackgroundTransparency = orig
                    d:SetAttribute("AKZ_OrigBT", nil)
                end
            end
        end
        menuFrame.BackgroundTransparency = 0
    end
end

