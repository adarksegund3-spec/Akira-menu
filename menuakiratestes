	Aurora     = {clock = 1.2, col = Color3.fromRGB(90, 255, 200), decay = Color3.fromRGB(150, 80, 255), dens = 0.32, haze = 1.6, glare = 0.3, amb = Color3.fromRGB(70, 130, 140), bright = 1.4, stars = 8000},
	Neblina    = {clock = 7.5, col = Color3.fromRGB(205, 212, 225), decay = Color3.fromRGB(170, 180, 200), dens = 0.62, haze = 4.5, glare = 0, amb = Color3.fromRGB(140, 145, 160), bright = 1.8, stars = 0},
}
defineFeature("sky", function(f)
	local saved = {clock = Lighting.ClockTime, bright = Lighting.Brightness, amb = Lighting.Ambient, out = Lighting.OutdoorAmbient}
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	local ownAtm = false
	if not atm then atm = new("Atmosphere", {}, Lighting); ownAtm = true end
	local sa = {Color = atm.Color, Decay = atm.Decay, Density = atm.Density, Haze = atm.Haze, Glare = atm.Glare}
	local sky = Lighting:FindFirstChildOfClass("Sky")
	local ownSky = false
	if not sky then sky = new("Sky", {}, Lighting); ownSky = true end
	local sstars = sky.StarCount
	local function apply()
		local p = SKY[Config.sky] or SKY.Amanhecer
		Lighting.ClockTime = p.clock; Lighting.Brightness = p.bright
		Lighting.Ambient = p.amb; Lighting.OutdoorAmbient = p.amb
		atm.Color = p.col; atm.Decay = p.decay; atm.Density = p.dens; atm.Haze = p.haze; atm.Glare = p.glare
		sky.StarCount = p.stars
	end
	f.reapply = apply
	apply()
	f.x(function()
		Lighting.ClockTime = saved.clock; Lighting.Brightness = saved.bright
		Lighting.Ambient = saved.amb; Lighting.OutdoorAmbient = saved.out
		if ownAtm then atm:Destroy() else
			atm.Color = sa.Color; atm.Decay = sa.Decay; atm.Density = sa.Density; atm.Haze = sa.Haze; atm.Glare = sa.Glare
		end
		if ownSky then sky:Destroy() else sky.StarCount = sstars end
	end)
end)

