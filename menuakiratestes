local C = {
    bg = Color3.fromRGB(18, 18, 24), panel = Color3.fromRGB(28, 28, 38),
    green = Color3.fromRGB(34, 197, 94), red = Color3.fromRGB(239, 68, 68),
    redDark = Color3.fromRGB(153, 27, 27), blue = Color3.fromRGB(59, 130, 246),
    cyan = Color3.fromRGB(34, 211, 238), gray = Color3.fromRGB(52, 52, 68),
    text = Color3.fromRGB(237, 237, 245), muted = Color3.fromRGB(150, 150, 170),
}

local function new(class, props, parent)
    local o = Instance.new(class)
    if props then for k, v in pairs(props) do o[k] = v end end
    if parent then o.Parent = parent end
    return o
end
local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
local function stroke(o, color, alpha, th)
    return new("UIStroke", { Color = color, Transparency = alpha, Thickness = th or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
local function tween(o, t, props)
    local tw = TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end
local function label(parent, text, size, pos, font, ts, color, align)
    return new("TextLabel", { Text = text, Size = size, Position = pos or UDim2.new(), BackgroundTransparency = 1,
        Font = font or Enum.Font.Gotham, TextSize = ts or 12, TextColor3 = color or C.text,
        TextXAlignment = align or Enum.TextXAlignment.Left, BorderSizePixel = 0 }, parent)
end
local function makeButton(parent, text, pos, color)
    local b = new("TextButton", { Text = text, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = C.text,
        BackgroundColor3 = color, AutoButtonColor = false, Size = UDim2.new(1, -20, 0, 36), Position = pos,
        BorderSizePixel = 0 }, parent)
    b:SetAttribute("Base", color)
    corner(b, 10)
    b.MouseEnter:Connect(function() tween(b, 0.12, { BackgroundColor3 = b:GetAttribute("Base"):Lerp(Color3.new(1, 1, 1), 0.14) }) end)
    b.MouseLeave:Connect(function() tween(b, 0.12, { BackgroundColor3 = b:GetAttribute("Base") }) end)
    return b
end
local function setBase(b, color)
    b:SetAttribute("Base", color)
    tween(b, 0.2, { BackgroundColor3 = color })
end

local Conns = {}
local function track(c) Conns[#Conns + 1] = c return c end

