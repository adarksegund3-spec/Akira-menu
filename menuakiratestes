-- Botão flutuante
local floatingBtn = nil

function abrirBotaoFlutuante()
    if floatingBtn and floatingBtn.Parent then
        floatingBtn.Visible = true
        return
    end

    floatingBtn = Instance.new("TextButton")
    floatingBtn.AnchorPoint = Vector2.new(0.5, 0.5)
    floatingBtn.Size = UDim2.new(0, 150, 0, 52)
    floatingBtn.Position = UDim2.new(0.5, 0, 0.85, 0)
    floatingBtn.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    floatingBtn.BorderSizePixel = 0
    floatingBtn.Text = "INICIAR"
    floatingBtn.Font = Enum.Font.GothamBlack
    floatingBtn.TextSize = 17
    floatingBtn.TextColor3 = Accent
    floatingBtn.AutoButtonColor = false
    floatingBtn.Active = true
    floatingBtn.ZIndex = 50
    floatingBtn.Parent = screenGui

    Instance.new("UICorner", floatingBtn).CornerRadius = UDim.new(0, 14)
    local st = Instance.new("UIStroke", floatingBtn)
    st.Color = Accent
    st.Thickness = 2
    st.Transparency = 0.1

    local dragging = false
    local dragStart, startPos, moved = nil, nil, false

    floatingBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = floatingBtn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if not moved then
                        if not posicaoSalva then
                            floatingBtn.Text = "✗ SEM POSIÇÃO"
                            floatingBtn.TextColor3 = DANGER
                            task.delay(1.5, function()
                                if floatingBtn and floatingBtn.Parent then
                                    floatingBtn.Text = "INICIAR"
                                    floatingBtn.TextColor3 = Accent
                                end
                            end)
                            return
                        end

                        if andandoAtivo then
                            pararMovimento()
                            floatingBtn.Text = "PARADO"
                            floatingBtn.TextColor3 = WARN
                            task.delay(1, function()
                                if floatingBtn and floatingBtn.Parent then
                                    floatingBtn.Text = "INICIAR"
                                    floatingBtn.TextColor3 = Accent
                                end
                            end)
                        else
                            comecarCaminhada()
                            floatingBtn.Text = "ANDANDO..."
                            floatingBtn.TextColor3 = SUCCESS
                            task.spawn(function()
                                while andandoAtivo and floatingBtn and floatingBtn.Parent do
                                    task.wait(0.2)
                                end
                                if floatingBtn and floatingBtn.Parent then
                                    floatingBtn.Text = "INICIAR"
                                    floatingBtn.TextColor3 = Accent
                                end
                            end)
                        end
                    end
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then moved = true end
            floatingBtn.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

