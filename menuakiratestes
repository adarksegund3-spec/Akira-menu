local logoDrag = {
    active = false,
    moved = false,
    startPos = nil,
    startInput = nil,
}

logo.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        logoDrag.active = true
        logoDrag.moved = false
        logoDrag.startInput = input.Position
        logoDrag.startPos = logo.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not logoDrag.active then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - logoDrag.startInput
        if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
            logoDrag.moved = true
        end
        logo.Position = UDim2.new(
            logoDrag.startPos.X.Scale,
            logoDrag.startPos.X.Offset + delta.X,
            logoDrag.startPos.Y.Scale,
            logoDrag.startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if not logoDrag.active then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        logoDrag.active = false
        if not logoDrag.moved then
            -- Foi clique simples: abre/fecha menu
            if isOpen then closeMenu() else openMenu() end
        end
    end
end)

