task.spawn(function()
	while alive do
		task.wait(0.5)
		local txt
		if Recorder.active and Recorder.session then
			local s = Recorder.session
			local hum = getChar()
			txt = string.format("● GRAVANDO\nTempo: %s • Eventos: %d\nEstado: %s • Velocidade: %s", fmt(os.clock() - s.t0),
				#s.events, hum and hum:GetState().Name or "-", hum and tostring(r1(hum.WalkSpeed)) or "-")
		else
			txt = "Pronto para gravar."
		end
		if txt ~= lastTxt.rec then
			lastTxt.rec = txt
			pcall(function() recPara:Set({ Title = "Estado", Content = txt }) end)
		end
		local pt
		local c = Playback.ctx
		if c then
			local head = Playback.state == "paused" and "⏸ PAUSADO" or ((c.wait and "⏳ AGUARDANDO") or "▶ REPRODUZINDO")
			pt = string.format("%s\n%s / %s • %sx\nExecutadas: %d • Falhas: %d", head, fmt(c.t), fmt(c.dur),
				tostring(Playback.speed), c.ok, c.fail)
		else
			pt = "Parado."
		end
		if pt ~= lastTxt.pb then
			lastTxt.pb = pt
			pcall(function() pbPara:Set({ Title = "Estado", Content = pt }) end)
		end
		if Playback.summary ~= lastTxt.sum then
			lastTxt.sum = Playback.summary
			pcall(function() sumPara:Set({ Title = "Resumo da última reprodução", Content = Playback.summary }) end)
		end
	end
end)

