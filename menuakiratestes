TabHistory:CreateSection("Suas Rotas")

local lblTotal = TabHistory:CreateLabel("0 rotas")
local dropdownRoutes
local lblDetails

local currentFilter = ""
local currentSort = "Data"

local function buildOptions()
    local opts = {}
    for _, r in ipairs(Store.routes) do
        if currentFilter == "" or r.name:lower():find(currentFilter:lower(), 1, true) then
            table.insert(opts, r.name)
        end
    end
    if currentSort == "Data" then
        table.sort(opts, function(a, b)
            local ra, rb
            for _, r in ipairs(Store.routes) do
                if r.name == a then ra = r end
                if r.name == b then rb = r end
            end
            return (ra and ra.createdAt or 0) > (rb and rb.createdAt or 0)
        end)
    else
        table.sort(opts)
    end
    return opts
end

function refreshHistoryList()
    dropdownRoutes:Refresh(buildOptions())
    lblTotal:Set(#Store.routes .. " rotas totais")
end

