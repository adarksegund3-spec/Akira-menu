local function getAimPart(char)
    if not char then return nil end
    if Config.AimbotPart == "Head" then
        return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    else
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
            or char:FindFirstChild("HumanoidRootPart")
    end
end

local function wallBetween(fromPos, toPos, targetChar)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filters = { LocalPlayer.Character, Camera }
    if targetChar then table.insert(filters, targetChar) end
    params.FilterDescendantsInstances = filters
    local result = workspace:Raycast(fromPos, toPos - fromPos, params)
    return result and result.Instance ~= nil
end

local function findTarget()
    local centro = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    -- Mantém lock
    if Config.LockedTarget and Config.LockedTarget.Parent then
        local part = Config.LockedTarget
        local char = part.Parent
        local p = Players:GetPlayerFromCharacter(char)
        if p and char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and not (Config.AimbotTeamCheck and isAlly(p)) then
                local sp, on = Camera:WorldToViewportPoint(part.Position)
                if on and (Vector2.new(sp.X, sp.Y) - centro).Magnitude <= Config.AimbotFOV * 1.8 then
                    return part
                end
            end
        end
        Config.LockedTarget = nil
    end

    -- Novo alvo
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if not (Config.AimbotTeamCheck and isAlly(p)) then
                local char = p.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local part = getAimPart(char)
                        if part then
                            local sp, on = Camera:WorldToViewportPoint(part.Position)
                            if on then
                                local d = (Vector2.new(sp.X, sp.Y) - centro).Magnitude
                                if d <= Config.AimbotFOV and d < bestDist then
                                    if Config.AimbotWallCheck then
                                        if not wallBetween(Camera.CFrame.Position, part.Position, char) then
                                            best = part
                                            bestDist = d
                                        end
                                    else
                                        best = part
                                        bestDist = d
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    Config.LockedTarget = best
    return best
end

local function lockOn(part)
    if not part or not part.Parent then return end
    local camPos = Camera.CFrame.Position
    local dir = part.Position - camPos
    if dir.Magnitude < 0.01 then return end
    local targetCF = CFrame.lookAt(camPos, camPos + dir.Unit)
    if Config.AimbotSmooth <= 0.01 then
        Camera.CFrame = targetCF
    else
        local alpha = math.clamp(1 - Config.AimbotSmooth, 0.05, 1)
        Camera.CFrame = Camera.CFrame:Lerp(targetCF, alpha)
    end
end

