            if Bridge.main then
                if not Bridge.main.Parent then
                    Bridge.forget()
                    task.defer(showPage, "arceus")
                else
                    Bridge.main.Visible = true
                end
            else
                Bridge.scan(false)
                if Bridge.pick() then task.defer(showPage, "arceus") end
            end
        end
    end
end


