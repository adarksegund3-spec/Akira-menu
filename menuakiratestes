local function spImage(images, want) -- menor imagem com pelo menos 'want' px
	if type(images) ~= "table" then return nil end
	local best, bw, last
	each(images, function(im)
		if type(im.url) == "string" then
			last = im.url
			local w = tonumber(im.width) or 0
			if w >= want and (not bw or w < bw) then best, bw = im.url, w end
		end
	end)
	return best or last
end
local function spTrack(t, art)
	if type(t) ~= "table" or not t.id or type(t.uri) ~= "string" then return nil end
	local names = {}
	each(t.artists, function(a) table.insert(names, tostring(a.name or "")) end)
	local alb = type(t.album) == "table" and t.album or {}
	return {
		id = tostring(t.id), uri = t.uri, title = tostring(t.name or "Sem título"),
		artist = #names > 0 and table.concat(names, ", ") or "Desconhecido",
		duration = (tonumber(t.duration_ms) or 0) / 1000, art = spImage(alb.images, 64) or art,
		streamable = t.is_playable ~= false, source = "spotify",
	}
end
-- Texto: normalização, similaridade e filtro (só fica o que tem a frase ou algo parecido)
local Txt = {}
local ACC = {
	["á"]="a",["à"]="a",["â"]="a",["ã"]="a",["ä"]="a",["Á"]="a",["À"]="a",["Â"]="a",["Ã"]="a",["Ä"]="a",
	["é"]="e",["è"]="e",["ê"]="e",["ë"]="e",["É"]="e",["È"]="e",["Ê"]="e",["Ë"]="e",
	["í"]="i",["ì"]="i",["î"]="i",["ï"]="i",["Í"]="i",["Ì"]="i",["Î"]="i",["Ï"]="i",
	["ó"]="o",["ò"]="o",["ô"]="o",["õ"]="o",["ö"]="o",["Ó"]="o",["Ò"]="o",["Ô"]="o",["Õ"]="o",["Ö"]="o",
	["ú"]="u",["ù"]="u",["û"]="u",["ü"]="u",["Ú"]="u",["Ù"]="u",["Û"]="u",["Ü"]="u",
	["ç"]="c",["Ç"]="c",["ñ"]="n",["Ñ"]="n",
}
function Txt.norm(str)
	str = tostring(str or ""):gsub("[\192-\255][\128-\191]*", function(ch) return ACC[ch] or ch end)
	str = str:lower():gsub("[^%w\128-\255]+", " ")
	return (str:gsub("^%s+", ""):gsub("%s+$", ""))
end
function Txt.words(str)
	local out = {}
	for w in str:gmatch("%S+") do table.insert(out, w) end
	return out
end
function Txt.lev(a, b, maxd)
	local la, lb = #a, #b
	if math.abs(la - lb) > maxd then return maxd + 1 end
	local prev = {}
	for j = 0, lb do prev[j] = j end
	for i = 1, la do
		local cur = { [0] = i }
		local rowmin = i
		for j = 1, lb do
			local cost = a:byte(i) == b:byte(j) and 0 or 1
			local v = math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
			cur[j] = v
			if v < rowmin then rowmin = v end
		end
		if rowmin > maxd then return maxd + 1 end
		prev = cur
	end
	return prev[lb]
end
-- 0 = não combina; maior = mais parecido
function Txt.score(query, hayRaw, primaryRaw)
	local qn = Txt.norm(query)
	if qn == "" then return 1 end
	local h = Txt.norm(hayRaw)
	local pr = Txt.norm(primaryRaw or hayRaw)
	if pr == qn then return 120 end
	if pr:sub(1, #qn) == qn then return 110 end
	if h:find(qn, 1, true) then return 100 end
	local hw = Txt.words(h)
	local total, fuzzy = 0, false
	for _, t in ipairs(Txt.words(qn)) do
		local hit = false
		if #t <= 2 then
			for _, w in ipairs(hw) do if w:sub(1, #t) == t then hit = true break end end
		else
			hit = h:find(t, 1, true) ~= nil
		end
		if hit then
			total += 1
		else
			local k = #t >= 7 and 2 or (#t >= 4 and 1 or 0)
			local ok = false
			if k > 0 then
				for _, w in ipairs(hw) do if Txt.lev(t, w, k) <= k then ok = true break end end
			end
			if not ok then return 0 end
			fuzzy = true; total += 0.6
		end
	end
	return (fuzzy and 55 or 85) + total
end
function Txt.filter(list, query, hayFn, primFn)
	local arr = {}
	for i, it in ipairs(list or {}) do
		local sc = Txt.score(query, hayFn(it), primFn and primFn(it) or nil)
		if sc > 0 then table.insert(arr, { it = it, sc = sc, i = i }) end
	end
	table.sort(arr, function(x, y) if x.sc ~= y.sc then return x.sc > y.sc end return x.i < y.i end)
	local out = {}
	for _, e in ipairs(arr) do table.insert(out, e.it) end
	return out
end

local function cached(key, fn)
	local c = Api.cache[key]
	if c and os.clock() - c.t < CFG.SEARCH_TTL then return c.v end
	local v, e = fn()
	if not v then return nil, e end
	Api.cache[key] = { t = os.clock(), v = v }
	return v
end
function Api.search(text)
	return cached("s:" .. text:lower(), function()
		local d, e = Sp.call("GET", "/v1/search", { q = text, type = "track,artist,playlist,album", limit = 10, market = CFG.MARKET })
		if type(d) ~= "table" then return nil, e or "INVALID" end
		local out = { tracks = {}, artists = {}, playlists = {}, albums = {} }
		each(type(d.tracks) == "table" and d.tracks.items, function(t)
			local n = spTrack(t)
			if n then table.insert(out.tracks, n) end
		end)
		each(type(d.artists) == "table" and d.artists.items, function(u)
			if u.id then
				table.insert(out.artists, { id = tostring(u.id), uri = tostring(u.uri or ""), name = tostring(u.name or "Cantor"), handle = "",
					followers = tonumber(type(u.followers) == "table" and u.followers.total) or 0 })
			end
		end)
		each(type(d.playlists) == "table" and d.playlists.items, function(x)
			if x.id then
				local cnt = (type(x.tracks) == "table" and tonumber(x.tracks.total)) or (type(x.items) == "table" and tonumber(x.items.total)) or 0
				table.insert(out.playlists, { id = tostring(x.id), uri = tostring(x.uri or ""), name = tostring(x.name or "Playlist"),
					owner = type(x.owner) == "table" and tostring(x.owner.display_name or "") or "", count = cnt, isAlbum = false, art = spImage(x.images, 64) })
			end
		end)
		each(type(d.albums) == "table" and d.albums.items, function(x)
			if x.id then
				local first = type(x.artists) == "table" and type(x.artists[1]) == "table" and x.artists[1] or {}
				table.insert(out.albums, { id = tostring(x.id), uri = tostring(x.uri or ""), name = tostring(x.name or "Álbum"),
					owner = tostring(first.name or ""), count = tonumber(x.total_tracks) or 0, isAlbum = true, art = spImage(x.images, 64) })
			end
		end)
		return out
	end)
end

-- Início: mais tocadas da sua conta (ou tocadas recentemente)
function Api.home()
	local out = {}
	local d, e = Sp.call("GET", "/v1/me/top/tracks", { limit = 20, time_range = "short_term" })
	if type(d) == "table" then
		each(d.items, function(t) local n = spTrack(t); if n then table.insert(out, n) end end)
	end
	if #out == 0 then
		local r, e2 = Sp.call("GET", "/v1/me/player/recently-played", { limit = 20 })
		if type(r) == "table" then
			local seen = {}
			each(r.items, function(it)
				local n = spTrack(it.track)
				if n and not seen[n.id] then seen[n.id] = true; table.insert(out, n) end
			end)
		else
			e = e or e2
		end
	end
	if #out == 0 and e then return nil, e end
	return out
end

function Api.artistTracks(u)
	local out = {}
	local d, e = Sp.call("GET", "/v1/artists/" .. HttpService:UrlEncode(u.id) .. "/top-tracks", { market = CFG.MARKET })
	if type(d) == "table" then
		each(d.tracks, function(t) local n = spTrack(t); if n then table.insert(out, n) end end)
		if #out > 0 then return out end
	end
	-- top-tracks é bloqueado em apps novos: usa a busca pelo nome do cantor
	local r, e2 = Sp.call("GET", "/v1/search", { q = "artist:\"" .. u.name .. "\"", type = "track", limit = 10, market = CFG.MARKET })
	if type(r) ~= "table" then return nil, e2 or e end
	each(type(r.tracks) == "table" and r.tracks.items, function(t)
		local mine = false
		each(t.artists, function(a) if a.id == u.id then mine = true end end)
		if mine then local n = spTrack(t); if n then table.insert(out, n) end end
	end)
	return out
end

function Api.playlistTracks(pl)
	local base = "/v1/playlists/" .. HttpService:UrlEncode(pl.id)
	local d, e = Sp.call("GET", base .. "/items", { limit = 50, market = CFG.MARKET })
	if type(d) ~= "table" then d, e = Sp.call("GET", base .. "/tracks", { limit = 50, market = CFG.MARKET }) end
	if type(d) ~= "table" then return nil, e end
	local out = {}
	each(d.items, function(it)
		local t = it.item or it.track
		if type(t) == "table" and t.type ~= "episode" then
			local n = spTrack(t)
			if n then table.insert(out, n) end
		end
	end)
	return out
end

function Api.albumTracks(al)
	local d, e = Sp.call("GET", "/v1/albums/" .. HttpService:UrlEncode(al.id) .. "/tracks", { limit = 50, market = CFG.MARKET })
	if type(d) ~= "table" then return nil, e end
	local out = {}
	each(d.items, function(t)
		local n = spTrack(t, al.art)
		if n then table.insert(out, n) end
	end)
	return out
end

