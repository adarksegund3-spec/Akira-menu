local function toggle(parent, label, get, set)
    local c = card(parent, 44)
    text(c, label, 15, nil, nil, { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -80, 1, 0) })
    local sw = mk("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(46, 24),
        Text = "", AutoButtonColor = false, BorderSizePixel = 0,
        BackgroundColor3 = get() and T.accent or C(60, 62, 75),
    }, c)
    corner(sw, 12)
    local knob = mk("Frame", {
        Size = UDim2.fromOffset(18, 18), AnchorPoint = Vector2.new(0, 0.5), BorderSizePixel = 0,
        Position = get() and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
        BackgroundColor3 = C(255, 255, 255),
    }, sw)
    corner(knob, 9)
    sw.Activated:Connect(function()
        local v = not get()
        set(v)
        tween(sw, 0.15, { BackgroundColor3 = v and T.accent or C(60, 62, 75) })
        tween(knob, 0.15, { Position = v and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) })
    end)
end

local function slider(parent, label, min, max, init, onChange)
    local c = card(parent, 58)
    text(c, label, 15, nil, nil, { Position = UDim2.fromOffset(12, 4), Size = UDim2.new(0.6, 0, 0, 22) })
    local val = text(c, "", 15, T.accent, T.boldFont, {
        Position = UDim2.new(0.5, 0, 0, 4), Size = UDim2.new(0.5, -12, 0, 22),
        TextXAlignment = Enum.TextXAlignment.Right })
    local track = mk("Frame", { Position = UDim2.new(0, 12, 0, 38), Size = UDim2.new(1, -24, 0, 8),
        BackgroundColor3 = T.line, BackgroundTransparency = 0.6, BorderSizePixel = 0, Active = true }, c)
    corner(track, 4)
    local fill = mk("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.accent, BorderSizePixel = 0 }, track)
    corner(fill, 4)
    local knob = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(18, 18),
        BackgroundColor3 = C(255, 255, 255), BorderSizePixel = 0 }, track)
    corner(knob, 9)
    stroke(knob, T.accent, 2, 0)

    local function setValue(v, silent)
        v = math.clamp(math.floor(v + 0.5), min, max)
        local a = (v - min) / (max - min)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        val.Text = tostring(v)
        if not silent then onChange(v) end
    end
    local function fromX(x)
        local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        setValue(min + a * (max - min))
    end
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            fromX(i.Position.X)
            Drag.update = function(p) fromX(p.X) end
            Drag.finish = nil
        end
    end)
    setValue(init, true)
    return setValue
end

