local function buildReport()
    local avg = diag.clicked > 0 and diag.lateSum / diag.clicked or 0
    local lines = {}
    table.insert(lines, string.format("AtividadesLOG %s | plat=%s | delay=%.2f limite=%s cabeca=%s metodo=M%d",
        VERSION, IS_MOBILE and "MOBILE" or (IS_CONSOLE and "CONSOLE" or "PC"), mode.delay,
        tostring(mode.limit), tostring(findHeadLabel() ~= nil), chainIdx))
    table.insert(lines, string.format(
        "vistas=%d clicadas=%d perdidas=%d clicadas_sem_contar=%d retestes=%d urgentes=%d | atraso medio=%.0fms max=%.0fms | vida minima=%s",
        diag.seen, diag.clicked, diag.missed, diagState.notCounted, diag.retries, diag.urgent,
        avg * 1000, diag.lateMax * 1000, diag.lifeMin and string.format("%.2fs", diag.lifeMin) or "-"))
    table.insert(lines, string.format("travadas de frame >0.25s: %d (maior %.2fs) | calibVida=%s calibCadencia=%s perigo=%s",
        diagState.stalls, diagState.stallMax,
        calibLife and string.format("%.2f", calibLife) or "-",
        calibCadence and string.format("%.2f", calibCadence) or "-",
        learnedDanger and string.format("%.2f", learnedDanger) or "-"))
    do
        local parts = {}
        for k, v in pairs(diagState.paths) do table.insert(parts, k .. "=" .. v) end
        table.sort(parts)
        table.insert(lines, "cliques por caminho: " .. (#parts > 0 and table.concat(parts, " ") or "nenhum"))
    end
    if #events == 0 then
        table.insert(lines, "(nenhuma bolha perdida registrada)")
    else
        for _, e in ipairs(events) do table.insert(lines, e) end
    end
    return table.concat(lines, "\n")
end

local function copyText(text)
    local done = false
    pcall(function() if setclipboard then setclipboard(text) done = true end end)
    if not done then pcall(function() if toclipboard then toclipboard(text) done = true end end) end
    if not done then pcall(function() if set_clipboard then set_clipboard(text) done = true end end) end
    if not done then pcall(function() if Clipboard and Clipboard.set then Clipboard.set(text) done = true end end) end
    return done
end

-- se o executor nao tiver clipboard, mostra o texto numa caixa para copiar na mao
