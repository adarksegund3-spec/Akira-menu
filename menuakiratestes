---------------------------------------------------------------- Arrastar a bolinha (distingue clique de arraste)
do
	local dragging, moved, dragInput, startInput, startPos = false, false, nil, nil, nil
	Maid.add(bubble.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, moved, dragInput = true, false, i
			startInput = i.Position; startPos = bubble.AbsolutePosition + bubble.AbsoluteSize / 2
		end
	end))
	Maid.add(UIS.InputChanged:Connect(function(i)
		if not dragging then return end
		local ok = (dragInput.UserInputType == Enum.UserInputType.Touch and i == dragInput)
			or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseMovement)
		if not ok then return end
		local d = Vector3.new(i.Position.X - startInput.X, i.Position.Y - startInput.Y, 0)
		if not moved and d.Magnitude < 8 then return end -- limiar de arraste
		moved = true
		local r = bubbleSize / 2
		local x = math.clamp(startPos.X + d.X, r, vp.X - r)
		local y = math.clamp(startPos.Y + d.Y, r, vp.Y - r)
		bubble.Position = UDim2.fromOffset(x, y)
	end))
	Maid.add(UIS.InputEnded:Connect(function(i)
		if not dragging then return end
		if i == dragInput or (i.UserInputType == Enum.UserInputType.MouseButton1 and dragInput.UserInputType == Enum.UserInputType.MouseButton1) then
			dragging = false
			if not moved then openWindow() end
		end
	end))
end

