-- ═══════════════════════════ HELPERS ═══════════════════════════
local function getPlayerTeam(player)
    local ok, team = pcall(function() return player.Team end)
    if ok and team then return team end
    return nil
end

local function isSameTeam(player)
    local myTeam = getPlayerTeam(LocalPlayer)
    local theirTeam = getPlayerTeam(player)
    if myTeam and theirTeam then return myTeam == theirTeam end
    return false
end

local function getCharacterPart(player, partName)
    local char = player and player.Character
    if not char then return nil end
    return char:FindFirstChild(partName)
end

