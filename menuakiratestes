-- Renderiza os scripts
local currentResults = {}
local debounceToken = 0

local function clearResults()
    for _, obj in ipairs(currentResults) do
        pcall(function() if obj and obj.Parent then obj:Destroy() end end)
    end
    currentResults = {}
end

local function renderScripts(scripts)
    clearResults()
    if not scripts or #scripts == 0 then
        resultsParagraph:Set("🔍 Nenhum script encontrado.", "Tente outro nome ou desative filtros.")
        return
    end
    resultsParagraph:Set(string.format("%d scripts encontrados", RScripts.State.total),
        "Página " .. RScripts.State.page .. " de " .. RScripts.State.totalPages)

    for _, s in ipairs(scripts) do
        local title = s.title or s.name or "Sem título"
        local desc  = (s.game and s.game.title) or "—"
        local tags = {}
        if s.isMobileReady then table.insert(tags, "📱") end
        if not s.isKeySystem then table.insert(tags, "🔑") end
        if not s.isPaid then table.insert(tags, "🆓") end
        local tagStr = table.concat(tags, " ")
        local views = s.views or 0
        local likes = s.likes or 0

        Tabs.Jogos:AddSection({title})
        Tabs.Jogos:AddParagraph({
            Title = tagStr ~= "" and tagStr or "—",
            Content = "Jogo: " .. desc .. "\n👁 " .. views .. "  ❤ " .. likes
        })
        Tabs.Jogos:AddButton({"▶ EXECUTAR — " .. title, function()
            redzlib:Notify({Title = title, Description = "⏳ Carregando script...", Type = "Info", Duration = 2})
            local ok, msg = RScripts.execute(s)
            if ok then
                redzlib:Notify({Title = title, Description = msg, Type = "Success", Duration = 3})
            else
                redzlib:Notify({Title = title, Description = msg, Type = "Error", Duration = 4})
            end
        end})
    end
end

-- Função de refresh
RScripts.State._refresh = function()
    local myToken = debounceToken + 1
    debounceToken = myToken
    resultsParagraph:Set("⏳ Pesquisando scripts...", "Aguarde...")
    redzlib:Notify({Title = "API", Description = "⏳ Consultando RScripts...", Type = "Info", Duration = 2})

    RScripts.fetch(RScripts.State.query, RScripts.State.filters, RScripts.State.page,
        function(data, err)
            if myToken ~= debounceToken then return end
            if err then
                resultsParagraph:Set("⚠ Erro", err.message)
                redzlib:Notify({Title = "RScripts API", Description = err.message, Type = "Error", Duration = 5})
                return
            end
            local scripts = data and data.data
            if scripts and scripts.scripts then scripts = scripts.scripts end
            if type(scripts) ~= "table" then scripts = {} end
            renderScripts(scripts)
            pageInfo:Set("Página " .. RScripts.State.page .. " / " .. RScripts.State.totalPages,
                RScripts.State.total .. " resultados")
        end)
end

