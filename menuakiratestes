-- ============================================
-- 1) NOCLIP
-- Desliga de verdade: devolve a colisão original de cada parte.
-- ============================================
local noclipConnection = nil
local colisaoOriginal = {} -- [parte] = CanCollide original

local function ligarNoclip()
    if noclipConnection then return end
    noclipConnection = RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                if colisaoOriginal[p] == nil then
                    colisaoOriginal[p] = p.CanCollide
                end
                p.CanCollide = false
            end
        end
    end)
end

local function desligarNoclip()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    for p, valor in pairs(colisaoOriginal) do
        if p.Parent then p.CanCollide = valor end
    end
    colisaoOriginal = {}
end

-- ============================================
-- 2) ANTI-TP (v3)
-- Duas proteções:
--  a) Limita velocidade que NÃO vem do próprio boneco (puxão por força/velocidade,
--     que era o que te puxava "uns metros pra cima").
--  b) Detecta salto de posição (teleporte) e volta para a última posição válida.
-- Não considera a velocidade atual como desculpa para o salto (a v2 fazia isso).
-- ============================================
local antiTpConnections = {}
local ultimaPosicao = nil
local ultimoChar = nil

local MARGEM = 3      -- studs de tolerância por frame além do movimento normal
local MARGEM_VEL = 10 -- studs/s de tolerância acima da velocidade do boneco
local QUEDA_MAX = 400 -- studs/s: queda livre permitida

-- Velocidades que o próprio Humanoid consegue fazer (andar e pular)
local function limitesDoBoneco(hum)
    local andar = hum and hum.WalkSpeed or 16
    local pulo = 50
    if hum then
        if hum.UseJumpPower then
            pulo = hum.JumpPower
        else
            pulo = math.sqrt(2 * workspace.Gravity * hum.JumpHeight)
        end
    end
    return andar + MARGEM_VEL, pulo + MARGEM_VEL -- (máx horizontal, máx para cima)
end

local function checarTeleporte(dt)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hum = char:FindFirstChildOfClass("Humanoid")

    -- Personagem novo (respawn): aceita a posição atual como referência
    if char ~= ultimoChar or not ultimaPosicao then
        ultimoChar = char
        ultimaPosicao = hrp.CFrame
        return
    end

    -- Sentado (carro/cavalo/cadeira) ou morto: não interfere
    if hum and (hum.SeatPart or hum.Health <= 0) then
        ultimaPosicao = hrp.CFrame
        return
    end

    dt = math.clamp(dt, 1 / 240, 0.1)
    local maxH, maxCima = limitesDoBoneco(hum)

    -- a) Limita velocidade que o boneco não conseguiria fazer sozinho
    local v = hrp.AssemblyLinearVelocity
    local h = Vector3.new(v.X, 0, v.Z)
    local vy = v.Y
    local mudou = false
    if h.Magnitude > maxH then
        h = h.Unit * maxH
        mudou = true
    end
    if vy > maxCima then
        vy = maxCima
        mudou = true
    end
    if mudou then
        hrp.AssemblyLinearVelocity = Vector3.new(h.X, vy, h.Z)
    end

    -- b) Salto de posição (teleporte)
    local delta = hrp.Position - ultimaPosicao.Position
    local horiz = Vector3.new(delta.X, 0, delta.Z).Magnitude
    local permitidoH = maxH * dt + MARGEM
    local permitidoCima = maxCima * dt + MARGEM
    local permitidoBaixo = QUEDA_MAX * dt + MARGEM

    if horiz > permitidoH or delta.Y > permitidoCima or -delta.Y > permitidoBaixo then
        hrp.CFrame = ultimaPosicao
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    else
        ultimaPosicao = hrp.CFrame
    end
end

local function ligarAntiTp()
    if #antiTpConnections > 0 then return end
    ultimaPosicao = nil
    ultimoChar = nil
    -- Antes da física (Stepped), depois (Heartbeat) e antes de desenhar (RenderStepped)
    table.insert(antiTpConnections, RunService.Stepped:Connect(function(_, dt)
        checarTeleporte(dt)
    end))
    table.insert(antiTpConnections, RunService.Heartbeat:Connect(function(dt)
        checarTeleporte(dt)
    end))
    table.insert(antiTpConnections, RunService.RenderStepped:Connect(function(dt)
        checarTeleporte(dt)
    end))
end

local function desligarAntiTp()
    for _, c in ipairs(antiTpConnections) do
        c:Disconnect()
    end
    antiTpConnections = {}
    ultimaPosicao = nil
    ultimoChar = nil
end

-- ============================================
-- 3) REMOVER TEXTO (detecta e apaga o texto da prisão)
-- ============================================
local textoConnections = {}
local textosOcultos = {} -- [label] = Visible original
local textoAtivo = false

local function normalizar(s)
    s = string.gsub(tostring(s), "<[^>]+>", "")
    s = string.gsub(s, "ã", "a")
    s = string.gsub(s, "Ã", "a")
    return string.lower(s)
end

local function contem(texto, palavra)
    return string.find(texto, palavra, 1, true) ~= nil
end

-- DETECTAR: cita prisão E fala de polichinelos/minutos
local function ehMensagemDePrisao(obj)
    local t = normalizar(obj.Text)
    local prisao = contem(t, "prisao") or contem(t, "preso") or contem(t, "prison") or contem(t, "jail")
    local regra = contem(t, "polichinelo") or contem(t, "minut")
    return prisao and regra
end

-- APAGAR: oculta e mantém oculto se o jogo tentar mostrar de novo
local function apagar(obj)
    if textosOcultos[obj] ~= nil then return end
    textosOcultos[obj] = obj.Visible
    obj.Visible = false
    table.insert(textoConnections, obj:GetPropertyChangedSignal("Visible"):Connect(function()
        if textoAtivo and obj.Visible then obj.Visible = false end
    end))
end

local function verificar(obj)
    if ehMensagemDePrisao(obj) then apagar(obj) end
end

local function observar(obj)
    if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and not obj:IsDescendantOf(ScreenGui) then
        verificar(obj)
        table.insert(textoConnections, obj:GetPropertyChangedSignal("Text"):Connect(function()
            verificar(obj)
        end))
    end
end

local function ligarRemoverTexto()
    if textoAtivo then return end
    textoAtivo = true
    for _, d in ipairs(PlayerGui:GetDescendants()) do
        observar(d)
    end
    table.insert(textoConnections, PlayerGui.DescendantAdded:Connect(observar))
end

local function desligarRemoverTexto()
    textoAtivo = false
    for _, c in ipairs(textoConnections) do
        c:Disconnect()
    end
    textoConnections = {}
    for obj, visivelOriginal in pairs(textosOcultos) do
        if obj.Parent then obj.Visible = visivelOriginal end
    end
    textosOcultos = {}
end

-- ============================================
-- BOTÃO ÚNICO
--  Ligar   -> Noclip + Anti-TP + Remover texto
--  Desligar-> só o Noclip (Anti-TP e Remover texto continuam)
-- ============================================
local noclipAtivo = false

local function atualizarBotao()
    if noclipAtivo then
        BypassBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        BypassBtn.Text = "ATIVADO"
    else
        BypassBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
        BypassBtn.Text = "Desativado"
    end

    if #antiTpConnections > 0 then
        StatusLabel.Text = "Anti-TP: ATIVO"
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 200)
    else
        StatusLabel.Text = "Anti-TP: desligado"
        StatusLabel.TextColor3 = Color3.fromRGB(150, 155, 170)
    end
end

BypassBtn.MouseButton1Click:Connect(function()
    noclipAtivo = not noclipAtivo
    if noclipAtivo then
        ligarAntiTp()        -- liga antes de sair da cela
        ligarRemoverTexto()
        ligarNoclip()
    else
        desligarNoclip()     -- só o noclip desliga
    end
    atualizarBotao()
end)

-- Desliga TUDO e fecha o menu (✕, ou executar o script de novo)
local function desligarTudo()
    noclipAtivo = false
    desligarAntiTp()
    desligarRemoverTexto()
    desligarNoclip()
end

local function limpar()
    desligarTudo()
    if ScreenGui.Parent then ScreenGui:Destroy() end
end

CloseBtn.MouseButton1Click:Connect(limpar)
_G.BypassPrisonCleanup = limpar
ScreenGui.Destroying:Connect(desligarTudo)

atualizarBotao()