local function makeDraggable(handle, target, onTap)
    local dragging, startInput, dragStart, startPos, moved, t0 = false, nil, nil, nil, false, 0
    track(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging, moved = true, false
            startInput, dragStart, startPos, t0 = input, input.Position, target.Position, os.clock()
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if onTap and not moved and (os.clock() - t0) < 0.4 then onTap() end
                end
            end)
        end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input == startInput or input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = input.Position - dragStart
            if d.Magnitude > 6 then moved = true end
            if moved then
                target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end
    end))
end

