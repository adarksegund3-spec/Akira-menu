        rowBtn("Testar", C.AccentDark, 1, function()
            if isRecording then setStatus("Pare a gravação antes", "warn") return end
            MainFrame.Visible = true
            playRoute(entry.Data)
        end)

        rowBtn("Copiar", C.Bg3, 2, function()
            if setclipboard then
                local ok = pcall(function() setclipboard(buildCopyText(name, entry)) end)
                setStatus(ok and ("Copiado: " .. name) or "Falha ao copiar", ok and "ok" or "warn")
            else
                setStatus("Sem clipboard neste executor", "warn")
            end
        end)

        local confirmAt = 0
        rowBtn("Apagar", Color3.fromRGB(150, 44, 60), 3, function(btn)
            if os.clock() - confirmAt < 2.5 then
                deleteFromDisk(entry)
                savedRoutes[name] = nil
