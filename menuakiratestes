    button(m1, "ENVIAR", function() sendAction(";hb PREPARAR PARA MARCHAR!", "Preparar para marchar") end)
    local m2 = card(m, "Marchar"); label(m2, ";hb MARCHEM!", 11)
    button(m2, "ENVIAR", function() sendAction(";hb MARCHEM!", "Marchem") end)

    -- Tempos
    local t = card(p, "TEMPOS DO TREINAMENTO")
    categoryInfoLabel = label(t, "", 10, false, C.dim)
    local function updateInfo()
        local d = DATA[Session.category or ""]
        if not d then categoryInfoLabel.Text = "Nenhuma categoria selecionada (aba Geral)."; return end
        categoryInfoLabel.Text = "Categoria: " .. Session.category .. "\nMínimo: " .. d.min .. "\nPolichinelos: " .. d.jj
            .. (d.nota and ("\n" .. d.nota) or "")
    end
    table.insert(refreshers, updateInfo); updateInfo()
    for i = 1, 4 do
        local u = messageCard(t, "PARKOUR " .. i, function()
            local tm = parkourTime(i); return tm and (";hb ao " .. tm) or nil
        end)
