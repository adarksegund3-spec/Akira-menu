-- Onde a GUI pode morar (executores diferentes aceitam lugares diferentes)
local function guiRoots()
    local r = {}
    local ok, h = pcall(function() return gethui and gethui() end)
    if ok and h then r[#r+1] = h end
    r[#r+1] = game:GetService("CoreGui")
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if pg then r[#r+1] = pg end
    return r
end
for _, root in ipairs(guiRoots()) do
    for _, n in ipairs({"AKZUniversal","AKZUniversalToast"}) do
        local ok, o = pcall(function() return root:FindFirstChild(n) end)
        if ok and o then pcall(function() o:Destroy() end) end
    end
end
local function mountGui(g)
    for _, root in ipairs(guiRoots()) do
        if pcall(function() g.Parent = root end) and g.Parent == root then return end
    end
    g.Parent = LP:WaitForChild("PlayerGui")
end

