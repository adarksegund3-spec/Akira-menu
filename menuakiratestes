---------------------------------------------------------------- Spotify (Web API oficial)
local Sp = { token = CFG.SPOTIFY_TOKEN, refreshToken = CFG.SPOTIFY_REFRESH_TOKEN, refreshing = false, lastRefreshOk = false }
local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64(str)
	local out = {}
	for i = 1, #str, 3 do
		local a, b, c = str:byte(i, i + 2)
		local n = a * 65536 + (b or 0) * 256 + (c or 0)
		local c1, c2, c3, c4 = (n // 262144) % 64, (n // 4096) % 64, (n // 64) % 64, n % 64
		table.insert(out, B64:sub(c1 + 1, c1 + 1))
		table.insert(out, B64:sub(c2 + 1, c2 + 1))
		table.insert(out, b and B64:sub(c3 + 1, c3 + 1) or "=")
		table.insert(out, c and B64:sub(c4 + 1, c4 + 1) or "=")
	end
	return table.concat(out)
end

function Sp.refresh()
	if CFG.SPOTIFY_CLIENT_ID == "" or CFG.SPOTIFY_CLIENT_SECRET == "" or Sp.refreshToken == "" then return false end
	if Sp.refreshing then
		local t0 = os.clock()
		while Sp.refreshing and os.clock() - t0 < 10 do task.wait(0.1) end
		return Sp.lastRefreshOk
	end
	Sp.refreshing = true
	local ok = false
	local res = Http.req("POST", "https://accounts.spotify.com/api/token", {
		Authorization = "Basic " .. b64(CFG.SPOTIFY_CLIENT_ID .. ":" .. CFG.SPOTIFY_CLIENT_SECRET),
		["Content-Type"] = "application/x-www-form-urlencoded",
	}, "grant_type=refresh_token&refresh_token=" .. HttpService:UrlEncode(Sp.refreshToken))
	if res and res.StatusCode == 200 then
		local s2, d = pcall(HttpService.JSONDecode, HttpService, res.Body or "")
		if s2 and type(d) == "table" and type(d.access_token) == "string" then
			Sp.token = d.access_token
			if type(d.refresh_token) == "string" and d.refresh_token ~= "" then Sp.refreshToken = d.refresh_token end
			ok = true
		end
	end
	Sp.refreshing = false
	Sp.lastRefreshOk = ok
	return ok
end

-- Retorna: tabela decodificada | true (sem conteúdo) | nil, codigoDeErro
function Sp.call(method, path, params, body)
	local parts = {}
	for k, v in pairs(params or {}) do
		table.insert(parts, HttpService:UrlEncode(tostring(k)) .. "=" .. HttpService:UrlEncode(tostring(v)))
	end
	local url = "https://api.spotify.com" .. path .. (#parts > 0 and ("?" .. table.concat(parts, "&")) or "")
	local payload = body ~= nil and HttpService:JSONEncode(body) or nil
	local refreshed = false
	for attempt = 1, 3 do
		local headers = { Authorization = "Bearer " .. Sp.token, Accept = "application/json" }
		if payload then headers["Content-Type"] = "application/json" end
		local res, err = Http.req(method, url, headers, payload)
		if not res then return nil, err end
		local code = res.StatusCode or 0
		local text = type(res.Body) == "string" and res.Body or ""
		if code >= 200 and code < 300 then
			if code == 204 or text == "" then return true end
			local ok, data = pcall(HttpService.JSONDecode, HttpService, text)
			if ok and type(data) == "table" then return data end
			return true
		elseif code == 401 then
			if refreshed or not Sp.refresh() then return nil, "TOKEN" end
			refreshed = true
		elseif code == 429 then
			if attempt == 3 then return nil, "RATE" end
			local h = res.Headers or {}
			task.wait(math.min(tonumber(h["Retry-After"] or h["retry-after"]) or 1, 3))
		elseif code >= 500 then
			if attempt == 3 then return nil, "SERVER" end
			task.wait(1)
		elseif code == 403 then
			if text:find("PREMIUM_REQUIRED") then return nil, "PREMIUM" end
			if text:find("VOLUME_CONTROL") then return nil, "NOVOLUME" end
			if text:lower():find("scope") then return nil, "SCOPE" end
			return nil, "FORBIDDEN"
		elseif code == 404 then
			if text:find("NO_ACTIVE_DEVICE") then return nil, "NODEVICE" end
			return nil, "NOTFOUND"
		else
			return nil, "HTTP_" .. tostring(code)
		end
	end
	return nil, "NETWORK"
end

-- primeiro dispositivo disponível (usado quando não há dispositivo ativo)
function Sp.firstDevice()
	local d, e = Sp.call("GET", "/v1/me/player/devices")
	if type(d) ~= "table" or type(d.devices) ~= "table" then return nil, e or "NODEVICE" end
	local pick
	for _, dv in ipairs(d.devices) do
		if type(dv) == "table" and dv.id and not dv.is_restricted then
			if dv.is_active then return dv.id end
			pick = pick or dv.id
		end
	end
	if not pick then return nil, "NODEVICE" end
	return pick
end

