--[[ === GRAVAÇÃO === ]]
local function startRecording()
    local _, hrp = getParts()
    if not hrp then setStatus("Personagem não carregado!", C.red) return end
    recordedData = {}
    codeBox.Visible = false
    startTime = os.clock()
    applyMode("rec")
    recordingConn = RunService.Heartbeat:Connect(function()
        local _, root, hum = getParts() -- pega sempre o personagem atual (respawn)
        if not root then return end
        local vel = root.AssemblyLinearVelocity
        recordedData[#recordedData + 1] = {
            Time = os.clock() - startTime,
            CF = { root.CFrame:GetComponents() },
            Velocity = { vel.X, vel.Y, vel.Z },
            State = hum and hum:GetState() or Enum.HumanoidStateType.Running,
        }
        UI.status.Text = string.format("Gravando... %d pts", #recordedData)
    end)
    setStatus("Gravando... 0 pts", C.red)
end

local function stopRecording()
    if recordingConn then recordingConn:Disconnect() recordingConn = nil end
    applyMode("idle")
    setStatus("Gravado! (" .. #recordedData .. " pts)", C.green)
end

--[[ === TESTE (REPRODUÇÃO LOCAL) === ]]
local function stopPlayback()
    if playbackConn then playbackConn:Disconnect() playbackConn = nil end
    local _, _, hum = getParts()
    if antigravidade then antigravidade:Destroy() antigravidade = nil end
    if hum then
        hum.AutoRotate = savedAutoRotate ~= nil and savedAutoRotate or true
        if savedWalkSpeed then hum.WalkSpeed = savedWalkSpeed end
    end
    for parte, status in pairs(originalCollides) do
        if parte and parte.Parent then parte.CanCollide = status end
    end
    table.clear(originalCollides)
    savedWalkSpeed, savedAutoRotate = nil, nil
end

local function runTest()
    local char, hrp, hum = getParts()
    if not (hrp and hum) then setStatus("Personagem não carregado!", C.red) return end
    cancelTest = false
    applyMode("test")
    setStatus("Indo até o início da rota...", C.cyan)

    -- 1) anda até o primeiro ponto
    local startCF = CFrame.new(unpack(recordedData[1].CF))
    savedWalkSpeed, savedAutoRotate = hum.WalkSpeed, hum.AutoRotate
    hum.WalkSpeed = 22
    hum:MoveTo(startCF.Position)
    local reached = false
    local mConn = hum.MoveToFinished:Connect(function() reached = true end)
    local timeout = os.clock() + 4
    while not reached and os.clock() < timeout and not cancelTest do task.wait(0.1) end
    mConn:Disconnect()
    if cancelTest then stopPlayback() applyMode("idle") setStatus("Teste cancelado.", C.muted) return end

    -- 2) reproduz a rota (sem colisão, com antigravidade)
    hum.AutoRotate = false
    local totalMass = 0
    for _, parte in ipairs(char:GetChildren()) do
        if parte:IsA("BasePart") then
            originalCollides[parte] = parte.CanCollide
            parte.CanCollide = false
            totalMass += parte:GetMass()
        end
    end
    antigravidade = Instance.new("BodyForce", hrp)
    antigravidade.Force = Vector3.new(0, totalMass * workspace.Gravity, 0)

    setStatus("Reproduzindo teste...", C.cyan)
    local pStart, total, idx = os.clock(), #recordedData, 1
    playbackConn = RunService.Heartbeat:Connect(function()
        local elapsed = os.clock() - pStart
        while idx < total and elapsed >= recordedData[idx + 1].Time do idx += 1 end
        if idx >= total or not hrp.Parent then
            stopPlayback()
            applyMode("idle")
            setStatus("Teste concluído!", C.green)
            return
        end
        local p0, p1 = recordedData[idx], recordedData[idx + 1]
        local span = p1.Time - p0.Time
        local alpha = span > 0 and math.clamp((elapsed - p0.Time) / span, 0, 1) or 1
        hrp.CFrame = CFrame.new(unpack(p0.CF)):Lerp(CFrame.new(unpack(p1.CF)), alpha)
        hrp.AssemblyLinearVelocity = Vector3.new(p1.Velocity[1], p1.Velocity[2], p1.Velocity[3])
        if p0.State then pcall(function() hum:ChangeState(p0.State) end) end
    end)
end

--[[ === GERAR / COPIAR CÓDIGO === ]]
local function buildCode()
    local lines = { "return {" }
    for _, node in ipairs(recordedData) do
        local cf = {}
        for i, v in ipairs(node.CF) do cf[i] = string.format("%.4f", v) end
        local stateName = typeof(node.State) == "EnumItem" and node.State.Name or "Running"
        lines[#lines + 1] = string.format("    {Time = %.3f, CF = {%s}, Velocity = {%.3f, %.3f, %.3f}, State = Enum.HumanoidStateType.%s},",
            node.Time, table.concat(cf, ", "), node.Velocity[1], node.Velocity[2], node.Velocity[3], stateName)
    end
    lines[#lines + 1] = "}"
    return table.concat(lines, "\n")
end

--[[ === BOTÕES === ]]
recBtn.Activated:Connect(function()
    if mode == "test" then cancelTest = true stopPlayback() end
    if mode == "rec" then stopRecording() else startRecording() end
end)

testBtn.Activated:Connect(function()
    if mode == "rec" then setStatus("Pare a gravação antes de testar!", C.red) return end
    if mode == "test" then
        cancelTest = true
        stopPlayback()
        applyMode("idle")
        setStatus("Teste cancelado.", C.muted)
        return
    end
    if #recordedData == 0 then setStatus("Nenhuma rota gravada!", C.red) return end
    task.spawn(runTest)
end)

copyBtn.Activated:Connect(function()
    if #recordedData == 0 then setStatus("Nada gravado ainda!", C.red) return end
    local code = buildCode()
    local copied = false
    if setclipboard then copied = pcall(setclipboard, code) end
    if copied then
        setStatus("Copiado com sucesso!", C.green)
    else
        -- sem clipboard: mostra o código numa caixa dentro do menu
        codeBox.Text = code
        codeBox.Visible = true
        setStatus("Sem clipboard: código na caixa abaixo.", C.muted)
    end
end)

--[[ === LIMPEZA E INÍCIO === ]]
genv.DripRecorderCleanup = function()
    cancelTest = true
    if recordingConn then recordingConn:Disconnect() end
    stopPlayback()
    for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
    pcall(function() menuGui:Destroy() end)
    pcall(function() logoGui:Destroy() end)
    genv.DripRecorderCleanup = nil
end

applyMode("idle")
clampLogo()
toggleMenu(true)