---------------------------------------------------------------- Http
local Http = { bearerOk = nil }
local httpRequest
do
	if type(request) == "function" then httpRequest = request
	elseif type(http_request) == "function" then httpRequest = http_request
	elseif syn and type(syn.request) == "function" then httpRequest = syn.request
	elseif http and type(http.request) == "function" then httpRequest = http.request
	elseif fluxus and type(fluxus.request) == "function" then httpRequest = fluxus.request end
end

local function q(params)
	local parts = { "app_name=" .. CFG.APP_NAME, "api_key=" .. HttpService:UrlEncode(CFG.API_KEY) }
	for k, v in pairs(params or {}) do
		table.insert(parts, HttpService:UrlEncode(tostring(k)) .. "=" .. HttpService:UrlEncode(tostring(v)))
	end
	return table.concat(parts, "&")
end

function Http.raw(url, useBearer)
	if not httpRequest then return nil, "NOHTTP" end
	local headers = { Accept = "application/json" }
	if useBearer and CFG.USE_BEARER and Http.bearerOk ~= false then
		headers.Authorization = "Bearer " .. CFG.BEARER
	end
	local ok, res = pcall(httpRequest, { Url = url, Method = "GET", Headers = headers })
	if not ok or type(res) ~= "table" then return nil, "NETWORK" end
	return res
end

-- Retorna tabela decodificada (campo data) ou nil, codigoDeErro
function Http.json(path, params)
	local url = CFG.API_HOST .. path .. "?" .. q(params)
	for attempt = 1, 3 do
		local res, err = Http.raw(url, true)
		if not res then return nil, err end
		local code = res.StatusCode or 0
		if code == 401 or code == 403 then
			if CFG.USE_BEARER and Http.bearerOk ~= false then
				Http.bearerOk = false -- tenta de novo só com API key
			else
				return nil, "AUTH"
			end
		elseif code == 429 then
			if attempt == 3 then return nil, "RATE" end
			task.wait(1.5 * attempt)
		elseif code >= 500 then
			if attempt == 3 then return nil, "SERVER" end
			task.wait(1)
		elseif code >= 200 and code < 300 then
			local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body or "")
			if not ok or type(data) ~= "table" or data.data == nil then return nil, "INVALID" end
			if CFG.USE_BEARER and Http.bearerOk == nil then Http.bearerOk = true end
			return data.data
		else
			return nil, "HTTP_" .. tostring(code)
		end
	end
	return nil, "NETWORK"
end

local Errors = {
	NOHTTP = "Seu executor não suporta requisições HTTP.",
	NETWORK = "Falha de conexão. Verifique a internet.",
	AUTH = "Autenticação recusada pela Audius.",
	RATE = "Limite de requisições atingido. Aguarde um pouco.",
	SERVER = "Servidores da Audius indisponíveis.",
	INVALID = "Resposta inválida da API.",
	NOAUDIO = "Executor sem writefile/getcustomasset: não é possível tocar áudio.",
	UNAVAILABLE = "Música indisponível para streaming.",
	LOADFAIL = "O áudio não carregou.",
	NOSTART = "O áudio não iniciou.",
}
local function errText(code) return Errors[code] or ("Erro: " .. tostring(code)) end

---------------------------------------------------------------- Api
local Api = { cache = {} }
local function normTrack(t)
	if type(t) ~= "table" or not t.id then return nil end
	local art = type(t.artwork) == "table" and (t.artwork["150x150"] or t.artwork["480x480"] or t.artwork["1000x1000"]) or nil
	return {
		id = tostring(t.id), title = tostring(t.title or "Sem título"),
		artist = type(t.user) == "table" and tostring(t.user.name or "Desconhecido") or "Desconhecido",
		duration = tonumber(t.duration) or 0, art = art, streamable = t.is_streamable ~= false,
	}
end
local function normList(list)
	local out, seen = {}, {}
	for _, t in ipairs(type(list) == "table" and list or {}) do
		local n = normTrack(t)
		if n and not seen[n.id] then seen[n.id] = true; table.insert(out, n) end
	end
	return out
end
function Api.trending(limit)
	local d, e = Http.json("/v1/tracks/trending", { limit = limit or 25 })
	if not d then return nil, e end
	return normList(d)
end
function Api.searchTracks(text)
	local key = "t:" .. text:lower()
	local c = Api.cache[key]
	if c and os.clock() - c.t < CFG.SEARCH_TTL then return c.v end
	local d, e = Http.json("/v1/tracks/search", { query = text, limit = 25 })
	if not d then return nil, e end
	local v = normList(d)
	Api.cache[key] = { t = os.clock(), v = v }
	return v
end
function Api.searchPlaylists(text)
	local d, e = Http.json("/v1/playlists/search", { query = text, limit = 6 })
	if not d then return nil, e end
	local out = {}
	for _, p in ipairs(d) do
		if p.id then table.insert(out, {
			id = tostring(p.id), name = tostring(p.playlist_name or "Playlist"),
			owner = type(p.user) == "table" and tostring(p.user.name or "") or "",
			count = tonumber(p.track_count) or 0,
			art = type(p.artwork) == "table" and (p.artwork["150x150"] or p.artwork["480x480"]) or nil,
		}) end
	end
	return out
end
function Api.playlistTracks(id)
	local d, e = Http.json("/v1/playlists/" .. HttpService:UrlEncode(id) .. "/tracks", {})
	if not d then return nil, e end
	return normList(d)
end
function Api.streamUrl(id)
	return CFG.API_HOST .. "/v1/tracks/" .. HttpService:UrlEncode(id) .. "/stream?" .. q({})
end

---------------------------------------------------------------- Audio (download -> arquivo local -> asset)
local Audio = {}
local getAsset = (type(getcustomasset) == "function" and getcustomasset) or (type(getsynasset) == "function" and getsynasset) or nil
Audio.supported = type(writefile) == "function" and getAsset ~= nil
Audio.order = {}
local function fsOk(f, ...) local ok, r = pcall(f, ...) return ok and r end
local function ensureFolders()
	if type(makefolder) ~= "function" then return end
	for _, p in ipairs({ CFG.FOLDER, CFG.FOLDER .. "/cache" }) do
		if not fsOk(isfolder, p) then pcall(makefolder, p) end
	end
end

function Audio.download(url, path, validator)
	local res, err = Http.raw(url, false) -- sem Bearer: o stream redireciona para nós de conteúdo
	if not res then return nil, err end
	if res.StatusCode == 401 or res.StatusCode == 403 then return nil, "AUTH" end
	if res.StatusCode == 429 then return nil, "RATE" end
	if res.StatusCode == 404 or res.StatusCode == 400 then return nil, "UNAVAILABLE" end
	if res.StatusCode >= 500 then return nil, "SERVER" end
	local body = res.Body
	if res.StatusCode ~= 200 or type(body) ~= "string" or #body < 2048 then return nil, "UNAVAILABLE" end
	if validator and not validator(body) then return nil, "INVALID" end
	local ok = pcall(writefile, path, body)
	if not ok then return nil, "NOAUDIO" end
	return true
end

local function looksLikeAudio(b)
	local h3 = b:sub(1, 3)
	return h3 == "ID3" or b:byte(1) == 0xFF or b:sub(1, 4) == "OggS" or b:sub(5, 8) == "ftyp"
end

function Audio.fetch(track)
	if not Audio.supported then return nil, "NOAUDIO" end
	ensureFolders()
	local path = ("%s/cache/%s.mp3"):format(CFG.FOLDER, track.id)
	if not (type(isfile) == "function" and fsOk(isfile, path)) then
		local ok, err = Audio.download(Api.streamUrl(track.id), path, looksLikeAudio)
		if not ok then return nil, err end
		table.insert(Audio.order, path)
		while #Audio.order > CFG.CACHE_LIMIT do
			local old = table.remove(Audio.order, 1)
			if type(delfile) == "function" then pcall(delfile, old) end
		end
	end
	local ok, asset = pcall(getAsset, path)
	if not ok or not asset then return nil, "LOADFAIL" end
	return asset
end

---------------------------------------------------------------- Img (capas)
local Img = { cache = {}, active = 0 }
function Img.apply(label, track)
	if not (Audio.supported and track.art) then return end
	local key = "art_" .. track.id
	if Img.cache[key] then label.Image = Img.cache[key] return end
	task.spawn(function()
		while Img.active >= 4 do task.wait(0.15) end
		if not label.Parent then return end
		Img.active += 1
		ensureFolders()
		local path = ("%s/cache/%s.jpg"):format(CFG.FOLDER, key)
		local ok = type(isfile) == "function" and fsOk(isfile, path)
		if not ok then ok = Audio.download(track.art, path, nil) end
		Img.active -= 1
		if ok then
			local s, asset = pcall(getAsset, path)
			if s and asset then
				Img.cache[key] = asset
				if label.Parent then label.Image = asset end
			end
		end
	end)
end

