    UI.status.TextColor3 = color or C.muted
end

local function applyMode(m)
    mode = m
    if logoPulse then logoPulse:Cancel() logoPulse = nil end
    logoStroke.Transparency = 0.1
    if m == "idle" then
        recBtn.Text = "● INICIAR GRAVAÇÃO"
        setBase(recBtn, C.green)
        testBtn.Text = "▶ TESTAR ROTA GRAVADA"
        setBase(testBtn, C.blue)
        logoGrad.Color = ColorSequence.new(C.green, C.cyan)
        logoText.Text = "D"
    elseif m == "rec" then
        recBtn.Text = "■ PARAR GRAVAÇÃO"
        setBase(recBtn, C.red)
        logoGrad.Color = ColorSequence.new(C.red, C.redDark)
        logoText.Text = "●"
        logoPulse = TweenService:Create(logoStroke, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
            { Transparency = 0.9 })
