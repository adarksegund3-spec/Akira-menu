local function buildCopyText(name, entry)
    local lines = { string.format("-- drip admin | %s | %.3fs\nreturn {", name, entry.Duracao) }
    for _, node in ipairs(entry.Data) do
        local cfStr = table.concat(node.CF, ", ")
        local velStr = table.concat(node.Velocity, ", ")
        local stateName = "Running"
        if typeof(node.State) == "EnumItem" then stateName = node.State.Name
        elseif type(node.State) == "string" then stateName = node.State end
        local parts = {}
        for _, a in ipairs(node.Animations or {}) do
            table.insert(parts, string.format(
                "{Id=\"%s\",Speed=%.3f,Weight=%.3f,Priority=\"%s\",Looped=%s}",
                a.Id, a.Speed or 1, a.Weight or 1, a.Priority or "Movement", tostring(a.Looped ~= false)))
        end
        table.insert(lines, string.format(
            "{Time=%.3f,CF={%s},Velocity={%s},State=Enum.HumanoidStateType.%s,Animations={%s}},",
            node.Time, cfStr, velStr, stateName, table.concat(parts, ",")))
    end
    table.insert(lines, "}")
    return table.concat(lines, "\n")
end

refreshDataList = function()
    for _, child in ipairs(DataScroll:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
    end
    local names = {}
    for n in pairs(savedRoutes) do table.insert(names, n) end
    table.sort(names)

    CountLabel.Text = string.format("%d rota(s)%s", #names, canFS and "  |  salvas no aparelho" or "  |  só nesta sessão")

    if #names == 0 then
        new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 60),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamMedium,
            Text = "Nenhuma rota salva\nGrave uma rota e toque em Salvar rota",
            TextColor3 = C.TextDim,
            TextSize = 11,
            TextWrapped = true,
        }, DataScroll)
