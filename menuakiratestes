new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, toast)

local toastToken = 0
local function showToast(text, color)
	toastToken += 1
	local my = toastToken
	toast.Text, toast.BackgroundColor3 = text, color
	toast.BackgroundTransparency, toast.TextTransparency = 0.05, 0
	task.delay(2.4, function()
		if my == toastToken then
			TweenService:Create(toast, TweenInfo.new(0.3), { BackgroundTransparency = 1, TextTransparency = 1 }):Play()
		end
	end)
end

-- Abrir / fechar com animação
local menuOpen = false
local function setMenu(open)
	if open == menuOpen then return end
	menuOpen = open
	if open then
		menu.Visible = true
		TweenService:Create(menu, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { GroupTransparency = 0 }):Play()
		TweenService:Create(menuScale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	else
		local info = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		local t = TweenService:Create(menu, info, { GroupTransparency = 1 })
		TweenService:Create(menuScale, info, { Scale = 0.9 }):Play()
		t:Play()
		t.Completed:Once(function() if not menuOpen then menu.Visible = false end end)
	end
end

makeDraggable(logo, logo, function() setMenu(not menuOpen) end)
makeDraggable(titleBar, menu, nil)
closeBtn.Activated:Connect(function() setMenu(false) end)

--=====================================================================
-- BOTÕES
--=====================================================================
local lastReport, busy = nil, false

local function runDetect()
	local ok, best = pcall(detect)
	if not ok then
		lastReport = "Falha na análise: " .. tostring(best)
		return nil
	end
	lastReport = buildReport(best)
	return best
end

diagBtn.Activated:Connect(function()
	if busy then return end
	busy = true
	statusLabel.Text = "Analisando..."
	local best = runDetect()
	resultBox.TextEditable = false
	resultBox.Text = lastReport
	statusLabel.Text = best and "Mensagem detectada." or "Mensagem não encontrada."
	busy = false
end)

eraseBtn.Activated:Connect(function()
	if busy then return end
	-- Segundo toque: restaura o texto
	if next(hiddenByUs) then
		restoreAll()
		statusLabel.Text = "Texto restaurado."
		showToast("Texto restaurado", COLORS.warn)
		return
	end
	busy = true
	statusLabel.Text = "Procurando texto..."
	local best = runDetect()
	if best then
		local n = hideMessage(best)
		lastReport = buildReport(best) -- reflete o estado "APAGADO"
		resultBox.TextEditable = false
		resultBox.Text = lastReport
		statusLabel.Text = "Texto apagado. Toque de novo para restaurar."
		showToast("✔ Texto apagado (" .. n .. ")", COLORS.ok)
	else
		resultBox.Text = lastReport or ""
		statusLabel.Text = "Nada para apagar."
		showToast("⚠ Texto não encontrado. Rode quando estiver preso", COLORS.warn)
	end
	busy = false
end)

local function getClipboardFn()
	local ok, fn = pcall(function() return setclipboard or toclipboard or (Clipboard and Clipboard.set) end)
	if ok and type(fn) == "function" then return fn end
end

copyBtn.Activated:Connect(function()
	if not lastReport then
		showToast("⚠ Execute o Diagnóstico primeiro", COLORS.warn)
		return
	end
	local clip = getClipboardFn()
	if clip and pcall(clip, lastReport) then
		showToast("✔ Diagnóstico copiado!", COLORS.ok)
	else
		resultBox.Text = lastReport
		resultBox.TextEditable = true -- permite selecionar e copiar manualmente
		showToast("Sem área de transferência: selecione o texto", COLORS.warn)
	end
end)