-- ============================================
-- BOTÃO NOCLIP
-- ============================================
NoclipBtn.MouseButton1Click:Connect(function()
    noclipAtivo = não noclipAtivo

    se noclipAtivo então
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        NoclipBtn.Text = "Noclip: LIGADO"
        
        noclipConnection = RunService.Stepped:Connect(function()
            se não houver noclipAtivo, retorne fim
            char local = LocalPlayer.Character
            Se não for um caractere, retorne o fim.
            para _, p em ipairs(char:GetDescendants()) faça
                se p:IsA("BasePart") então p.CanCollide = false end
            fim
        fim)
    outro
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
        NoclipBtn.Text = "Noclip: DESATIVADO"
        se noclipConnection então
            noclipConnection:Desconectar()
            noclipConnection = nulo
        fim
    fim
fim)

-- ============================================
-- BOTÃO ANTI-TP (BYPASS + DETECTOR DE TEXTO)
-- ============================================
BypassBtn.MouseButton1Click:Connect(function()
    bypassAtivo = não bypassAtivo

    se bypassAtivo então
        BypassBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        BypassBtn.Text = "Anti-TP: LIGADO"
        
        char local = LocalPlayer.Character
        local hrp = char e char:FindFirstChild("HumanoidRootPart")
        se hrp então
            ultimaPosicao = hrp.CFrame
        fim

        -- Anti-Teleporte (Heartbeat, como era antes e funcionava)
        antiTpConnection = RunService.Heartbeat:Connect(function()
            se não bypassAtivo então retorne fim
            char local = LocalPlayer.Character
            local hrp = char e char:FindFirstChild("HumanoidRootPart")
            se não hrp ou não ultimaPosicao então retorne fim

            distância local = (hrp.Position - ultimaPosicao.Position).Magnitude
            
            se dist > 30 então
                hrp.CFrame = ultimaPosicao
            outro
                ultimaPosicao = hrp.CFrame
            fim
        fim)

        -- Detector de Texto da Prisão
        função local normalizar(s)
            s = string.gsub(tostring(s), "<[^>]+>", "")
            s = string.gsub(s, "ã", "a")
            s = string.gsub(s, "Ã", "a")
            retornar string.minúsculas(s)
        fim

        função local contem(texto, palavra)
            return string.find(texto, palavra, 1, true) ~= nil
        fim

        função local ehMensagemDePrisao(obj)
            local t = normalizar(obj.Texto)
            prisão local = contem(t, "prisão") ou contem(t, "preso") ou contem(t, "prisão") ou contem(t, "prisão")
            local regra = contem(t, "polichinelo") ou contem(t, "minuto")
            retornar prisao e regra
        fim

        função local vide(obj)
            se textosOcultos[obj] ~= nil então retorne fim
            textosOcultos[obj] = obj.Visível
            obj.Visível = falso
            tabela.inserir(textoConnections, obj:GetPropertyChangedSignal("Visível"):Connect(function()
                Se bypassAtivo e obj.Visible então obj.Visible = falso fim
            fim))
        fim

        função local verificar(obj)
            if ehMensagemDePrisao(obj) then apagar(obj) end
        fim

        função local observar(obj)
            se (obj:IsA("TextLabel") ou obj:IsA("TextButton")) e não obj:IsDescendantOf(ScreenGui) então
                verificar(obj)
                tabela.inserir(textoConnections, obj:GetPropertyChangedSignal("Text"):Connect(function()
                    verificar(obj)
                fim))
            fim
        fim

        local playerGui = LocalPlayer:WaitForChild("PlayerGui")
        para _, d em ipairs(playerGui:GetDescendants()) faça
            observar(d)
        fim
        tabela.inserir(textoConnections, playerGui.DescendantAdded:Connect(observar))

    outro
        BypassBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
        BypassBtn.Text = "Anti-TP: DESLIGADO"
        
        se antiTpConnection então
            antiTpConnection:Desconectar()
            antiTpConnection = nulo
        fim
        ultimaPosicao = nulo

        para _, c em ipairs(textoConnections) faça
            c:Desconectar()
        fim
        textoConnections = {}
        para obj, visivelOriginal em pares(textosOcultos) do
            se obj.Parent então obj.Visible = visivelOriginal fim
        fim
        textosOcultos = {}
    fim
fim)