------------------------------------------------------------------
-- Utilitários
------------------------------------------------------------------
local function r3(n)
	if type(n) ~= "number" or n ~= n or n == math.huge or n == -math.huge then
		return 0
	end
	return math.floor(n * 1000 + 0.5) / 1000
end

local function vec(v)
	return { r3(v.X), r3(v.Y), r3(v.Z) }
end

local function col(c)
	return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
end

local function cfc(c)
	local t = { c:GetComponents() }
	for i = 1, #t do
		t[i] = r3(t[i])
	end
	return t
end

local function enumName(v)
	return v.Name
end

local function idf(v)
	return v
end

local function index(o, k)
	return o[k]
end

local function ser(v)
	local t = typeof(v)
	if t == "number" then
		return r3(v)
	elseif t == "string" or t == "boolean" then
		return v
	elseif t == "Vector3" then
		return vec(v)
	elseif t == "Vector2" then
		return { r3(v.X), r3(v.Y) }
	elseif t == "Color3" then
		return col(v)
	elseif t == "CFrame" then
		return cfc(v)
	elseif t == "EnumItem" then
		return v.Name
	end
	return tostring(v)
end

local function readSpec(inst, specs)
	local out, miss = {}, {}
	for _, p in ipairs(specs) do
		local ok, v = pcall(index, inst, p[2])
		if ok then
			local ok2, cv = pcall(p[3], v)
			if ok2 then
				out[p[1]] = cv
			else
				miss[#miss + 1] = p[2]
			end
		else
			miss[#miss + 1] = p[2]
		end
	end
	return out, miss
end

