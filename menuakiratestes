function UI.switchTab(name)
    for n, page in pairs(UI.pages) do page.Visible = (n == name) end
    for n, btn in pairs(UI.tabs) do
        local on = (n == name)
        btn:SetAttribute("Base", on and C.accent or C.panel2)
        tween(btn, 0.15, { BackgroundColor3 = on and C.accent or C.panel2 })
    end
end

function UI.setMode(mode)
    State.mode = mode
    local b, lg = UI.recBtn, UI.logo
    if UI.pulse then UI.pulse:Cancel() UI.pulse = nil end
    if UI.logoPulse then UI.logoPulse:Cancel() UI.logoPulse = nil end
    if b then
        local idleSize = UDim2.new(1, 0, 0, 56)
        if mode == "idle" then
            b.Text = "● GRAVAR"
            b:SetAttribute("Base", C.danger)
            tween(b, 0.25, { BackgroundColor3 = C.danger, Size = idleSize })
        elseif mode == "rec" then
            b.Text = "■ PARAR"
            b:SetAttribute("Base", C.danger)
            tween(b, 0.25, { BackgroundColor3 = C.danger, Size = idleSize })
            task.delay(0.27, function()
                if State.mode == "rec" then
                    UI.pulse = TweenService:Create(b, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
                        { BackgroundColor3 = C.dangerDark, Size = UDim2.new(1, -10, 0, 52) })
                    UI.pulse:Play()
                end
            end)
        else
            b.Text = "■ PARAR REPLAY"
            b:SetAttribute("Base", C.accent)
            tween(b, 0.25, { BackgroundColor3 = C.accent, Size = idleSize })
        end
    end
    if lg and UI.logoGrad and UI.logoText and UI.logoStroke then
        if mode == "rec" then
            UI.logoGrad.Color = ColorSequence.new(C.danger, C.dangerDark)
            UI.logoText.Text = "●"
            UI.logoPulse = TweenService:Create(UI.logoStroke, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
                { Transparency = 0.9 })
            UI.logoPulse:Play()
        elseif mode == "replay" then
            UI.logoGrad.Color = ColorSequence.new(C.success, C.accent2)
            UI.logoText.Text = "▶"
            UI.logoStroke.Transparency = 0.1
        else
            UI.logoGrad.Color = ColorSequence.new(C.accent, C.accent2)
            UI.logoText.Text = "R"
            UI.logoStroke.Transparency = 0.1
        end
    end
end

