		RequiresHandle = false, CanBeDropped = false,
	})
	local model, keel, jR, jL, jK, trailR, trailL, wind
	local equipped, gliding = false, false
	local blend, unfold, yaw, pitch, roll, speed, vyB = 0, 0, 0, 0.12, 0, 0, 0
	local glideT, stuck, flapCD, flapAnim, airT = 0, 0, 0, 0, 0
	local standC0 = CFrame.new(0, 5.4, 0.3)
	local flightC0 = CFrame.new(0, 0, 3.1) * CFrame.Angles(math.pi / 2, 0, 0)
	local wingC1 = CFrame.new(0, 0, -0.6)

	local function destroyModel()
		if model then pcall(function() model:Destroy() end) end
		model, keel, jR, jL, jK, trailR, trailL, wind = nil, nil, nil, nil, nil, nil, nil, nil
	end

	local N, S = 4, 9.0
	local function P(i, j, m)
		local u = i / N
		local x = m * S * u
		local zLE = -7.6 + 10.8 * u
		local zTE = 2.3 + 0.9 * u - 0.5 * math.sin(u * math.pi)
		local z = zLE + (zTE - zLE) * (j / 2)
		local y = 0.95 * (1 - u ^ 1.5) - 0.45 * u
		if j == 1 then y = y + 0.3 * (1 - u * 0.6) end
		return Vector3.new(x, y, z)
	end

	local function build()
		local hrp = getHRP()
		local th = GLIDER_THEMES[Config.glider] or GLIDER_THEMES.Aurora
		model = new("Model", {Name = "WonderGlider"}, FX)
		local origin = hrp.CFrame * standC0 * wingC1:Inverse()
		local function root(nm)
			return part({Name = nm, Size = Vector3.new(0.4, 0.4, 0.4), Transparency = 1, CFrame = origin, Parent = model})
		end
		keel = root("Keel")
		local wR, wL = root("WingR"), root("WingL")
		jR = new("Weld", {Part0 = keel, Part1 = wR, C0 = CFrame.new(), C1 = CFrame.new()}, keel)
		jL = new("Weld", {Part0 = keel, Part1 = wL, C0 = CFrame.new(), C1 = CFrame.new()}, keel)

		for _, m in ipairs({1, -1}) do
			local host = (m == 1) and wR or wL
			for i = 0, N - 1 do
				for j = 0, 1 do
					local a, b, c, d = P(i, j, m), P(i + 1, j, m), P(i + 1, j + 1, m), P(i, j + 1, m)
					local col = th.c0:Lerp(th.c1, (i + 0.5) / N)
					if j == 0 then col = col:Lerp(Color3.new(0, 0, 0), 0.15) else col = col:Lerp(WHITE, 0.08) end
					tri(host, model, a, b, c, col, Enum.Material.Fabric, 0.06)
					tri(host, model, a, c, d, col, Enum.Material.Fabric, 0.06)
				end
			end
			tube(host, model, P(0, 0, m), P(N, 0, m), 0.11, SILVER, Enum.Material.Metal)
			for i = 0, N - 1 do
				tube(host, model, P(i, 2, m), P(i + 1, 2, m), 0.06, th.glow, Enum.Material.Neon)
			end
			tube(host, model, P(2, 0, m), P(2, 2, m), 0.04, SILVER, Enum.Material.Metal)
			tube(host, model, P(3, 0, m), P(3, 2, m), 0.04, SILVER, Enum.Material.Metal)
			-- ponta com rastro
			local tp = part({Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, CFrame = origin * CFrame.new(P(N, 1, m)), Parent = model})
			weld(host, tp)
			local a0 = new("Attachment", {Position = Vector3.new(0, 0.15, 0)}, tp)
			local a1 = new("Attachment", {Position = Vector3.new(0, -0.15, 0)}, tp)
			local tr = new("Trail", {
				Attachment0 = a0, Attachment1 = a1, Lifetime = 0.9, LightEmission = 0.7, Enabled = false, FaceCamera = true,
				Color = ColorSequence.new(WHITE, th.glow), Transparency = NS(NSK(0, 0.3), NSK(1, 1)),
			}, tp)
			if m == 1 then trailR = tr else trailL = tr end
			-- barras de controle
			local lePoint = P(1, 0, m)
			tube(keel, model, lePoint, Vector3.new(m * 1.9, -2.5, -3.4), 0.07, SILVER, Enum.Material.Metal)
		end
		tube(keel, model, Vector3.new(-1.9, -2.5, -3.4), Vector3.new(1.9, -2.5, -3.4), 0.09, th.glow, Enum.Material.Neon)
		tube(keel, model, Vector3.new(0, 0.85, -1.0), Vector3.new(0, -2.45, -1.0), 0.06, SILVER, Enum.Material.Metal)
		tube(keel, model, Vector3.new(0, 0.95, -7.6), Vector3.new(0, 0.95, 2.3), 0.14, SILVER, Enum.Material.Metal)

		local nose = part({
			Shape = Enum.PartType.Ball, Size = Vector3.new(0.55, 0.55, 0.55), Material = Enum.Material.Neon,
			Color = th.glow, CFrame = origin * CFrame.new(0, 0.95, -7.7), Parent = model,
		})
		weld(keel, nose)
		wind = new("ParticleEmitter", {
			Texture = SPARK, Rate = 0, Lifetime = NumberRange.new(0.3, 0.5), Speed = NumberRange.new(22, 32),
			SpreadAngle = Vector2.new(35, 35), EmissionDirection = Enum.NormalId.Back,
			Size = NS(NSK(0, 0.28), NSK(1, 0)), Transparency = NS(NSK(0, 0.4), NSK(1, 1)),
			LightEmission = 0.6, Orientation = Enum.ParticleOrientation.VelocityParallel,
		}, nose)
		new("PointLight", {Color = th.glow, Range = 18, Brightness = 1.1}, keel)
	end

	local function startGlide()
		local hrp, hum = getHRP(), getHum()
		if gliding or not hrp or not hum or not model then return end
		if cast(hrp.Position, Vector3.new(0, -9, 0)) then return end
		local look = hrp.CFrame.LookVector
		yaw = math.atan2(-look.X, -look.Z)
		local v = hrp.AssemblyLinearVelocity
		speed = math.clamp(Vector3.new(v.X, 0, v.Z).Magnitude + 22, 38, 80)
		pitch, roll, vyB, glideT, stuck = 0.14, 0, 8, 0, 0
		gliding = true
		hum.PlatformStand = true
		hum.AutoRotate = false
	end

	local function stopGlide(landing, hit)
		if not gliding then return end
		gliding = false
		if trailR then trailR.Enabled = false; trailL.Enabled = false end
		if wind then wind.Rate = 0 end
		local hrp, hum = getHRP(), getHum()
		if not hrp or not hum then return end
		hum.PlatformStand = false
		hum.AutoRotate = true
		local pos = hrp.Position
		if landing and hit then
			local h = (hum.HipHeight > 0) and (hum.HipHeight + hrp.Size.Y / 2) or 3
			pos = Vector3.new(pos.X, hit.Position.Y + h + 0.1, pos.Z)
		end
		hrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
		local v = hrp.AssemblyLinearVelocity
		if landing then
			hrp.AssemblyLinearVelocity = Vector3.new(v.X * 0.35, 0, v.Z * 0.35)
		else
			hrp.AssemblyLinearVelocity = Vector3.new(v.X * 0.5, math.min(v.Y, 0), v.Z * 0.5)
		end
		hrp.AssemblyAngularVelocity = Vector3.zero
		hum:ChangeState(landing and Enum.HumanoidStateType.Running or Enum.HumanoidStateType.Freefall)
	end

	local function update(dt)
		if not equipped or not model or not jK then return end
		local hrp, hum = getHRP(), getHum()
		if not hrp or not hum or hum.Health <= 0 then return end
		local t = os.clock()
		flapCD = math.max(0, flapCD - dt)
		unfold = math.min(1, unfold + dt * 1.5)
		if hum.FloorMaterial == Enum.Material.Air then airT = airT + dt else airT = 0 end
		if not gliding and airT > 0.35 and hrp.AssemblyLinearVelocity.Y < -55 then startGlide() end
		blend = math.clamp(blend + (gliding and dt * 2.6 or -dt * 2.6), 0, 1)
		local e = blend * blend * (3 - 2 * blend)
		jK.C0 = standC0:Lerp(flightC0, e)

		local fl = ((1 - unfold) ^ 2) * 1.25
		local sway = math.sin(t * 1.6) * 0.025
		local upR, upL = sway, sway
		flapAnim = math.max(0, flapAnim - dt * 2.2)
		local fd = 0
		if flapAnim > 0 then fd = -math.sin((1 - flapAnim) * math.pi) * 0.38 end

		if gliding then
			glideT = glideT + dt
			local md = hum.MoveDirection
			local steer, fwd = 0, 0
			if md.Magnitude > 0.1 then
				local lv = cam().CFrame:VectorToObjectSpace(md)
				steer, fwd = lv.X, -lv.Z
			end
			yaw = yaw - steer * dt * 1.55
			local pt = 0.12
			if fwd > 0.2 then pt = pt + 0.3 * fwd elseif fwd < -0.2 then pt = pt + 0.34 * fwd end
			pitch = pitch + (pt - pitch) * math.min(1, dt * 2.8)
			roll = roll + ((-steer * 0.65) - roll) * math.min(1, dt * 3.5)
			local tSpeed = math.clamp(46 + pitch * 115, 22, 98)
			speed = speed + (tSpeed - speed) * math.min(1, dt * 1.3)
			local sink = math.clamp(7 + pitch * 62, 1.2, 42)
			vyB = vyB * math.max(0, 1 - dt * 1.8)
			local dir = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))

			if glideT > 0.4 then
				local pv = hrp.AssemblyLinearVelocity
				local hv = Vector3.new(pv.X, 0, pv.Z).Magnitude
				if hv < speed * 0.28 then stuck = stuck + dt else stuck = 0 end
				if stuck > 0.4 then stopGlide(false); return end
			end
			if glideT > 0.3 then
				local hit = cast(hrp.Position, Vector3.new(0, -4.8, 0))
				if hit then stopGlide(true, hit); return end
			end

			hrp.AssemblyLinearVelocity = dir * speed + Vector3.new(0, -sink + vyB, 0)
			hrp.AssemblyAngularVelocity = Vector3.zero
			hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, roll)
				* CFrame.Angles(-pitch * 0.9, 0, 0) * CFrame.Angles(-math.pi / 2, 0, 0)

			if wind then wind.Rate = math.clamp((speed - 30) * 1.2, 0, 90) end
			local tr = speed > 48
			if trailR then trailR.Enabled = tr; trailL.Enabled = tr end
			local load = speed / 95 * 0.07
			upR = upR + load + math.max(0, roll) * 0.1
			upL = upL + load + math.max(0, -roll) * 0.1
			upR = upR + math.sin(t * 9) * 0.01 * (speed / 90)
			upL = upL + math.cos(t * 9) * 0.01 * (speed / 90)
		end
		jR.C0 = CFrame.Angles(0, 0, upR + fl + fd)
		jL.C0 = CFrame.Angles(0, 0, -(upL + fl + fd))
	end

	f.c(RS.RenderStepped, update)
	f.c(UIS.JumpRequest, function()
		if not equipped then return end
		if gliding then
			if flapCD <= 0 then
				flapCD = 1.1; vyB = 24; speed = math.min(speed + 10, 100); flapAnim = 1
			end
		elseif airT > 0.3 then
			startGlide()
		end
	end)
	tool.Equipped:Connect(function()
		equipped = true
		if model then return end
		local hrp = getHRP()
		if not hrp then return end
		build()
		jK = new("Weld", {Part0 = hrp, Part1 = keel, C0 = standC0, C1 = wingC1}, keel)
		unfold, blend = 0, 0
		local hum = getHum()
		if hum then
			hum.Died:Connect(function() gliding = false end)
		end
	end)
	tool.Unequipped:Connect(function()
		equipped = false
		stopGlide(false)
		destroyModel()
	end)
	f.x(function() stopGlide(false); destroyModel() end)
	return tool
end)

