local REMOTE_CLASSES = {
	RemoteEvent = true, RemoteFunction = true, UnreliableRemoteEvent = true,
	BindableEvent = true, BindableFunction = true,
}

-- Extrai linhas de código que mencionam os termos (só se Source for legível)
local function extractSnippets(scriptObj, src, store_)
	local perScript = 0
	for line in string.gmatch(src, "[^\r\n]+") do
		if perScript >= 8 or #store_ >= 40 then break end
		local hits = findHits(normalize(line), KEYWORDS)
		if #hits > 0 then
			perScript += 1
			table.insert(store_, {
				path = scriptObj:GetFullName(),
				line = clip(cleanText(line), 160),
				hits = hits,
			})
		end
	end
end

local function scanWorld()
	local out = {
		scanned = 0, names = {}, otherText = {}, prompts = {}, snippets = {},
		scriptsSeen = 0, scriptsReadable = 0, sourceBlocked = false,
	}
	local failures = 0
	for _, svc in ipairs(SERVICES_TO_SCAN) do
		local ok, list = pcall(function() return svc:GetDescendants() end)
		if ok then
			for _, d in ipairs(list) do
				out.scanned += 1
				if out.scanned % 1500 == 0 then task.wait() end

				-- (a) nome do objeto contém termo?
				local nameHits = findHits(normalize(d.Name), KEYWORDS)
				if #nameHits > 0 and #out.names < CONFIG.MAX_ENTRIES then
					table.insert(out.names, { path = d:GetFullName(), class = d.ClassName, hits = nameHits })
				end

				if d:IsA("LuaSourceContainer") then
					-- (b) tenta ler o código (em jogos normais o cliente NÃO consegue)
					out.scriptsSeen += 1
					if not out.sourceBlocked then
						local okSrc, src = pcall(function() return d.Source end)
						if okSrc and type(src) == "string" and #src > 0 then
							out.scriptsReadable += 1
							extractSnippets(d, src, out.snippets)
						else
							failures += 1
							if failures >= 5 and out.scriptsReadable == 0 then out.sourceBlocked = true end
						end
					end
				elseif isTextObject(d) then
					-- (c) textos fora do PlayerGui (modelos em StarterGui, SurfaceGui, etc.)
					local hits = findHits(normalize(d.Text), KEYWORDS)
					if #hits > 0 and #out.otherText < CONFIG.MAX_ENTRIES then
						table.insert(out.otherText, {
							path = d:GetFullName(), class = d.ClassName,
							text = cleanText(d.Text), hits = hits,
						})
					end
				elseif d:IsA("ProximityPrompt") then
					-- (d) prompts de interação (ex.: "Soltar preso")
					local combined = d.ActionText .. " " .. d.ObjectText
					local hits = findHits(normalize(combined), KEYWORDS)
					if #hits > 0 and #out.prompts < CONFIG.MAX_ENTRIES then
						table.insert(out.prompts, {
							path = d:GetFullName(),
							action = d.ActionText, object = d.ObjectText, hits = hits,
						})
					end
				end
			end
		end
	end
	return out
end

-- Atributos e valores (leaderstats etc.) do jogador, personagem e Workspace
local function scanPlayerData()
	local out = {}
	local function checkAttrs(inst, label)
		for k, v in pairs(inst:GetAttributes()) do
			local hits = findHits(normalize(k .. " " .. tostring(v)), KEYWORDS)
			if #hits > 0 then
				table.insert(out, { kind = "Atributo", where = label, name = k, value = tostring(v), hits = hits })
			end
		end
	end
	local function checkValues(root, label)
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("ValueBase") then
				local okV, val = pcall(function() return d.Value end)
				local hits = findHits(normalize(d.Name .. " " .. tostring(okV and val or "")), KEYWORDS)
				if #hits > 0 then
					table.insert(out, { kind = "Valor", where = d:GetFullName(), name = d.Name,
						value = tostring(okV and val or "?"), hits = hits })
				end
			end
		end
	end
	checkAttrs(player, "Player")
	checkAttrs(Workspace, "Workspace")
	checkValues(player, "Player")
	if player.Character then
		checkAttrs(player.Character, "Character")
		checkValues(player.Character, "Character")
	end
	return out
end

