local function footGlow()
	toggle("Pegadas de Luz", function()
		local add, clean = bag(); local last = 0
		add(RS.Heartbeat:Connect(function()
			local h, r = hum(), hrp(); if not (h and r) then return end
			if h.MoveDirection.Magnitude > 0 and h.FloorMaterial ~= Enum.Material.Air and os.clock() - last > 0.12 then
				last = os.clock()
				local p = Instance.new("Part")
				p.Shape, p.Anchored, p.CanCollide, p.Material = Enum.PartType.Cylinder, true, false, Enum.Material.Neon
				p.Color, p.Size = Color3.fromHSV(os.clock() % 2 / 2, 1, 1), Vector3.new(0.1, 1.5, 1.5)
				p.CFrame = CFrame.new(r.Position - Vector3.new(0, h.HipHeight + r.Size.Y / 2 - 0.05, 0)) * CFrame.Angles(0, 0, math.pi / 2)
				p.Parent = workspace
				TS:Create(p, TweenInfo.new(0.8), {Transparency = 1, Size = Vector3.new(0.1, 3, 3)}):Play()
				Debris:AddItem(p, 0.9)
			end
		end))
		return clean
	end)
end

