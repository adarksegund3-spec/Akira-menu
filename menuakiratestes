local function instPath(inst)
    local p, cur = {}, inst
    while cur and cur ~= game do
        table.insert(p, 1, cur.Name)
        cur = cur.Parent
    end
    return p
end

local function resolvePath(p)
    if type(p) ~= "table" or #p == 0 then return nil end
    local cur = game
    for _, name in ipairs(p) do
        local nxt = cur:FindFirstChild(name)
        if not nxt then cur = nil break end
        cur = nxt
    end
    if cur then return cur end
    local ok, found = pcall(function() return workspace:FindFirstChild(p[#p], true) end)
    return ok and found or nil
end

local function ser(v, depth)
    depth = depth or 0
    local t = typeof(v)
    if t == "number" then
        if v ~= v or v == math.huge or v == -math.huge then return 0 end
        return v
    elseif t == "string" or t == "boolean" then return v
    elseif t == "Vector3" then return { __t = "V3", x = v.X, y = v.Y, z = v.Z }
    elseif t == "Vector2" then return { __t = "V2", x = v.X, y = v.Y }
    elseif t == "CFrame" then return { __t = "CF", c = { v:GetComponents() } }
    elseif t == "Color3" then return { __t = "C3", r = v.R, g = v.G, b = v.B }
    elseif t == "Instance" then return { __t = "I", p = instPath(v) }
    elseif t == "EnumItem" then return { __t = "E", e = tostring(v) }
    elseif t == "table" then
        if depth > 4 then return { __t = "N" } end
        local arr, map = {}, {}
        for i, val in ipairs(v) do arr[i] = ser(val, depth + 1) end
        for k, val in pairs(v) do
            if type(k) == "string" then map[k] = ser(val, depth + 1) end
        end
        return { __t = "T", arr = arr, map = map }
    end
    return { __t = "N" }
end

local function deser(v)
    if type(v) ~= "table" then return v end
    local t = v.__t
    if t == "V3" then return Vector3.new(v.x, v.y, v.z)
    elseif t == "V2" then return Vector2.new(v.x, v.y)
    elseif t == "CF" then return CFrame.new(unpack(v.c))
    elseif t == "C3" then return Color3.new(v.r, v.g, v.b)
    elseif t == "I" then return resolvePath(v.p)
    elseif t == "E" then
        local _, _, en, name = string.find(v.e or "", "Enum%.(%w+)%.(%w+)")
        local ok, item = pcall(function() return Enum[en][name] end)
        return ok and item or nil
    elseif t == "T" then
        local out = {}
        for i, val in ipairs(v.arr or {}) do out[i] = deser(val) end
        for k, val in pairs(v.map or {}) do out[k] = deser(val) end
        return out
    end
    return nil
end

--[[ === SEÇÃO 4: PERSISTÊNCIA === ]]
local function encode(v)
    local ok, r = pcall(HttpService.JSONEncode, HttpService, v)
    return ok and r or nil
end
local function decode(s)
    local ok, r = pcall(HttpService.JSONDecode, HttpService, s)
    if ok then return r end
end
local function sanitize(n) return (tostring(n):gsub("[^%w_%-]", "_")) end
local function routeFile(route) return "RouteHub_" .. sanitize(route.name) .. ".json" end

local function saveAll()
    Data.settings = S
    genv.RouteHubData = Data
    if API.writefile then
        local js = encode(Data)
        if js then pcall(API.writefile, DATA_FILE, js) end
    end
end
local function saveRouteFile(route)
    if not API.writefile then return end
    local js = encode(route)
    if js then pcall(API.writefile, routeFile(route), js) end
end
local function deleteRouteFile(route)
    if not (API.delfile and API.isfile) then return end
    pcall(function()
        local f = routeFile(route)
        if API.isfile(f) then API.delfile(f) end
    end)
end
local function loadAll()
    local src = genv.RouteHubData
    if not (type(src) == "table" and type(src.routes) == "table") then
        src = nil
        if API.isfile and API.readfile then
            local ok, exists = pcall(API.isfile, DATA_FILE)
            if ok and exists then
                local ok2, raw = pcall(API.readfile, DATA_FILE)
                if ok2 then
                    local dec = decode(raw)
                    if type(dec) == "table" then src = dec end
                end
            end
        end
    end
    if src then
        Data.routes = type(src.routes) == "table" and src.routes or {}
        if type(src.settings) == "table" then
            for k, v in pairs(src.settings) do
                if Defaults[k] ~= nil and type(v) == type(Defaults[k]) then S[k] = v end
            end
        end
    end
end

--[[ === SEÇÃO 5: HELPERS DE UI, TOASTS === ]]
local function new(class, props, parent)
    local o = Instance.new(class)
    if props then for k, v in pairs(props) do o[k] = v end end
    if parent then o.Parent = parent end
    return o
end
local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end
local function stroke(o, color, alpha, th)
    return new("UIStroke", { Color = color or C.accent, Transparency = alpha or 0.7, Thickness = th or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
local function gradient(o, c1, c2, rot)
    return new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rot or 0 }, o)
end
local function tween(o, t, props, style, dir)
    local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end
local function label(parent, text, size, pos, font, ts, color, align)
    return new("TextLabel", {
        Text = text, Size = size, Position = pos or UDim2.new(), BackgroundTransparency = 1,
        Font = font or Enum.Font.Gotham, TextSize = ts or 13, TextColor3 = color or C.text,
        TextXAlignment = align or Enum.TextXAlignment.Left, BorderSizePixel = 0,
    }, parent)
end
local function makeButton(parent, text, size, pos, color, textColor)
    local base = color or C.accent
    local b = new("TextButton", {
        Text = text, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = textColor or C.text,
        BackgroundColor3 = base, AutoButtonColor = false, Size = size, Position = pos or UDim2.new(),
        BorderSizePixel = 0,
    }, parent)
    b:SetAttribute("Base", base)
    corner(b, 10)
    b.MouseEnter:Connect(function() tween(b, 0.12, { BackgroundColor3 = b:GetAttribute("Base"):Lerp(Color3.new(1, 1, 1), 0.14) }) end)
    b.MouseLeave:Connect(function() tween(b, 0.12, { BackgroundColor3 = b:GetAttribute("Base") }) end)
    return b
end
-- Define a ordem do item dentro de uma lista (UIListLayout)
local function ord(obj)
    local p = obj.Parent
    local n = (p:GetAttribute("n") or 0) + 1
    p:SetAttribute("n", n)
    obj.LayoutOrder = n
    return obj
end

local Toast = { container = nil }
function Toast.show(msg, kind)
    if not Toast.container then return end
    local col = (kind == "success" and C.success) or (kind == "error" and C.danger) or C.accent
    local g = new("CanvasGroup", { Size = UDim2.new(0, 260, 0, 34), BackgroundColor3 = C.panel,
        GroupTransparency = 1, BorderSizePixel = 0 }, Toast.container)
    corner(g, 10)
    stroke(g, col, 0.3)
    new("Frame", { Size = UDim2.new(0, 4, 1, 0), BackgroundColor3 = col, BorderSizePixel = 0 }, g)
    local l = label(g, tostring(msg), UDim2.new(1, -18, 1, 0), UDim2.new(0, 12, 0, 0), Enum.Font.GothamBold, 12)
    l.TextTruncate = Enum.TextTruncate.AtEnd
    tween(g, 0.2, { GroupTransparency = 0 })
    task.delay(2.8, function()
        if g and g.Parent then
            local tw = tween(g, 0.3, { GroupTransparency = 1 })
            tw.Completed:Connect(function() if g then g:Destroy() end end)
        end
    end)
end

--[[ === SEÇÃO 6: DIAGNÓSTICO (BOTÃO VISÍVEL, RESULTADO NA TELA) === ]]
local Diag = { running = false, report = nil }

local function esc(s) return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end
local function hex(c) return string.format("#%02x%02x%02x", c.R * 255, c.G * 255, c.B * 255) end
local function colored(c, s) return '<font color="' .. hex(c) .. '">' .. s .. "</font>" end

function Diag.run()
    if Diag.running then return end
    Diag.running = true
    UI.setDiagText(colored(C.accent2, "<b>Escaneando o jogo...</b>") .. "\nAguarde alguns segundos.")
    task.spawn(function()
        local rep, L = {}, {}
        local function head(t) L[#L + 1] = "\n" .. colored(C.accent2, "<b>" .. t .. "</b>") end
        local function ok(t) L[#L + 1] = colored(C.success, "● ") .. t end
        local function warnL(t) L[#L + 1] = colored(C.warn, "● ") .. t end
        local function bad(t) L[#L + 1] = colored(C.danger, "● ") .. t end
        local function step(name, fn)
            local good, err = pcall(fn)
            if not good then bad("Falha ao inspecionar " .. name .. ": " .. esc(err)) end
        end

        head("EXECUTOR")
        step("executor", function()
            rep.hook = (API.hookmetamethod and API.getnamecallmethod) and true or false
            rep.firePrompt = API.fireproximityprompt and true or false
            rep.fireTouch = API.firetouchinterest and true or false
            rep.fireClick = API.fireclickdetector and true or false
            rep.getconn = API.getconnections and true or false
            rep.vim = VIM and true or false
            rep.files = API.writefile and true or false
            ;(rep.hook and ok or warnL)("Hook de Remotes (hookmetamethod): " .. (rep.hook and "sim" or "não — Remotes não serão gravados"))
            ;(rep.firePrompt and ok or warnL)("fireproximityprompt: " .. (rep.firePrompt and "sim" or "não (uso InputHold)"))
            ;(rep.getconn and ok or warnL)("getconnections (clicar botões da loja): " .. (rep.getconn and "sim" or "não (uso clique virtual)"))
            ;(rep.vim and ok or warnL)("VirtualInputManager: " .. (rep.vim and "sim" or "não"))
            ;(rep.files and ok or warnL)("Salvar em arquivo: " .. (rep.files and "sim" or "não — só memória"))
        end)

        head("PERSONAGEM")
        step("personagem", function()
            local char, hum, root = getChar(), getHum(), getRoot()
            if not (char and hum and root) then error("personagem não carregado") end
            rep.walkSpeed = hum.WalkSpeed
            rep.useJumpPower = hum.UseJumpPower
            ok(string.format("WalkSpeed: %.0f", hum.WalkSpeed))
            ok("Pulo: " .. (hum.UseJumpPower and ("JumpPower " .. hum.JumpPower) or ("JumpHeight " .. hum.JumpHeight)))
            local animator = hum:FindFirstChildOfClass("Animator")
            local tracks = animator and animator:GetPlayingAnimationTracks() or {}
            local animate = char:FindFirstChild("Animate")
            rep.walkAnim = ((animate and animate:FindFirstChild("walk")) ~= nil) or #tracks > 0
            ;(rep.walkAnim and ok or warnL)("Animações de caminhada: " .. (rep.walkAnim and "detectadas" or "não encontradas"))
            rep.pathOk = pcall(function()
                local p = PathfindingService:CreatePath()
                p:ComputeAsync(root.Position, root.Position + Vector3.new(0, 0, 10))
            end)
            ;(rep.pathOk and ok or warnL)("Pathfinding (andar até o ponto inicial): " .. (rep.pathOk and "funciona" or "indisponível, uso caminho direto"))
        end)

        head("TELA / BOTÕES")
        step("PlayerGui", function()
            rep.touchEnabled = UIS.TouchEnabled
            ok("Toque na tela: " .. (UIS.TouchEnabled and "sim" or "não"))
            local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
            local total, sprint, shop = 0, {}, {}
            local n = 0
            if pg then
                for _, o in ipairs(pg:GetDescendants()) do
                    if o:IsA("GuiButton") then
                        total += 1
                        local s = (o.Name .. " " .. (o:IsA("TextButton") and o.Text or "")):lower()
                        if (s:find("sprint") or s:find("run") or s:find("correr") or s:find("corrida")) and #sprint < 5 then
                            sprint[#sprint + 1] = o.Name
                        end
                        if (s:find("shop") or s:find("loja") or s:find("buy") or s:find("compr") or s:find("store")) and #shop < 5 then
                            shop[#shop + 1] = o.Name
                        end
                    end
                    n += 1
                    if n % 1000 == 0 then task.wait() end
                end
            end
            rep.guiButtons, rep.sprintButtons, rep.shopButtons = total, #sprint, #shop
            ok("Botões na tela do jogo: " .. total)
            ;(#sprint > 0 and ok or warnL)("Botão de correr: " .. (#sprint > 0 and esc(table.concat(sprint, ", ")) or "não encontrado"))
            if #shop > 0 then ok("Botões de loja/compra: " .. esc(table.concat(shop, ", "))) end
        end)

        head("REMOTES E INTERAÇÕES")
        step("Remotes/Prompts", function()
            local counts = { RemoteEvent = 0, RemoteFunction = 0, BindableEvent = 0,
                ProximityPrompt = 0, ClickDetector = 0, TouchTransmitter = 0 }
            local remotes, prompts = {}, {}
            local n = 0
            for _, root in ipairs({ ReplicatedStorage, ReplicatedFirst, workspace }) do
                for _, o in ipairs(root:GetDescendants()) do
                    local cn = o.ClassName
                    if counts[cn] ~= nil then
                        counts[cn] += 1
                        if cn == "RemoteEvent" and #remotes < 12 then remotes[#remotes + 1] = o.Name end
                        if cn == "ProximityPrompt" and #prompts < 8 then
                            prompts[#prompts + 1] = string.format("%s (%s, hold %.1fs)", o.Parent and o.Parent.Name or "?",
                                o.ActionText ~= "" and o.ActionText or "sem texto", o.HoldDuration)
                        end
                    end
                    n += 1
                    if n % 1500 == 0 then task.wait() end
                end
            end
            rep.remoteEvents, rep.remoteFunctions = counts.RemoteEvent, counts.RemoteFunction
            rep.prompts, rep.clickDetectors, rep.touchInterests = counts.ProximityPrompt, counts.ClickDetector, counts.TouchTransmitter
            ok("RemoteEvents: " .. counts.RemoteEvent .. " | RemoteFunctions: " .. counts.RemoteFunction)
            if #remotes > 0 then L[#L + 1] = "   " .. colored(C.muted, esc(table.concat(remotes, ", ") .. (counts.RemoteEvent > #remotes and ", ..." or ""))) end
            ok("ProximityPrompts: " .. counts.ProximityPrompt)
            for _, p in ipairs(prompts) do L[#L + 1] = "   " .. colored(C.muted, esc(p)) end
            ok("ClickDetectors: " .. counts.ClickDetector .. " | TouchInterest: " .. counts.TouchTransmitter)
        end)

        head("FERRAMENTAS")
        step("Tools", function()
            local names = {}
            local bp, char = LocalPlayer:FindFirstChildOfClass("Backpack"), getChar()
            for _, holder in ipairs({ bp, char }) do
                if holder then for _, t in ipairs(holder:GetChildren()) do
                    if t:IsA("Tool") then names[#names + 1] = t.Name end
                end end
            end
            rep.tools = #names
            ok("Tools equipáveis: " .. #names .. (#names > 0 and (" — " .. esc(table.concat(names, ", "))) or ""))
        end)

        head("O QUE A GRAVAÇÃO VAI CAPTURAR")
        L[#L + 1] = colored(C.success, "● ") .. "Caminhada e pulos (posição por posição)"
        L[#L + 1] = colored(C.success, "● ") .. "Mudanças de velocidade (correr)"
        if rep.hook and (rep.remoteEvents or 0) > 0 then L[#L + 1] = colored(C.success, "● ") .. "Remotes disparados por você" end
        if (rep.prompts or 0) > 0 then L[#L + 1] = colored(C.success, "● ") .. "ProximityPrompts (segurar / acionar)" end
        if (rep.guiButtons or 0) > 0 then L[#L + 1] = colored(C.success, "● ") .. "Cliques em botões do jogo (loja etc.)" end
        if (rep.clickDetectors or 0) > 0 then L[#L + 1] = colored(C.success, "● ") .. "ClickDetectors" end
        if (rep.touchInterests or 0) > 0 then L[#L + 1] = colored(C.success, "● ") .. "Peças de toque (TouchInterest)" end
        if (rep.tools or 0) > 0 then L[#L + 1] = colored(C.success, "● ") .. "Equipar / usar ferramentas" end

        Diag.report = rep
        genv.RouteHubDiag = rep
        UI.setDiagText(table.concat(L, "\n"))
        Diag.running = false
        Toast.show("Diagnóstico concluído", "success")
    end)
end

--[[ === SEÇÃO 7: GRAVAÇÃO === ]]
local IGNORE_KEYS = {
    [Enum.KeyCode.W] = true, [Enum.KeyCode.A] = true, [Enum.KeyCode.S] = true, [Enum.KeyCode.D] = true,
    [Enum.KeyCode.Up] = true, [Enum.KeyCode.Down] = true, [Enum.KeyCode.Left] = true, [Enum.KeyCode.Right] = true,
    [Enum.KeyCode.Space] = true, [Enum.KeyCode.LeftShift] = true, [Enum.KeyCode.RightShift] = true,
    [Enum.KeyCode.LeftControl] = true, [Enum.KeyCode.Unknown] = true,
} -- movimento é gravado por posição; essas teclas só atrapalhariam o replay

local Recorder = {
    active = false, events = {}, t0 = 0, conns = {}, charConns = {},
    boundTools = setmetatable({}, { __mode = "k" }), seenTracks = setmetatable({}, { __mode = "k" }),
    keysDown = {}, startPos = nil, baseWS = 16, lastWS = 16,
    lastP = Vector3.zero, wasMoving = false, lastMoveMs = 0, lastCamMs = 0, lastCF = nil,
}

function Recorder.add(typ, data)
    if not Recorder.active then return nil end
    local ev = { t = math.floor((os.clock() - Recorder.t0) * 1000), type = typ, data = data }
    Recorder.events[#Recorder.events + 1] = ev
    return ev
end

local function pointerInfo(input)
    local inset = GuiService:GetGuiInset()
    local px, py, sx, sy
    if input.UserInputType == Enum.UserInputType.Touch then
        px, py = input.Position.X, input.Position.Y
        sx, sy = px + inset.X, py + inset.Y
    else
        local m = UIS:GetMouseLocation()
        sx, sy = m.X, m.Y
        px, py = sx - inset.X, sy - inset.Y
    end
    return px, py, sx, sy
end

local function overOurs(sx, sy)
    for _, f in ipairs({ UI.menu, UI.logo }) do
        if f and f.Parent and f.Visible then
            local ap, as = f.AbsolutePosition, f.AbsoluteSize
            if sx >= ap.X and sx <= ap.X + as.X and sy >= ap.Y and sy <= ap.Y + as.Y then return true end
        end
    end
    return false
end

local function findGameButton(px, py, sx, sy)
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return nil end
    for _, pos in ipairs({ Vector2.new(px, py), Vector2.new(sx, sy) }) do
        local ok, objs = pcall(pg.GetGuiObjectsAtPosition, pg, pos.X, pos.Y)
        if ok then
            for _, o in ipairs(objs) do
                local mine = (UI.gui and o:IsDescendantOf(UI.gui)) or (UI.logoGui and o:IsDescendantOf(UI.logoGui))
                if o:IsA("GuiButton") and o.Visible and not mine then return o end
            end
        end
    end
    return nil
end

function Recorder.onInputBegan(input, gpe)
    local ut = input.UserInputType
    if ut == Enum.UserInputType.Keyboard then
        if gpe then return end
        local kc = input.KeyCode
        if IGNORE_KEYS[kc] then return end
        Recorder.keysDown[kc] = os.clock()
        Recorder.add("KeyDown", { k = kc.Name })
    elseif ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.Touch then
        local px, py, sx, sy = pointerInfo(input)
        if overOurs(sx, sy) then return end
        local btn = findGameButton(px, py, sx, sy) -- só botões do jogo (loja etc.); toques soltos são ignorados
        if btn then Recorder.add("Click", { btn = instPath(btn), nm = btn.Name }) end
    end
end

function Recorder.onInputEnded(input)
    local kc = input.KeyCode
    local since = Recorder.keysDown[kc]
    if since then
        Recorder.keysDown[kc] = nil
        Recorder.add("KeyUp", { k = kc.Name, dur = math.floor((os.clock() - since) * 1000) })
    end
end

function Recorder.logTrack(track)
    if Recorder.seenTracks[track] then return end
    Recorder.seenTracks[track] = true
    local anim = track.Animation
    Recorder.add("Animation", { id = anim and anim.AnimationId or "", pr = track.Priority.Name,
        sp = r3(track.Speed), w = r3(track.WeightTarget) })
end

local function addConn(list, sig, fn)
    local c = sig:Connect(fn)
    list[#list + 1] = c
    return c
end

function Recorder.unbindChar()
    for _, c in ipairs(Recorder.charConns) do pcall(function() c:Disconnect() end) end
    Recorder.charConns = {}
end

function Recorder.bindTool(tool)
    if Recorder.boundTools[tool] then return end
    Recorder.boundTools[tool] = true
    local L = Recorder.charConns
    addConn(L, tool.Equipped, function() Recorder.add("ToolActivated", { n = tool.Name, ev = "Equipped" }) end)
    addConn(L, tool.Unequipped, function() Recorder.add("ToolActivated", { n = tool.Name, ev = "Unequipped" }) end)
    addConn(L, tool.Activated, function() Recorder.add("ToolActivated", { n = tool.Name, ev = "Activated" }) end)
end

-- Reconecta ao respawnar durante a gravação
function Recorder.bindCharacter(char)
    Recorder.unbindChar()
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 5)
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not hum or not Recorder.active then return end
    local L = Recorder.charConns
    addConn(L, hum.Jumping, function(active) if active then Recorder.add("Jump", {}) end end)
    if S.recordAnim then
        local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 3)
        if animator then addConn(L, animator.AnimationPlayed, Recorder.logTrack) end
    end
    for _, t in ipairs(char:GetChildren()) do if t:IsA("Tool") then Recorder.bindTool(t) end end
    addConn(L, char.ChildAdded, function(t) if t:IsA("Tool") then Recorder.bindTool(t) end end)
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then Recorder.bindTool(t) end end
        addConn(L, bp.ChildAdded, function(t) if t:IsA("Tool") then Recorder.bindTool(t) end end)
    end
    local rep = Diag.report
    if root and rep and (rep.touchInterests or 0) > 0 then
        local last = {}
        addConn(L, root.Touched, function(part)
            if not part:FindFirstChildOfClass("TouchTransmitter") then return end
            local now = os.clock()
            if last[part] and now - last[part] < 0.5 then return end
            last[part] = now
            Recorder.add("TouchPart", { p = instPath(part) })
        end)
    end
end

function Recorder.sample()
    if not Recorder.active then return end
    local nowMs = math.floor((os.clock() - Recorder.t0) * 1000)
    local hum, root = getHum(), getRoot()
    if hum and root and nowMs - Recorder.lastMoveMs >= S.moveSampleRateMs then
        Recorder.lastMoveMs = nowMs
        local p = root.Position
        local moving = hum.MoveDirection.Magnitude > 0.05
        if (moving and (p - Recorder.lastP).Magnitude >= 0.4) or (not moving and Recorder.wasMoving) then
            Recorder.add("Move", { p = { r3(p.X), r3(p.Y), r3(p.Z) } })
            Recorder.lastP = p
        end
        Recorder.wasMoving = moving
        local ws = hum.WalkSpeed
        if math.abs(ws - Recorder.lastWS) > 0.01 then
            Recorder.lastWS = ws
            Recorder.add("Sprint", { ws = r3(ws), on = ws > Recorder.baseWS + 0.5 })
        end
    end
    if S.recordCamera and nowMs - Recorder.lastCamMs >= 100 then
        Recorder.lastCamMs = nowMs
        local c = cam()
        if c and (not Recorder.lastCF or (c.CFrame.Position - Recorder.lastCF.Position).Magnitude > 0.05
            or c.CFrame.LookVector:Dot(Recorder.lastCF.LookVector) < 0.9999) then
            Recorder.lastCF = c.CFrame
            local comps = { c.CFrame:GetComponents() }
            for i = 1, #comps do comps[i] = r4(comps[i]) end
            Recorder.add("Camera", { c = comps })
        end
    end
end

-- Remotes: hook em __namecall (instalado uma única vez, logger trocável)
local function remoteLogger(remote, method, args)
    if not Recorder.active or State.mode == "replay" then return end
    pcall(function()
        if typeof(remote) ~= "Instance" then return end
        if not (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then return end
        local list = {}
        for i = 1, args.n do list[i] = ser(args[i]) end
        Recorder.add("Remote", { p = instPath(remote), m = method, n = args.n, a = list, nm = remote.Name })
    end)
end

local function installRemoteHook()
    if genv.RouteHubHookInstalled then return true end
    if not (API.hookmetamethod and API.getnamecallmethod) then return false end
    local wrap = API.newcclosure or function(f) return f end
    local old
    local ok = pcall(function()
        old = API.hookmetamethod(game, "__namecall", wrap(function(self, ...)
            local m = API.getnamecallmethod()
            if m == "FireServer" or m == "InvokeServer" then
                local lg = genv.RouteHubRemoteLogger
                if lg then task.defer(lg, self, m, table.pack(...)) end -- fora do hook
            end
            return old(self, ...)
        end))
    end)
    if ok then genv.RouteHubHookInstalled = true end
    return ok
end

function Recorder.bindClickDetectors()
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("ClickDetector") then
            pcall(function()
                addConn(Recorder.conns, o.MouseClick, function()
                    Recorder.add("ClickDetector", { p = instPath(o) })
                end)
            end)
        end
    end
end

function Recorder.start()
    if Recorder.active then return false end
    local root = getRoot()
    if not (root and getHum()) then return false end
    Recorder.events, Recorder.keysDown = {}, {}
    Recorder.boundTools = setmetatable({}, { __mode = "k" })
    Recorder.seenTracks = setmetatable({}, { __mode = "k" })
    Recorder.t0 = os.clock()
    Recorder.startPos = root.Position
    Recorder.lastP = root.Position
    Recorder.wasMoving = false
    Recorder.lastMoveMs, Recorder.lastCamMs, Recorder.lastCF = -1000, -1000, nil
    local ws = getHum().WalkSpeed
    Recorder.baseWS, Recorder.lastWS = math.min(ws, 16), ws
    Recorder.active = true

    genv.RouteHubRemoteLogger = remoteLogger
    installRemoteHook()

    local L = Recorder.conns
    addConn(L, UIS.InputBegan, Recorder.onInputBegan)
    addConn(L, UIS.InputEnded, Recorder.onInputEnded)
    addConn(L, RunService.Heartbeat, Recorder.sample)

    local holds = {}
    addConn(L, PPS.PromptButtonHoldBegan, function(prompt, plr)
        if plr ~= LocalPlayer then return end
        holds[prompt] = Recorder.add("PromptHold", { p = instPath(prompt), dur = prompt.HoldDuration })
    end)
    addConn(L, PPS.PromptButtonHoldEnded, function(prompt, plr)
        if plr ~= LocalPlayer then return end
        local ev = holds[prompt]
        holds[prompt] = nil
        if ev then ev.data.dur = math.max((math.floor((os.clock() - Recorder.t0) * 1000) - ev.t) / 1000, 0) end
    end)
    addConn(L, PPS.PromptTriggered, function(prompt, plr)
        if plr ~= LocalPlayer then return end
        Recorder.add("PromptTriggered", { p = instPath(prompt), hd = prompt.HoldDuration })
    end)

    local rep = Diag.report
    if rep and (rep.clickDetectors or 0) > 0 then task.spawn(Recorder.bindClickDetectors) end
    task.spawn(Recorder.bindCharacter, getChar())
    return true
end

function Recorder.stop()
    if not Recorder.active then return nil end
    local duration = math.floor((os.clock() - Recorder.t0) * 1000)
    Recorder.active = false
    for _, c in ipairs(Recorder.conns) do pcall(function() c:Disconnect() end) end
    Recorder.conns = {}
    Recorder.unbindChar()
    local okG, guid = pcall(HttpService.GenerateGUID, HttpService, false)
    local sp = Recorder.startPos
    local route = {
        id = okG and guid or tostring(os.time()), name = "Rota_" .. os.time(), created = os.time(),
        duration = duration, count = #Recorder.events, events = Recorder.events,
        startPos = sp and { r3(sp.X), r3(sp.Y), r3(sp.Z) } or nil,
        baseWalkSpeed = Recorder.baseWS, placeId = game.PlaceId,
    }
    Recorder.events = {}
    return route
end

--[[ === SEÇÃO 8: REPLAY (ANDA ATÉ O PONTO INICIAL, SEM TELEPORTE) === ]]
local Replay = { running = false, cancel = false, route = nil, status = "" }
local RS = { heldKeys = {}, animCache = {}, recentHold = {}, origWS = nil,
    camTarget = nil, camSet = false, origCamType = nil }
local ReplayAnimPriorities = { Action = true, Action2 = true, Action3 = true, Action4 = true }
local Exec = {}

local function hMoveTo(pos)
    local h = getHum()
    if h then h:MoveTo(pos) end
end

local function flatDist(a, b) return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude end

-- Anda (de verdade) até pos usando Pathfinding quando possível; nunca teleporta
local function walkTo(pos, timeout)
    local root = getRoot()
    if not (root and getHum()) then return false end
    local deadline = os.clock() + timeout
    local function arrived()
        local r = getRoot()
        return r ~= nil and flatDist(r.Position, pos) < 4 and math.abs(r.Position.Y - pos.Y) < 10
    end
    if arrived() then return true end

    local waypoints
    local okP = pcall(function()
        local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
        path:ComputeAsync(root.Position, pos)
        if path.Status == Enum.PathStatus.Success then waypoints = path:GetWaypoints() end
    end)
    if okP and waypoints then
        for _, wp in ipairs(waypoints) do
            if Replay.cancel or os.clock() > deadline then break end
            local h = getHum()
            if not h then break end
            if wp.Action == Enum.PathWaypointAction.Jump then h.Jump = true end
            h:MoveTo(wp.Position)
            local t0 = os.clock()
            while not Replay.cancel and os.clock() - t0 < 3 do
                local r = getRoot()
                if not r or flatDist(r.Position, wp.Position) < 3.5 then break end
                RunService.Heartbeat:Wait()
            end
        end
    end
    -- Aproximação final direta (também é o fallback sem Pathfinding)
    while not Replay.cancel and os.clock() < deadline and not arrived() do
        hMoveTo(pos) -- MoveTo expira em ~8s, então reemite
        local t0 = os.clock()
        while not Replay.cancel and os.clock() - t0 < 2 and not arrived() do RunService.Heartbeat:Wait() end
    end
    return arrived()
end

local function fireGuiButton(obj)
    if not API.getconnections then return 0 end
    local fired = 0
    for _, sigName in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down", "MouseButton1Up" }) do
        pcall(function()
            for _, c in ipairs(API.getconnections(obj[sigName])) do c:Fire() fired += 1 end
        end)
    end
    return fired
end

local function clickGuiObject(obj)
    if fireGuiButton(obj) > 0 then return end -- mais confiável para botões de loja
    if not VIM then return end
    local ap, as = obj.AbsolutePosition, obj.AbsoluteSize
    local sg = obj:FindFirstAncestorOfClass("ScreenGui")
    local inset = (sg and sg.IgnoreGuiInset) and Vector2.zero or GuiService:GetGuiInset()
    local x, y = ap.X + as.X / 2 + inset.X, ap.Y + as.Y / 2 + inset.Y
    pcall(function() VIM:SendTouchEvent(0, 0, x, y) end)
    pcall(function() VIM:SendMouseButtonEvent(x, y, 0, true, game, 0) end)
    task.wait(0.05)
    pcall(function() VIM:SendTouchEvent(0, 2, x, y) end)
    pcall(function() VIM:SendMouseButtonEvent(x, y, 0, false, game, 0) end)
end

function Exec.Move(ev)
    local p = ev.data.p
    if p then hMoveTo(Vector3.new(p[1], p[2], p[3])) end
end
function Exec.Sprint(ev)
    local h = getHum()
    if h and ev.data.ws then h.WalkSpeed = ev.data.ws end
end
function Exec.Jump() local h = getHum() if h then h.Jump = true end end

function Exec.Camera(ev)
    local c = cam()
    if not c then return end
    if not RS.camSet then
        RS.origCamType = c.CameraType
        c.CameraType = Enum.CameraType.Scriptable
        RS.camSet = true
    end
    RS.camTarget = CFrame.new(unpack(ev.data.c))
end

function Exec.KeyDown(ev)
    local kc = Enum.KeyCode[ev.data.k]
    if not (VIM and kc) then return end
    RS.heldKeys[ev.data.k] = true
    VIM:SendKeyEvent(true, kc, false, game)
end
function Exec.KeyUp(ev)
    local kc = Enum.KeyCode[ev.data.k]
    if not (VIM and kc) then return end
    RS.heldKeys[ev.data.k] = nil
    VIM:SendKeyEvent(false, kc, false, game)
end

function Exec.Click(ev)
    local obj = resolvePath(ev.data.btn)
    if obj and obj:IsA("GuiObject") then task.spawn(clickGuiObject, obj) end
end

function Exec.Animation(ev)
    local d = ev.data
    if not ReplayAnimPriorities[d.pr] or not d.id or d.id == "" then return end
    local h = getHum()
    local animator = h and h:FindFirstChildOfClass("Animator")
    if not animator then return end
    local track = RS.animCache[d.id]
    if not track then
        local a = Instance.new("Animation")
        a.AnimationId = d.id
        track = animator:LoadAnimation(a)
        RS.animCache[d.id] = track
    end
    pcall(function() track.Priority = Enum.AnimationPriority[d.pr] end)
    track:Stop(0)
    track:Play(0.1, d.w or 1, d.sp or 1)
end

function Exec.Remote(ev)
    local d = ev.data
    local remote = resolvePath(d.p)
    if not remote then return end
    local args = {}
    for i = 1, d.n or 0 do args[i] = deser(d.a[i]) end
    if d.m == "InvokeServer" and remote:IsA("RemoteFunction") then
        task.spawn(function() pcall(function() remote:InvokeServer(unpack(args, 1, d.n or 0)) end) end)
    elseif remote:IsA("RemoteEvent") then
        remote:FireServer(unpack(args, 1, d.n or 0))
    end
end

function Exec.PromptHold(ev)
    local prompt = resolvePath(ev.data.p)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    RS.recentHold[prompt] = os.clock()
    local dur = (ev.data.dur or prompt.HoldDuration) / math.max(S.speedMultiplier, 0.01)
    task.spawn(function()
        local ok = pcall(function() prompt:InputHoldBegin() end)
        if not ok then
            if API.fireproximityprompt then pcall(API.fireproximityprompt, prompt) end
            return
        end
        task.wait(math.max(dur, 0.05))
        pcall(function() prompt:InputHoldEnd() end)
    end)
end

function Exec.PromptTriggered(ev)
    local prompt = resolvePath(ev.data.p)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    local last = RS.recentHold[prompt]
    if last and os.clock() - last < 2 + prompt.HoldDuration then return end -- o hold já aciona
    if API.fireproximityprompt then
        API.fireproximityprompt(prompt)
    else
        prompt:InputHoldBegin()
        task.wait()
        prompt:InputHoldEnd()
    end
end

function Exec.ClickDetector(ev)
    local cd = resolvePath(ev.data.p)
    if cd and API.fireclickdetector then API.fireclickdetector(cd) end
end

function Exec.TouchPart(ev)
    local part, root = resolvePath(ev.data.p), getRoot()
    if part and root and API.firetouchinterest then
        API.firetouchinterest(root, part, 0)
        task.wait()
        API.firetouchinterest(root, part, 1)
    end
end

local function findTool(name)
    local char = getChar()
    local t = char and char:FindFirstChild(name)
    if t and t:IsA("Tool") then return t end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    t = bp and bp:FindFirstChild(name)
    if t and t:IsA("Tool") then return t end
end

function Exec.ToolActivated(ev)
    local d, h = ev.data, getHum()
    if d.ev == "Equipped" then
        local tool = findTool(d.n)
        if tool and h then h:EquipTool(tool) end
    elseif d.ev == "Unequipped" then
        if h then h:UnequipTools() end
    else
        local tool = findTool(d.n)
        if tool then tool:Activate() end
    end
end

local function replayRelease()
    if VIM then
        for key in pairs(RS.heldKeys) do
            pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode[key], false, game) end)
        end
    end
    RS.heldKeys, RS.recentHold = {}, {}
    for _, tr in pairs(RS.animCache) do pcall(function() tr:Stop(0.1) end) end
    RS.animCache = {}
end

local function replayBegin()
    local h = getHum()
    RS.origWS = h and h.WalkSpeed
    RS.camSet, RS.camTarget = false, nil
    pcall(function() RunService:UnbindFromRenderStep("RouteHubReplay") end)
    RunService:BindToRenderStep("RouteHubReplay", Enum.RenderPriority.Last.Value, function()
        if RS.camTarget then
            local c = cam()
            if c then c.CFrame = c.CFrame:Lerp(RS.camTarget, 0.5) end
        end
    end)
end

local function replayEnd()
    pcall(function() RunService:UnbindFromRenderStep("RouteHubReplay") end)
    replayRelease()
    local h, r = getHum(), getRoot()
    if h and r then
        h:MoveTo(r.Position) -- para o boneco
        if RS.origWS then h.WalkSpeed = RS.origWS end
    end
    local c = cam()
    if c and RS.camSet then c.CameraType = RS.origCamType or Enum.CameraType.Custom end
    RS.camSet, RS.camTarget = false, nil
end

function Replay.pass(events, duration)
    replayRelease()
    local idx, startClock, lastUI, errs = 1, os.clock(), 0, 0
    while not Replay.cancel do
        local now = (os.clock() - startClock) * S.speedMultiplier * 1000
        while idx <= #events and events[idx].e.t <= now do
            local ev = events[idx].e
            idx += 1
            local fn = Exec[ev.type]
            if fn and not pcall(fn, ev) then errs += 1 end
            if S.actionDelayMs > 0 then startClock += task.wait(S.actionDelayMs / 1000) end
        end
        if os.clock() - lastUI > 0.1 then
            lastUI = os.clock()
            UI.setProgress(duration > 0 and math.clamp(now / duration, 0, 1) or 1,
                fmtTime(math.min(now, duration)) .. " / " .. fmtTime(duration))
        end
        if idx > #events and now >= duration then break end
        RunService.Heartbeat:Wait()
    end
    return not Replay.cancel, errs
end

function Replay.run(route)
    if Replay.running or Recorder.active then return end
    if type(route) ~= "table" or type(route.events) ~= "table" then return end
    Replay.running, Replay.cancel, Replay.route = true, false, route
    UI.setMode("replay")
    UI.showProgress(true)
    local tStart = os.clock()

    local events = {}
    for i, e in ipairs(route.events) do events[i] = { i = i, e = e } end
    table.sort(events, function(a, b)
        if a.e.t == b.e.t then return a.i < b.i end
        return a.e.t < b.e.t
    end)
    local duration = route.duration or (events[#events] and events[#events].e.t) or 0
    local startPos = route.startPos and Vector3.new(route.startPos[1], route.startPos[2], route.startPos[3]) or nil

    replayBegin()
    local totalErrs = 0
    repeat
        if startPos then
            Replay.status = "Indo até o ponto inicial..."
            UI.setProgress(0, "Indo até o ponto inicial...")
            local arrived = walkTo(startPos, 60)
            if not arrived and not Replay.cancel then
                Toast.show("Não cheguei ao ponto inicial, reproduzindo mesmo assim", "error")
            end
        end
        if Replay.cancel then break end
        Replay.status = "Reproduzindo: " .. tostring(route.name)
        local finished, errs = Replay.pass(events, duration)
        totalErrs += errs or 0
        if finished and S.loopReplay and not Replay.cancel then task.wait(0.25) end
    until Replay.cancel or not S.loopReplay
    replayEnd()

    warn(string.format("[REPLAY] Finalizado em %.1fs", os.clock() - tStart))
    if totalErrs > 0 then Toast.show(totalErrs .. " evento(s) falharam", "error") end
    Replay.running = false
    UI.showProgress(false)
    UI.setMode("idle")
end

function Replay.start(route)
    if Replay.running then return end
    if Recorder.active then Toast.show("Pare a gravação antes", "error") return end
    task.spawn(Replay.run, route)
end
function Replay.stop() if Replay.running then Replay.cancel = true end end

--[[ === SEÇÃO 9: WIDGETS (SLIDER / TOGGLE) === ]]
local function makeToggle(parent, text, init, onChange)
    local row = new("Frame", { Size = UDim2.new(1, -6, 0, 40), BackgroundColor3 = C.panel, BorderSizePixel = 0 }, parent)
    corner(row, 10)
    label(row, text, UDim2.new(1, -70, 1, 0), UDim2.new(0, 12, 0, 0), Enum.Font.GothamBold, 12)
    local sw = new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(42, 22),
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
        BackgroundColor3 = init and C.accent or C.panel2, BorderSizePixel = 0 }, row)
    corner(sw, 11)
    local knob = new("Frame", { Size = UDim2.fromOffset(18, 18), AnchorPoint = Vector2.new(0, 0.5),
        Position = init and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
        BackgroundColor3 = C.text, BorderSizePixel = 0 }, sw)
    corner(knob, 9)
    local value = init
    sw.Activated:Connect(function()
        value = not value
        tween(sw, 0.15, { BackgroundColor3 = value and C.accent or C.panel2 })
        tween(knob, 0.15, { Position = value and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0) })
        onChange(value)
        saveAll()
    end)
    return ord(row)
end

local function makeSlider(parent, text, min, max, step, init, fmt, onChange, scroller)
    local row = new("Frame", { Size = UDim2.new(1, -6, 0, 54), BackgroundColor3 = C.panel, BorderSizePixel = 0 }, parent)
    corner(row, 10)
    label(row, text, UDim2.new(0.6, 0, 0, 20), UDim2.new(0, 12, 0, 6), Enum.Font.GothamBold, 12)
    local valLbl = label(row, "", UDim2.new(0.4, -12, 0, 20), UDim2.new(0.6, 0, 0, 6), Enum.Font.GothamBold, 12,
        C.accent2, Enum.TextXAlignment.Right)
    local bar = new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.new(1, -28, 0, 6),
        Position = UDim2.new(0, 14, 0, 38), BackgroundColor3 = C.bg, BorderSizePixel = 0 }, row)
    corner(bar, 3)
    local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.accent, BorderSizePixel = 0 }, bar)
    corner(fill, 3)
    local knob = new("Frame", { Size = UDim2.fromOffset(18, 18), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = C.text, BorderSizePixel = 0, ZIndex = 2 }, bar)
    corner(knob, 9)
    local function set(v, fire)
        v = math.clamp(math.floor((v - min) / step + 0.5) * step + min, min, max)
        local a = (v - min) / (max - min)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        valLbl.Text = fmt(v)
        if fire then onChange(v) end
    end
    set(init, false)
    local dragging = false
    local function fromInput(input)
        set(min + math.clamp((input.Position.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1) * (max - min), true)
    end
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            if scroller then scroller.ScrollingEnabled = false end
            fromInput(input)
        end
    end)
    track(UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then fromInput(input) end
    end))
    track(UIS.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            if scroller then scroller.ScrollingEnabled = true end
            saveAll()
        end
    end))
    return ord(row)
end

