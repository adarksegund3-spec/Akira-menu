defineTool("portals", function(f)
	local tool = new("Tool", {Name = "Portais", ToolTip = "Toque em duas superficies: azul e laranja", RequiresHandle = false, CanBeDropped = false})
	local portals, nextIdx, cooldown = {}, 1, 0
	local cols = {Color3.fromRGB(40, 170, 255), Color3.fromRGB(255, 140, 30)}
	local grads = {}

	local function make(idx, pos, n)
		if portals[idx] then portals[idx].part:Destroy() end
		local col = cols[idx]
		local center = pos + n * 0.12
		local p = f.o(part({
			Anchored = true, Transparency = 1, Size = Vector3.new(0.2, 7, 4.4),
			CFrame = faceCF(center, n) * CFrame.Angles(0, math.pi / 2, 0), Parent = FX,
		}))
		for _, face in ipairs({Enum.NormalId.Right, Enum.NormalId.Left}) do
			local sg = new("SurfaceGui", {
				Face = face, SizingMode = Enum.SurfaceGuiSizingMode.FixedSize,
				CanvasSize = Vector2.new(264, 420), LightInfluence = 0,
			}, p)
			local glow = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
			}, sg)
			corner(glow, 0.5, true); ustroke(glow, col, 26, 0.65)
			local ring = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.96, 0.96),
				BackgroundColor3 = col, BackgroundTransparency = 0.5,
			}, sg)
			corner(ring, 0.5, true); ustroke(ring, col, 14, 0)
			local g = new("UIGradient", {
				Color = ColorSequence.new(col, WHITE),
				Transparency = NS(NSK(0, 0.2), NSK(0.5, 0.85), NSK(1, 0.2)),
			}, ring)
			table.insert(grads, g)
		end
		local em = new("ParticleEmitter", {
			Texture = SPARK, Rate = 40, Lifetime = NumberRange.new(0.6, 1.1), Speed = NumberRange.new(1, 4),
			SpreadAngle = Vector2.new(180, 180), Size = NS(NSK(0, 0.5), NSK(1, 0)), LightEmission = 1,
			Color = ColorSequence.new(col, WHITE),
		}, p)
		new("PointLight", {Color = col, Range = 14, Brightness = 2}, p)
		portals[idx] = {part = p, pos = center, n = n, em = em}
	end

	tool.Activated:Connect(function()
		local o, d = aimRay()
		local res = cast(o, d * 260)
		if not res then toast("Mire em uma superficie"); return end
		make(nextIdx, res.Position, res.Normal)
		toast(nextIdx == 1 and "Portal azul criado" or "Portal laranja criado")
		nextIdx = (nextIdx == 1) and 2 or 1
	end)

	f.c(RS.RenderStepped, function(dt)
		for _, g in ipairs(grads) do
			if g.Parent then g.Rotation = (g.Rotation + dt * 140) % 360 end
		end
	end)
	f.c(RS.Heartbeat, function(dt)
		cooldown = cooldown - dt
		if cooldown > 0 or not portals[1] or not portals[2] then return end
		local hrp = getHRP()
		if not hrp then return end
		for idx = 1, 2 do
			local p, q = portals[idx], portals[3 - idx]
			local rel = hrp.Position - p.pos
			if rel.Magnitude < 3.8 and math.abs(rel:Dot(p.n)) < 2.4 then
				local v = hrp.AssemblyLinearVelocity
				local sp = math.max(v.Magnitude, 22)
				local exit = q.pos + q.n * 3.4
				local fd = Vector3.new(q.n.X, 0, q.n.Z)
				if fd.Magnitude < 0.1 then
					local l = hrp.CFrame.LookVector
					fd = Vector3.new(l.X, 0, l.Z)
				end
				hrp.CFrame = CFrame.lookAt(exit, exit + fd)
				hrp.AssemblyLinearVelocity = q.n * sp
				p.em:Emit(40); q.em:Emit(40)
				cooldown = 0.9
				break
			end
		end
	end)
	return tool
end)

