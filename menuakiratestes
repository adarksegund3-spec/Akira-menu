-- ═══════════════════════════════════════════════════════════════
local function applyNewTheme(newThemeName)
    local newT = THEMES[newThemeName]
    if not newT then return end
    if newThemeName == CurrentThemeName then return end

    local oldT = CurrentTheme

    local swaps = {
        [oldT.BG1]      = newT.BG1,
        [oldT.BG2]      = newT.BG2,
        [oldT.Header1]  = newT.Header1,
        [oldT.Header2]  = newT.Header2,
        [oldT.BG_TAB]   = newT.BG_TAB,
        [oldT.BG_ROW]   = newT.BG_ROW,
        [oldT.BG_BLOCK] = newT.BG_BLOCK,
        [oldT.TEXT]     = newT.TEXT,
        [oldT.TEXT_DIM] = newT.TEXT_DIM,
        [oldT.STROKE]   = newT.STROKE,
        [oldT.Accent]   = newT.Accent,
        [oldT.Accent2]  = newT.Accent2,
    }

    local function swapIn(root)
        for _, d in ipairs(root:GetDescendants()) do
            pcall(function()
                if d:IsA("GuiObject") then
                    if d.BackgroundColor3 and swaps[d.BackgroundColor3] then
                        d.BackgroundColor3 = swaps[d.BackgroundColor3]
                    end
                    if d.TextColor3 and swaps[d.TextColor3] then
                        d.TextColor3 = swaps[d.TextColor3]
                    end
                end
                if d:IsA("UIStroke") and swaps[d.Color] then
                    d.Color = swaps[d.Color]
                end
                if d:IsA("ScrollingFrame") and swaps[d.ScrollBarImageColor3] then
                    d.ScrollBarImageColor3 = swaps[d.ScrollBarImageColor3]
                end
            end)
        end
    end
    swapIn(screenGui)
    swapIn(toastGui)

    -- Atualiza gradientes
    menuGradient.Color = ColorSequence.new(newT.BG1, newT.BG2)
    headerGrad.Color = ColorSequence.new(newT.Header1, newT.Header2)

    CurrentTheme = newT
    CurrentThemeName = newThemeName
    Theme.Accent = newT.Accent
    Theme.AccentDim = newT.Accent2
    BG          = newT.BG1
    BG_HEADER   = newT.Header1
    BG_TAB      = newT.BG_TAB
    BG_ROW      = newT.BG_ROW
    BG_BLOCK    = newT.BG_BLOCK
    TEXT        = newT.TEXT
    TEXT_DIM    = newT.TEXT_DIM
    STROKE_CLR  = newT.STROKE
end

