local function makeBtn(parent, text, bg, fg, onClick)
    local b = Instance.new("TextButton", parent)
    b.BackgroundColor3 = bg
    b.Font = Enum.Font.GothamBold
    b.Text = text
    b.TextColor3 = fg
    b.TextSize = 9
    b.BorderSizePixel = 0
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
    b.MouseButton1Click:Connect(onClick)
    return b
end

function refreshDataList()
    for _, child in ipairs(DataScroll:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
    end
    local names = {}
    for n in pairs(savedRoutes) do table.insert(names, n) end
    table.sort(names)

    if #names == 0 then
        local empty = Instance.new("TextLabel", DataScroll)
        empty.Size = UDim2.new(1, 0, 0, 40)
        empty.BackgroundTransparency = 1
        empty.Font = Enum.Font.Gotham
        empty.Text = "◦ vazio\n\ngrave e guarde"
        empty.TextColor3 = C_TXT_DIM
        empty.TextSize = 8
        empty.TextWrapped = true
        DataScroll.CanvasSize = UDim2.new(0, 0, 0, 40)
        return
    end

    for _, name in ipairs(names) do
        local entry = savedRoutes[name]
        local item = Instance.new("Frame", DataScroll)
        item.Size = UDim2.new(1, 0, 0, 30)
        item.BackgroundColor3 = C_BG_2
        item.BorderSizePixel = 0
        Instance.new("UICorner", item).CornerRadius = UDim.new(0, 5)
        local s = Instance.new("UIStroke", item)
        s.Color = C_BG_3
        s.Thickness = 1

        local nameLbl = Instance.new("TextLabel", item)
        nameLbl.Size = UDim2.new(1, -58, 0, 11)
        nameLbl.Position = UDim2.new(0, 5, 0, 3)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.Text = name
        nameLbl.TextColor3 = C_TXT
        nameLbl.TextSize = 8
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        nameLbl.TextTruncate = Enum.TextTruncate.AtEnd

        local infoLbl = Instance.new("TextLabel", item)
        infoLbl.Size = UDim2.new(1, -58, 0, 10)
        infoLbl.Position = UDim2.new(0, 5, 0, 15)
        infoLbl.BackgroundTransparency = 1
        infoLbl.Font = Enum.Font.Code
        infoLbl.Text = string.format("%.2fs · %d", entry.Duracao, entry.Pontos)
        infoLbl.TextColor3 = C_TURQ
        infoLbl.TextSize = 7
        infoLbl.TextXAlignment = Enum.TextXAlignment.Left

        local playBtn = makeBtn(item, "▸", Color3.fromRGB(30, 80, 130),
            Color3.fromRGB(180, 220, 255), function()
            playRoute(entry.Data)
        end)
        playBtn.Size = UDim2.new(0, 16, 0, 18)
        playBtn.Position = UDim2.new(1, -52, 0, 6)

        local copyBtn = makeBtn(item, "⧉", C_BG_3, C_TXT, function()
            local result = string.format("-- ⚡ angel • %s (%.3fs)\nreturn {\n", name, entry.Duracao)
            for _, node in ipairs(entry.Data) do
                local cfStr = table.concat(node.CF, ", ")
                local velStr = table.concat(node.Velocity, ", ")
                local stateName = typeof(node.State) == "EnumItem" and node.State.Name or "Running"
                local animStr = ""
                if node.Animations and #node.Animations > 0 then
                    local parts = {}
                    for _, a in ipairs(node.Animations) do
                        table.insert(parts, string.format(
                            "{Id=\"%s\",Speed=%.3f,Weight=%.3f,Priority=\"%s\"}",
                            a.Id, a.Speed, a.Weight, a.Priority))
                    end
                    animStr = ",Animations={" .. table.concat(parts, ",") .. "}"
                else
                    animStr = ",Animations={}"
                end
                result = result .. string.format(
                    "{Time=%.3f,CF={%s},Velocity={%s},State=Enum.HumanoidStateType.%s%s},\n",
                    node.Time, cfStr, velStr, stateName, animStr)
            end
            result = result .. "}"
            if setclipboard then
                setclipboard(result)
                StatusLabel.Text = "◦ copiado"
            else
                print(result)
            end
        end)
        copyBtn.Size = UDim2.new(0, 16, 0, 18)
        copyBtn.Position = UDim2.new(1, -34, 0, 6)

        local delBtn = makeBtn(item, "✕", Color3.fromRGB(120, 35, 45),
            Color3.fromRGB(255, 190, 200), function()
            savedRoutes[name] = nil
            StatusLabel.Text = "◦ apagado"
            refreshDataList()
        end)
        delBtn.Size = UDim2.new(0, 16, 0, 18)
        delBtn.Position = UDim2.new(1, -16, 0, 6)
    end

    DataScroll.CanvasSize = UDim2.new(0, 0, 0, #names * 33)
end

