    local st = default or false
    local function render()
        if st then
            tween(tr, 0.2, {BackgroundColor3 = Color3.fromRGB(60,180,90)})
            tween(kn, 0.2, {Position = UDim2.new(1,-16,0.5,-7), BackgroundColor3 = Color3.fromRGB(255,255,255)})
            tween(s, 0.2, {Color = Color3.fromRGB(60,180,90), Transparency = 0.2})
            tween(b, 0.2, {BackgroundColor3 = Color3.fromRGB(25,8,8)})
        else
            tween(tr, 0.2, {BackgroundColor3 = Color3.fromRGB(50,20,20)})
            tween(kn, 0.2, {Position = UDim2.new(0,2,0.5,-7), BackgroundColor3 = Color3.fromRGB(160,160,160)})
