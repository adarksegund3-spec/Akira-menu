function UI.renameRoute(route)
    UI.prompt("Renomear rota", route.name, function(newName)
        deleteRouteFile(route)
        route.name = newName
        saveAll()
        saveRouteFile(route)
        UI.renderHistory()
        Toast.show("Rota renomeada", "success")
    end)
end

function UI.deleteRoute(route)
    local i = table.find(Data.routes, route)
    if not i then return end
    table.remove(Data.routes, i)
    deleteRouteFile(route)
    saveAll()
    UI.renderHistory()
    Toast.show("Rota excluída", "success")
end

function UI.playRoute(route)
    if Recorder.active then Toast.show("Pare a gravação primeiro", "error") return end
    UI.switchTab("Principal")
    Replay.start(route)
end

function UI.renderHistory()
    local scroll = UI.histScroll
    if not scroll then return end
    for _, ch in ipairs(scroll:GetChildren()) do
        if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") then ch:Destroy() end
    end
    if #Data.routes == 0 then
        label(scroll, "Nenhuma rota salva.\nGrave uma na aba Principal.", UDim2.new(1, 0, 0, 60), nil,
            Enum.Font.Gotham, 13, C.muted, Enum.TextXAlignment.Center)
    end
    for i = #Data.routes, 1, -1 do
        local route = Data.routes[i]
        local item = new("Frame", { Size = UDim2.new(1, -6, 0, 62), BackgroundColor3 = C.panel,
            BorderSizePixel = 0, LayoutOrder = #Data.routes - i }, scroll)
        corner(item, 8)
        stroke(item, C.stroke, 0.8)
        local nameLbl = label(item, route.name, UDim2.new(1, -112, 0, 22), UDim2.new(0, 10, 0, 6), Enum.Font.GothamBold, 13)
        nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
        label(item, string.format("%s • %d ações • %s", fmtTime(route.duration), route.count or #route.events, fmtDate(route.created)),
            UDim2.new(1, -112, 0, 18), UDim2.new(0, 10, 0, 34), Enum.Font.Gotham, 11, C.muted)
        local play = makeButton(item, "▶", UDim2.fromOffset(30, 30), UDim2.new(1, -104, 0.5, -15), C.success)
        local ren = makeButton(item, "✎", UDim2.fromOffset(30, 30), UDim2.new(1, -70, 0.5, -15), C.panel2)
        local del = makeButton(item, "🗑", UDim2.fromOffset(30, 30), UDim2.new(1, -36, 0.5, -15), C.danger)
        play.Activated:Connect(function() UI.playRoute(route) end)
        ren.Activated:Connect(function() UI.renameRoute(route) end)
        del.Activated:Connect(function() UI.deleteRoute(route) end)
    end
    if UI.countLbl then UI.countLbl.Text = "Rotas salvas: " .. #Data.routes end
end

function UI.revealDiag()
    if UI.diagBtn and not UI.diagBtn.Visible then
        UI.diagBtn.Visible = true
    end
end

local function startRecording()
    if Replay.running then Toast.show("Pare o replay antes de gravar", "error") return end
    Recorder.start()
    UI.setMode("rec")
    Toast.show("Gravação iniciada", "success")
end

local function stopRecording()
    local route = Recorder.stop()
    UI.setMode("idle")
    if not route or route.count == 0 then
        Toast.show("Nada foi gravado", "error")
        return
    end
    Data.routes[#Data.routes + 1] = route
    saveAll()
    saveRouteFile(route)
    UI.renderHistory()
    Toast.show("Rota salva: " .. route.name, "success")
    if not S.autoRename then UI.renameRoute(route) end
end

function UI.onMainButton()
    if State.mode == "idle" then startRecording()
    elseif State.mode == "rec" then stopRecording()
    elseif State.mode == "replay" then Replay.stop() end
end

