local espCache = {}

local function clearESP(p)
    local c = espCache[p]
    if not c then return end
    if c.highlight then c.highlight:Destroy(); c.highlight = nil end
    if c.billboard then c.billboard:Destroy(); c.billboard = nil end
    if c.box then pcall(function() c.box:Remove() end); c.box = nil end
    if c.tracer then pcall(function() c.tracer:Remove() end); c.tracer = nil end
end

local function clearAllESP()
    for p in pairs(espCache) do clearESP(p) end
end

local function getBounds(char)
    local cf, size
    local ok = pcall(function() cf, size = char:GetBoundingBox() end)
    if not ok or not cf then return nil end
    size = size + Vector3.new(0, 0.6, 0)
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local any = false
    for ix = -0.5, 0.5, 1 do
        for iy = -0.5, 0.5, 1 do
            for iz = -0.5, 0.5, 1 do
                local wp = cf:PointToWorldSpace(Vector3.new(ix*size.X, iy*size.Y, iz*size.Z))
                local sp, on = Camera:WorldToViewportPoint(wp)
                if on then
                    any = true
                    minX = math.min(minX, sp.X); minY = math.min(minY, sp.Y)
                    maxX = math.max(maxX, sp.X); maxY = math.max(maxY, sp.Y)
                end
            end
        end
    end
    if not any then return nil end
    return Vector2.new(minX, minY), Vector2.new(maxX, maxY)
end

local function updateESP(p)
    if p == LocalPlayer then return end
    if Config.ESPTeamCheck and isAlly(p) then clearESP(p); return end
    local char = p.Character
    if not char then clearESP(p); return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then clearESP(p); return end

    local cor = getColor(p)
    local c = espCache[p]
    if not c then c = {}; espCache[p] = c end

    -- Highlight
    if Config.ESPHighlight then
        if not c.highlight or not c.highlight.Parent then
            c.highlight = Instance.new("Highlight")
            c.highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            c.highlight.Adornee = char
            c.highlight.Parent = char
        end
        c.highlight.FillColor = cor
        c.highlight.OutlineColor = cor
        c.highlight.FillTransparency = 0.5
        c.highlight.OutlineTransparency = 0
    elseif c.highlight then
        c.highlight:Destroy(); c.highlight = nil
    end

    -- Nome + HP
    local head = char:FindFirstChild("Head")
    if (Config.ESPName or Config.ESPHealth) and head then
        if not c.billboard or not c.billboard.Parent then
            local bb = Instance.new("BillboardGui")
            bb.Size = UDim2.new(0, 160, 0, 40)
            bb.StudsOffset = Vector3.new(0, 3, 0)
            bb.AlwaysOnTop = true
            bb.ResetOnSpawn = false
            bb.Adornee = head
            bb.Parent = head
            local nm = Instance.new("TextLabel")
            nm.Name = "Name"
            nm.Size = UDim2.new(1, 0, 0, 18)
            nm.BackgroundTransparency = 1
            nm.Font = Enum.Font.GothamBold
            nm.TextSize = 12
            nm.TextStrokeTransparency = 0
            nm.TextStrokeColor3 = Color3.new(0,0,0)
            nm.Parent = bb
            local hpBg = Instance.new("Frame")
            hpBg.Name = "HpBg"
            hpBg.Size = UDim2.new(0.7, 0, 0, 4)
            hpBg.Position = UDim2.new(0.15, 0, 0, 22)
            hpBg.BackgroundColor3 = Color3.fromRGB(30,30,30)
            hpBg.BorderSizePixel = 0
            hpBg.Parent = bb
            Instance.new("UICorner", hpBg).CornerRadius = UDim.new(1,0)
            local hpFill = Instance.new("Frame")
            hpFill.Name = "Fill"
            hpFill.Size = UDim2.new(1, 0, 1, 0)
            hpFill.BackgroundColor3 = Color3.fromRGB(50, 205, 50)
            hpFill.BorderSizePixel = 0
            hpFill.Parent = hpBg
            Instance.new("UICorner", hpFill).CornerRadius = UDim.new(1,0)
            c.billboard = bb
        end
        c.billboard.Name.Text = p.DisplayName
        c.billboard.Name.TextColor3 = cor
        c.billboard.Name.Visible = Config.ESPName
        c.billboard.HpBg.Visible = Config.ESPHealth
        if Config.ESPHealth then
            local hp = hum.Health / math.max(hum.MaxHealth, 1)
            c.billboard.HpBg.Fill.Size = UDim2.new(math.clamp(hp, 0, 1), 0, 1, 0)
            c.billboard.HpBg.Fill.BackgroundColor3 = Color3.fromRGB(255 * (1-hp), 255 * hp, 60)
        end
    elseif c.billboard then
        c.billboard:Destroy(); c.billboard = nil
    end

    -- Box / Tracer
    if hasDrawing then
        local top, bottom = getBounds(char)
        if Config.ESPBox and top and bottom then
            if not c.box then
                c.box = Drawing.new("Square")
                c.box.Thickness = 1
                c.box.Filled = false
                c.box.Transparency = 1
            end
            c.box.Position = top
            c.box.Size = Vector2.new(bottom.X - top.X, bottom.Y - top.Y)
            c.box.Color = cor
            c.box.Visible = true
        elseif c.box then
            c.box.Visible = false
        end

        if Config.ESPTracer and top and bottom then
            if not c.tracer then
                c.tracer = Drawing.new("Line")
                c.tracer.Thickness = 1
                c.tracer.Transparency = 1
            end
            c.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            c.tracer.To = Vector2.new((top.X + bottom.X) / 2, bottom.Y)
            c.tracer.Color = cor
            c.tracer.Visible = true
        elseif c.tracer then
            c.tracer.Visible = false
        end
    end
end

