    local function tinted(c)
        local r, g, b = c.R * 255, c.G * 255, c.B * 255
        return r > g * 1.3 + 3 and r > b * 1.3 + 3
    end
    local function lum(c)
        return 0.3 * c.R * 255 + 0.59 * c.G * 255 + 0.11 * c.B * 255
    end
    local function hasText(o)
        return o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox")
    end
    local function mapColor(o, k, c)
        if not tinted(c) then return c end
        if k == "BackgroundColor3" then
            local l = lum(c)
            if l >= 70 then
                if hasText(o) then return Color3.fromRGB(88, 90, 96) end
                return TH.White
            end
            local g = math.floor(11 + l + 0.5)
            return Color3.fromRGB(g, g + 1, g + 5)
        elseif k == "TextColor3" then
            return TH.SubText
        end
        return TH.Border   -- Color (UIStroke) e ScrollBarImageColor3
    end
    local COLOR_KEYS = { BackgroundColor3 = true, TextColor3 = true, Color = true, ScrollBarImageColor3 = true }

    local function setOrig(i, k)
        local t = Orig[i]
        if not t then t = {}; Orig[i] = t end
        if t[k] == nil then t[k] = i[k] end
    end
    local function put(i, k, v)        -- altera e guarda o original p/ restaurar
        setOrig(i, k)
        i[k] = v
    end
    local function recolor(i, k)
        local c = i[k]
        if typeof(c) == "Color3" and tinted(c) then
            setOrig(i, k)
            i[k] = mapColor(i, k, c)
        end
    end

    -- animações (tween) continuam coloridas pelo tema ativo
    State.themeMap = function(o, p)
