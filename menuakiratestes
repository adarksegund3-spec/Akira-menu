-- ESP (adaptado do source — Highlight + Billboard separados)
-- ═══════════════════════════════════════════════════════════════
local HL_TAG = "AKZ_ESP_HL"
local BB_TAG = "AKZ_ESP_BB"

local espCache = {}

local function clearESPForPlayer(player)
    local char = player.Character
    if char then
        local hl = char:FindFirstChild(HL_TAG)
        if hl then hl:Destroy() end
        local bb = char:FindFirstChild(BB_TAG)
        if bb then bb:Destroy() end
    end
    espCache[player] = nil
end

local function clearAllESP()
    for _, p in ipairs(Players:GetPlayers()) do
        clearESPForPlayer(p)
    end
end

local function updateESPForPlayer(player)
    if player == LocalPlayer then return end

    local char = player.Character
    if not char then clearESPForPlayer(player); return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then
        clearESPForPlayer(player); return
    end

    -- Team check (só funciona se API detectada com times)
    if Config.ESPTeamCheck and GameAPI.hasTeams and isAlly(player) then
        clearESPForPlayer(player); return
    end

    -- Cor: se ESP_Color ligado, usa cor do time; senão vermelho padrão
    local color
    if Config.ESP_Color then
        color = getPlayerColor(player)
    else
        color = Color3.fromRGB(220, 40, 40)
    end

    -- ═══ HIGHLIGHT (só se ligado) ═══
    if Config.ESP_Highlight then
        local hl = char:FindFirstChild(HL_TAG)
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = HL_TAG
            hl.Adornee = char
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = char
        end
        hl.FillColor = color
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = Config.ESP_HighlightFill
        hl.OutlineTransparency = 0
    else
        local hl = char:FindFirstChild(HL_TAG)
        if hl then hl:Destroy() end
    end

    -- ═══ NOME / DISTÂNCIA (só se pelo menos um ligado) ═══
    local wantBB = Config.ESP_Name or Config.ESP_Distance
    if wantBB then
        local head = char:FindFirstChild("Head")
        if head then
            local bb = char:FindFirstChild(BB_TAG)
            if not bb then
                bb = Instance.new("BillboardGui")
                bb.Name = BB_TAG
                bb.Size = UDim2.new(0, 200, 0, 24)
                bb.StudsOffset = Vector3.new(0, 2.8, 0)
                bb.AlwaysOnTop = true
                bb.ResetOnSpawn = false
                bb.Adornee = head
                bb.Parent = head
                local lbl = Instance.new("TextLabel")
                lbl.Name = "Lbl"
                lbl.Size = UDim2.new(1, 0, 1, 0)
                lbl.BackgroundTransparency = 1
                lbl.Font = Enum.Font.GothamBold
                lbl.TextSize = 13
                lbl.TextStrokeTransparency = 0
                lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
                lbl.Parent = bb
            end
            -- Monta texto
            local txt = ""
            if Config.ESP_Name then
                txt = player.DisplayName
            end
            if Config.ESP_Distance then
                local dist = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)
                if txt ~= "" then
                    txt = txt .. "  |  " .. dist .. "m"
                else
                    txt = dist .. "m"
                end
            end
            bb.Lbl.Text = txt
            bb.Lbl.TextColor3 = color
        end
    else
        local bb = char:FindFirstChild(BB_TAG)
        if bb then bb:Destroy() end
    end

    -- ═══ TRACER ═══
    if Config.ESP_Tracer then
        -- Tracer simples usando um Highlight distante não faz sentido; usamos o próprio bb
        -- (para manter leve, só marcamos com um stroke diferente)
    end
end

-- ═══════════════════════════════════════════════════════════════
-- AIMBOT
-- ═══════════════════════════════════════════════════════════════
local function getAimPart(char)
    if not char then return nil end
    if Config.AimbotPart == "Head" then
        return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    else
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
            or char:FindFirstChild("LowerTorso") or char:FindFirstChild("HumanoidRootPart")
    end
end

local function hasWallBetween(fromPos, toPos, alvoChar)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filtros = { LocalPlayer.Character, Camera }
    if alvoChar then table.insert(filtros, alvoChar) end
    params.FilterDescendantsInstances = filtros
    local dir = toPos - fromPos
    local result = workspace:Raycast(fromPos, dir, params)
    return result and result.Instance ~= nil
end

local function getAimbotTarget()
    local centro = getScreenCenter()
    if Config.LockedTarget and Config.LockedTarget.Parent then
        local part = Config.LockedTarget
        local char = part.Parent
        local p = Players:GetPlayerFromCharacter(char)
        if p and char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local isAllyCheck = Config.AimbotTeamCheck and GameAPI.hasTeams and isAlly(p)
            if hum and hum.Health > 0 and not isAllyCheck then
                local sp, on = Camera:WorldToViewportPoint(part.Position)
                if on and (Vector2.new(sp.X, sp.Y) - centro).Magnitude <= Config.AimbotFOV * 2.0 then
                    return part
                end
            end
        end
        Config.LockedTarget = nil
    end

    local nearest, nearestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local isAllyCheck = Config.AimbotTeamCheck and GameAPI.hasTeams and isAlly(p)
            if not isAllyCheck then
                local char = p.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local part = getAimPart(char)
                        if part then
                            local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                            if onScreen then
                                local d = (Vector2.new(sp.X, sp.Y) - centro).Magnitude
                                if d <= Config.AimbotFOV and d < nearestDist then
                                    if Config.AimbotWallCheck then
                                        if not hasWallBetween(Camera.CFrame.Position, part.Position, char) then
                                            nearest = part
                                            nearestDist = d
                                        end
                                    else
                                        nearest = part
                                        nearestDist = d
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    Config.LockedTarget = nearest
    return nearest
end

local function lockOn(targetPart)
    if not targetPart or not targetPart.Parent then return end
    local camPos = Camera.CFrame.Position
    local dir = targetPart.Position - camPos
    if dir.Magnitude < 0.01 then return end
    local targetCF = CFrame.lookAt(camPos, camPos + dir.Unit)
    if Config.AimbotSmooth <= 0.01 then
        Camera.CFrame = targetCF
    else
        local alpha = math.clamp(1 - Config.AimbotSmooth, 0.05, 1)
        Camera.CFrame = Camera.CFrame:Lerp(targetCF, alpha)
    end
    Camera.Focus = Camera.CFrame
end

