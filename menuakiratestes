-- ============================================================
-- FUNÇÃO PARA ABRIR O LINK DO DISCORD
-- ============================================================

local DISCORD_URL = "https://discord.gg/kc7myVSq3"

local function abrirDiscord()
    -- Tentativa 1: GuiService:OpenBrowserWindow (funciona em alguns executores)
    pcall(function()
        GuiService:OpenBrowserWindow(DISCORD_URL)
    end)

    -- Tentativa 2: LinkingService:OpenUrl (alternativa)
    pcall(function()
        local LinkingService = game:GetService("LinkingService")
        LinkingService:OpenUrl(DISCORD_URL)
    end)

    -- Tentativa 3: setclipboard (fallback universal)
    local clipboardFunc = setclipboard or toclipboard or syn and syn.write_clipboard
    if clipboardFunc then
        pcall(function()
            clipboardFunc(DISCORD_URL)
        end)
    end

    -- Notificação visual
    local NotifyGui = create("ScreenGui", {
        Name = "NotifyGui",
        ResetOnSpawn = false,
        Parent = PlayerGui
    })

    local NotifyFrame = create("Frame", {
        Name = "Notify",
        Size = UDim2.new(0, 280, 0, 60),
        Position = UDim2.new(0.5, -140, 0, -80),
        BackgroundColor3 = Color3.fromRGB(40, 40, 55),
        BorderSizePixel = 0,
        Parent = NotifyGui
    })
    addCorner(NotifyFrame, 0.1)
    addStroke(NotifyFrame, Color3.fromRGB(88, 101, 242), 2)

    create("TextLabel", {
        Name = "NotifyText",
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = "🔗 Link copiado! Abra o Discord.",
        TextSize = 14,
        Font = Enum.Font.GothamMedium,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextWrapped = true,
        Parent = NotifyFrame
    })

    -- Animação de entrada
    TweenService:Create(NotifyFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
        Position = UDim2.new(0.5, -140, 0, 20)
    }):Play()

    -- Remove após 3 segundos
    task.delay(3, function()
        TweenService:Create(NotifyFrame, TweenInfo.new(0.3), {
            Position = UDim2.new(0.5, -140, 0, -80)
        }):Play()
        task.wait(0.35)
        NotifyGui:Destroy()
    end)
end

JoinButton.MouseButton1Click:Connect(abrirDiscord)

-- ============================================================
-- LÓGICA DE ABRIR/FECHAR O MENU
-- ============================================================

local menuAberto = false

local function toggleMenu()
    menuAberto = not menuAberto
    MenuFrame.Visible = menuAberto

    if menuAberto then
        -- Animação de escala ao abrir
        MenuFrame.Size = UDim2.new(0, 0, 0, 0)
        MenuFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
        TweenService:Create(MenuFrame, TweenInfo.new(0.25, Enum.EasingStyle.Back), {
            Size = UDim2.new(0, 320, 0, 220),
            Position = UDim2.new(0.5, -160, 0.5, -110)
        }):Play()
    end
end

-- Clique no ícone
IconButton.MouseButton1Click:Connect(function()
    -- Ignora se foi um arrasto (movimento maior que 5px)
    if dragging then return end
    toggleMenu()
end)

-- Fechar pelo botão X
CloseButton.MouseButton1Click:Connect(function()
    menuAberto = false
    MenuFrame.Visible = false
end)

