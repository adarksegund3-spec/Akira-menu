local function horrorGrad(parent, mul)
    mul = mul or 1
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(70*mul, 8*mul, 8*mul)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(25, 2, 2)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0,0,0))
    }
    g.Rotation = 90; g.Parent = parent; return g
end

local function makeDraggable(handle, target, onClick)
    target = target or handle
    local dragging, moved, dragInput, dragStart, startPos = false, false, nil, nil, nil
    local THRESH = 5
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging, moved = true, false
            dragStart, startPos = i.Position, target.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if not moved and onClick then onClick() end
                end
            end)
        end
    end)
    handle.InputChanged:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch then dragInput = i end
    end)
    UIS.InputChanged:Connect(function(i)
        if i == dragInput and dragging then
            local d = i.Position - dragStart
            if math.abs(d.X) > THRESH or math.abs(d.Y) > THRESH then moved = true end
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

