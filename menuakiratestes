-- Sistema de Troca de Abas
local function SwitchView(viewName)
    if currentView == viewName then return end
    
    -- Esconde todas com fade out
    for name, view in pairs(views) do
        if view.Visible then
            TweenService:Create(view, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
            task.wait(0.15)
            view.Visible = false
        end
    end

    -- Mostra a selecionada com fade in
    if views[viewName] then
        views[viewName].Visible = true
        views[viewName].BackgroundTransparency = 1
        TweenService:Create(views[viewName], TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
        currentView = viewName
    end

    -- Atualiza visual dos botões da sidebar
    for name, btn in pairs(sidebarButtons) do
        if name == viewName then
            btn.BackgroundTransparency = 0.8
            btn.TextColor3 = Theme.Accent
            btn.Text = "▶ " .. name
        else
            btn.BackgroundTransparency = 1
            btn.TextColor3 = Theme.TextMuted
            btn.Text = name
        end
    end
end

