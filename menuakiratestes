defineFeature("rave", function(f)
	local hrp = getHRP()
	if not hrp then return end
	local cc = f.o(new("ColorCorrectionEffect", {Name = "WonderRave"}, Lighting))
	f.o(new("BloomEffect", {Intensity = 0.8, Size = 30, Threshold = 0.9}, Lighting))
	local ball = f.o(part({
		Anchored = true, Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.2, 2.2),
		Material = Enum.Material.Neon, Parent = FX,
	}))
	new("ParticleEmitter", {
		Texture = SPARK, Rate = 30, Lifetime = NumberRange.new(0.6, 1), Speed = NumberRange.new(6, 12),
		SpreadAngle = Vector2.new(180, 180), Size = NS(NSK(0, 0.8), NSK(1, 0)), LightEmission = 1,
	}, ball)
	local spots = {}
	for i = 1, 4 do
		local p = f.o(part({Anchored = true, Transparency = 1, Size = Vector3.new(0.4, 0.4, 0.4), Parent = FX}))
		local sl = new("SpotLight", {Angle = 38, Range = 70, Brightness = 6, Face = Enum.NormalId.Front}, p)
		spots[i] = {p = p, l = sl}
	end
	f.c(RS.RenderStepped, function()
		local h = getHRP()
		if not h then return end
		local t = os.clock()
		local bp = h.Position + Vector3.new(0, 9, 0)
		local beat = math.max(0, math.sin(t * 8)) ^ 4
		ball.Position = bp
		ball.Color = hue(t * 0.3)
		for i, s in ipairs(spots) do
			local a = t * 1.6 + i * math.pi / 2
			s.p.CFrame = CFrame.lookAt(bp, bp + Vector3.new(math.cos(a), -0.55, math.sin(a)))
			s.l.Color = hue(t * 0.4 + i * 0.25)
		end
		cc.TintColor = Color3.fromHSV((t * 0.2) % 1, 0.15 + 0.1 * beat, 1)
		cc.Brightness = 0.02 * beat
	end)
end)

