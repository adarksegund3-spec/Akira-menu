                autoSpin = false
                Rayfield:Notify({Title = "Estilo Obtido!", Content = "Você conseguiu: " .. currentStyle, Duration = 4, Image = 4483362458})
                break
            else
                game:GetService("ReplicatedStorage").Packages._Index["sleitnick_knit@1.7.0"].knit.Services.StylesService.RF.Roll:InvokeServer(false)
                task.wait(0.5)
            end
        end
    end)()
end

