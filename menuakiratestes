        local ch = LocalPlayer.Character
        return ch and ch:FindFirstChild("HumanoidRootPart")
    end
    local function savePos(key, nice)
        local r = rootPart()
        if not r then notify("error", "Sem personagem", "Não foi possível ler a posição.", 3); return end
        cfg.pos[key] = r.CFrame
        notify("success", "Posição salva", nice, 2)
    end
    local function gotoPos(key, nice)
        local pos = cfg.pos[key]
        if not pos then notify("warn", "Configuração incompleta", nice .. ": posição não salva.", 3); return false end
        local r = rootPart()
        if not r then notify("error", "Sem personagem", "Não foi possível posicionar.", 3); return false end
        r.CFrame = pos
        return true
    end

    local function runAuto()
        if running then return end
        running = true
        local steps = {
            { key = "char", nice = "Preparar personagem", posKey = "p1",
                wait = { LocalPlayer.CharacterAppearanceLoaded, LocalPlayer.CharacterAdded } },
            { key = "clone", nice = "Clonagem", posKey = "p2", wait = { Workspace.ChildAdded } },
            { key = "title", nice = "Título", wait = nil },
        }
        for _, s in ipairs(steps) do
            local cmd = cfg.cmds[s.key]
            if cfg.on[s.key] and cmd and cmd ~= "" then
                local ok, err = sendChat(cmd)
                if not ok then
                    notify("error", "Auto Organizar interrompido", s.nice .. ": " .. tostring(err), 5)
                    running = false
                    return
                end
                if s.wait then
                    local seen = waitAny(s.wait, 4)
                    if not seen then
                        notify("warn", s.nice, "Comando enviado, sem confirmação de efeito.", 3)
                    end
                else
                    notify("info", s.nice, "Comando enviado (sem como confirmar o efeito).", 3)
                end
                if s.posKey and cfg.pos[s.posKey] then gotoPos(s.posKey, s.nice) end
            end
        end
        if cfg.pos.dest then
            if gotoPos("dest", "STS Central") then notify("success", "Posicionamento", "Posição de destino aplicada.", 2.5) end
        else
            notify("warn", "Configuração incompleta", "Posição de destino (STS Central) não salva.", 3.5)
        end
        running = false
    end
    autoBtn.Activated:Connect(function() task.spawn(runAuto) end)

    -- Configuração admin (recolhível)
    local adminHead = button(auto, "CONFIGURAÇÃO ADMIN ▸", function() end, { Size = UDim2.new(1, 0, 0, 24) })
    local admin = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
