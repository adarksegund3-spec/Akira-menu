-- Loop de status otimizado (1s)
task.spawn(function()
    local fc, fs = 0, tick()
    addConn("fpsC", RunService.RenderStepped:Connect(function() fc = fc + 1 end))
    while task.wait(1) do
        statusRows.executor.Text = "Detectado"
        statusRows.executor.TextColor3 = Color3.fromRGB(120,220,120)
        local ok, info = pcall(function()
            return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
        end)
        statusRows.game.Text = ok and info.Name or "Desconhecido"
        statusRows.player.Text = LP.Name
        local el = tick() - fs
        local fps = math.floor(fc / el)
        statusRows.fps.Text = tostring(fps)
        statusRows.fps.TextColor3 = fps > 50 and Color3.fromRGB(120,220,120)
            or (fps > 25 and Color3.fromRGB(220,200,80) or Color3.fromRGB(220,80,80))
        fc, fs = 0, tick()
        statusRows.ping.Text = math.floor(LP:GetNetworkPing()*1000).." ms"
        statusRows.players.Text = #Players:GetPlayers().." / "..Players.MaxPlayers
        statusRows.place.Text = tostring(game.PlaceId)
        statusRows.job.Text = string.sub(game.JobId,1,16).."..."
    end
end)

