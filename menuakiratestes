function refreshDataList()
    for _, child in ipairs(DataScroll:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
    end
    local names = {}
    for n in pairs(savedRoutes) do table.insert(names, n) end
    table.sort(names)

    if #names == 0 then
        local empty = Instance.new("TextLabel", DataScroll)
        empty.Size = UDim2.new(1, 0, 0, 40)
        empty.BackgroundTransparency = 1
        empty.Font = Enum.Font.Gotham
        empty.Text = "Nenhuma rota salva.\nGrave uma e salve!"
        empty.TextColor3 = Color3.fromRGB(120, 120, 120)
        empty.TextSize = 9
        empty.TextWrapped = true
        DataScroll.CanvasSize = UDim2.new(0, 0, 0, 40)
        return
    end

    for _, name in ipairs(names) do
        local entry = savedRoutes[name]
        local item = Instance.new("Frame", DataScroll)
        item.Size = UDim2.new(1, 0, 0, 32)
        item.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        item.BorderSizePixel = 0
        Instance.new("UICorner", item).CornerRadius = UDim.new(0, 4)

        local nameLbl = Instance.new("TextLabel", item)
        nameLbl.Size = UDim2.new(1, -66, 0, 12)
        nameLbl.Position = UDim2.new(0, 4, 0, 2)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.Text = name
        nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLbl.TextSize = 9
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        nameLbl.TextTruncate = Enum.TextTruncate.AtEnd

        local infoLbl = Instance.new("TextLabel", item)
        infoLbl.Size = UDim2.new(1, -66, 0, 10)
        infoLbl.Position = UDim2.new(0, 4, 0, 13)
        infoLbl.BackgroundTransparency = 1
        infoLbl.Font = Enum.Font.Code
        infoLbl.Text = string.format("⏱ %.3fs • %d pts", entry.Duracao, entry.Pontos)
        infoLbl.TextColor3 = Color3.fromRGB(0, 200, 100)
        infoLbl.TextSize = 8
        infoLbl.TextXAlignment = Enum.TextXAlignment.Left

        local playBtn = makeRouteButton(item, "▶", Color3.fromRGB(40, 100, 180), function()
            playRoute(entry.Data)
        end)
        playBtn.Size = UDim2.new(0, 18, 0, 20)
        playBtn.Position = UDim2.new(1, -62, 0, 6)

        local copyBtn = makeRouteButton(item, "📋", Color3.fromRGB(80, 80, 80), function()
            local result = string.format(
                "-- ==================== ROTA: %s ====================\n" ..
                "-- DURAÇÃO: %s\n-- PONTOS: %d\n" ..
                "-- ================================================\nreturn {\n",
                name, formatTime(entry.Duracao), entry.Pontos
            )
            for _, node in ipairs(entry.Data) do
                local cfStr = table.concat(node.CF, ", ")
                local velStr = table.concat(node.Velocity, ", ")
                local stateName = typeof(node.State) == "EnumItem" and node.State.Name or "Running"
                local animStr = ""
                if node.Animations and #node.Animations > 0 then
                    local parts = {}
                    for _, a in ipairs(node.Animations) do
                        table.insert(parts, string.format(
                            "{Id = \"%s\", Speed = %.3f, Weight = %.3f, Priority = \"%s\"}",
                            a.Id, a.Speed, a.Weight, a.Priority))
                    end
                    animStr = ", Animations = {" .. table.concat(parts, ", ") .. "}"
                else
                    animStr = ", Animations = {}"
                end
                result = result .. string.format(
                    "    {Time = %.3f, CF = {%s}, Velocity = {%s}, State = Enum.HumanoidStateType.%s%s},\n",
                    node.Time, cfStr, velStr, stateName, animStr)
            end
            result = result .. "}"
            if setclipboard then
                setclipboard(result)
                StatusLabel.Text = "Copiado: " .. name
            else
                print(result)
                StatusLabel.Text = "F9 (sem clipboard)"
            end
        end)
        copyBtn.Size = UDim2.new(0, 18, 0, 20)
        copyBtn.Position = UDim2.new(1, -42, 0, 6)

        local delBtn = makeRouteButton(item, "🗑", Color3.fromRGB(170, 0, 0), function()
            savedRoutes[name] = nil
            StatusLabel.Text = "Deletado: " .. name
            refreshDataList()
        end)
        delBtn.Size = UDim2.new(0, 18, 0, 20)
        delBtn.Position = UDim2.new(1, -22, 0, 6)
    end

    DataScroll.CanvasSize = UDim2.new(0, 0, 0, #names * 35)
end

