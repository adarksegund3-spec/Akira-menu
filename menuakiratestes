        local sr = mk("Frame", { Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, LayoutOrder = nextOrd() }, p)
        local stLabel = text(sr, Bridge.status(), 12, SUB, nil, { Size = UDim2.new(1, -120, 1, 0), TextWrapped = false,
            TextTruncate = Enum.TextTruncate.AtEnd })
        local hb = mk("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.fromOffset(116, 18), BackgroundTransparency = 1, AutoButtonColor = false,
            Text = Bridge.hide and "Mostrar original" or "Ocultar original", Font = T.boldFont,
            TextSize = 12, TextColor3 = T.accent }, sr)
        hb.Activated:Connect(function()
            Bridge.hide = not Bridge.hide
            Bridge.applyHide()
            hb.Text = Bridge.hide and "Mostrar original" or "Ocultar original"
        end)

        local hostH = math.max(ContentH - 66, 90)
        local host = mk("Frame", { Size = UDim2.new(1, 0, 0, hostH), BackgroundColor3 = T.card,
            BackgroundTransparency = T.cardT, BorderSizePixel = 0, ClipsDescendants = true,
            LayoutOrder = nextOrd() }, p)
        corner(host, cr())
        stroke(host, T.line, 1, 0.65)

        if m and Bridge.embed(host, ContentW, hostH) then
            -- ok: a janela original do Arceus agora vive aqui dentro
        else
            text(host, "Abra o Arceus uma vez e toque em ↻ Achar.\nAssim que ele aparecer, toda a interface dele entra aqui.",
                14, SUB, nil, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center,
                TextYAlignment = Enum.TextYAlignment.Center })
        end

        stLabel.Text = Bridge.status()

        Live.fns[#Live.fns + 1] = function()
