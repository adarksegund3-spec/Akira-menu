-- ═══════════════════════════════════════════════════════════════
-- TEAM CHECK
-- ═══════════════════════════════════════════════════════════════
local function getTeam(p)
    if not p then return nil end
    local ok, t = pcall(function() return p.Team end)
    if ok and t then return t end
    local c = p.Character
    if c then
        for _, o in ipairs(c:GetChildren()) do
            if o.Name == "Team" and (o:IsA("StringValue") or o:IsA("ObjectValue")) then
                return o.Value
            end
        end
    end
    return nil
end

local function isAlly(p)
    if not p or p == LocalPlayer then return false end
    local a, b = getTeam(LocalPlayer), getTeam(p)
    if a == nil or b == nil then return false end
    return a == b
end

local function getColor(p)
    if isAlly(p) then return Color3.fromRGB(80, 170, 255) end
    local ok, tc = pcall(function() return p.TeamColor end)
    if ok and tc and tc.Color then return tc.Color end
    return Color3.fromRGB(220, 60, 60)
end

