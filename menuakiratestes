local function finishRecording()
    isRecording = false
    if recordingConnection then
        recordingConnection:Disconnect()
        recordingConnection = nil
    end
    stopTimer()
    resetRecordButton()
    setStatus(string.format("%.2fs  |  %d pts  |  %d anims", timerFrozen, #recordedData, countAnims(recordedData)), "ok")
end

track(RecordBtn.MouseButton1Click:Connect(function()
    if isRecording then
        finishRecording()
        return
    end

    if playbackConnection or playingBusy then stopPlayback() end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then
        setStatus("Sem personagem", "warn")
        return
    end
    local animator = getAnimator(hum)

    isRecording = true
    recordedData = {}
    startTime = os.clock()
    startTimer()
    RecordBtn.Text = "Parar"
    RecordBtn.BackgroundColor3 = C.Red
    setStatus("Gravando...", "rec")

    local lastNameTick = 0
    local frameSeen = {}

    recordingConnection = RunService.Heartbeat:Connect(function()
        if not hrp.Parent or not hum.Parent then
            finishRecording()
            return
        end

        local currentTime = os.clock() - startTime
        local cf = hrp.CFrame
        local vel = hrp.AssemblyLinearVelocity

        local wantNames = (currentTime - lastNameTick) >= 0.25
        local names = nil
        if wantNames then
            lastNameTick = currentTime
            names = {}
        end

        -- detecta TODAS as animações tocando agora (andar, correr, agachar, pular, ferramentas...)
        local anims = {}
        table.clear(frameSeen)
        for _, trackObj in ipairs(animator:GetPlayingAnimationTracks()) do
            local a = trackObj.Animation
            local weight = trackObj.WeightCurrent
            if a and weight > 0.001 then
                local id = a.AnimationId
                if id ~= "" and not frameSeen[id] then
                    frameSeen[id] = true
                    table.insert(anims, {
                        Id = id,
                        Speed = trackObj.Speed,
                        Weight = weight,
                        Priority = trackObj.Priority.Name,
                        Pos = trackObj.TimePosition,
                        Looped = trackObj.Looped,
                    })
                    if names then
                        local nm = a.Name
                        if nm == "" then nm = id:match("%d+") or "?" end
                        table.insert(names, nm)
                    end
                end
            end
        end

        table.insert(recordedData, {
            Time = currentTime,
            CF = { cf:GetComponents() },
            Velocity = { vel.X, vel.Y, vel.Z },
            State = hum:GetState().Name,
            Animations = anims,
        })

        if names then
            local txt = string.format("Gravando | %d anim", #names)
            if #names > 0 then txt = txt .. ": " .. table.concat(names, ", ") end
            setStatus(txt, "rec")
        end
    end)
end))

