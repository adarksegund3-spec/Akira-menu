        espEnabled = Value
        if espEnabled then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if isBall(obj) then createESP(obj) end
            end
        else
            for ballModel, _ in pairs(ballESP) do removeESP(ballModel) end
        end
    end
})

Workspace.DescendantAdded:Connect(function(obj)
    if isBall(obj) and espEnabled then createESP(obj) end
