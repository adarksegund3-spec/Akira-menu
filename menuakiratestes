local function countTools()
    local n = 0
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then for _, c in ipairs(bp:GetChildren()) do if c:IsA("Tool") then n += 1 end end end
    local ch = LocalPlayer.Character
    if ch then for _, c in ipairs(ch:GetChildren()) do if c:IsA("Tool") then n += 1 end end end
    return n
end

local function unbindTool()
    for _, c in ipairs(toolConns) do c:Disconnect() end
    table.clear(toolConns)
end
local function bindTool(t)
    unbindTool()
    tool = t
    table.insert(toolConns, t.Equipped:Connect(function() task.defer(openMenu) end))
    table.insert(toolConns, t.Unequipped:Connect(closeAll))
    table.insert(toolConns, t.AncestryChanged:Connect(function()
        local par = t.Parent
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
        if par == nil or (par ~= bp and par ~= LocalPlayer.Character) then
            closeAll()
            if par == nil then tool = nil end
        end
    end))
    if isEquipped() then openMenu() end
end

local ensuring = false
local function ensureTool()
    if ensuring then return end
    if tool and tool:IsDescendantOf(game) then return end
    ensuring = true
    local backpack = LocalPlayer:WaitForChild("Backpack", 10)
    if not backpack then
        notify("error", "Prancheta V1", "Backpack não encontrado; item não criado.", 4)
        ensuring = false; return
    end
    local existing
    for _, container in ipairs({ backpack, LocalPlayer.Character }) do
        if container then
            for _, c in ipairs(container:GetChildren()) do
                if c:IsA("Tool") and c:GetAttribute("PranchetaV1") then existing = c end
            end
        end
    end
    if existing then bindTool(existing); ensuring = false; return end

    local before = countTools() -- verifica os seis espaços antes de inserir
    local t = new("Tool", { Name = TOOL_NAME, ToolTip = "Prancheta V1 | Drip Menu", RequiresHandle = false, CanBeDropped = false })
    t:SetAttribute("PranchetaV1", true)
    t.Parent = backpack
    if t.Parent ~= backpack then
        notify("error", "Prancheta V1", "O jogo impediu a criação do item. Nada foi criado.", 4)
        t:Destroy(); ensuring = false; return
    end
    bindTool(t)
    if before >= HOTBAR_SIZE then
        notify("warn", "HOTBAR CHEIA", HOTBAR_MSG, 6.5)
    end
    ensuring = false
end

