showPage = function(id)
    Bridge.detach()
    State.tab = id
    Live.fns = {}
    Log.hook = nil
    ord = 0
    for _, ch in ipairs(Content:GetChildren()) do
        if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") then ch:Destroy() end
    end
    Content.CanvasPosition = Vector2.new()
    local ok, err = pcall(Pages[id], Content)
    if not ok then log("Erro na página " .. id .. ": " .. tostring(err)) end
    for tid, setter in pairs(tabSetters) do setter(tid == id) end
end

local function makeTab(parent, def, size)
    local style = T.tabStyle
    local b = mk("TextButton", { Size = size, Text = "", AutoButtonColor = false, BorderSizePixel = 0,
        BackgroundColor3 = T.accent, BackgroundTransparency = 1 }, parent)
    local lab = mk("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Font = T.boldFont,
        TextSize = 14, TextColor3 = C(255, 255, 255) }, b)
    local mark
    if style == "bar" then
        corner(b, 8)
        lab.Text = "  " .. def.icon .. "  " .. def.label
        lab.TextXAlignment = Enum.TextXAlignment.Left
        mark = mk("Frame", { Size = UDim2.new(0, 3, 0.6, 0), Position = UDim2.new(0, 0, 0.2, 0),
            BackgroundColor3 = T.accent, BorderSizePixel = 0 }, b)
        corner(mark, 2)
    elseif style == "underline" then
        lab.Text = def.icon .. " " .. def.label
        lab.TextSize = 13
        mark = mk("Frame", { Size = UDim2.new(1, -12, 0, 2), Position = UDim2.new(0, 6, 1, -2),
            BackgroundColor3 = T.accent, BorderSizePixel = 0 }, b)
    elseif style == "pill" then
        corner(b, 999)
        lab.Text = def.icon .. "  " .. def.label
    else -- dock
        corner(b, 10)
        lab.Text = def.icon .. "\n" .. def.label
        lab.TextSize = 13
    end
    b.Activated:Connect(function() showPage(def.id) end)
    return function(sel)
        if style == "bar" then
            b.BackgroundTransparency = sel and 0.72 or 1
            mark.Visible = sel
        elseif style == "underline" then
            b.BackgroundTransparency = sel and 0.85 or 1
            mark.Visible = sel
        else
            b.BackgroundColor3 = sel and T.accent or T.card
            b.BackgroundTransparency = sel and 0.05 or 0.5
            lab.TextColor3 = sel and T.onAccent or C(255, 255, 255)
        end
    end, b
end

local function fitUpdate()
    local cam = workspace.CurrentCamera
    if not (cam and Fit and T and W) then return end
    local vp = cam.ViewportSize
    Fit.Scale = math.clamp(math.min((vp.X - 24) / W, (vp.Y - 24) / H, 1.2), 0.45, 1.2)
end

local function cornerBrackets(body)
    local function L(x, y, ax, ay)
        local f = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 16),
            AnchorPoint = Vector2.new(ax, ay), Position = UDim2.new(ax, ax == 0 and 6 or -6, ay, ay == 0 and 6 or -6) }, body)
        mk("Frame", { Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, ay, ay == 0 and 0 or -2),
            BackgroundColor3 = T.accent, BorderSizePixel = 0 }, f)
        mk("Frame", { Size = UDim2.new(0, 2, 1, 0), Position = UDim2.new(ax, ax == 0 and 0 or -2, 0, 0),
            BackgroundColor3 = T.accent, BorderSizePixel = 0 }, f)
    end
    L(0, 0, 0, 0) L(0, 0, 1, 1)
end

local function updateLogo()
    if not Logo then return end
    Logo.BackgroundColor3 = C(255, 255, 255)
    local g = Logo:FindFirstChild("Fundo")
    if g then g.Color = ColorSequence.new(T.bg0, T.bg1) end
    local lab = Logo:FindFirstChild("A")
    if lab then lab.TextColor3 = T.accent end
    local st = Logo:FindFirstChildOfClass("UIStroke")
    if st then
        st.Color = T.accent
        local sg = st:FindFirstChildOfClass("UIGradient")
        if sg then
            sg.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, T.accent),
                ColorSequenceKeypoint.new(0.5, T.accent:Lerp(C(0, 0, 0), 0.85)),
                ColorSequenceKeypoint.new(1, T.accent),
            })
        end
    end
end

rebuild = function()
    T = Themes[State.themeIdx]
    local k = State.big and 1.4 or 1
    W, H = math.floor(T.w * k), math.floor(T.h * k)
    Spinners, Live, ShineFrame, tabSetters = {}, { fns = {} }, nil, {}
    Log.hook = nil
    Bridge.detach()
    Bridge.retheme()
    if Window then Window:Destroy() end

    Window = mk("Frame", { Name = "Janela", AnchorPoint = Vector2.new(0.5, 0.5),
        Position = State.winPos or UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(W, H),
        BackgroundTransparency = 1, Visible = State.open }, Gui)
    Fit = mk("UIScale", {}, Window)
    fitUpdate()

    if T.glow then
        local gl = mk("Frame", { Position = UDim2.fromOffset(-8, -8), Size = UDim2.new(1, 16, 1, 16),
            BackgroundTransparency = 1 }, Window)
        corner(gl, T.radius + 8)
        stroke(gl, T.accent, 8, 0.86)
    end

    Body = mk("Frame", { Name = "Corpo", Size = UDim2.fromScale(1, 1), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = C(255, 255, 255),
        BackgroundTransparency = T.bgT, BorderSizePixel = 0, ClipsDescendants = true }, Window)
    BodyScale = mk("UIScale", {}, Body)
    corner(Body, T.radius)
    grad(Body, T.bg0, T.bg1, T.bgRot)
    local bst = stroke(Body, T.accent, 1.6, 0.1)
    if T.animBorder then
        local g = mk("UIGradient", { Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, T.accent),
            ColorSequenceKeypoint.new(0.5, T.accent:Lerp(C(0, 0, 0), 0.85)),
            ColorSequenceKeypoint.new(1, T.accent) }) }, bst)
        Spinners[#Spinners + 1] = g
        bst.Thickness = 2.2
    end
    if T.corners then cornerBrackets(Body) end

    -- Cabeçalho
    local header = mk("Frame", { Size = UDim2.new(1, 0, 0, T.headerH), BackgroundTransparency = 1,
        Active = true, ClipsDescendants = true }, Body)
    local mini = mk("Frame", { Position = UDim2.fromOffset(12, (T.headerH - 34) / 2), Size = UDim2.fromOffset(34, 34),
        BackgroundColor3 = C(255, 255, 255), BorderSizePixel = 0 }, header)
    corner(mini, T.radius > 8 and 17 or 6)
    grad(mini, T.bg0, T.bg1, 45)
    stroke(mini, T.accent, 1.6, 0)
    text(mini, "A", 18, T.accent, T.titleFont, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })

    local title = text(header, "Angel executor", T.titleSize, C(255, 255, 255), T.titleFont, {
        Position = UDim2.fromOffset(T.center and 56 or 56, 0), Size = UDim2.new(1, -112, 1, 0),
        TextXAlignment = T.center and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,
        TextScaled = true, TextWrapped = false })
    mk("UITextSizeConstraint", { MaxTextSize = T.titleSize, MinTextSize = 12 }, title)
    grad(title, C(255, 255, 255), T.accent:Lerp(C(255, 255, 255), 0.25), 0)

    local close = mk("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(32, 32), BackgroundColor3 = C(220, 40, 60), BackgroundTransparency = 0.25,
        Text = "✕", Font = T.boldFont, TextSize = 16, TextColor3 = C(255, 255, 255), AutoButtonColor = false,
        BorderSizePixel = 0 }, header)
    corner(close, T.radius > 8 and 16 or 5)
    close.Activated:Connect(function() setOpen(false) end)

    mk("Frame", { Position = UDim2.new(0, 10, 1, -2), Size = UDim2.new(1, -20, 0, T.id == "v2" and 2 or 1),
        BackgroundColor3 = T.accent, BackgroundTransparency = T.id == "v2" and 0.1 or 0.6, BorderSizePixel = 0 }, header)

    if T.shine then
        ShineFrame = mk("Frame", { Size = UDim2.new(0, 46, 2, 0), AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, -80, 0.5, 0), Rotation = 20, BackgroundColor3 = C(255, 255, 255),
            BorderSizePixel = 0, BackgroundTransparency = 0 }, header)
        mk("UIGradient", { Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.82), NumberSequenceKeypoint.new(1, 1) }) }, ShineFrame)
    end

    makeDraggable(header, Window, nil, function(pos) State.winPos = pos end, UDim2.fromScale(0.5, 0.5))

    -- Layout: abas + conteúdo
    local w, h, hh = W, H, T.headerH
    local tabsHolder, contentPos, contentSize
    local tabSizeV = UDim2.new(1, 0, 0, 36)

    if T.layout == "side_left" or T.layout == "side_right" then
        local tx = T.layout == "side_left" and 8 or (w - 128)
        local cx = T.layout == "side_left" and 136 or 8
        tabsHolder = mk("Frame", { Position = UDim2.fromOffset(tx, hh + 4), Size = UDim2.fromOffset(120, h - hh - 12),
            BackgroundColor3 = T.card, BackgroundTransparency = T.cardT, BorderSizePixel = 0 }, Body)
        corner(tabsHolder, math.max(T.radius - 4, 4)) stroke(tabsHolder, T.line, 1, 0.65)
        mk("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }, tabsHolder)
        mk("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, tabsHolder)
        contentPos = UDim2.fromOffset(cx, hh + 4)
        contentSize = UDim2.fromOffset(w - 144, h - hh - 12)
        local th = math.clamp(math.floor((h - hh - 12 - 6 - (#TABS - 1) * 5) / #TABS), 28, 38)
        tabSizeV = UDim2.new(1, 0, 0, th)
    elseif T.layout == "top" then
        tabsHolder = mk("Frame", { Position = UDim2.fromOffset(8, hh + 4), Size = UDim2.fromOffset(w - 16, 34),
            BackgroundTransparency = 1 }, Body)
        mk("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4),
            SortOrder = Enum.SortOrder.LayoutOrder }, tabsHolder)
        tabSizeV = UDim2.new(1 / #TABS, -4, 1, 0)
        contentPos = UDim2.fromOffset(8, hh + 44)
        contentSize = UDim2.fromOffset(w - 16, h - hh - 52)
    else -- dock
        local dockW = math.floor((w - 40 - (#TABS - 1) * 6) / #TABS)
        tabsHolder = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, h - 56),
            Size = UDim2.fromOffset(#TABS * dockW + (#TABS - 1) * 6 + 12, 48), BackgroundColor3 = T.card,
            BackgroundTransparency = 0.1, BorderSizePixel = 0 }, Body)
        corner(tabsHolder, 14) stroke(tabsHolder, T.accent, 1.2, 0.35)
        mk("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 6) }, tabsHolder)
        mk("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder }, tabsHolder)
        tabSizeV = UDim2.new(0, dockW, 0, 40)
        contentPos = UDim2.fromOffset(8, hh + 2)
        contentSize = UDim2.fromOffset(w - 16, h - hh - 66)
    end

    ContentW, ContentH = contentSize.X.Offset - 6, contentSize.Y.Offset - 4

    for i, def in ipairs(TABS) do
        local setter, btn = makeTab(tabsHolder, def, tabSizeV)
        btn.LayoutOrder = i
        tabSetters[def.id] = setter
    end

    Content = mk("ScrollingFrame", { Position = contentPos, Size = contentSize, BackgroundTransparency = 1,
        BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = T.accent,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new() }, Body)
    mk("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, Content)
    mk("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 4) }, Content)

    updateLogo()
    showPage(State.tab)
end

setOpen = function(v)
    State.open = v
    if not Window then return end
    Window.Visible = v
    if v and BodyScale then
        BodyScale.Scale = 0.86
        tween(BodyScale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
    end
end

