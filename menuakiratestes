local pickPlaylist, openTrackMenu
function pickPlaylist(track)
	local items = {}
	for _, pl in ipairs(Store.data.playlists) do
		table.insert(items, { pl.name, function()
			Toast(Store.playlistAdd(pl, track) and ("Adicionado a " .. pl.name) or "Já está na playlist")
		end })
	end
	table.insert(items, { "+ Nova playlist", function()
		local pl = Store.newPlaylist("Playlist " .. (#Store.data.playlists + 1))
		Store.playlistAdd(pl, track); Toast("Adicionado a " .. pl.name)
	end, C.green })
	sheet("Adicionar à playlist", items)
end
function openTrackMenu(track, ctx)
	local items = {
		{ "Tocar agora", ctx.play, C.green },
		{ "Adicionar à fila", function() Player.enqueue(track); Toast("Adicionado à fila") end },
		{ Store.isFav(track.id) and "Remover dos favoritos" or "Adicionar aos favoritos", function()
			local on = Store.toggleFav(track)
			if ctx.after then ctx.after() end
			Toast(on and "Adicionado aos favoritos" or "Removido dos favoritos")
		end },
		{ "Adicionar à playlist", function() pickPlaylist(track) end },
	}
	if ctx.onRemove then table.insert(items, { "Remover desta lista", ctx.onRemove, C.red }) end
	sheet(track.title, items)
end

