local function TocarAnim()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator or trackAndar then return end
    local an = char:FindFirstChild("Animate")
    if an then an.Enabled = false end
    for _, t in ipairs(animator:GetPlayingAnimationTracks()) do t:Stop(0) end
    trackAndar = animator:LoadAnimation(animAndar)
    trackAndar.Looped = true
    trackAndar.Priority = Enum.AnimationPriority.Action
    trackAndar:Play(0.1)
end

local function PararAnim()
    if trackAndar then trackAndar:Stop(0.1) trackAndar = nil end
    local char = LocalPlayer.Character
    local an = char and char:FindFirstChild("Animate")
    if an then an.Enabled = true end
end

local function limparVis()
    if visFolder then visFolder:Destroy() visFolder = nil end
    if clone then clone:Destroy() clone = nil end
    if placa then placa:Destroy() placa = nil end
    if touchConn then touchConn:Disconnect() touchConn = nil end
    autoStart = false
end

local function desenhar(dados, nomeRota)
    limparVis()
    if not dados or #dados < 2 then return end
    visFolder = Instance.new("Folder", workspace)
    visFolder.Name = "JpRota"
    local pts = {}
    for _, n in ipairs(dados) do table.insert(pts, CFrame.new(table.unpack(n.CF)).Position) end
    for i = 2, #pts do
        local a, b = pts[i - 1], pts[i]
        local dist = (b - a).Magnitude
        if dist > 0.05 then
            local l = Instance.new("Part", visFolder)
            l.Anchored, l.CanCollide, l.CanQuery, l.CanTouch = true, false, false, false
            l.Material, l.Color, l.Transparency = Enum.Material.Neon, Color3.fromRGB(0, 255, 0), 0.4
            l.Size, l.CFrame = Vector3.new(0.2, 0.2, dist), CFrame.lookAt((a + b) / 2, b)
        end
    end
    local cfI = CFrame.new(table.unpack(dados[1].CF))
    if LocalPlayer.Character then
        clone = LocalPlayer.Character:Clone()
        clone.Name = "Clone"
        for _, p in ipairs(clone:GetDescendants()) do
            if p:IsA("BasePart") then p.Anchored, p.CanCollide = true, false
            elseif p:IsA("Script") or p:IsA("LocalScript") then p:Destroy() end
        end
        clone:PivotTo(cfI)
        clone.Parent = visFolder
    end
    placa = Instance.new("BillboardGui", clone:FindFirstChild("Head") or visFolder)
    placa.Size, placa.StudsOffset, placa.AlwaysOnTop = UDim2.new(0, 200, 0, 60), Vector3.new(0, 3, 0), true
    local f = Instance.new("Frame", placa)
    f.Size, f.BackgroundColor3, f.BackgroundTransparency = UDim2.new(1, 0, 1, 0), Color3.fromRGB(15, 20, 25), 0.1
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
    Instance.new("UIStroke", f).Color = Color3.fromRGB(0, 255, 200)
    local t1 = Instance.new("TextLabel", f)
    t1.Size, t1.Position, t1.BackgroundTransparency = UDim2.new(1, 0, 0, 20), UDim2.new(0, 0, 0, 5), 1
    t1.Text, t1.TextColor3, t1.Font, t1.TextSize = "⛳ PERCURSO", Color3.fromRGB(0, 255, 200), Enum.Font.GothamBold, 12
    local t2 = Instance.new("TextLabel", f)
    t2.Size, t2.Position, t2.BackgroundTransparency = UDim2.new(1, 0, 0, 20), UDim2.new(0, 0, 0, 25), 1
    t2.Text, t2.TextColor3, t2.Font, t2.TextSize = nomeRota or "Rota", Color3.fromRGB(255, 255, 255), Enum.Font.GothamBold, 14
    
    autoStart = true
    touchConn = RunService.Heartbeat:Connect(function()
        if not autoStart or not clone or not LocalPlayer.Character then return end
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if (hrp.Position - cfI.Position).Magnitude < 3 then
            autoStart = false
            touchConn:Disconnect()
            limparVis()
            _G.PlayRota(dados)
        end
    end)
end

function _G.PlayRota(dados)
    if not dados or #dados < 2 or playConn then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local cfs = {}
    for i, n in ipairs(dados) do cfs[i] = CFrame.new(table.unpack(n.CF)) end

    hum.WalkSpeed, hum.AutoRotate = 0, false
    TocarAnim()
    hrp.CFrame = cfs[1]

    local pStart, idx, total = os.clock(), 1, #dados
    local animSpeed = 1

    local function fim()
        if playConn then playConn:Disconnect() playConn = nil end
        if hum.Parent then hum.AutoRotate, hum.WalkSpeed = true, 16 end
        PararAnim()
    end

    playConn = RunService.RenderStepped:Connect(function()
        if not hrp.Parent or hum.Health <= 0 then return fim() end
        local elap = os.clock() - pStart
        while idx < total and elap >= dados[idx + 1].Time do idx += 1 end
        if idx >= total then return fim() end

        local t0, t1 = dados[idx].Time, dados[idx + 1].Time
        local alpha = (t1 > t0) and math.clamp((elap - t0) / (t1 - t0), 0, 1) or 1
        hrp.CFrame = cfs[idx]:Lerp(cfs[idx + 1], alpha)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        -- velocidade horizontal numa janela de ~0.15s
        local j = idx
        while j < total and dados[j].Time - t0 < 0.15 do j += 1 end
        local dt = dados[j].Time - t0
        local v = 0
        if dt > 0 then
            local d = cfs[j].Position - cfs[idx].Position
            v = Vector3.new(d.X, 0, d.Z).Magnitude / dt
        end

        if trackAndar then
            if v < 1 then
                if trackAndar.IsPlaying then trackAndar:Stop(0.15) end
            else
                if not trackAndar.IsPlaying then trackAndar:Play(0.15) end
                local alvo = math.clamp(v / 14.5, 0.3, 3) -- 14.5 = base do walk R6
                animSpeed += (alvo - animSpeed) * 0.2
                trackAndar:AdjustSpeed(animSpeed)
            end
        end
    end)
end

