------------------------------------------------------------------ HISTORY
local History = { list = {}, byId = {}, cache = nil }
local function newId()
	local id
	repeat
		local ok, g = pcall(HttpService.GenerateGUID, HttpService, false)
		id = ok and g:gsub("[^%w]", ""):sub(1, 10) or (tostring(os.time()) .. math.random(100, 999))
	until not History.byId[id]
	return id
end
local function sanitizeName(s)
	s = tostring(s or ""):gsub("%c", ""):gsub("^%s+", ""):gsub("%s+$", "")
	return s:sub(1, 40)
end
function History.save()
	local old = Storage.read("index.json")
	if old then Storage.write("index.bak.json", old) end
	local s, err = Serializer.encode({ v = CFG.version, routes = History.list })
	if not s then return false, err end
	return Storage.write("index.json", s)
end
function History.load()
	History.list, History.byId = {}, {}
	local function tryRead(name)
		local raw = Storage.read(name)
		if not raw then return nil end
		local data = Serializer.decode(raw)
		return data and Serializer.migrate(data)
	end
	local data = tryRead("index.json") or tryRead("index.bak.json")
	if not data or type(data.routes) ~= "table" then return end
	for _, m in ipairs(data.routes) do
		if type(m) == "table" and type(m.id) == "string" and type(m.name) == "string"
			and type(m.dur) == "number" and not History.byId[m.id] then
			m.n = tonumber(m.n) or 0
			History.list[#History.list + 1] = m
			History.byId[m.id] = m
		end
	end
end
function History.nextName()
	local mx = 0
	for _, m in ipairs(History.list) do
		local n = tonumber(m.name:match("^Rota (%d+)$"))
		if n and n > mx then mx = n end
	end
	return string.format("Rota %03d", mx + 1)
end
function History.add(session, dur, partial)
	local id = newId()
	local meta = Serializer.buildMeta(id, History.nextName(), session, dur, partial)
	local body, err = Serializer.encode({ v = CFG.version, id = id, ev = session.events })
	if not body then return nil, err end
	local ok, werr = Storage.write("route_" .. id .. ".json", body)
	if not ok then return nil, werr end
	History.list[#History.list + 1] = meta
	History.byId[id] = meta
	local sok, serr = History.save()
	if not sok then return meta, "rota salva, mas o índice falhou: " .. tostring(serr) end
	return meta
end
function History.getEvents(id)
	if History.cache and History.cache.id == id then return History.cache.ev end
	local raw = Storage.read("route_" .. id .. ".json")
	if not raw then return nil, "arquivo da rota não encontrado" end
	local data, err = Serializer.decode(raw)
	if not data then return nil, err end
	local md, merr = Serializer.migrate(data)
	if not md then return nil, merr end
	if md.id ~= id then return nil, "identificador inconsistente" end
	local ev = Serializer.cleanEvents(md.ev)
	if #ev == 0 then return nil, "rota vazia ou corrompida" end
	local meta = History.byId[id]
	if meta then
		local c = Serializer.analyze(ev)
		meta.ok, meta.na, meta.n = c.ok, c.na, #ev
	end
	History.cache = { id = id, ev = ev }
	return ev
end
function History.rename(id, name)
	local m = History.byId[id]
	if not m then return false, "rota inexistente" end
	name = sanitizeName(name)
	if name == "" then return false, "nome vazio" end
	m.name = name
	return History.save()
end
function History.delete(id)
	if not History.byId[id] then return false, "rota inexistente" end
	for i, x in ipairs(History.list) do if x.id == id then table.remove(History.list, i) break end end
	History.byId[id] = nil
	if History.cache and History.cache.id == id then History.cache = nil end
	Storage.delete("route_" .. id .. ".json")
	return History.save()
end
function History.duplicate(id)
	local m = History.byId[id]
	if not m then return nil, "rota inexistente" end
	local ev, err = History.getEvents(id)
	if not ev then return nil, err end
	local nid = newId()
	local body, e2 = Serializer.encode({ v = CFG.version, id = nid, ev = ev })
	if not body then return nil, e2 end
	local ok, werr = Storage.write("route_" .. nid .. ".json", body)
	if not ok then return nil, werr end
	local copy = {}
	for k, v in pairs(m) do copy[k] = v end
	copy.id, copy.name, copy.created = nid, sanitizeName(m.name .. " (cópia)"), os.time()
	History.list[#History.list + 1] = copy
	History.byId[nid] = copy
	History.save()
	return copy
end
function History.sorted()
	local out = {}
	for _, m in ipairs(History.list) do out[#out + 1] = m end
	table.sort(out, function(a, b) return a.created > b.created end)
	return out
end
local function statusOf(m)
	if m.partial then return "incompleta" end
	if (m.na or 0) > 0 then return "com eventos não reproduzíveis" end
	return "disponível"
end
local function compatPct(m)
	local t = (m.ok or 0) + (m.na or 0)
	return t == 0 and 100 or math.floor((m.ok or 0) / t * 100)
end

------------------------------------------------------------------ LER JOGO (diagnóstico)
local Scan = { profile = nil, sections = {}, order = {}, summary = "Toque em LER JOGO para diagnosticar.", running = false }
local SPRINT_PAT = { "sprint", "run", "dash", "correr", "corrida", "shift", "rapido", "rápido" }
local function isSprintName(s)
	s = string.lower(tostring(s or ""))
	for _, p in ipairs(SPRINT_PAT) do if s:find(p, 1, true) then return true end end
	return false
end
local SLOTS = { "idle", "walk", "run", "jump", "fall", "climb", "swim", "swimidle", "toolnone", "sit" }

function Scan.run(full)
	local P = { sprintKeys = {}, sprintGui = {}, sprintAttrs = {}, customLoco = false, hasSprint = false }
	local secs, order = {}, {}
	local function sec(name, lines) secs[name] = lines order[#order + 1] = name end
	local yn = 0
	local function y() yn += 1 if full and yn % 800 == 0 then task.wait() end end

	-- Jogo
	local pname = "?"
	pcall(function() pname = MPS:GetProductInfo(game.PlaceId).Name end)
	sec("Jogo", {
		"Nome: " .. tostring(pname), "PlaceId: " .. game.PlaceId, "GameId: " .. game.GameId,
		string.format("Toque: %s • Teclado: %s • Controle: %s", tostring(UIS.TouchEnabled), tostring(UIS.KeyboardEnabled), tostring(UIS.GamepadEnabled)),
		"Gravidade: " .. workspace.Gravity, "Streaming: " .. tostring(workspace.StreamingEnabled),
		"Jogadores: " .. #Players:GetPlayers(),
	})

	-- Personagem + animação de andar
	local hum, _, char = getChar()
	local L = {}
	if hum then
		L[#L + 1] = "Rig: " .. hum.RigType.Name
		L[#L + 1] = "WalkSpeed: " .. r1(hum.WalkSpeed)
		L[#L + 1] = hum.UseJumpPower and ("JumpPower: " .. hum.JumpPower) or ("JumpHeight: " .. hum.JumpHeight)
		L[#L + 1] = "HipHeight: " .. r2(hum.HipHeight) .. " • AutoRotate: " .. tostring(hum.AutoRotate)
		local animate = char:FindFirstChild("Animate")
		if animate then
			P.animate = true
			L[#L + 1] = "Script Animate: SIM"
			for _, slot in ipairs(SLOTS) do
				local f = animate:FindFirstChild(slot)
				if f then
					local ids = {}
					for _, a in ipairs(f:GetChildren()) do
						if a:IsA("Animation") then ids[#ids + 1] = (a.AnimationId:gsub("%D", "")) end
					end
					L[#L + 1] = "  " .. slot .. ": " .. (#ids > 0 and table.concat(ids, ", ") or "-")
					if slot == "walk" then P.walkAnim = ids[1] end
					if slot == "run" then P.runAnim = ids[1] end
				end
			end
		else
			P.customLoco = true
			L[#L + 1] = "Script Animate: NÃO (andar/animações provavelmente personalizados)"
		end
		local animator = hum:FindFirstChildOfClass("Animator")
		if animator then
			L[#L + 1] = "Animações tocando agora:"
			for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
				L[#L + 1] = string.format("  %s • %s • %s", tr.Name, (tr.Animation and tr.Animation.AnimationId or ""):gsub("%D", ""), tr.Priority.Name)
			end
		end
	else
		L[1] = "Personagem indisponível."
	end
	sec("Personagem", L)

	-- Correr / sprint
	local SL = {}
	local okA, bound = pcall(function() return CAS:GetAllBoundActionInfo() end)
	SL[#SL + 1] = "Ações vinculadas (ContextActionService):"
	if okA and type(bound) == "table" then
		for aname, info in pairs(bound) do
			local keys = {}
			for _, it in ipairs(info.inputTypes or {}) do
				keys[#keys + 1] = (typeof(it) == "EnumItem") and it.Name or tostring(it)
			end
			local sp = isSprintName(aname) or isSprintName(info.title)
			SL[#SL + 1] = (sp and "★ " or "• ") .. tostring(aname) .. " [" .. table.concat(keys, ",") .. "]"
				.. (info.createTouchButton and " (botão na tela)" or "")
			if sp then
				P.hasSprint, P.sprintAction = true, aname
				for _, it in ipairs(info.inputTypes or {}) do
					if typeof(it) == "EnumItem" and it.EnumType == Enum.KeyCode then P.sprintKeys[it.Name] = true end
				end
			end
		end
	end
	SL[#SL + 1] = "Atributos:"
	local function attrs(inst, label)
		if not inst then return end
		local okT, t = pcall(function() return inst:GetAttributes() end)
		if okT and type(t) == "table" then
			for k, v in pairs(t) do
				SL[#SL + 1] = "  " .. label .. "." .. k .. " = " .. tostring(v)
				if isSprintName(k) then P.sprintAttrs[#P.sprintAttrs + 1] = label .. "." .. k P.hasSprint = true end
			end
		end
	end
	attrs(LP, "Player") attrs(char, "Char") attrs(hum, "Humanoid")
	local BL = {}
	local pg = LP:FindFirstChildOfClass("PlayerGui")
	if pg then
		for _, d in ipairs(pg:GetDescendants()) do
			y()
			if d:IsA("GuiButton") then
				local txt = d:IsA("TextButton") and d.Text or ""
				local sp = isSprintName(d.Name) or isSprintName(txt)
				BL[#BL + 1] = string.format("%s%s (%s) em %s%s", sp and "★ " or "• ", d.Name, d.ClassName,
					d.Parent and d.Parent.Name or "?", txt ~= "" and (' "' .. txt .. '"') or "")
				if sp then P.sprintGui[d.Name] = true P.hasSprint = true end
			end
		end
	end
	sec("Correr e controles", SL)
	sec("Botões da tela", BL)

	if full then
		-- Animações encontradas
		local AL, seen = {}, {}
		local function scanAnim(root, label)
			if not root then return end
			for _, d in ipairs(root:GetDescendants()) do
				y()
				if d:IsA("Animation") and d.AnimationId ~= "" and not seen[d.AnimationId] then
					seen[d.AnimationId] = true
					AL[#AL + 1] = label .. ": " .. d.Name .. " = " .. (d.AnimationId:gsub("%D", ""))
				end
			end
		end
		scanAnim(char, "Personagem") scanAnim(LP:FindFirstChildOfClass("Backpack"), "Mochila")
		scanAnim(game:GetService("StarterPack"), "StarterPack") scanAnim(RSt, "ReplicatedStorage")
		scanAnim(workspace, "Workspace")
		sec("Animações", AL)

		-- Interações + remotes (uma passada no Workspace)
		local IL, RL = {}, {}
		local nPrompt, nClick, nSeat = 0, 0, 0
		for _, d in ipairs(workspace:GetDescendants()) do
			y()
			if d:IsA("ProximityPrompt") then
				nPrompt += 1
				if nPrompt <= 40 then
					IL[#IL + 1] = string.format("Prompt: %s / %s (segurar %.1fs) em %s", d.ObjectText, d.ActionText, d.HoldDuration, d.Parent and d.Parent.Name or "?")
				end
			elseif d:IsA("ClickDetector") then
				nClick += 1
				if nClick <= 40 then IL[#IL + 1] = "ClickDetector em " .. (d.Parent and d.Parent.Name or "?") end
			elseif d:IsA("Seat") or d:IsA("VehicleSeat") then
				nSeat += 1
			elseif d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
				RL[#RL + 1] = d.ClassName .. ": " .. d:GetFullName()
			end
		end
		table.insert(IL, 1, string.format("Total: %d prompts • %d click detectors • %d assentos", nPrompt, nClick, nSeat))
		local tools = {}
		local bp = LP:FindFirstChildOfClass("Backpack")
		for _, root in ipairs({ bp, char, game:GetService("StarterPack") }) do
			if root then for _, t in ipairs(root:GetChildren()) do if t:IsA("Tool") then tools[t.Name] = true end end end
		end
		local tl = {}
		for n in pairs(tools) do tl[#tl + 1] = n end
		IL[#IL + 1] = "Ferramentas: " .. (#tl > 0 and table.concat(tl, ", ") or "nenhuma")
		sec("Interações", IL)

		for _, d in ipairs(RSt:GetDescendants()) do
			y()
			if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") or d.ClassName == "UnreliableRemoteEvent" then
				RL[#RL + 1] = d.ClassName .. ": " .. d:GetFullName()
			end
		end
		table.insert(RL, 1, "Total de remotes visíveis: " .. #RL .. " (só nomes; o servidor não é visível)")
		sec("Remotes", RL)

		-- Scripts visíveis
		local CL = {}
		local function scanScripts(root, label)
			if not root then return end
			for _, d in ipairs(root:GetDescendants()) do
				y()
				if d:IsA("LocalScript") or d:IsA("ModuleScript") then
					CL[#CL + 1] = label .. ": " .. d.ClassName .. " " .. d.Name
				end
			end
		end
		scanScripts(pg, "PlayerGui") scanScripts(LP:FindFirstChild("PlayerScripts"), "PlayerScripts")
		scanScripts(char, "Personagem")
		sec("Scripts (nomes)", CL)
	end
	sec("Executor", Compat.report())

	-- Resumo
	local keys = {}
	for k in pairs(P.sprintKeys) do keys[#keys + 1] = k end
	local guis = {}
	for k in pairs(P.sprintGui) do guis[#guis + 1] = k end
	local sum = {}
	sum[#sum + 1] = "Animação de andar: " .. (P.customLoco and "PERSONALIZADA (sem Animate) — gravo todas as animações"
		or ("padrão (Animate)" .. (P.walkAnim and (" • walk " .. P.walkAnim) or "")))
	if P.hasSprint then
		sum[#sum + 1] = "Correr: DETECTADO" .. (P.sprintAction and (" • ação " .. tostring(P.sprintAction)) or "")
			.. (#keys > 0 and (" • teclas " .. table.concat(keys, ",")) or "")
			.. (#guis > 0 and (" • botões " .. table.concat(guis, ",")) or "")
			.. (#P.sprintAttrs > 0 and (" • atributos " .. table.concat(P.sprintAttrs, ",")) or "")
	else
		sum[#sum + 1] = "Correr: não detectado (mudanças de velocidade ainda são gravadas)"
	end
	sum[#sum + 1] = "Controles: " .. (UIS.TouchEnabled and "toque" or "teclado/mouse")
	if full then
		sum[#sum + 1] = string.format("Prompts/cliques: %s", (secs["Interações"] and secs["Interações"][1]) or "-")
	end

	Scan.profile = P
	if full or #Scan.order == 0 then
		Scan.sections, Scan.order, Scan.summary = secs, order, table.concat(sum, "\n")
	end
	return P, secs, order
end

function Scan.reportText()
	local out = { "AKZ ROTAS — diagnóstico do jogo", os.date("%d/%m/%Y %H:%M"), "" }
	for _, name in ipairs(Scan.order) do
		out[#out + 1] = "=== " .. name .. " ==="
		for _, l in ipairs(Scan.sections[name]) do out[#out + 1] = l end
		out[#out + 1] = ""
	end
	return table.concat(out, "\n")
end

function Scan.runAsync()
	if Scan.running then N("Ler jogo", "Já está lendo...") return end
	Scan.running = true
	N("Ler jogo", "Lendo o jogo... pode levar alguns segundos.", 4)
	task.spawn(function()
		local ok, err = pcall(Scan.run, true)
		Scan.running = false
		if not alive then return end
		if not ok then N("Erro ao ler jogo", tostring(err), 5) return end
		local txt = Scan.reportText()
		local saved = Storage.write("diagnostico_" .. game.PlaceId .. ".txt", txt)
		if Compat.clip then pcall(setclipboard, txt) end
		N("Leitura concluída", saved and (Storage.persistent and "Relatório salvo e copiado." or "Relatório na memória.") or "Relatório pronto.", 4)
		if UI.updateScan then UI.updateScan() end
	end)
end

------------------------------------------------------------------ RECORDER
local Playback
local Recorder = { active = false, session = nil, conns = {}, errors = 0 }
local SKIP_KEYS = { W = 1, A = 1, S = 1, D = 1, Up = 1, Down = 1, Left = 1, Right = 1, Space = 1, Unknown = 1 }

local function guard(f)
	return function(...)
		if not pcall(f, ...) then Recorder.errors += 1 end
	end
end
local function rconn(c) Recorder.conns[#Recorder.conns + 1] = c end

function Recorder.push(k, d)
	local s = Recorder.session
	if not (s and Recorder.active) then return end
	if #s.events >= CFG.maxEvents then Recorder.stop("limite de eventos", true) return end
	s.seq += 1
	local e = { t = r2(os.clock() - s.t0), n = s.seq, k = k, d = d or {} }
	local _, hrp = getChar()
	if hrp then
		e.p = { r2(hrp.Position.X), r2(hrp.Position.Y), r2(hrp.Position.Z) }
		e.r = yawOf(hrp)
	end
	s.events[#s.events + 1] = e
	return e
end

local function findDetector(part)
	local cur, depth = part, 0
	while cur and cur ~= workspace and depth < 5 do
		local cd = cur:FindFirstChildOfClass("ClickDetector")
		if cd then return cd end
		cur = cur.Parent
		depth += 1
	end
end
local function buttonAt(pos)
	local pg = LP:FindFirstChildOfClass("PlayerGui")
	if not pg then return nil end
	local inset = GuiService:GetGuiInset().Y
	for _, yy in ipairs({ pos.Y, pos.Y - inset }) do
		local okG, objs = pcall(function() return pg:GetGuiObjectsAtPosition(pos.X, yy) end)
		if okG then
			for _, o in ipairs(objs) do
				if o:IsA("GuiButton") and isShown(o) then return o end
			end
		end
	end
end

function Recorder.sample(force)
	local s = Recorder.session
	local hum, hrp = getChar()
	if not (s and hum and hrp) then return end
	local pos, yaw = hrp.Position, yawOf(hrp)
	local last = s.last
	local moved = (not last) or (pos - last.pos).Magnitude >= CFG.moveThreshold
	local rot = (not last) or math.abs(angDiff(yaw, last.yaw)) >= CFG.rotThreshold
	local idle = (os.clock() - s.lastT) >= CFG.idleInterval
	if force or moved or rot or idle then
		local ws = r2(hum.WalkSpeed)
		s.baseWs = s.baseWs or ws
		s.wsMin = s.wsMin and math.min(s.wsMin, ws) or ws
		s.wsMax = s.wsMax and math.max(s.wsMax, ws) or ws
		Recorder.push("move", {
			ws = ws, v = r2(hrp.AssemblyLinearVelocity.Magnitude), st = hum:GetState().Name,
			run = s.baseWs > 0 and ws >= s.baseWs * 1.2 or false,
		})
		s.last = { pos = pos, yaw = yaw }
		s.lastT = os.clock()
	end
end

local function bindTool(tool)
	if not tool:IsA("Tool") then return end
	rconn(tool.Activated:Connect(guard(function() Recorder.push("tool", { ph = "use", name = tool.Name }) end)))
end

function Recorder.bindCharacter(char, prof)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local s = Recorder.session
	rconn(hum.StateChanged:Connect(guard(function(old, new)
		Recorder.push("state", { from = old.Name, to = new.Name })
		local _, hrp = getChar()
		if new == Enum.HumanoidStateType.Jumping then
			s.jumpT = os.clock()
			Recorder.push("jump", { ph = "start", vy = hrp and r2(hrp.AssemblyLinearVelocity.Y) or 0 })
		elseif new == Enum.HumanoidStateType.Landed then
			local air = s.jumpT and r2(os.clock() - s.jumpT) or nil
			s.jumpT = nil
			Recorder.push("jump", { ph = "land", air = air })
		end
	end)))
	rconn(hum:GetPropertyChangedSignal("WalkSpeed"):Connect(guard(function() Recorder.sample(true) end)))
	rconn(hum.Died:Connect(guard(function() Recorder.stop("personagem morreu", true) end)))
	local animator = hum:FindFirstChildOfClass("Animator")
	if animator then
		rconn(animator.AnimationPlayed:Connect(guard(function(track)
			local id = track.Animation and track.Animation.AnimationId or ""
			local pri = track.Priority.Name
			local action = (pri == "Action" or pri == "Action2" or pri == "Action3" or pri == "Action4")
			local rp = id ~= "" and (action or prof.customLoco) or false
			Recorder.push("anim", { ph = "start", id = id, name = track.Name, pri = pri, sp = r2(track.Speed),
				loop = track.Looped, rp = rp })
			local c
			c = track.Stopped:Connect(function()
				if c then c:Disconnect() end
				guard(function() Recorder.push("anim", { ph = "stop", id = id, name = track.Name, rp = rp }) end)()
			end)
		end)))
	end
	rconn(char.ChildAdded:Connect(guard(function(ch)
		if ch:IsA("Tool") then Recorder.push("tool", { ph = "equip", name = ch.Name }) end
	end)))
	rconn(char.ChildRemoved:Connect(guard(function(ch)
		if ch:IsA("Tool") then Recorder.push("tool", { ph = "unequip", name = ch.Name }) end
	end)))
	for _, t in ipairs(char:GetChildren()) do bindTool(t) end
	local bp = LP:FindFirstChildOfClass("Backpack")
	if bp then
		for _, t in ipairs(bp:GetChildren()) do bindTool(t) end
		rconn(bp.ChildAdded:Connect(guard(bindTool)))
	end
	for _, pair in ipairs({ { LP, "Player" }, { char, "Char" }, { hum, "Humanoid" } }) do
		local inst, label = pair[1], pair[2]
		rconn(inst.AttributeChanged:Connect(guard(function(name)
			local v = inst:GetAttribute(name)
			if type(v) == "string" or type(v) == "number" or type(v) == "boolean" then
				Recorder.push("attr", { who = label, name = name, val = v, sp = isSprintName(name) or nil })
			end
		end)))
	end
end

function Recorder.start()
	if Recorder.active then return false, "já existe gravação ativa" end
	if Playback.state ~= "idle" then return false, "pare o Playback antes de gravar" end
	local hum, hrp, char = getChar()
	if not (hum and hrp) or hum.Health <= 0 then return false, "personagem indisponível" end
	if not Scan.profile then pcall(Scan.run, false) end
	local prof = Scan.profile or { sprintKeys = {}, customLoco = false }
	local s = { t0 = os.clock(), seq = 0, events = {}, lastT = os.clock(), keys = {}, holds = {}, touches = {},
		customLoco = prof.customLoco }
	Recorder.session, Recorder.active, Recorder.errors = s, true, 0
	Recorder.sample(true)

	local acc = 0
	rconn(RunService.Heartbeat:Connect(guard(function(dt)
		acc += dt
		if acc < CFG.sampleInterval then return end
		acc = 0
		Recorder.sample(false)
	end)))
	Recorder.bindCharacter(char, prof)
	rconn(LP.CharacterRemoving:Connect(guard(function() Recorder.stop("respawn", true) end)))

	local function isSprintKey(key) return prof.sprintKeys[key] or key == "LeftShift" or key == "RightShift" end
	rconn(UIS.InputBegan:Connect(guard(function(input, gp)
		if UIS:GetFocusedTextBox() then return end
		local ut = input.UserInputType
		if ut == Enum.UserInputType.Keyboard then
			local key = input.KeyCode.Name
			if SKIP_KEYS[key] then return end
			if gp and not isSprintKey(key) then return end
			s.keys[key] = os.clock()
			Recorder.push("input", { ph = "down", key = key, sp = isSprintKey(key) or nil })
		elseif ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.Touch then
			local btn = buttonAt(input.Position)
			if btn then
				s.touches[input] = { ref = makeRef(btn), t = os.clock(), sp = isSprintName(btn.Name) or nil }
				Recorder.push("gui", { ph = "down", ref = s.touches[input].ref, sp = s.touches[input].sp })
			elseif not gp then
				task.defer(guard(function()
					local target = LP:GetMouse().Target
					local cd = target and findDetector(target)
					if cd then Recorder.push("click", { ref = makeRef(cd) }) end
				end))
			end
		end
	end)))
	rconn(UIS.InputEnded:Connect(guard(function(input)
		local ut = input.UserInputType
		if ut == Enum.UserInputType.Keyboard then
			local key = input.KeyCode.Name
			if s.keys[key] then
				Recorder.push("input", { ph = "up", key = key, held = r2(os.clock() - s.keys[key]), sp = isSprintKey(key) or nil })
				s.keys[key] = nil
			end
		elseif s.touches[input] then
			local tc = s.touches[input]
			s.touches[input] = nil
			Recorder.push("gui", { ph = "up", ref = tc.ref, held = r2(os.clock() - tc.t), sp = tc.sp })
		end
	end)))
	rconn(PPS.PromptButtonHoldBegan:Connect(guard(function(prompt, plr)
		if plr ~= LP then return end
		s.holds[prompt] = os.clock()
		Recorder.push("prompt", { ph = "hold_begin", ref = makeRef(prompt), hold = prompt.HoldDuration })
	end)))
	rconn(PPS.PromptButtonHoldEnded:Connect(guard(function(prompt, plr)
		if plr ~= LP then return end
		local t0 = s.holds[prompt]
		s.holds[prompt] = nil
		Recorder.push("prompt", { ph = "hold_end", ref = makeRef(prompt), held = t0 and r2(os.clock() - t0) or 0 })
	end)))
	rconn(PPS.PromptTriggered:Connect(guard(function(prompt, plr)
		if plr ~= LP then return end
		Recorder.push("prompt", { ph = "trigger", ref = makeRef(prompt), hold = prompt.HoldDuration,
			action = prompt.ActionText, obj = prompt.ObjectText })
	end)))
	N("Gravação iniciada", prof.customLoco and "Animação personalizada detectada: gravando todas." or "Gravando movimentos e ações.")
	if UI.onRecState then UI.onRecState() end
	return true
end

function Recorder.finish(reason, interrupted)
	local s = Recorder.session
	Recorder.active = false
	for _, c in ipairs(Recorder.conns) do pcall(function() c:Disconnect() end) end
	Recorder.conns, Recorder.session = {}, nil
	if not s then return end
	local dur = os.clock() - s.t0
	if #s.events < 2 then
		N("Gravação descartada", "Poucos eventos para salvar.")
	else
		local meta, err = History.add(s, dur, interrupted and reason or nil)
		if not meta then
			N("Erro ao salvar", tostring(err), 5)
		else
			if err then N("Aviso", tostring(err), 5) end
			N(interrupted and "Gravação interrompida" or "Rota salva",
				string.format("%s • %s • %d eventos%s%s", meta.name, fmt(meta.dur), meta.n,
					meta.run and " • correr detectado" or "", interrupted and (" • " .. reason) or ""), 4)
			UI.sel = meta.id
		end
	end
	History.cache = nil
end
function Recorder.stop(reason, interrupted)
	if not Recorder.active then return end
	Recorder.finish(reason or "manual", interrupted)
	if alive and UI.refresh then UI.refresh() end
	if alive and UI.onRecState then UI.onRecState() end
end
function Recorder.cancel()
	if not Recorder.active then return end
	Recorder.active = false
	for _, c in ipairs(Recorder.conns) do pcall(function() c:Disconnect() end) end
	Recorder.conns, Recorder.session = {}, nil
	N("Gravação cancelada", "Dados descartados.")
	if UI.onRecState then UI.onRecState() end
end

------------------------------------------------------------------ PLAYBACK
Playback = { state = "idle", speed = 1, startPct = 0, ctx = nil, id = nil, summary = "Nenhuma reprodução ainda." }
UI.opts = { loop = false, countdown = true, tele = true, sprint = true, anims = true, tol = 8 }

local function sampleMove(ctx, t, advance)
	local m = ctx.moves
	local n = #m
	if n == 0 then return nil end
	local i = ctx.mi
	while i < n and m[i + 1].t <= t do i += 1 end
	if advance then ctx.mi = i end
	local a, b = m[i], m[i + 1]
	local function P(e) return Vector3.new(e.p[1], e.p[2], e.p[3]) end
	if t <= a.t or not b then
		return { pos = P(a), yaw = a.r or 0, ws = a.d.ws or 16, v = a.d.v or 0 }
	end
	local f = math.clamp((t - a.t) / math.max(b.t - a.t, 1e-3), 0, 1)
	local ya, yb = a.r or 0, b.r or 0
	return { pos = P(a):Lerp(P(b), f), yaw = ya + angDiff(yb, ya) * f, ws = a.d.ws or 16, v = a.d.v or 0 }
end
local function snapTo(ctx, tgt)
	pcall(function() ctx.char:PivotTo(CFrame.new(tgt.pos) * CFrame.Angles(0, math.rad(tgt.yaw), 0)) end)
end

function Playback.start(id)
	if Recorder.active then N("Bloqueado", "Pare a gravação antes de reproduzir.") return end
	if Playback.state ~= "idle" then N("Bloqueado", "Já existe um Playback ativo.") return end
	local meta = History.byId[id]
	if not meta then N("Selecione uma rota", "Nenhuma rota selecionada.") return end
	local ev, err = History.getEvents(id)
	if not ev then N("Erro ao carregar", tostring(err), 5) return end
	local hum, hrp, char = getChar()
	if not (hum and hrp) or hum.Health <= 0 then N("Playback", "Personagem indisponível.") return end
	local moves = {}
	for _, e in ipairs(ev) do if e.k == "move" then moves[#moves + 1] = e end end
	if #moves == 0 then N("Rota inválida", "Sem eventos de movimento.") return end
	if meta.place and meta.place ~= game.PlaceId then N("Aviso", "Rota gravada em outro jogo.", 4) end
	local opts = {}
	for k, v in pairs(UI.opts) do opts[k] = v end
	local dur = meta.dur
	local t0 = dur * (Playback.startPct / 100)
	local ei = 1
	while ei <= #ev and ev[ei].t < t0 do ei += 1 end
	local ctx = {
		ev = ev, ei = ei, moves = moves, mi = 1, t = t0, t0 = t0, dur = dur, hum = hum, char = char, opts = opts,
		tracks = {}, ok = 0, fail = 0, info = 0, hold = 0, corr = 0, loops = 0, errs = {}, speed = Playback.speed,
		savedWs = hum.WalkSpeed, animator = hum:FindFirstChildOfClass("Animator"),
	}
	local c = Serializer.analyze(ev)
	if c.na > 0 then N("Compatibilidade", c.na .. " evento(s) incompatíveis serão ignorados.", 4) end
	local s0 = sampleMove(ctx, t0, true)
	if s0 and (hrp.Position - s0.pos).Magnitude > opts.tol then
		if opts.tele then snapTo(ctx, s0) else N("Longe do início", "Vá até o ponto inicial da rota.", 4) end
	end
	if opts.countdown then
		ctx.wait = os.clock() + 3
		N("Playback", "Começa em 3s • " .. Playback.speed .. "x", 3)
	end
	Playback.ctx, Playback.id, Playback.state = ctx, id, "playing"
	Playback.conn = RunService.Heartbeat:Connect(function(dt)
		local ok, e = pcall(Playback.step, dt)
		if not ok then Playback.stop("erro interno") end
	end)
	if not opts.countdown then N("Playback iniciado", meta.name .. " • " .. Playback.speed .. "x") end
end

function Playback.step(dt)
	local ctx = Playback.ctx
	if Playback.state ~= "playing" or not ctx then return end
	local hum, hrp, char = getChar()
	if not (hum and hrp) or hum.Health <= 0 then Playback.stop("personagem indisponível") return end
	ctx.hum, ctx.char = hum, char
	if ctx.wait then
		if os.clock() < ctx.wait then return end
		ctx.wait = nil
	end
	local sp, tol = ctx.speed, ctx.opts.tol
	local tgt = sampleMove(ctx, ctx.t, true)
	if tgt then
		local flat = Vector3.new(hrp.Position.X - tgt.pos.X, 0, hrp.Position.Z - tgt.pos.Z).Magnitude
		pcall(function() hum.WalkSpeed = math.max(tgt.ws * sp, 4) end)
		if flat > tol or ctx.hold > 2 then
			snapTo(ctx, tgt)
			ctx.corr += 1
			ctx.hold = 0
			if ctx.corr <= 3 then N("Desvio corrigido", string.format("%.0f studs fora da rota.", flat), 2) end
		elseif flat > 3 and ctx.t < ctx.dur then
			ctx.hold += dt -- espera o personagem real alcançar
		else
			ctx.hold = 0
			ctx.t += dt * sp
		end
		local ahead = sampleMove(ctx, ctx.t + 0.2 * sp, false) or tgt
		hum:MoveTo(ahead.pos)
		if flat < 1 and tgt.v < 0.5 and math.abs(angDiff(hrp.Orientation.Y, tgt.yaw)) > 10 then
			pcall(function() hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(tgt.yaw), 0) end)
		end
	else
		ctx.t += dt * sp
	end
	local ev = ctx.ev
	while ctx.ei <= #ev and ev[ctx.ei].t <= ctx.t do
		local e = ev[ctx.ei]
		ctx.ei += 1
		if e.k ~= "move" then
			local st, msg = Adapters.run(e, ctx)
			if st == "ok" then ctx.ok += 1
			elseif st == "info" then ctx.info += 1
			else
				ctx.fail += 1
				if #ctx.errs < 4 then
					ctx.errs[#ctx.errs + 1] = msg or "falha"
					N("Não reproduzível", tostring(msg), 3)
				end
			end
		end
	end
	if ctx.t >= ctx.dur and ctx.ei > #ev then
		if ctx.opts.loop then
			ctx.loops += 1
			for _, tr in pairs(ctx.tracks) do pcall(function() tr:Stop(0.1) end) end
			ctx.tracks = {}
			ctx.t, ctx.mi, ctx.ei, ctx.hold = ctx.t0, 1, 1, 0
			while ctx.ei <= #ev and ev[ctx.ei].t < ctx.t0 do ctx.ei += 1 end
			local s0 = sampleMove(ctx, ctx.t0, true)
			if s0 and ctx.opts.tele then snapTo(ctx, s0) end
			ctx.wait = os.clock() + 1
		else
			Playback.stop("concluído")
		end
	end
end

function Playback.pause()
	if Playback.state ~= "playing" then return end
	Playback.state = "paused"
	local hum, hrp = getChar()
	if hum and hrp then pcall(function() hum:MoveTo(hrp.Position) end) end
	N("Playback pausado", fmt(Playback.ctx.t))
end
function Playback.resume()
	if Playback.state ~= "paused" then return end
	Playback.state = "playing"
	N("Playback retomado", fmt(Playback.ctx.t))
end
function Playback.stop(reason, quiet)
	if Playback.state == "idle" then return end
	local ctx = Playback.ctx
	Playback.state, Playback.ctx = "idle", nil
	if Playback.conn then Playback.conn:Disconnect() Playback.conn = nil end
	if ctx then
		pcall(function()
			local _, hrp = getChar()
			ctx.hum.WalkSpeed = ctx.savedWs
			if hrp then ctx.hum:MoveTo(hrp.Position) end
		end)
		for _, tr in pairs(ctx.tracks) do pcall(function() tr:Stop(0.1) end) end
		Playback.summary = string.format("%s\nExecutadas: %d • Falhas: %d • Informativas: %d\nCorreções de desvio: %d • Voltas: %d",
			tostring(reason), ctx.ok, ctx.fail, ctx.info, ctx.corr, ctx.loops)
		if not quiet then
			N(reason == "concluído" and "Playback concluído" or "Reprodução interrompida",
				string.format("%s • ok %d • falhas %d", tostring(reason), ctx.ok, ctx.fail), 4)
		end
	end
end
function Playback.restart()
	local id = Playback.id or UI.sel
	Playback.stop("reiniciado", true)
	if id then Playback.start(id) end
end

