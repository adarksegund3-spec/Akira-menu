-- BOTÃO ATIVAR
-- ═══════════════════════════════════════════════════════════════
ativar.MouseButton1Click:Connect(function()
    ativar.Text = "ESCANEANDO..."
    statusLbl.Text = "Coletando dados..."
    statusLbl.TextColor3 = Color3.fromRGB(255, 190, 60)

    task.wait(0.1)

    local ok, err = pcall(coletar)
    if not ok then
        linhas = {"ERRO: " .. tostring(err)}
    end

    -- Preview: só as primeiras 100 linhas
    local previewMax = 100
    local previewLinhas = {}
    for i = 1, math.min(#linhas, previewMax) do
        table.insert(previewLinhas, linhas[i])
    end
    if #linhas > previewMax then
        table.insert(previewLinhas, "")
        table.insert(previewLinhas, "... mais " .. (#linhas - previewMax) .. " linhas.")
        table.insert(previewLinhas, "Use COPIAR TUDO para pegar o resultado completo.")
    end

    previewText.Text = table.concat(previewLinhas, "\n")

    ativar.Text = "✔ CONCLUIDO"
    statusLbl.Text = tostring(#linhas) .. " linhas • Pronto"
    statusLbl.TextColor3 = Color3.fromRGB(120, 220, 140)

    task.delay(2, function()
        ativar.Text = "ATIVAR"
    end)
end)

