local function mk(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function corner(o, r) return mk("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
local function stroke(o, col, th, tr)
    return mk("UIStroke", { Color = col, Thickness = th or 1, Transparency = tr or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
local function grad(o, c0, c1, rot)
    return mk("UIGradient", { Color = ColorSequence.new(c0, c1), Rotation = rot or 0 }, o)
end
local function tween(o, t, props, style, dir)
    local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end
local function cr() return math.max(T.radius - 6, 3) end

local function text(parent, str, size, color, font, props)
    local p = {
        BackgroundTransparency = 1, Text = str, TextSize = size, TextColor3 = color or C(255, 255, 255),
        Font = font or T.bodyFont, TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center, Size = UDim2.new(1, 0, 0, size + 6),
        TextWrapped = true,
    }
    for k, v in pairs(props or {}) do p[k] = v end
    return mk("TextLabel", p, parent)
end

local SUB = C(190, 200, 220)

local function card(parent, h)
    local c = mk("Frame", { Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = T.card,
        BackgroundTransparency = T.cardT, BorderSizePixel = 0, LayoutOrder = nextOrd() }, parent)
    corner(c, cr())
    stroke(c, T.line, 1, 0.65)
    return c
end

local function button(parent, str, primary, cb, size)
    local b = mk("TextButton", {
        Size = size or UDim2.new(1, 0, 0, 38), BackgroundColor3 = primary and T.accent or T.card,
        BackgroundTransparency = primary and 0.05 or 0.1, Text = str, Font = T.boldFont, TextSize = 15,
        TextColor3 = primary and T.onAccent or C(255, 255, 255), AutoButtonColor = false,
        BorderSizePixel = 0, LayoutOrder = nextOrd(),
    }, parent)
    corner(b, cr())
    stroke(b, primary and T.accent or T.line, 1, primary and 0.2 or 0.5)
    if T.press then
        local sc = mk("UIScale", {}, b)
        b.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                tween(sc, 0.08, { Scale = 0.94 })
            end
        end)
        b.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                tween(sc, 0.12, { Scale = 1 }, Enum.EasingStyle.Back)
            end
        end)
    end
    b.Activated:Connect(function() pcall(cb) end)
    return b
end

local function row(parent, h)
    local f = mk("Frame", { Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 1, LayoutOrder = nextOrd() }, parent)
    mk("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder }, f)
    return f
end

