-- bloco recolhivel: titulo ^ + opcoes
-- prefix: se informado, aparece no nome do status ("Parkour 3 \u{00B7} R\u{00E1}pido")
local function makeBlock(order, titleText, options, prefix)
    local card = makeCard(PageParkour)
    card.LayoutOrder = order
    new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, card)

    local header = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, LayoutOrder = 1,
    }, card)

    local ht = label(header, titleText, 14, Enum.Font.GothamBold, TEXT)
    ht.Position = UDim2.new(0, 14, 0, 0)
    ht.Size = UDim2.new(1, -50, 1, 0)

    local arrow = label(header, "v", 16, Enum.Font.GothamBold, GREEN)
    arrow.TextXAlignment = Enum.TextXAlignment.Center
    arrow.Position = UDim2.new(1, -36, 0, 0)
    arrow.Size = UDim2.fromOffset(24, 42)

    local body = new("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2,
        Visible = false,
    }, card)
    new("UIPadding", {
        PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
    }, body)
    new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, body)

    header.MouseButton1Click:Connect(function()
        body.Visible = not body.Visible
        arrow.Text = body.Visible and "^" or "v"
    end)

    for n, opt in ipairs(options) do
        local optName, file = opt[1], opt[2]
        local has = file ~= nil
        local ob = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 34), LayoutOrder = n,
            BackgroundColor3 = Color3.fromRGB(24, 31, 27), AutoButtonColor = false,
            Text = has and optName or (optName .. "  \u{00B7}  em breve"),
            TextSize = 13, Font = Enum.Font.GothamMedium,
            TextColor3 = has and TEXT or MUTED, TextXAlignment = Enum.TextXAlignment.Left,
        }, body)
        corner(ob, 9)
        new("UIPadding", { PaddingLeft = UDim.new(0, 28) }, ob)
        local od = new("Frame", {
            Size = UDim2.fromOffset(6, 6), Position = UDim2.new(0, -16, 0.5, -3),
            BackgroundColor3 = has and GREEN or MUTED, BorderSizePixel = 0,
        }, ob)
        corner(od, 3)

        ob.MouseEnter:Connect(function() tween(ob, 0.15, { BackgroundColor3 = Color3.fromRGB(32, 48, 40) }) end)
        ob.MouseLeave:Connect(function() tween(ob, 0.15, { BackgroundColor3 = Color3.fromRGB(24, 31, 27) }) end)
        ob.MouseButton1Click:Connect(function()
            ob.BackgroundColor3 = Color3.fromRGB(50, 110, 80)
            tween(ob, 0.35, { BackgroundColor3 = Color3.fromRGB(24, 31, 27) })
            runMacroFile(file, prefix and (prefix .. " \u{00B7} " .. optName) or optName)
        end)
    end
end

do
