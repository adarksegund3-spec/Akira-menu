-- ======================================================================== --
-- BYPASS PRISON BY WILLZ & JP
-- ======================================================================== --

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local bypassAtivo = false
local noclipConnection = nil
local antiTpConnection = nil
local ultimaPosicao = nil
local textoConnections = {} -- conexões do detector/apagador do texto da prisão
local textosOcultos = {}    -- [label] = Visible original (para restaurar ao desativar)

-- ============================================
-- UI (TAMANHO E ESTILO DA FOTO)
-- ============================================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "BypassPrisonGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

-- Frame Principal
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 220, 0, 150) -- Tamanho da UI original
MainFrame.Position = UDim2.new(0.5, -110, 0.5, -75)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 20, 25) -- Fundo escuro
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = MainFrame

-- Borda ciano neon
local UIStroke = Instance.new("UIStroke")
UIStroke.Color = Color3.fromRGB(0, 255, 200)
UIStroke.Thickness = 1.5
UIStroke.Parent = MainFrame

-- Título no topo (só pra ficar bonito)
local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundTransparency = 1
Title.Font = Enum.Font.GothamBold
Title.Text = "BYPASS PRISON"
Title.TextColor3 = Color3.fromRGB(0, 255, 200)
Title.TextSize = 12
Title.Parent = MainFrame

-- Botão Principal (Grande)
local BypassBtn = Instance.new("TextButton")
BypassBtn.Size = UDim2.new(1, -20, 0, 50)
BypassBtn.Position = UDim2.new(0, 10, 0, 40)
BypassBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0) -- Vermelho (Desativado)
BypassBtn.Font = Enum.Font.GothamBold
BypassBtn.Text = "Desativado"
BypassBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
BypassBtn.TextSize = 14
BypassBtn.Parent = MainFrame

local BtnCorner = Instance.new("UICorner")
BtnCorner.CornerRadius = UDim.new(0, 6)
BtnCorner.Parent = BypassBtn

-- Área de Créditos embaixo
local Credits = Instance.new("TextLabel")
Credits.Size = UDim2.new(1, -20, 0, 40)
Credits.Position = UDim2.new(0, 10, 0, 100)
Credits.BackgroundColor3 = Color3.fromRGB(25, 30, 35)
Credits.Font = Enum.Font.GothamMedium
Credits.Text = "Créditos\nby willz & jp"
Credits.TextColor3 = Color3.fromRGB(200, 200, 200)
Credits.TextSize = 11
Credits.Parent = MainFrame

local CreditsCorner = Instance.new("UICorner")
CreditsCorner.CornerRadius = UDim.new(0, 6)
CreditsCorner.Parent = Credits

-- ============================================
-- FUNÇÕES
-- ============================================
BypassBtn.MouseButton1Click:Connect(function()
    bypassAtivo = not bypassAtivo

    if bypassAtivo then
        -- ATIVAR (VERDE)
        BypassBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        BypassBtn.Text = "ATIVADO"
        
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            ultimaPosicao = hrp.CFrame
        end

        -- Noclip
        noclipConnection = RunService.Stepped:Connect(function()
            if not bypassAtivo then return end
            local char = LocalPlayer.Character
            if not char then return end
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end)

        -- Anti-Teleporte
        antiTpConnection = RunService.Heartbeat:Connect(function()
            if not bypassAtivo then return end
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp or not ultimaPosicao then return end

            local dist = (hrp.Position - ultimaPosicao.Position).Magnitude
            
            -- Se a distância for muito grande (teleporte do server), volta
            if dist > 30 then
                hrp.CFrame = ultimaPosicao
            else
                ultimaPosicao = hrp.CFrame
            end
        end)

        -- Detectar e apagar o texto da prisão (somente na sua tela)
        local function normalizar(s)
            s = string.gsub(tostring(s), "<[^>]+>", "")
            s = string.gsub(s, "ã", "a")
            s = string.gsub(s, "Ã", "a")
            return string.lower(s)
        end

        local function contem(texto, palavra)
            return string.find(texto, palavra, 1, true) ~= nil
        end

        -- DETECTAR: cita prisão E fala de polichinelos/minutos
        -- Ex.: "Faça polichinelos para sair da prisão mais rápido! 50 polichinelos = -1 minuto na prisão"
        local function ehMensagemDePrisao(obj)
            local t = normalizar(obj.Text)
            local prisao = contem(t, "prisao") or contem(t, "preso") or contem(t, "prison") or contem(t, "jail")
            local regra = contem(t, "polichinelo") or contem(t, "minut")
            return prisao and regra
        end

        -- APAGAR: oculta o texto e mantém oculto se o jogo tentar mostrar de novo
        local function apagar(obj)
            if textosOcultos[obj] ~= nil then return end
            textosOcultos[obj] = obj.Visible
            obj.Visible = false
            table.insert(textoConnections, obj:GetPropertyChangedSignal("Visible"):Connect(function()
                if bypassAtivo and obj.Visible then obj.Visible = false end
            end))
        end

        local function verificar(obj)
            if ehMensagemDePrisao(obj) then apagar(obj) end
        end

        -- Verifica o texto agora e sempre que mudar (ex.: definido só ao ser preso)
        local function observar(obj)
            if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and not obj:IsDescendantOf(ScreenGui) then
                verificar(obj)
                table.insert(textoConnections, obj:GetPropertyChangedSignal("Text"):Connect(function()
                    verificar(obj)
                end))
            end
        end

        local playerGui = LocalPlayer:WaitForChild("PlayerGui")
        for _, d in ipairs(playerGui:GetDescendants()) do
            observar(d)
        end
        -- Textos criados depois (nova prisão)
        table.insert(textoConnections, playerGui.DescendantAdded:Connect(observar))

    else
        -- DESATIVAR (VERMELHO)
        BypassBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
        BypassBtn.Text = "Desativado"
        
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
        if antiTpConnection then
            antiTpConnection:Disconnect()
            antiTpConnection = nil
        end
        ultimaPosicao = nil

        -- Para o detector e restaura o texto da prisão
        for _, c in ipairs(textoConnections) do
            c:Disconnect()
        end
        textoConnections = {}
        for obj, visivelOriginal in pairs(textosOcultos) do
            if obj.Parent then obj.Visible = visivelOriginal end
        end
        textosOcultos = {}
    end
end)