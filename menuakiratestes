local views = {}

local function criarView(nome)
    local v = create("Frame", {
        Name = nome,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Visible = false,
    }, Content)
    views[nome] = v
    return v
end

local function mostrarView(nome)
    for n, v in pairs(views) do v.Visible = (n == nome) end
end

