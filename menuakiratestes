-- LÓGICA
-- ======================================================================== --
local recordedData = {}
local recordingConnection = nil
local playbackConnection = nil
local startTime = 0
local antigravidade = nil
local originalCollides = {}
local animationCache = {}
local activeTracks = {}
local preWalkTracks = {}

local function getOrLoadTrack(animator, animationId)
    if animationCache[animationId] and animationCache[animationId].Parent == animator then
        return animationCache[animationId]
    end
    local anim = Instance.new("Animation")
    anim.AnimationId = animationId
    local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
    if ok and track then
        animationCache[animationId] = track
        return track
    end
    return nil
end

local function getStartAnimations(data)
    data = data or recordedData
    if #data == 0 then return {} end
    local counts = {}
    local sampleCount = math.min(30, #data)
    for i = 1, sampleCount do
        local anims = data[i].Animations
        if anims then
            for _, a in ipairs(anims) do
                if not counts[a.Id] then counts[a.Id] = {anim = a, count = 0} end
                counts[a.Id].count = counts[a.Id].count + 1
            end
        end
    end
    local result = {}
    local threshold = math.max(2, sampleCount * 0.3)
    for _, info in pairs(counts) do
        if info.count >= threshold then table.insert(result, info.anim) end
    end
    local prioOrder = {Action=4,Action2=4,Action3=4,Action4=4,Movement=3,Idle=2,Core=1}
    table.sort(result, function(a, b)
        return (prioOrder[a.Priority] or 0) > (prioOrder[b.Priority] or 0)
    end)
    return result
end

local function stopPreWalkAnimations()
    for _, track in ipairs(preWalkTracks) do
        pcall(function() track:Stop(0.1) end)
    end
    preWalkTracks = {}
end

local function stopPlayback()
    if playbackConnection then
        playbackConnection:Disconnect()
        playbackConnection = nil
    end
    stopPreWalkAnimations()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if antigravidade then antigravidade:Destroy() antigravidade = nil end
    if hum then hum.AutoRotate = true end
    for _, track in pairs(activeTracks) do
        pcall(function() track:Stop(0.1) end)
    end
    activeTracks = {}
    for parte, status in pairs(originalCollides) do
        if parte and parte.Parent then parte.CanCollide = status end
    end
    table.clear(originalCollides)
end

local function playRoute(data)
    if #data == 0 then
        StatusLabel.Text = "Dados vazios!"
        return
    end
    if playbackConnection then
        stopPlayback()
        stopTimer()
        StatusLabel.Text = "Cancelado"
        return
    end

    StatusLabel.Text = "Indo pro início..."
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not hrp or not hum then return end

    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then animator = Instance.new("Animator", hum) end

    local animateScript = char:FindFirstChild("Animate")
    local animateWasDisabled = false
    if animateScript and animateScript:IsA("BaseScript") then
        animateScript.Disabled = true
        animateWasDisabled = true
    end

    local detectedAnims = getStartAnimations(data)
    preWalkTracks = {}
    for _, animData in ipairs(detectedAnims) do
        local track = getOrLoadTrack(animator, animData.Id)
        if track then
            pcall(function()
                track.Priority = Enum.AnimationPriority[animData.Priority] or Enum.AnimationPriority.Movement
                track.Looped = true
                track:Play(0.1)
                track:AdjustSpeed(animData.Speed or 1)
            end)
            table.insert(preWalkTracks, track)
        end
    end

    if #preWalkTracks == 0 then
        for i = 1, math.min(20, #data) do
            local anims = data[i].Animations
            if anims then
                local found = false
                for _, a in ipairs(anims) do
                    if a.Priority == "Movement" then
                        local track = getOrLoadTrack(animator, a.Id)
                        if track then
                            pcall(function()
                                track.Priority = Enum.AnimationPriority.Movement
                                track.Looped = true
                                track:Play(0.1)
                                track:AdjustSpeed(a.Speed or 1)
                            end)
                            table.insert(preWalkTracks, track)
                        end
                        found = true
                        break
                    end
                end
                if found then break end
            end
        end
    end

    local startCF = CFrame.new(unpack(data[1].CF))
    hum.WalkSpeed = 22
    hum:MoveTo(startCF.Position)

    local reached = false
    local conn
    conn = hum.MoveToFinished:Connect(function()
        reached = true
        if conn then conn:Disconnect() end
    end)
    local timeout = tick() + 5
    while not reached and tick() < timeout do task.wait(0.1) end
    if conn then conn:Disconnect() end

    stopPreWalkAnimations()
    if animateWasDisabled and animateScript then
        pcall(function() animateScript.Disabled = false end)
    end

    hum.AutoRotate = false
    antigravidade = Instance.new("BodyForce", hrp)
    antigravidade.Force = Vector3.new(0, 0, 0)

    for _, parte in ipairs(char:GetChildren()) do
        if parte:IsA("BasePart") then
            originalCollides[parte] = parte.CanCollide
            parte.CanCollide = false
        end
    end

    local pstartTime = os.clock()
    local totalPoints = #data
    local currentIndex = 1
    activeTracks = {}

    StatusLabel.Text = "Reproduzindo..."
    startTimer()

    playbackConnection = RunService.Heartbeat:Connect(function()
        -- Tempo já está em escala "normal" (pós-processado)
        local elapsedTime = os.clock() - pstartTime

        while currentIndex < totalPoints and elapsedTime >= data[currentIndex + 1].Time do
            currentIndex = currentIndex + 1
        end
        if currentIndex >= totalPoints then
            stopPlayback()
            stopTimer()
            StatusLabel.Text = string.format("OK! em %.2fs", timerFrozen)
            return
        end

        local p0 = data[currentIndex]
        local p1 = data[currentIndex + 1]
        local alpha = (p1.Time - p0.Time > 0) and math.clamp((elapsedTime - p0.Time) / (p1.Time - p0.Time), 0, 1) or 1

        local cf0 = CFrame.new(unpack(p0.CF))
        local cf1 = CFrame.new(unpack(p1.CF))
        hrp.CFrame = cf0:Lerp(cf1, alpha)

        local totalMass = 0
        for _, parte in ipairs(char:GetChildren()) do
            if parte:IsA("BasePart") then
                totalMass = totalMass + parte:GetMass()
            end
        end
        if antigravidade and antigravidade.Parent then
            antigravidade.Force = Vector3.new(0, totalMass * workspace.Gravity, 0)
        end
        if p1.Velocity then
            hrp.AssemblyLinearVelocity = Vector3.new(p1.Velocity[1], p1.Velocity[2], p1.Velocity[3])
        end
        if p0.State then
            pcall(function() hum:ChangeState(p0.State) end)
        end

        if p1.Animations then
            local wanted = {}
            for _, animData in ipairs(p1.Animations) do
                wanted[animData.Id] = animData
                local track = activeTracks[animData.Id]
                if not track then
                    track = getOrLoadTrack(animator, animData.Id)
                    if track then
                        pcall(function()
                            track.Priority = Enum.AnimationPriority[animData.Priority] or Enum.AnimationPriority.Movement
                            track.Looped = true
                            track:Play(0.05)
                        end)
                        activeTracks[animData.Id] = track
                    end
                end
                local t = activeTracks[animData.Id]
                if t then pcall(function() t:AdjustSpeed(animData.Speed) end) end
            end
            for id, track in pairs(activeTracks) do
                if not wanted[id] then
                    pcall(function() track:Stop(0.1) end)
                    activeTracks[id] = nil
                end
            end
        end
    end)
end

