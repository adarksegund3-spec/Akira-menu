	bShuffle.BackgroundColor3 = Player.shuffle and C.green or C.dgreen
	bShuffle.TextColor3 = Player.shuffle and C.black or C.white
	bRepeat.Text = Player.repeatMode == 2 and "⟲1" or "⟲"
	bRepeat.BackgroundColor3 = Player.repeatMode > 0 and C.green or C.dgreen
	bRepeat.TextColor3 = Player.repeatMode > 0 and C.black or C.white
