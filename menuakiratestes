        if processed or not selecting then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local plr = pickPlayerAt(input.Position)
        if not plr then return end
        if plr == LocalPlayer then notify("warn", "Seleção inválida", "Selecione outro militar.", 2.5); return end
        endSelection()
        selectedPlayer = plr
        pwName.Text = plr.Name
        pwQty.Text = ""
        PointsWin.Visible = true
    end)
end

