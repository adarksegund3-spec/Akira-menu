---------------------------------------------------------------- Maid / Util
local Maid = { items = {} }
function Maid.add(x) table.insert(Maid.items, x) return x end
function Maid.clean()
	for _, x in ipairs(Maid.items) do
		pcall(function()
			if typeof(x) == "RBXScriptConnection" then x:Disconnect()
			elseif typeof(x) == "Instance" then x:Destroy()
			elseif typeof(x) == "Tween" then x:Cancel()
			elseif type(x) == "function" then x() end
		end)
	end
	Maid.items = {}
end

local function new(class, props, kids)
	local o = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else o[k] = v end
	end
	for _, c in ipairs(kids or {}) do c.Parent = o end
	if parent then o.Parent = parent end
	return o
end
