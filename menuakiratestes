local VisualTab = Window:CreateTab("Visual", 4483362458)

VisualTab:CreateSection("ESP da Bola")

local espEnabled = false
local ballESP = {}

local function createESP(ballModel)
    if not espEnabled then return end
    local part = getBallPart(ballModel)
    if not part then return end
    local highlight = Instance.new("Highlight")
    highlight.Name = "BallESP"
    highlight.Adornee = ballModel
    highlight.FillColor = Color3.fromRGB(0, 255, 100)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.Parent = ballModel
    ballESP[ballModel] = highlight
end

local function removeESP(ballModel)
    if ballESP[ballModel] then ballESP[ballModel]:Destroy(); ballESP[ballModel] = nil end
end

VisualTab:CreateToggle({
    Name = "ESP da Bola",
    CurrentValue = false,
    Flag = "BallESP",
