local function runScan()
	local errCount, removed, skippedCount, totalSeen, failSer = 0, 0, 0, 0, 0
	local truncatedInst, truncatedBytes = false, false
	local list, idOf, skip = {}, {}, {}
	local roots = { Workspace, Lighting }
	local byClass, byCat, missingByProp = {}, {}, {}
	local incompletos = {}
	local incompletosTotal = 0
	local assets, assetOrder = {}, {}
	local partCount = {}
	local pivots = {}
	local objLines = {}
	local bytes = 0
	local registered = 0

	local function yieldLoop(n, label, fn)
		local last = os.clock()
		for i = 1, n do
			local ok = pcall(fn, i)
			if not ok then
				errCount = errCount + 1
			end
			if os.clock() - last > CONFIG.FRAME_BUDGET then
				setStatus(string.format("%s %d/%d (%d%%)", label, i, n, math.floor(i / n * 100)))
				task.wait()
				last = os.clock()
				if not gui.Parent then
					error("janela fechada")
				end
			end
		end
	end

	local function addSkip(root)
		skip[root] = true
		local ok, d = pcall(root.GetDescendants, root)
		if ok then
			for i = 1, #d do
				skip[d[i]] = true
			end
		end
	end

	setStatus("Listando instâncias...")
	task.wait()

	local cam = Workspace.CurrentCamera
	if cam then
		addSkip(cam)
	end
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then
			addSkip(pl.Character)
		end
	end

	for _, root in ipairs(roots) do
		local ok, desc = pcall(root.GetDescendants, root)
		if ok then
			for i = 1, #desc do
				local inst = desc[i]
				totalSeen = totalSeen + 1
				if skip[inst] then
					skippedCount = skippedCount + 1
				elseif #list >= CONFIG.MAX_INSTANCES then
					truncatedInst = true
				elseif not idOf[inst] then
					list[#list + 1] = inst
					idOf[inst] = #list
				end
			end
		else
			errCount = errCount + 1
		end
	end

	-- Pré-passo: quantidade de peças por contêiner
	yieldLoop(#list, "Contando peças", function(i)
		local inst = list[i]
		if inst:IsA("BasePart") and not inst:IsA("Terrain") then
			local p = inst.Parent
			while p and p ~= Workspace and p ~= Lighting and p ~= game do
				partCount[p] = (partCount[p] or 0) + 1
				p = p.Parent
			end
		end
	end)

	local function addAsset(kind, val, path)
		if type(val) ~= "string" or val == "" then
			return false
		end
		local a = assets[val]
		if not a then
			if #assetOrder >= CONFIG.MAX_ASSETS then
				return true
			end
			a = { tipo = kind, id = val, usos = 0, exemplos = {} }
			assets[val] = a
			assetOrder[#assetOrder + 1] = a
		end
		a.usos = a.usos + 1
		if #a.exemplos < 3 then
			a.exemplos[#a.exemplos + 1] = path
		end
		return true
	end

	local function getPivot(m)
		local c = pivots[m]
		if c == nil then
			local ok, cf = pcall(m.GetPivot, m)
			c = ok and cf or false
			pivots[m] = c
		end
		return c
	end

	local function classify(inst, rec, hasInteractChild, hasMechChild, stateAttr)
		local out = {}
		local present = {}
		local function add(c, conf, why)
			if not present[c] then
				present[c] = true
				out[#out + 1] = { categoria = c, confianca = conf, motivo = why }
			end
		end
		local cn = inst.ClassName
		if inst:IsA("Terrain") or inst:IsA("Sky") or inst:IsA("Atmosphere") or inst:IsA("Clouds") then
			add("terreno_ambiente", "confirmada", "classe " .. cn)
		end
		if inst:IsA("Light") or inst:IsA("ParticleEmitter") or inst:IsA("Fire") or inst:IsA("Smoke")
			or inst:IsA("Sparkles") or inst:IsA("Beam") or inst:IsA("Trail") or inst:IsA("PostEffect") then
			add("iluminacao_efeitos", "confirmada", "classe " .. cn)
		end
		if MECH[cn] then
			add("portas_portoes_mecanismos", "confirmada", "constraint/atuador físico (" .. cn .. ")")
		end
		if hasMechChild then
			add("portas_portoes_mecanismos", "confirmada", "possui constraint/atuador físico como filho")
		end
		if INTERACT[cn] or EVENTS[cn] or inst:IsA("Seat") or inst:IsA("VehicleSeat") then
			add("objetos_interativos", "confirmada", "classe " .. cn)
		end
		if hasInteractChild then
			add("objetos_interativos", "confirmada", "possui ProximityPrompt/ClickDetector/TouchInterest como filho")
		end
		if stateAttr then
			add("objetos_interativos", "provavel", "atributo com nome de estado (" .. stateAttr .. ")")
		end
		local set = tokens(inst.Name)
		for _, grp in ipairs(KW) do
			for _, kw in ipairs(grp[2]) do
				if set[kw] then
					add(grp[1], "provavel", "nome contém '" .. kw .. "'")
					break
				end
			end
		end
		if #out == 0 then
			if inst:IsA("BasePart") then
				add("desconhecidos", "nenhuma", "peça sem indício de função")
			elseif inst:IsA("Model") or inst:IsA("Folder") then
				add("desconhecidos", "nenhuma", "contêiner sem classificação")
			else
				add("desconhecidos", "nenhuma", "classe " .. cn .. " sem classificação")
			end
		end
		return out
	end

	local function describe(inst, id)
		local cn = inst.ClassName
		local rec = {
			id = id,
			parent_id = idOf[inst.Parent] or 0,
			nome = inst.Name,
			classe = cn,
			caminho = inst:GetFullName(),
		}
		local miss = {}
		local isTerrain = inst:IsA("Terrain")

		local nearest, outer
		local p = inst.Parent
		while p and p ~= Workspace and p ~= Lighting and p ~= game do
			if p:IsA("Model") then
				nearest = nearest or p
				outer = p
			end
			p = p.Parent
		end
		if nearest then
			rec.modelo_pai = nearest:GetFullName()
		end
		if outer and outer ~= nearest then
			rec.estrutura_principal = outer:GetFullName()
		end

		local assetRefs = {}
		for _, g in ipairs(PROPS) do
			if inst:IsA(g[1]) and not (g[1] == "BasePart" and isTerrain) then
				local out, m = readSpec(inst, g[2])
				for k, v in pairs(out) do
					rec[k] = v
				end
				for _, mm in ipairs(m) do
					miss[#miss + 1] = mm
					local key = cn .. "." .. mm
					missingByProp[key] = (missingByProp[key] or 0) + 1
				end
				for _, sp in ipairs(g[2]) do
					if sp[4] and out[sp[1]] then
						if addAsset(sp[4], out[sp[1]], rec.caminho) then
							assetRefs[#assetRefs + 1] = { tipo = sp[4], id = out[sp[1]] }
						end
					end
				end
			end
		end

		-- Posição mundial usada para posições relativas
		local wpos
		if inst:IsA("BasePart") and not isTerrain then
			local ok, v = pcall(index, inst, "Position")
			if ok then
				wpos = v
			end
		elseif inst:IsA("Attachment") then
			local ok, v = pcall(index, inst, "WorldPosition")
			if ok then
				wpos = v
			end
		end

		if inst:IsA("Model") then
			local ok, cf, sz = pcall(function()
				return inst:GetBoundingBox()
			end)
			if ok and cf and sz then
				rec.posicao = vec(cf.Position)
				rec.tamanho = vec(sz)
				local rx, ry, rz = cf:ToOrientation()
				rec.orientacao = { r3(math.deg(rx)), r3(math.deg(ry)), r3(math.deg(rz)) }
				wpos = cf.Position
			else
				miss[#miss + 1] = "BoundingBox"
			end
			local pv = getPivot(inst)
			if pv then
				rec.pivo_posicao = vec(pv.Position)
			end
			local okp, pp = pcall(index, inst, "PrimaryPart")
			if okp and pp then
				rec.peca_primaria = pp.Name
			end
		end

		if inst:IsA("ValueBase") then
			local ok, v = pcall(index, inst, "Value")
			if ok then
				rec.valor = ser(v)
			else
				miss[#miss + 1] = "Value"
			end
		end

		if wpos then
			if nearest then
				local pv = getPivot(nearest)
				if pv then
					rec.relativo_modelo = vec(pv:PointToObjectSpace(wpos))
				end
			end
			if outer and outer ~= nearest then
				local pv = getPivot(outer)
				if pv then
					rec.relativo_estrutura = vec(pv:PointToObjectSpace(wpos))
				end
			end
		end

		local hasInteractChild, hasMechChild = false, false
		if inst:IsA("BasePart") or inst:IsA("Model") or inst:IsA("Folder") then
			local ok, ch = pcall(inst.GetChildren, inst)
			if ok then
				local fi, sc = {}, {}
				for _, c in ipairs(ch) do
					local ccn = c.ClassName
					if INTERACT[ccn] then
						hasInteractChild = true
						if #fi < 12 then
							fi[#fi + 1] = ccn .. ":" .. c.Name
						end
					elseif MECH[ccn] then
						hasMechChild = true
						if #fi < 12 then
							fi[#fi + 1] = ccn .. ":" .. c.Name
						end
					elseif c:IsA("LuaSourceContainer") then
						if #sc < 8 then
							sc[#sc + 1] = ccn .. ":" .. c.Name
						end
					end
				end
				if #fi > 0 then
					rec.filhos_interativos = fi
				end
				if #sc > 0 then
					rec.scripts_filhos = sc
				end
				if not inst:IsA("BasePart") then
					rec.filhos_diretos = #ch
				end
			end
			if inst:IsA("Model") or inst:IsA("Folder") then
				rec.pecas_contidas = partCount[inst] or 0
			end
		end

		local stateAttr
		local okA, at = pcall(inst.GetAttributes, inst)
		if okA and at and next(at) ~= nil then
			local keys = {}
			for k in pairs(at) do
				keys[#keys + 1] = k
			end
			table.sort(keys)
			local arr = {}
			for _, k in ipairs(keys) do
				arr[#arr + 1] = { nome = k, valor = ser(at[k]) }
				if not stateAttr and STATE_ATTR[string.lower(k)] then
					stateAttr = k
				end
			end
			rec.atributos = arr
		elseif not okA then
			miss[#miss + 1] = "Attributes"
		end

		local okT, tags = pcall(CollectionService.GetTags, CollectionService, inst)
		if okT and tags and #tags > 0 then
			table.sort(tags)
			rec.tags = tags
		end

		if #assetRefs > 0 then
			rec.recursos_visuais = assetRefs
		end

		local cls = classify(inst, rec, hasInteractChild, hasMechChild, stateAttr)
		rec.categoria = cls[1].categoria
		rec.confianca = cls[1].confianca
		rec.motivo_classificacao = cls[1].motivo
		if #cls > 1 then
			local extra = {}
			for i = 2, #cls do
				extra[#extra + 1] = cls[i]
			end
			rec.classificacoes_adicionais = extra
		end

		if isTerrain then
			rec.observacao = "Ver bloco 'terreno' do relatório."
		end

		if #miss > 0 then
			rec.propriedades_indisponiveis = miss
			incompletosTotal = incompletosTotal + 1
			if #incompletos < CONFIG.MAX_INCOMPLETE then
				incompletos[#incompletos + 1] = { id = id, caminho = rec.caminho, faltando = miss }
			end
		end

		return rec
	end

	-- Varredura principal
	yieldLoop(#list, "Varrendo", function(i)
		local inst = list[i]
		if inst.Parent == nil then
			removed = removed + 1
			return
		end
		if bytes > CONFIG.MAX_REPORT_BYTES then
			truncatedBytes = true
			return
		end
		local ok, rec = pcall(describe, inst, i)
		if not ok or type(rec) ~= "table" then
			failSer = failSer + 1
			rec = { id = i, nome = "?", classe = inst.ClassName, erro = "falha ao descrever o objeto" }
		end
		local okE, enc = pcall(HttpService.JSONEncode, HttpService, rec)
		if not okE then
			failSer = failSer + 1
			rec = { id = i, classe = inst.ClassName, erro = "falha ao serializar (nome/valor inválido)" }
			okE, enc = pcall(HttpService.JSONEncode, HttpService, rec)
			if not okE then
				return
			end
		end
		objLines[#objLines + 1] = enc
		bytes = bytes + #enc + 2
		registered = registered + 1
		byClass[rec.classe] = (byClass[rec.classe] or 0) + 1
		local c = rec.categoria or "desconhecidos"
		byCat[c] = (byCat[c] or 0) + 1
	end)

	-- Terreno (amostragem por raycast)
	setStatus("Amostrando terreno...")
	task.wait()
	local terrainInfo = { encontrado = false }
	local sampleLines = {}
	do
		local terrain = Workspace:FindFirstChildOfClass("Terrain")
		if terrain then
			terrainInfo.encontrado = true
			local tp, tmiss = readSpec(terrain, {
				{ "cor_agua_rgb", "WaterColor", col },
				{ "transparencia_agua", "WaterTransparency", r3 },
				{ "reflectancia_agua", "WaterReflectance", r3 },
				{ "onda_tamanho", "WaterWaveSize", r3 },
				{ "onda_velocidade", "WaterWaveSpeed", r3 },
				{ "decoracao_ativa", "Decoration", idf },
			})
			terrainInfo.propriedades = tp
			if #tmiss > 0 then
				terrainInfo.propriedades_indisponiveis = tmiss
			end

			local lo = Vector3.new(-1024, -512, -1024)
			local hi = Vector3.new(1024, 1024, 1024)
			local okE, e = pcall(index, terrain, "MaxExtents")
			if okE and e then
				local okC = pcall(function()
					lo = Vector3.new(e.Min.X * 4, e.Min.Y * 4, e.Min.Z * 4)
					hi = Vector3.new(e.Max.X * 4, e.Max.Y * 4, e.Max.Z * 4)
					terrainInfo.extensao_declarada_studs = { vec(lo), vec(hi) }
				end)
				if not okC then
					lo = Vector3.new(-1024, -512, -1024)
					hi = Vector3.new(1024, 1024, 1024)
				end
			end
			lo = Vector3.new(math.max(lo.X, -2048), math.max(lo.Y, -1024), math.max(lo.Z, -2048))
			hi = Vector3.new(math.min(hi.X, 2048), math.min(hi.Y, 2048), math.min(hi.Z, 2048))
			local span = math.max(hi.X - lo.X, hi.Z - lo.Z, 16)
			local step = math.max(16, math.ceil(span / 64 / 16) * 16)

			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			params.FilterDescendantsInstances = { terrain }
			params.IgnoreWater = false

			local mats, matList, matCount = {}, {}, {}
			local hits, waterHits, total = 0, 0, 0
			local yMin, yMax = math.huge, -math.huge
			local cur = {}
			local last = os.clock()
			local height = hi.Y - lo.Y + 8
			local x = lo.X
			while x <= hi.X do
				local z = lo.Z
				while z <= hi.Z do
					total = total + 1
					local ok, res = pcall(function()
						return Workspace:Raycast(Vector3.new(x, hi.Y + 4, z), Vector3.new(0, -height, 0), params)
					end)
					if ok and res then
						hits = hits + 1
						local mn = res.Material.Name
						if not mats[mn] then
							matList[#matList + 1] = mn
							mats[mn] = #matList
							matCount[mn] = 0
						end
						matCount[mn] = matCount[mn] + 1
						if res.Material == Enum.Material.Water then
							waterHits = waterHits + 1
						end
						local y = res.Position.Y
						yMin = math.min(yMin, y)
						yMax = math.max(yMax, y)
						cur[#cur + 1] = string.format("[%d,%d,%.1f,%d]", x, z, y, mats[mn])
						if #cur >= 100 then
							sampleLines[#sampleLines + 1] = table.concat(cur, ",")
							cur = {}
						end
					end
					if os.clock() - last > CONFIG.FRAME_BUDGET then
						setStatus(string.format("Amostrando terreno %d amostras...", total))
						task.wait()
						last = os.clock()
					end
					z = z + step
				end
				x = x + step
			end
			if #cur > 0 then
				sampleLines[#sampleLines + 1] = table.concat(cur, ",")
			end

			local matOut = {}
			for _, mn in ipairs(matList) do
				local entry = { indice = mats[mn], material = mn, amostras = matCount[mn] }
				local okc, c = pcall(function()
					return terrain:GetMaterialColor(Enum.Material[mn])
				end)
				if okc and c then
					entry.cor_rgb = col(c)
				end
				matOut[#matOut + 1] = entry
			end
			terrainInfo.metodo = "ESTIMATIVA: raycast vertical em grade (somente superfície visível). Não é leitura de voxels."
			terrainInfo.formato_amostras = "[x, z, y, indice_material]"
			terrainInfo.limites_amostrados = { vec(lo), vec(hi) }
			terrainInfo.passo_studs = step
			terrainInfo.amostras_totais = total
			terrainInfo.amostras_com_terreno = hits
			terrainInfo.amostras_agua = waterHits
			terrainInfo.altura_min = hits > 0 and r3(yMin) or nil
			terrainInfo.altura_max = hits > 0 and r3(yMax) or nil
			terrainInfo.materiais = matOut
			if hits == 0 then
				terrainInfo.aviso = "Nenhum terreno detectado nas amostras (pode não existir ou não estar carregado)."
			else
				terrainInfo.aviso = "Cavernas, camadas inferiores e feições menores que o passo não foram capturadas; o terreno NÃO foi reconstruído integralmente."
			end
		end
	end

	-- Ambiente
	local ambiente = { place_id = game.PlaceId, game_id = game.GameId }
	pcall(function()
		local info = MarketplaceService:GetProductInfo(game.PlaceId)
		if info and info.Name then
			ambiente.nome_do_lugar = info.Name
		end
	end)
	local lp, lmiss = readSpec(Lighting, {
		{ "clock_time", "ClockTime", r3 },
		{ "brilho", "Brightness", r3 },
		{ "ambient_rgb", "Ambient", col },
		{ "outdoor_ambient_rgb", "OutdoorAmbient", col },
		{ "fog_cor_rgb", "FogColor", col },
		{ "fog_inicio", "FogStart", r3 },
		{ "fog_fim", "FogEnd", r3 },
		{ "sombras_globais", "GlobalShadows", idf },
		{ "tecnologia", "Technology", enumName },
	})
	ambiente.iluminacao = lp
	if #lmiss > 0 then
		ambiente.iluminacao_indisponivel = lmiss
	end
	local wp, wmiss = readSpec(Workspace, {
		{ "gravidade", "Gravity", r3 },
		{ "streaming_ativo", "StreamingEnabled", idf },
		{ "altura_destruicao_pecas", "FallenPartsDestroyHeight", r3 },
	})
	ambiente.workspace = wp
	if #wmiss > 0 then
		ambiente.workspace_indisponivel = wmiss
	end

	local streaming = wp.streaming_ativo == true

	-- Resumo
	local parcial = truncatedInst or truncatedBytes or errCount > 0 or failSer > 0
	local cats = {
		"terreno_ambiente", "estruturas_edificios", "salas_divisoes", "moveis_decorativos",
		"portas_portoes_mecanismos", "objetos_interativos", "iluminacao_efeitos", "desconhecidos",
	}
	local catOut = {}
	for _, c in ipairs(cats) do
		catOut[c] = byCat[c] or 0
	end
	local resumo = {
		total_instancias_encontradas = totalSeen,
		total_instancias_examinadas = #list,
		total_objetos_registrados = registered,
		ignoradas_personagens_e_camera = skippedCount,
		removidas_durante_varredura = removed,
		falhas_individuais = errCount,
		falhas_de_serializacao = failSer,
		coleta_parcial = parcial,
		contagem_por_classe = byClass,
		contagem_por_categoria = catOut,
		recursos_visuais_unicos = #assetOrder,
		objetos_com_propriedades_incompletas = incompletosTotal,
	}

	local limitacoes = {
		"Somente dados replicados ao cliente: ServerStorage, ServerScriptService e objetos não replicados não são acessíveis.",
		"Classificação 'confirmada' vem de classe/constraint/componente; 'provavel' vem apenas do nome ou de atributos e não é garantia.",
		"Scripts: apenas a existência (nome/classe) é registrada, nunca o código. Nenhum evento remoto foi chamado.",
		"Personagens de jogadores e a câmera foram ignorados.",
		"Union/MeshPart: tamanho é a caixa delimitadora, não a geometria real. Models: caixa delimitadora calculada por GetBoundingBox.",
		"Terreno: apenas amostragem por raycast da superfície; não é reconstrução integral.",
		"Salas e construções não são reconhecidas semanticamente; a categoria é uma sugestão para organizar a reconstrução.",
	}
	if streaming then
		limitacoes[#limitacoes + 1] = "StreamingEnabled está ativo: partes distantes do mapa podem não estar carregadas no cliente e ficaram fora do relatório."
	end
	if truncatedInst then
		limitacoes[#limitacoes + 1] = "COLETA PARCIAL: limite de " .. CONFIG.MAX_INSTANCES .. " instâncias atingido."
	end
	if truncatedBytes then
		limitacoes[#limitacoes + 1] = "COLETA PARCIAL: limite de tamanho do relatório atingido."
	end
	if removed > 0 then
		limitacoes[#limitacoes + 1] = removed .. " objeto(s) foram removidos do mapa durante a varredura."
	end

	local naoAnalisados = {
		"Serviços fora de Workspace e Lighting (ReplicatedStorage, StarterGui etc.) não foram varridos.",
	}
	if streaming then
		naoAnalisados[#naoAnalisados + 1] = "Áreas não transmitidas pelo streaming."
	end
	if truncatedInst then
		naoAnalisados[#naoAnalisados + 1] = "Instâncias além do limite de " .. CONFIG.MAX_INSTANCES .. "."
	end
	if truncatedBytes then
		naoAnalisados[#naoAnalisados + 1] = "Objetos finais da lista (limite de tamanho do relatório)."
	end
	if skippedCount > 0 then
		naoAnalisados[#naoAnalisados + 1] = skippedCount .. " instâncias de personagens/câmera ignoradas."
	end

	local dt = "indisponível"
	pcall(function()
		dt = DateTime.now():ToIsoDate()
	end)

	-- Montagem do JSON (linhas)
	local lines = { "{" }
	local function field(key, val)
		local ok, e = pcall(HttpService.JSONEncode, HttpService, val)
		if not ok then
			e = "null"
		end
		lines[#lines + 1] = '"' .. key .. '":' .. e .. ","
	end
	field("nome_diagnostico", "MAP SCANNER ULTIMATE v1.0")
	field("data_hora_utc", dt)
	field("ambiente", ambiente)
	field("resumo", resumo)
	field("limitacoes", limitacoes)
	field("possiveis_objetos_nao_analisados", naoAnalisados)
	field("propriedades_indisponiveis_por_classe", missingByProp)
	field("terreno", terrainInfo)
	lines[#lines + 1] = '"terreno_amostras":['
	for i, s in ipairs(sampleLines) do
		lines[#lines + 1] = s .. (i < #sampleLines and "," or "")
	end
	lines[#lines + 1] = "],"
	field("recursos_visuais", assetOrder)
	field("objetos_com_propriedades_incompletas", incompletos)
	lines[#lines + 1] = '"objetos":['
	for i, s in ipairs(objLines) do
		lines[#lines + 1] = s .. (i < #objLines and "," or "")
	end
	lines[#lines + 1] = "]"
	lines[#lines + 1] = "}"

	-- Partes para cópia
	local parts, cur, curSize = {}, {}, 0
	for _, ln in ipairs(lines) do
		if curSize + #ln + 1 > CONFIG.CLIP_LIMIT and #cur > 0 then
			parts[#parts + 1] = table.concat(cur, "\n")
			cur, curSize = {}, 0
		end
		cur[#cur + 1] = ln
		curSize = curSize + #ln + 1
	end
	if #cur > 0 then
		parts[#parts + 1] = table.concat(cur, "\n")
	end

	local total = 0
	for _, p in ipairs(parts) do
		total = total + #p
	end

	-- Validação do JSON e arquivo de apoio
	local validado = "não validado (relatório grande)"
	local salvo = false
	if total < 6000000 then
		local full = table.concat(parts, "\n")
		local okV = pcall(HttpService.JSONDecode, HttpService, full)
		validado = okV and "JSON válido" or "JSON COM ERRO de validação"
		if writefile then
			salvo = pcall(writefile, CONFIG.FILE_NAME, full)
		end
	elseif writefile then
		salvo = pcall(writefile, CONFIG.FILE_NAME, table.concat(parts, "\n"))
	end

	return {
		parts = parts,
		total = total,
		registered = registered,
		parcial = parcial,
		validado = validado,
		salvo = salvo,
	}
end

local function doCopy(text)
	local fn = setclipboard or toclipboard or (Clipboard and Clipboard.set)
	if not fn then
		return false, "indisponível"
	end
	local ok = pcall(fn, text)
	return ok, ok and "ok" or "erro"
end

btnGen.Activated:Connect(function()
	if scanning then
		return
	end
	scanning = true
	btnGen.Text = "Varrendo..."
	local ok, res = pcall(runScan)
	scanning = false
	btnGen.Text = "Gerar diagnóstico"
	if ok and res then
		report = res
		copyIdx = 1
		local msg = string.format("Concluído: %d objetos. %s.", res.registered, res.validado)
		if res.parcial then
			msg = msg .. " ATENÇÃO: coleta parcial."
		end
		if #res.parts > 1 then
			msg = msg .. string.format(" Cópia em %d partes.", #res.parts)
		end
		if res.salvo then
			msg = msg .. " Salvo em " .. CONFIG.FILE_NAME .. "."
		end
		setStatus(msg)
	else
		setStatus("Falha na varredura. Tente gerar novamente.")
	end
end)

btnCopy.Activated:Connect(function()
	if scanning then
		setStatus("Aguarde o fim da varredura.")
		return
	end
	if not report then
		setStatus("Gere o diagnóstico primeiro.")
		return
	end
	local n = #report.parts
	if n == 1 then
		local ok, why = doCopy(report.parts[1])
		if ok then
			setStatus("Diagnóstico copiado (" .. report.total .. " caracteres).")
		elseif why == "indisponível" then
			setStatus("Cópia indisponível neste executor." .. (report.salvo and (" Use o arquivo " .. CONFIG.FILE_NAME .. ".") or " Nada foi copiado."))
		else
			setStatus("A cópia falhou. Nada foi copiado." .. (report.salvo and (" Use o arquivo " .. CONFIG.FILE_NAME .. ".") or ""))
		end
		return
	end
	-- Relatório grande: cópia em partes (nada é descartado)
	local ok, why = doCopy(report.parts[copyIdx])
	if ok then
		local msg = string.format("Parte %d/%d copiada.", copyIdx, n)
		if copyIdx < n then
			copyIdx = copyIdx + 1
			msg = msg .. " Cole em um local e toque de novo para a próxima."
		else
			copyIdx = 1
			msg = msg .. " Todas as partes foram copiadas."
		end
		setStatus(msg)
	elseif why == "indisponível" then
		setStatus("Cópia indisponível neste executor." .. (report.salvo and (" Use o arquivo " .. CONFIG.FILE_NAME .. ".") or " Nada foi copiado."))
	else
		setStatus("A cópia da parte " .. copyIdx .. " falhou. Nada foi copiado.")
	end
end)