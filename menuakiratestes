local function doCopy(field, okText)
    if rec then setStatus("Pare a gravacao antes", "warn") return end
    local res = results[TABS[currentTab].key]
    if not res then setStatus("Nada gravado nesta aba", "warn") return end
    if not setclipboard then setStatus("Executor sem clipboard", "warn") return end
    local content = res[field]
    if not content or content == "" then setStatus("Nenhuma animacao detectada", "warn") return end
    local ok = pcall(function() setclipboard(content) end)
    setStatus(ok and okText or "Falha ao copiar", ok and "ok" or "warn")
end

