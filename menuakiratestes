-- ── HTTP ───────────────────────────────────────────────────
local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request
    or (fluxus and fluxus.request)

local function hasApiKey()
    local k = CatalogConfig.RScriptsAPIKey
    return type(k) == "string" and k ~= "" and k ~= "COLOQUE_SUA_API_KEY_AQUI"
end

-- Retorna status, body, retryAfter. status 0 = falha de conexão.
local function httpGet(url)
    if httpRequest then
        local headers = {Accept = "application/json"}
        if hasApiKey() then headers.Authorization = "Bearer " .. CatalogConfig.RScriptsAPIKey end
        local ok, res = pcall(httpRequest, {Url = url, Method = "GET", Headers = headers})
        if not ok or type(res) ~= "table" then return 0, tostring(res) end
        local ra
        if type(res.Headers) == "table" then
            for k, v in pairs(res.Headers) do
                if tostring(k):lower() == "retry-after" then ra = tonumber(v) end
            end
        end
        return tonumber(res.StatusCode) or 0, res.Body or "", ra
    end
    -- Fallback sem request(): HttpGet anônimo (a API é aberta, a key é opcional).
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok then return 200, body end
    local s = tostring(body)
    local code = tonumber(s:match("[Hh][Tt][Tt][Pp]%s*(%d%d%d)")) or tonumber(s:match("%f[%d](%d%d%d)%f[%D]")) or 0
    return code, s
end

local function errMsg(code, retry)
    if code == 0 then return "⚠ Não foi possível conectar à API.\nVerifique sua conexão ou tente novamente." end
    if code == 400 then return "⚠ Requisição inválida." end
    if code == 401 then return "⚠ API Key inválida." end
    if code == 403 then return "⚠ Acesso negado." end
    if code == 404 then return "⚠ Recurso não encontrado." end
    if code == 429 then
        return "⚠ Muitas requisições. Aguarde " .. tostring(math.ceil(retry or 8)) .. "s."
    end
    if code >= 500 then return "⚠ Servidor temporariamente indisponível." end
    if code == -1 then return "⚠ Resposta inválida da API." end
    return "⚠ Erro inesperado (" .. tostring(code) .. ")."
end

-- Respeita intervalo mínimo entre requests; devolve JSON decodificado ou nil, {code, retry}.
function Catalog.apiGet(url)
    local wait = Catalog.lastReq + CatalogConfig.MinRequestInterval - os.clock()
    if wait > 0 then task.wait(wait) end
    Catalog.lastReq = os.clock()
    local status, body, retry = httpGet(url)
    if status < 200 or status >= 300 then
        if status == 429 then Catalog.blockedUntil = os.clock() + (retry or 8) end
        return nil, {code = status, retry = retry}
    end
    local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not ok or type(data) ~= "table" then return nil, {code = -1} end
    return data
end

-- Monta a URL conforme a documentação (docs.sirius.menu/scripts-api).
-- Retorna url, sig (sig = consulta sem o número da página, usada no cache).
function Catalog.buildRequest(st, page)
    local q = (st.query:gsub("^%s+", ""):gsub("%s+$", ""))
    local path
    if q ~= "" then
        path = "/scripts/search"
    elseif st.useCurrentGame and Catalog.gameHasScripts then
        path = "/games/" .. tostring(game.PlaceId) .. "/scripts"
    else
        path = "/scripts"
    end
    local p = {}
    if q ~= "" then p[#p + 1] = "q=" .. HttpService:UrlEncode(q) end
    p[#p + 1] = "max=" .. tostring(CatalogConfig.ResultsPerPage)
    local by = SORTS[st.sortIdx].by
    if not by and q == "" then by = "score" end
    if by then p[#p + 1] = "sortBy=" .. by; p[#p + 1] = "order=desc" end
    if st.noKey then p[#p + 1] = "key=0" end
    if st.free then p[#p + 1] = "mode=free" end
    if st.mobile then p[#p + 1] = "tag=mobile" end
    if st.hidePatched then p[#p + 1] = "patched=0" end
    local sig = path .. "?" .. table.concat(p, "&")
    return CatalogConfig.BaseURL .. sig .. "&page=" .. tostring(page), sig
end

local function normalize(data, page)
    local r = data.result or {}
    local m = data.meta or r
    local scripts = r.scripts or {}
    local pg = tonumber(m.page or r.page) or page
    local tp = math.max(1, tonumber(m.totalPages or r.totalPages) or 1)
    return {
        scripts = scripts, page = pg, totalPages = tp,
        total = tonumber(m.total or r.total) or #scripts,
        hasNext = (m.nextPage ~= nil) or (pg < tp),
    }
end

-- ── Execução ───────────────────────────────────────────────
-- Usa a URL "loadstring" oficial da API (fallback: rawUrl, só presente em free + keyless).
-- Retorna true  OU  false, "motivo curto" (download / compilação / erro dentro do script).
function Catalog.execute(s)
    if s._builtin then
        if GameModule.execute(s._builtin, function() end) then return true end
        return false, "fontes indisponíveis"
    end
    local urls = {}
    if type(s.loadstring) == "string" and s.loadstring ~= "" then urls[#urls + 1] = s.loadstring end
    if type(s.rawUrl) == "string" and s.rawUrl ~= "" then urls[#urls + 1] = s.rawUrl end
    if #urls == 0 then return false, "sem conteúdo executável" end

    local code, lastErr
    for _, u in ipairs(urls) do
        for attempt = 1, 2 do
            local ok, res = pcall(function() return game:HttpGet(u) end)
            if ok and type(res) == "string" and #res >= 10 then code = res; break end
            lastErr = ok and "resposta vazia" or tostring(res)
            if attempt == 1 then task.wait(1) end
        end
        if code then break end
    end
    if not code then
        warn("[AKZ] Catálogo download: " .. tostring(lastErr))
        if tostring(lastErr):find("429", 1, true) then return false, "limite de downloads, aguarde" end
        return false, "download falhou: " .. tostring(lastErr):sub(1, 45)
    end
    if code:sub(1, 1) == "<" then return false, "resposta não é Lua (bloqueio/HTML)" end

    local fn, perr = loadstring(code)
    if not fn then
        warn("[AKZ] Catálogo compilação: " .. tostring(perr))
        return false, "não compilou: " .. tostring(perr):sub(1, 45)
    end

    -- Roda em outra thread: scripts que ficam em loop/yield não travam o catálogo.
    local done, rok, rerr = false, true, nil
    task.spawn(function() rok, rerr = pcall(fn); done = true end)
    local t0 = os.clock()
    while not done and (os.clock() - t0) < 2 do task.wait(0.1) end
    if done and not rok then
        warn("[AKZ] Catálogo script: " .. tostring(rerr))
        return false, "erro no script: " .. tostring(rerr):sub(1, 55)
    end
    return true -- terminou sem erro, ou continua rodando (hub aberto)
end

