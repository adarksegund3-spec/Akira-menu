    local function drawLine(cfs,corC)
        clearLine()
        if not cfs or #cfs<2 then return end
        local cor=corC or S.lineColor or T.purple
        local step=math.max(16, math.ceil(#cfs/MAX_LINE_PARTS))
        local pts=table.create(MAX_LINE_PARTS+2)
        local n=0
        for i=1,#cfs,step do n=n+1; pts[n]=cfs[i].Position end
        if pts[n]~=cfs[#cfs].Position then n=n+1; pts[n]=cfs[#cfs].Position end
        if n<2 then return end
        local folder=Instance.new("Folder"); folder.Name="PrimeHubLine"; folder.Parent=workspace
        local count=0
        for i=1,n-1 do
            local a=pts[i]; local b=pts[i+1]
            local dx=b.X-a.X; local dy=b.Y-a.Y; local dz=b.Z-a.Z
            local d=math.sqrt(dx*dx+dy*dy+dz*dz)
            if d>0.5 then
                local s=Instance.new("Part")
                s.Anchored=true; s.CanCollide=false; s.CanQuery=false; s.CanTouch=false; s.CastShadow=false
                s.Material=Enum.Material.Neon; s.Color=cor
                s.Size=Vector3.new(0.15,0.15,d)
                s.CFrame=CFrame.lookAt(Vector3.new((a.X+b.X)*0.5,(a.Y+b.Y)*0.5,(a.Z+b.Z)*0.5),b)
                s.Parent=folder
                count=count+1
                if count%40==0 then task.wait() end
            end
        end
        currentLineRef=folder
    end

