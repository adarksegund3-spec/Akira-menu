local function cinema()
	toggle("Câmera Cinema", function()
		local add, clean = bag(); local t0 = os.clock()
		cam.CameraType = Enum.CameraType.Scriptable
		add(function() cam.CameraType = Enum.CameraType.Custom; cam.FieldOfView = 70 end)
		add(RS.RenderStepped:Connect(function()
			local r = hrp(); if not r then return end
			local t, c = (os.clock() - t0) * 0.5, r.Position
			cam.FieldOfView = 55
			cam.CFrame = CFrame.lookAt(c + Vector3.new(math.cos(t) * 14, 5, math.sin(t) * 14), c + Vector3.new(0, 1, 0))
		end))
		return clean
	end)
end

local function scale(name, f)
	toggle(name, function()
		local h = hum(); local olds = {}
		for _, k in ipairs({"BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale"}) do
			local v = h and h:FindFirstChild(k)
			if not v then notify("Precisa ser avatar R15") return end
			olds[k] = v.Value
		end
		for k, v in pairs(olds) do h[k].Value = v * f end
		return function()
			local hh = hum()
			if hh then for k, v in pairs(olds) do local o = hh:FindFirstChild(k) if o then o.Value = v end end end
		end
	end)
end

local function moonGravity()
	toggle("Gravidade Lunar", function()
		local old = workspace.Gravity; workspace.Gravity = 45
		return function() workspace.Gravity = old end
	end)
end

---------------------------------------------------------------- 8) AMBIENTE
local function neonWorld()
	toggle("Mundo Neon", function()
		local add, clean = bag()
		local ct, br = Lighting.ClockTime, Lighting.Brightness
		Lighting.ClockTime, Lighting.Brightness = 0, 1.5
		local cc = add(Instance.new("ColorCorrectionEffect", Lighting))
		cc.Tint, cc.Saturation, cc.Contrast = Color3.fromRGB(190, 150, 255), 0.5, 0.2
		local bl = add(Instance.new("BloomEffect", Lighting))
		bl.Intensity, bl.Size, bl.Threshold = 1.2, 40, 0.8
		add(function() Lighting.ClockTime, Lighting.Brightness = ct, br end)
		return clean
	end)
end

local function snow()
	toggle("Neve Local", function()
		local add, clean = bag()
		local p = add(mk(workspace, Vector3.new(80, 1, 80), W)); p.Anchored, p.Transparency = true, 1
		local pe = Instance.new("ParticleEmitter", p)
		pe.Rate, pe.Lifetime, pe.Speed = 250, NumberRange.new(5, 7), NumberRange.new(12, 16)
		pe.EmissionDirection, pe.Size, pe.LightEmission = Enum.NormalId.Bottom, NumberSequence.new(0.3), 0.5
		add(RS.RenderStepped:Connect(function() p.Position = cam.CFrame.Position + Vector3.new(0, 35, 0) end))
		return clean
	end)
end

local function fireflies()
	toggle("Vagalumes", function()
		local add, clean = bag(); local f = {}
		for i = 1, 24 do
			local p = add(mk(workspace, Vector3.one * 0.35, Color3.fromRGB(255, 240, 120), Enum.Material.Neon))
			p.Shape, p.Anchored = Enum.PartType.Ball, true
			Instance.new("PointLight", p).Range = 6
			f[i] = {p = p, s = Vector3.new(math.random(), math.random(), math.random()) * 6.28, r = math.random(6, 16)}
		end
		local t0 = os.clock()
		add(RS.Heartbeat:Connect(function()
			local r = hrp(); if not r then return end
			local t = os.clock() - t0
			for _, d in ipairs(f) do
				d.p.Position = r.Position + Vector3.new(math.cos(t * 0.4 + d.s.X) * d.r, 2 + math.sin(t * 0.7 + d.s.Y) * 3, math.sin(t * 0.5 + d.s.Z) * d.r)
			end
		end))
		return clean
	end)
end

