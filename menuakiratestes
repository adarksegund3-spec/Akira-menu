local function trackRow(parent, track, ctx)
	local isCur = ctx.highlight
	local row = new("Frame", { Size = UDim2.new(1, -4, 0, 44), BackgroundColor3 = isCur and C.dgreen or C.black2,
		BackgroundTransparency = isCur and 0.1 or 0.35, BorderSizePixel = 0, LayoutOrder = ctx.order or 0, Parent = parent },
		{ corner(10) })
	local cover = new("ImageLabel", { Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(5, 5), BackgroundColor3 = C.black,
		Image = CFG.LOGO, ScaleType = Enum.ScaleType.Crop, Parent = row }, { corner(6) })
	Img.apply(cover, track)
	local bw = 56
	label({ Text = track.title, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = isCur and C.aqua or C.white,
		Size = UDim2.new(1, -(45 + bw + 4), 0, 16), Position = UDim2.fromOffset(45, 5), TextTransparency = track.streamable and 0 or 0.5, Parent = row })
	label({ Text = track.artist .. "  ·  " .. (track.source == "deezer" and "PRÉVIA 30s" or (fmt(track.duration) .. (track.source == "jamendo" and "  ·  Jamendo" or ""))) .. (track.streamable and "" or "  ·  indisponível"), TextSize = 9,
		TextColor3 = C.gray, Size = UDim2.new(1, -(45 + bw + 4), 0, 13), Position = UDim2.fromOffset(45, 23), Parent = row })
	local hit = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, -(bw + 4), 1, 0), Parent = row })
	tap(hit, ctx.play)
	local fav = button({ Text = Store.isFav(track.id) and "♥" or "♡", Size = UDim2.fromOffset(26, 30), BackgroundTransparency = 1, TextSize = 15,
		TextColor3 = C.aqua, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -30, 0.5, 0), Parent = row })
	local function setHeart() fav.Text = Store.isFav(track.id) and "♥" or "♡" end
	tap(fav, function()
		local on = Store.toggleFav(track); setHeart()
		Toast(on and "Adicionado aos favoritos" or "Removido dos favoritos")
	end)
	local more = button({ Text = "•••", Size = UDim2.fromOffset(26, 30), BackgroundTransparency = 1, TextSize = 10,
		TextColor3 = C.gray, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4, 0.5, 0), Parent = row })
	tap(more, function() openTrackMenu(track, { play = ctx.play, onRemove = ctx.onRemove, after = setHeart }) end)
	return row
end

local function renderTracks(scroll, tracks, opts)
	opts = opts or {}
	for i, t in ipairs(tracks) do
		trackRow(scroll, t, {
			order = (opts.baseOrder or 0) + i, highlight = opts.highlight and opts.highlight(i, t),
			play = function() if opts.onPlay then opts.onPlay(i) else Player.playQueue(tracks, i) end end,
			onRemove = opts.onRemove and function() opts.onRemove(i, t) end or nil,
		})
	end
end

