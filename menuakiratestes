            elseif i:IsA("Frame") and i.Parent == TC then
                i.BackgroundColor3 = mapColor(i, "BackgroundColor3", i.BackgroundColor3)
            end
        end)
    end)

    -- ───────── UI: botão "mudar tema ^" dentro da aba Principal ─────────
    local Card, Holder = State.themeCard, State.themeHolder
    local CLOSED_H, OPEN_H = 44, 102
    local open = false

