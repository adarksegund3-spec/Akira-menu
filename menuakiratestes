local SWEEP_INTERVAL = 0.08  -- intervalo pra parar animações do próprio jogo durante o replay
local RESYNC_THRESHOLD = 0.2 -- diferença (s) pra ressincronizar o tempo da animação

local prioCache = {}
local function prio(name)
    local key = name or "Movement"
    local p = prioCache[key]
    if p then return p end
    local ok, e = pcall(function() return Enum.AnimationPriority[key] end)
    p = (ok and e) or Enum.AnimationPriority.Movement
    prioCache[key] = p
    return p
end

local function getAnimator(hum)
    local a = hum:FindFirstChildOfClass("Animator")
    if not a and hum.Parent then
        a = hum.Parent:FindFirstChildWhichIsA("Animator", true)
    end
    if not a then
        a = Instance.new("Animator")
        a.Parent = hum
    end
    return a
end

-- carrega a track uma vez só e reaproveita (evita criar track nova toda hora)
local function getTrack(animator, id)
    if trackCacheOwner ~= animator then
        trackCache = {}
        ownedSet = {}
        trackCacheOwner = animator
    end
    local t = trackCache[id]
    if t ~= nil then return t or nil end
    local anim = Instance.new("Animation")
    anim.AnimationId = id
    local ok, tr = pcall(function() return animator:LoadAnimation(anim) end)
    if ok and tr then
        trackCache[id] = tr
        ownedSet[tr] = true
        return tr
    end
    trackCache[id] = false
    return nil
end

-- pré-carrega todas as animações da rota ANTES de começar (evita travadas)
local function preloadRoute(animator, data, token)
    local needed, list, n = {}, {}, 0
    for _, p in ipairs(data) do
        if p.Animations then
            for _, a in ipairs(p.Animations) do
                local id = a.Id
                if id and id ~= "" and not needed[id] then
                    needed[id] = true
                    n = n + 1
                    local anim = Instance.new("Animation")
                    anim.AnimationId = id
                    table.insert(list, anim)
                end
            end
        end
    end
    if n == 0 then return true end

    setStatus("Carregando " .. n .. " animações...", "play")

    local done = false
    task.spawn(function()
        pcall(function() ContentProvider:PreloadAsync(list) end)
        done = true
    end)
    local t0 = os.clock()
    while not done and os.clock() - t0 < 6 do
        task.wait(0.05)
        if token ~= playToken then return false end
    end

    local loaded = {}
    for id in pairs(needed) do
        local tr = getTrack(animator, id)
        if tr then table.insert(loaded, tr) end
    end

    t0 = os.clock()
    for _, tr in ipairs(loaded) do
        while tr.Length == 0 and os.clock() - t0 < 4 do
            task.wait(0.05)
            if token ~= playToken then return false end
        end
    end

    for _, a in ipairs(list) do a:Destroy() end
    return true
end

local function stopPlayback()
    playToken = playToken + 1
    if playbackConnection then
        playbackConnection:Disconnect()
        playbackConnection = nil
    end
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    playingBusy = false

    for _, tr in pairs(activeTracks) do
        pcall(function() tr:Stop(0.1) end)
    end
    table.clear(activeTracks)

    if antigravidade then antigravidade:Destroy() antigravidade = nil end

    for parte, status in pairs(originalCollides) do
        if parte and parte.Parent then parte.CanCollide = status end
    end
    table.clear(originalCollides)

    if playHum and playHum.Parent then
        if savedWalkSpeed then playHum.WalkSpeed = savedWalkSpeed end
        playHum.AutoRotate = true
        if savedPlatformStand ~= nil then playHum.PlatformStand = savedPlatformStand end
    end
    savedWalkSpeed = nil
    savedPlatformStand = nil

    if playHrp and playHrp.Parent then
        playHrp.AssemblyLinearVelocity = Vector3.zero
        playHrp.AssemblyAngularVelocity = Vector3.zero
    end

    if disabledAnimate and disabledAnimate.Parent then
        pcall(function() disabledAnimate.Disabled = false end)
    end
    disabledAnimate = nil
    playHum, playHrp = nil, nil
end

local function playRoute(data)
    if #data == 0 then setStatus("Nada gravado", "warn") return end
    if playingBusy or playbackConnection then
        stopPlayback()
        stopTimer()
        setStatus("Cancelado", "warn")
        return
    end
    playingBusy = true
    playToken = playToken + 1
    local token = playToken

    task.spawn(function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then
            playingBusy = false
            setStatus("Sem personagem", "warn")
            return
        end
        playHum, playHrp = hum, hrp

        local animator = getAnimator(hum)

        if not preloadRoute(animator, data, token) then return end
        if token ~= playToken then return end
        local cache = trackCache

        local total = #data
        local cfs = table.create(total)
        for i = 1, total do cfs[i] = CFrame.new(table.unpack(data[i].CF)) end

        -- anda até o início (com a animação normal do jogo); se estiver longe, teleporta
        local startPos = cfs[1].Position
        local flat = Vector3.new(hrp.Position.X - startPos.X, 0, hrp.Position.Z - startPos.Z).Magnitude
        if flat > 3 and flat <= APPROACH_MAX then
            setStatus("Indo para o início...", "play")
            savedWalkSpeed = hum.WalkSpeed
            if hum.WalkSpeed < 8 then hum.WalkSpeed = DEFAULT_WALKSPEED end
            hum:MoveTo(startPos)
            local t0 = os.clock()
            while os.clock() - t0 < 6 do
                task.wait(0.05)
                if token ~= playToken then return end
                local cur = hrp.Position
                if Vector3.new(cur.X - startPos.X, 0, cur.Z - startPos.Z).Magnitude < 2.5 then break end
            end
            if token ~= playToken then return end
            hum.WalkSpeed = savedWalkSpeed
            savedWalkSpeed = nil
        end

        -- assume o controle do personagem
        local animateScript = char:FindFirstChild("Animate")
        if animateScript and animateScript:IsA("BaseScript") then
            animateScript.Disabled = true
            disabledAnimate = animateScript
        end
        for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
            if not ownedSet[t] then pcall(function() t:Stop(0.05) end) end
        end

        savedPlatformStand = hum.PlatformStand
        hum.AutoRotate = false
        hum.PlatformStand = true

        local parts = {}
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then
                originalCollides[d] = d.CanCollide
                d.CanCollide = false
                table.insert(parts, d)
            end
        end
        noclipConnection = RunService.Stepped:Connect(function()
            for i = 1, #parts do
                local p = parts[i]
                if p.CanCollide then p.CanCollide = false end
            end
        end)

        antigravidade = Instance.new("BodyForce")
        antigravidade.Force = Vector3.new(0, hrp.AssemblyMass * workspace.Gravity, 0)
        antigravidade.Parent = hrp

        hrp.CFrame = cfs[1]
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        local pstartTime = os.clock()
        local currentIndex = 1
        local lastSweep = 0
        local wantedNow = {}
        table.clear(activeTracks)

        setStatus("Reproduzindo...", "play")
        startTimer()

        playbackConnection = RunService.RenderStepped:Connect(function()
            if not hrp.Parent or hum.Health <= 0 then
                stopPlayback()
                stopTimer()
                setStatus("Interrompido", "warn")
                return
            end

            local now = os.clock()
            local elapsedTime = now - pstartTime

            local idx = currentIndex
            while idx < total and elapsedTime >= data[idx + 1].Time do
                idx = idx + 1
            end
            currentIndex = idx

            if idx >= total then
                hrp.CFrame = cfs[total]
                stopPlayback()
                stopTimer()
                setStatus(string.format("Concluído em %.2fs", timerFrozen), "ok")
                return
            end

            local p0 = data[idx]
            local p1 = data[idx + 1]
            local span = p1.Time - p0.Time
            local alpha = (span > 0) and math.clamp((elapsedTime - p0.Time) / span, 0, 1) or 1

            -- posição: sem velocidade (senão a física move o personagem de novo e treme)
            hrp.CFrame = cfs[idx]:Lerp(cfs[idx + 1], alpha)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero

            -- animações
            local anims = p0.Animations
            if anims then
                table.clear(wantedNow)
                for _, a in ipairs(anims) do
                    local id = a.Id
                    local tr = id and cache[id]
                    if tr then
                        wantedNow[id] = true
                        local w = a.Weight or 1
                        local sp = a.Speed or 1
                        if not activeTracks[id] then
                            tr.Priority = prio(a.Priority)
                            tr.Looped = (a.Looped ~= false)
                            tr:Play(0, math.max(w, 0.001), sp)
                            if a.Pos then tr.TimePosition = a.Pos end
                            activeTracks[id] = tr
                        elseif tr.IsPlaying then
                            if math.abs(tr.WeightTarget - w) > 0.02 then tr:AdjustWeight(w, 0) end
                            if math.abs(tr.Speed - sp) > 0.01 then tr:AdjustSpeed(sp) end
                            if a.Pos and tr.Length > 0 then
                                local d = math.abs(tr.TimePosition - a.Pos)
                                if tr.Looped then d = math.min(d, tr.Length - d) end
                                if d > RESYNC_THRESHOLD then tr.TimePosition = a.Pos end
                            end
                        end
                    end
                end
                for id, tr in pairs(activeTracks) do
                    if not wantedNow[id] then
                        tr:Stop(0.05)
                        activeTracks[id] = nil
                    end
                end
            end

            -- impede que as animações do próprio jogo (correr/agachar/idle) briguem com o replay
            if now - lastSweep >= SWEEP_INTERVAL then
                lastSweep = now
                for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
                    if not ownedSet[t] then t:Stop(0) end
                end
            end
        end)
    end)
end

local function resetRecordButton()
