-- Asas de Fenix
local WING_THEMES = {
	Fenix  = {c0 = Color3.fromRGB(255, 125, 20), c1 = Color3.fromRGB(255, 238, 100)},
	Aurora = {c0 = Color3.fromRGB(40, 220, 255), c1 = Color3.fromRGB(180, 100, 255)},
	Sombra = {c0 = Color3.fromRGB(50, 20, 92), c1 = Color3.fromRGB(235, 70, 255)},
}
defineFeature("wings", function(f)
	local torso, hrp = getTorso(), getHRP()
	if not torso or not hrp then return end
	local th = WING_THEMES[Config.wings] or WING_THEMES.Fenix
	local model = f.o(new("Model", {Name = "WonderWings"}, FX))
	local joints = {}
	local lens = {4.6, 6.2, 7.4, 7.6, 6.8, 5.6, 4.2}
	for _, m in ipairs({1, -1}) do
		local root = part({Name = "WR", Size = Vector3.new(0.3, 0.3, 0.3), Transparency = 1, CFrame = torso.CFrame, Parent = model})
		for i, len in ipairs(lens) do
			local k = (i - 1) / (#lens - 1)
			local a = 0.05 + k * 1.45
			local dir = Vector3.new(m * math.sin(a), math.cos(a) * 0.95, 0.18).Unit
			local perp = dir:Cross(Vector3.new(0, 0, 1)).Unit
			local w = 0.5 + len * 0.05
			local base = Vector3.new(m * 0.15, 0.1 - k * 0.35, 0)
			local col = th.c0:Lerp(th.c1, k)
			local mid = base + dir * len * 0.42
			local tip = base + dir * len
			tri(root, model, base, mid + perp * w, tip, col, Enum.Material.Neon, 0.12)
			tri(root, model, base, mid - perp * w, tip, col, Enum.Material.Neon, 0.12)
			if i % 2 == 1 then
				local b2 = base + Vector3.new(m * 0.05, -0.15, -0.06)
				local l2 = len * 0.52
				tri(root, model, b2, b2 + dir * l2 * 0.5 + perp * w * 0.75, b2 + dir * l2, col:Lerp(WHITE, 0.4), Enum.Material.Neon, 0.1)
				tri(root, model, b2, b2 + dir * l2 * 0.5 - perp * w * 0.75, b2 + dir * l2, col:Lerp(WHITE, 0.4), Enum.Material.Neon, 0.1)
			end
		end
		local jt = new("Weld", {Part0 = torso, Part1 = root, C0 = CFrame.new(m * 0.3, 0.55, 0.55), C1 = CFrame.new()}, root)
		table.insert(joints, {jt = jt, m = m})
	end
	local open = 0
	f.c(RS.RenderStepped, function(dt)
		local hum, h = getHum(), getHRP()
		if not hum or not h or not torso.Parent then return end
		local v = h.AssemblyLinearVelocity
		local active = (hum.FloorMaterial == Enum.Material.Air) or Vector3.new(v.X, 0, v.Z).Magnitude > 3
		open = open + ((active and 1 or 0) - open) * math.min(1, dt * 3)
		local t = os.clock()
		local flap = math.sin(t * (2 + open * 6)) * (0.1 + open * 0.4)
		local fold = 0.85 - open * 0.6
		for _, j in ipairs(joints) do
			j.jt.C0 = CFrame.new(j.m * 0.3, 0.55, 0.55) * CFrame.Angles(0, -j.m * fold, 0) * CFrame.Angles(0, 0, j.m * (flap + 0.1))
		end
	end)
end)

-- Orbes Orbitais
defineFeature("orbs", function(f)
	local orbs = {}
	for i = 1, 5 do
		local o = f.o(part({Anchored = true, Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.9, 0.9), Material = Enum.Material.Neon, Parent = FX}))
		local a0 = new("Attachment", {Position = Vector3.new(0, 0.35, 0)}, o)
		local a1 = new("Attachment", {Position = Vector3.new(0, -0.35, 0)}, o)
		local tr = new("Trail", {
			Attachment0 = a0, Attachment1 = a1, Lifetime = 0.55, LightEmission = 1, FaceCamera = true,
			Transparency = NS(NSK(0, 0.1), NSK(1, 1)),
		}, o)
		local pl = new("PointLight", {Range = 9, Brightness = 1.3}, o)
		orbs[i] = {p = o, tr = tr, pl = pl}
	end
	local ang = 0
	f.c(RS.RenderStepped, function(dt)
		local hrp = getHRP()
		if not hrp then return end
		ang = ang + dt * 2.2
		local t = os.clock()
		for i, ob in ipairs(orbs) do
			local a = ang + (i - 1) * (math.pi * 2 / #orbs)
			local pos = hrp.Position + Vector3.new(math.cos(a) * 4.2, 0.3 + math.sin(a * 1.5 + i) * 1.2, math.sin(a) * 4.2)
			ob.p.Position = pos
			local col = hue(t * 0.1 + i / #orbs)
			ob.p.Color = col
			ob.tr.Color = ColorSequence.new(col)
			ob.pl.Color = col
		end
	end)
end)

-- Companheiro Luminoso
defineFeature("wisp", function(f)
	local n = 5
	local segs, pos = {}, {}
	local hrp0 = getHRP()
	if not hrp0 then return end
	for i = 1, n do
		local sz = (i == 1) and 1.1 or math.max(0.25, 0.8 - i * 0.13)
		local s = f.o(part({Anchored = true, Shape = Enum.PartType.Ball, Size = Vector3.new(sz, sz, sz), Material = Enum.Material.Neon, Parent = FX}))
		if i == 1 then
			new("PointLight", {Range = 16, Brightness = 1.6}, s)
			new("ParticleEmitter", {
				Texture = SPARK, Rate = 18, Lifetime = NumberRange.new(0.6, 1), Speed = NumberRange.new(0.5, 1.5),
				SpreadAngle = Vector2.new(180, 180), Size = NS(NSK(0, 0.4), NSK(1, 0)), LightEmission = 1,
				Transparency = NS(NSK(0, 0.2), NSK(1, 1)),
			}, s)
		end
		segs[i] = s
		pos[i] = hrp0.Position + Vector3.new(2, 3, 0)
	end
	f.c(RS.RenderStepped, function(dt)
		local hrp = getHRP()
		if not hrp then return end
		local t = os.clock()
		local cf = hrp.CFrame
		local target = hrp.Position + cf.RightVector * (3 + math.sin(t * 1.3) * 0.8) + Vector3.new(0, 3 + math.sin(t * 2.1) * 0.5, 0) - cf.LookVector * 1.2
		pos[1] = pos[1]:Lerp(target, math.clamp(dt * 4, 0, 1))
		for i = 2, n do
			pos[i] = pos[i]:Lerp(pos[i - 1], math.clamp(dt * 10, 0, 1))
			local d = pos[i] - pos[i - 1]
			local m = d.Magnitude
			if m < 0.55 then
				pos[i] = pos[i - 1] + ((m > 0.001) and d.Unit or Vector3.new(0, -1, 0)) * 0.55
			end
		end
		for i = 1, n do
			segs[i].Position = pos[i]
			segs[i].Color = hue(t * 0.12 + i * 0.04, 0.55)
		end
	end)
end)

-- Fantasma Residual
defineFeature("ghost", function(f)
	local last, hueT = 0, 0
	f.c(RS.Heartbeat, function()
		local char, hrp = LP.Character, getHRP()
		if not char or not hrp then return end
		local v = hrp.AssemblyLinearVelocity
		if Vector3.new(v.X, 0, v.Z).Magnitude < 16 and math.abs(v.Y) < 30 then return end
		local now = os.clock()
		if now - last < 0.1 then return end
		last = now
		hueT = (hueT + 0.03) % 1
		char.Archivable = true
		local g = char:Clone()
		if not g then return end
		local col = Color3.fromHSV(hueT, 0.7, 1)
		for _, d in ipairs(g:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true; d.CanCollide = false; d.CanTouch = false; d.CanQuery = false
				if d.Transparency < 0.95 then
					d.Material = Enum.Material.Neon; d.Color = col; d.Transparency = 0.5
					TS:Create(d, TweenInfo.new(0.55), {Transparency = 1}):Play()
				end
				for _, ch in ipairs(d:GetChildren()) do
					if ch:IsA("Decal") or ch:IsA("Texture") or ch:IsA("SurfaceAppearance") or ch:IsA("ParticleEmitter")
						or ch:IsA("Trail") or ch:IsA("Light") or ch:IsA("Sound") then
						ch:Destroy()
					end
				end
			elseif d:IsA("Accessory") or d:IsA("Model") or d:IsA("Attachment") or d:IsA("JointInstance") or d:IsA("Folder") then
				-- manter
			else
				pcall(function() d:Destroy() end)
			end
		end
		g.Parent = FX
		Debris:AddItem(g, 0.7)
	end)
end)

-- Pegadas de Neon
defineFeature("steps", function(f)
	local last, side, hueT = 0, 1, 0
	f.c(RS.Heartbeat, function()
		local hrp, hum = getHRP(), getHum()
		if not hrp or not hum then return end
		if hum.MoveDirection.Magnitude < 0.1 or hum.FloorMaterial == Enum.Material.Air then return end
		local now = os.clock()
		if now - last < 0.26 then return end
		last = now
		local res = cast(hrp.Position, Vector3.new(0, -6, 0))
		if not res then return end
		side = -side
		hueT = (hueT + 0.045) % 1
		local look = hrp.CFrame.LookVector
		local yaw = math.atan2(-look.X, -look.Z)
		local p = res.Position + hrp.CFrame.RightVector * side * 0.6 + res.Normal * 0.05
		local fp = part({
			Anchored = true, Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.06, 0.95, 1.7),
			Color = Color3.fromHSV(hueT, 0.8, 1), Material = Enum.Material.Neon, Transparency = 0.15,
			CFrame = CFrame.new(p) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, math.pi / 2), Parent = FX,
		})
		TS:Create(fp, TweenInfo.new(2.4, Enum.EasingStyle.Sine), {Transparency = 1, Size = Vector3.new(0.06, 1.15, 2.0)}):Play()
		Debris:AddItem(fp, 2.6)
	end)
end)

-- Impacto de Heroi
defineFeature("impact", function(f)
	local hum, hrp = getHum(), getHRP()
	if not hum or not hrp then return end
	local minVy = 0
	f.c(RS.Heartbeat, function()
		if hrp.Parent and hum.FloorMaterial == Enum.Material.Air then
			minVy = math.min(minVy, hrp.AssemblyLinearVelocity.Y)
		end
	end)
	f.c(hum.StateChanged, function(_, new)
		if new == Enum.HumanoidStateType.Landed then
			local v = -minVy
			minVy = 0
			if v > 38 and hrp.Parent then
				local res = cast(hrp.Position, Vector3.new(0, -8, 0))
				if res then shockwave(res.Position, res.Normal, math.clamp(v / 60, 0.5, 2)) end
			end
		end
	end)
end)

