local function addSlider(tab, title, minV, maxV, defV, cb, fmt)
	local card = baseCard(tab, title, nil, 52)
	local val = new("TextLabel", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 7), Size = UDim2.fromOffset(70, 16),
		Text = "", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.acc2, TextXAlignment = Enum.TextXAlignment.Right,
	}, card)
	local hit = new("TextButton", {Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(10, 24), BackgroundTransparency = 1, Text = ""}, card)
	local bar = new("Frame", {Size = UDim2.new(1, 0, 0, 6), Position = UDim2.fromOffset(0, 9), BackgroundColor3 = T.off, BorderSizePixel = 0}, hit)
	corner(bar, 1, true)
	local fill = new("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0}, bar)
	corner(fill, 1, true)
	new("UIGradient", {Color = ColorSequence.new(T.acc1, T.acc2)}, fill)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = WHITE, BorderSizePixel = 0,
	}, bar)
	corner(knob, 1, true)
	local function setRel(rel, fire)
		rel = math.clamp(rel, 0, 1)
		fill.Size = UDim2.fromScale(rel, 1)
		knob.Position = UDim2.fromScale(rel, 0.5)
		local v = minV + (maxV - minV) * rel
		val.Text = string.format(fmt or "%.1f", v)
		if fire then pcall(cb, v) end
	end
	setRel((defV - minV) / (maxV - minV), false)
	local dragging, dragIn = false, nil
	local function fromX(x) setRel((x - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X), true) end
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true; dragIn = i; fromX(i.Position.X)
		end
	end)
	bind(UIS.InputChanged, function(i)
		if dragging and (i == dragIn or i.UserInputType == Enum.UserInputType.MouseMovement) then fromX(i.Position.X) end
	end)
	bind(UIS.InputEnded, function(i)
		if i == dragIn then dragging = false end
	end)
end

