local Store = { data = { fav = {}, playlists = {}, recent = {}, volume = 0.7 }, dirty = false }
local DATA_PATH = CFG.FOLDER .. "/data.json"
function Store.load()
	if type(readfile) ~= "function" or not (type(isfile) == "function" and fsOk(isfile, DATA_PATH)) then return end
	local ok, d = pcall(function() return HttpService:JSONDecode(readfile(DATA_PATH)) end)
	if ok and type(d) == "table" then
		Store.data.fav = type(d.fav) == "table" and d.fav or {}
		Store.data.playlists = type(d.playlists) == "table" and d.playlists or {}
		Store.data.recent = type(d.recent) == "table" and d.recent or {}
		Store.data.volume = tonumber(d.volume) or 0.7
	end
end
function Store.save()
	if Store.dirty or type(writefile) ~= "function" then return end
	Store.dirty = true
	task.delay(1, function()
		Store.dirty = false
		ensureFolders()
		pcall(function() writefile(DATA_PATH, HttpService:JSONEncode(Store.data)) end)
	end)
end
function Store.isFav(id) for _, t in ipairs(Store.data.fav) do if t.id == id then return true end end return false end
function Store.toggleFav(track)
	for i, t in ipairs(Store.data.fav) do
		if t.id == track.id then table.remove(Store.data.fav, i); Store.save(); Bus.fire("favs"); return false end
	end
	table.insert(Store.data.fav, 1, track); Store.save(); Bus.fire("favs"); return true
end
function Store.addRecent(track)
	local r = Store.data.recent
	for i, t in ipairs(r) do if t.id == track.id then table.remove(r, i) break end end
	table.insert(r, 1, track)
	while #r > 40 do table.remove(r) end
	Store.save()
end
function Store.newPlaylist(name)
	local p = { id = HttpService:GenerateGUID(false), name = name, tracks = {} }
	table.insert(Store.data.playlists, p); Store.save(); Bus.fire("playlists")
	return p
end
function Store.playlistAdd(p, track)
	for _, t in ipairs(p.tracks) do if t.id == track.id then return false end end
	table.insert(p.tracks, track); Store.save(); Bus.fire("playlists"); return true
end

---------------------------------------------------------------- Player
local Player = { state = "IDLE", queue = {}, index = 0, shuffle = false, repeatMode = 0, token = 0, msg = "" }
local sound = Maid.add(new("Sound", { Name = "AngelMusicSound", Volume = 0.7, Parent = SoundService }))

function Player.setState(s, msg)
	Player.state, Player.msg = s, msg or ""
	Bus.fire("state")
end
function Player.current() return Player.queue[Player.index] end
function Player.setVolume(v)
	v = math.clamp(v, 0, 1); sound.Volume = v; Store.data.volume = v; Store.save(); Bus.fire("volume")
end

function Player.playQueue(list, start)
	Player.queue = {}
	for _, t in ipairs(list) do table.insert(Player.queue, t) end
	Bus.fire("queue")
	if #Player.queue > 0 then
		Player.playIndex(Player.shuffle and start == nil and math.random(#Player.queue) or (start or 1))
	end
end
function Player.enqueue(track)
	table.insert(Player.queue, track); Bus.fire("queue")
	if Player.state == "IDLE" and Player.index == 0 then Player.playIndex(#Player.queue) end
end
function Player.removeAt(i)
	table.remove(Player.queue, i)
	if i < Player.index then Player.index -= 1
	elseif i == Player.index then
		sound:Stop(); Player.token += 1; Player.index = math.min(Player.index, #Player.queue)
		Player.setState("IDLE")
		if Player.index > 0 then Player.playIndex(Player.index) end
	end
	Bus.fire("queue")
end
function Player.clear()
	Player.token += 1; sound:Stop(); sound.SoundId = ""
	Player.queue, Player.index = {}, 0
	Player.setState("IDLE"); Bus.fire("queue")
end

function Player.playIndex(i)
	local track = Player.queue[i]
	if not track then return end
	Player.token += 1
	local my = Player.token
	Player.index = i
	sound:Stop()
	Bus.fire("queue"); Bus.fire("track")
	if track.streamable == false then Player.setState("ERROR", errText("UNAVAILABLE")) return end
	Player.setState("LOADING")
	task.spawn(function()
		local asset, err = Audio.fetch(track)
		if my ~= Player.token then return end
		if not asset then Player.setState("ERROR", errText(err)) return end
		sound.SoundId = asset
		local t0 = os.clock()
		while not sound.IsLoaded and os.clock() - t0 < 10 do task.wait(0.1) end
		if my ~= Player.token then return end
		if not sound.IsLoaded then Player.setState("ERROR", errText("LOADFAIL")) return end
		sound.TimePosition = 0
		sound:Play()
		-- Só vira PLAYING quando o áudio realmente avança
		t0 = os.clock()
		while os.clock() - t0 < 6 do
			if my ~= Player.token then return end
			if sound.IsPlaying and sound.TimePosition > 0.05 then
				Store.addRecent(track); Player.setState("PLAYING") return
			end
			task.wait(0.1)
		end
		sound:Stop()
		Player.setState("ERROR", errText("NOSTART"))
	end)
end

function Player.toggle()
	local s = Player.state
	if s == "PLAYING" then sound:Pause(); Player.setState("PAUSED")
	elseif s == "PAUSED" then
		sound:Resume()
		local my = Player.token
		task.spawn(function()
			local p0 = sound.TimePosition; task.wait(0.4)
			if my == Player.token and Player.state == "PAUSED" then
				if sound.IsPlaying then Player.setState("PLAYING") else Player.setState("ERROR", errText("NOSTART")) end
			end
		end)
	elseif s ~= "LOADING" and #Player.queue > 0 then
		Player.playIndex(Player.index > 0 and Player.index or 1)
	end
end
function Player.next(auto)
	local n = #Player.queue
	if n == 0 then return end
	if auto and Player.repeatMode == 2 then Player.playIndex(Player.index) return end
	if Player.shuffle and n > 1 then
		local j = Player.index
		while j == Player.index do j = math.random(n) end
		Player.playIndex(j) return
	end
	if Player.index < n then Player.playIndex(Player.index + 1)
	elseif Player.repeatMode == 1 or not auto then Player.playIndex(1)
	else Player.setState("FINISHED") end
end
function Player.prev()
	if #Player.queue == 0 then return end
	if sound.TimePosition > 3 then sound.TimePosition = 0 return end
	Player.playIndex(Player.index > 1 and Player.index - 1 or (Player.repeatMode == 1 and #Player.queue or 1))
end
function Player.seek(r)
	if sound.IsLoaded and sound.TimeLength > 0 and (Player.state == "PLAYING" or Player.state == "PAUSED") then
		sound.TimePosition = math.clamp(r, 0, 1) * sound.TimeLength
	end
end
Maid.add(sound.Ended:Connect(function()
	if Player.state == "PLAYING" then Player.next(true) end
end))
Maid.add(sound.Paused:Connect(function() if Player.state == "PLAYING" then Player.setState("PAUSED") end end))

