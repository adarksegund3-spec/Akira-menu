-- FUNÇÕES DE SCAN
-- ═══════════════════════════════════════════════════════════════
local linhas = {}
local function L(s) table.insert(linhas, tostring(s)) end

local function scanAttributes(inst, prefixo, maxItems)
    local attrs = inst:GetAttributes()
    local n = 0
    for k, v in pairs(attrs) do
        n = n + 1
        if not maxItems or n <= maxItems then
            L(string.format("%s  %s = %s [%s]", prefixo, k, tostring(v), typeof(v)))
        end
    end
    if maxItems and n > maxItems then
        L(string.format("%s  ... mais %d atributos", prefixo, n - maxItems))
    end
end

local function coletar()
    linhas = {}
    L("═══════════════════════════════════════════")
    L("   AKZ DIAGNÓSTICO — Steal an Egg")
    L("   Gerado em: " .. os.date("%d/%m/%Y %H:%M:%S"))
    L("═══════════════════════════════════════════")
    L("")

    -- JOGADOR LOCAL
    L("━━━ 1) JOGADOR LOCAL ━━━")
    L("Nome: " .. LocalPlayer.Name)
    L("DisplayName: " .. LocalPlayer.DisplayName)
    L("UserId: " .. LocalPlayer.UserId)
    L("AccountAge: " .. LocalPlayer.AccountAge .. " dias")
    pcall(function() L("Team: " .. tostring(LocalPlayer.Team)) end)
    pcall(function() L("TeamColor: " .. tostring(LocalPlayer.TeamColor)) end)
    L("")

    -- CHARACTER ATRIBUTES
    L("━━━ 2) CHARACTER ATRIBUTES ━━━")
    local char = LocalPlayer.Character
    if char then
        L("Character: " .. char.Name)
        scanAttributes(char, "  ")
        L("  ─── filhos ───")
        for _, o in ipairs(char:GetChildren()) do
            L("  • " .. o.Name .. " [" .. o.ClassName .. "]")
            if o:IsA("ValueBase") then
                L("    = " .. tostring(o.Value))
            end
        end
    else
        L("(sem character)")
    end
    L("")

    -- HUMANOID
    L("━━━ 3) HUMANOID ━━━")
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            L("WalkSpeed: " .. hum.WalkSpeed)
            L("JumpPower: " .. hum.JumpPower)
            L("MaxHealth: " .. hum.MaxHealth)
            L("Health: " .. hum.Health)
            L("UseJumpPower: " .. tostring(hum.UseJumpPower))
        end
    end
    L("")

    -- LEADERSTATS
    L("━━━ 4) LEADERSTATS ━━━")
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            L("• " .. v.Name .. " = " .. tostring(v.Value) .. " [" .. v.ClassName .. "]")
        end
    else
        L("(sem leaderstats)")
    end
    L("")

    -- TODOS OS PLAYERS
    L("━━━ 5) TODOS OS PLAYERS (" .. #Players:GetPlayers() .. ") ━━━")
    for _, p in ipairs(Players:GetPlayers()) do
        local tag = (p == LocalPlayer) and " [EU]" or ""
        L("• " .. p.Name .. tag)
        if p.Character then
            local ch = p.Character
            local h = ch:FindFirstChildOfClass("Humanoid")
            if h then
                L("    Health: " .. h.Health .. "/" .. h.MaxHealth)
                L("    WalkSpeed: " .. h.WalkSpeed)
            end
        end
    end
    L("")

    -- TEAMS
    L("━━━ 6) TEAMS ━━━")
    local teams = Teams:GetTeams()
    if #teams == 0 then L("(nenhum)") end
    for _, t in ipairs(teams) do
        L("• " .. t.Name .. " | " .. tostring(t.TeamColor))
    end
    L("")

    -- WORKSPACE ESTRUTURA
    L("━━━ 7) WORKSPACE ━━━")
    L("Children:")
    for _, o in ipairs(Workspace:GetChildren()) do
        L("  • " .. o.Name .. " [" .. o.ClassName .. "]")
    end
    L("")
    L("Attributes do Workspace:")
    scanAttributes(Workspace, "  ")
    L("")

    -- WORKSPACE: procurar coisas chave
    L("━━━ 8) WORKSPACE — PROCURA ━━━")
    local chaves = {"speed", "walk", "treadmill", "esteira", "egg", "ovo", "coin", "pet", "base", "plot", "sell", "shop", "timer", "round", "spawn", "portal", "biome", "shop"}
    for _, chave in ipairs(chaves) do
        local achou = {}
        for _, o in ipairs(Workspace:GetDescendants()) do
            if o.Name:lower():find(chave, 1, true) then
                table.insert(achou, o)
                if #achou >= 5 then break end
            end
        end
        if #achou > 0 then
            L("● '" .. chave .. "':")
            for _, o in ipairs(achou) do
                L("   " .. o:GetFullName() .. " [" .. o.ClassName .. "]")
            end
        end
    end
    L("")

    -- REPLICATEDSTORAGE
    L("━━━ 9) REPLICATEDSTORAGE ━━━")
    for _, o in ipairs(ReplicatedStorage:GetChildren()) do
        L("• " .. o.Name .. " [" .. o.ClassName .. "]")
    end
    L("")

    -- REMOTES (RemoteEvent / RemoteFunction)
    L("━━━ 10) REMOTES ━━━")
    local remotes = {}
    for _, o in ipairs(ReplicatedStorage:GetDescendants()) do
        if o:IsA("RemoteEvent") or o:IsA("RemoteFunction") or o:IsA("UnreliableRemoteEvent") then
            table.insert(remotes, o)
        end
    end
    L("Total: " .. #remotes)
    for _, r in ipairs(remotes) do
        L("• " .. r:GetFullName() .. " [" .. r.ClassName .. "]")
    end
    L("")

    -- PROCURAR REMOTES ESPECÍFICOS
    L("━━━ 11) REMOTES — POSSÍVEIS FUNÇÕES ━━━")
    for _, r in ipairs(remotes) do
        local n = r.Name:lower()
        if n:find("speed") or n:find("walk") or n:find("egg") or n:find("steal")
        or n:find("hatch") or n:find("sell") or n:find("pet") or n:find("buy")
        or n:find("spawn") or n:find("tp") or n:find("teleport") or n:find("coin")
        or n:find("click") or n:find("claim") or n:find("reward") or n:find("cash")
        or n:find("money") or n:find("upgrade") or n:find("treadmill") or n:find("place") then
            L("★ " .. r:GetFullName() .. " [" .. r.ClassName .. "]")
        end
    end
    L("")

    -- STARTERGUI
    L("━━━ 12) STARTERGUI ━━━")
    for _, o in ipairs(StarterGui:GetChildren()) do
        L("• " .. o.Name .. " [" .. o.ClassName .. "]")
    end
    L("")

    -- PLAYERGUI ATUAL
    L("━━━ 13) PLAYERGUI ━━━")
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, o in ipairs(pg:GetChildren()) do
            if o.Name ~= "AKZ_Diag_SAE" then
                L("• " .. o.Name .. " [" .. o.ClassName .. "]")
                if o:IsA("ScreenGui") then
                    -- procurar textos importantes
                    for _, d in ipairs(o:GetDescendants()) do
                        if d:IsA("TextLabel") and d.Text ~= "" and #d.Text < 30 then
                            local t = d.Text:lower()
                            if t:find("speed") or t:find("veloc") or t:find("egg")
                            or t:find("ovo") or t:find("pet") or t:find("coin")
                            or t:find("moeda") or t:find("level") or t:find("cash")
                            or t:find("$") or t:find("buy") or t:find("comprar") then
                                L("   └ txt: " .. d.Text)
                            end
                        end
                    end
                end
            end
        end
    end
    L("")

    -- LIGHTING
    L("━━━ 14) LIGHTING ━━━")
    L("Ambient: " .. tostring(Lighting.Ambient))
    L("Brightness: " .. tostring(Lighting.Brightness))
    L("ClockTime: " .. tostring(Lighting.ClockTime))
    L("FogEnd: " .. tostring(Lighting.FogEnd))
    L("")

    -- SOUNDSERVICE
    L("━━━ 15) SOUNDSERVICE ━━━")
    for _, o in ipairs(SoundService:GetChildren()) do
        L("• " .. o.Name .. " [" .. o.ClassName .. "]")
    end
    L("")

    -- STRUCTURAS ESPECIAIS
    L("━━━ 16) ESTRUTURAS ESPECIAIS ━━━")
    local function procuraInstancia(nome)
        for _, o in ipairs(Workspace:GetDescendants()) do
            if o.Name:lower():find(nome, 1, true) then
                return o:GetFullName() .. " [" .. o.ClassName .. "]"
            end
        end
        return "não encontrado"
    end
    L("Base/Plot: " .. procuraInstancia("base"))
    L("Plot: " .. procuraInstancia("plot"))
    L("Timer: " .. procuraInstancia("timer"))
    L("Round: " .. procuraInstancia("round"))
    L("Egg/Ovo: " .. procuraInstancia("egg"))
    L("Treadmill/Esteira: " .. procuraInstancia("treadmill"))
    L("Coin/Moeda: " .. procuraInstancia("coin"))
    L("")

    -- MÓDULOS
    L("━━━ 17) MÓDULOS ━━━")
    for _, o in ipairs(ReplicatedStorage:GetDescendants()) do
        if o:IsA("ModuleScript") then
            L("• " .. o:GetFullName())
        end
    end
    L("")

    L("═══════════════════════════════════════════")
    L("   FIM DO DIAGNÓSTICO")
    L("   Total de linhas: " .. tostring(#linhas))
    L("═══════════════════════════════════════════")
end

