function UI.refresh()
	if not alive then return end
	local items = History.sorted(UI.query, UI.sort)
	UI.map = {}
	local labels, selLabel = {}, nil
	for _, m in ipairs(items) do
		local lb = cardLabel(m)
		UI.map[lb] = m.id
		labels[#labels + 1] = lb
		if m.id == UI.sel then selLabel = lb end
	end
	pcall(function() countLbl:Set(string.format("Rotas: %d (exibindo %d)", #History.list, #items)) end)
	if #labels == 0 then labels = { "(nenhuma rota)" } end
	pcall(function() routeDD:Refresh(labels) end)
	if not selLabel and UI.sel and not History.byId[UI.sel] then UI.sel = nil end
	if not selLabel and #items > 0 and not UI.sel then UI.sel = items[1].id selLabel = labels[1] end
	if selLabel then pcall(function() routeDD:Set({ selLabel }) end) end
	UI.details()
end

local FILTERS = {
	["Movimento"] = function(e) return e.k == "move" end,
	["Saltos"] = function(e) return e.k == "jump" end,
	["Animações"] = function(e) return e.k == "anim" end,
	["Interações"] = function(e) return Registry.types[e.k].cat == "inter" end,
	["Incompatíveis"] = function(e) return Adapters.can(e) == "na" end,
}
local function detailOf(e)
	local d = e.d or {}
	if e.k == "move" then return string.format("pos %.0f, %.0f, %.0f • %s", e.p[1], e.p[2], e.p[3], tostring(d.st))
	elseif e.k == "jump" then return tostring(d.ph) .. (d.air and (" • ar " .. d.air .. "s (inferido)") or "")
	elseif e.k == "state" then return tostring(d.from) .. " → " .. tostring(d.to)
	elseif e.k == "anim" then return tostring(d.ph) .. " " .. tostring(d.name)
	elseif e.k == "input" then return tostring(d.ph) .. " " .. tostring(d.key)
	elseif e.k == "prompt" then return tostring(d.ph) .. " " .. tostring(d.ref and d.ref.name)
	elseif e.k == "click" then return tostring(d.ref and d.ref.name)
	elseif e.k == "tool" then return tostring(d.ph) .. " " .. tostring(d.name) end
	return ""
end
function UI.timeline()
	if not UI.sel then return end
	local ev = History.getEvents(UI.sel)
	if not ev then pcall(function() tlPara:Set({ Title = "Eventos", Content = "Rota indisponível." }) end) return end
	local flt = FILTERS[UI.filter]
	local list = {}
	for _, e in ipairs(ev) do if not flt or flt(e) then list[#list + 1] = e end end
	local per = 20
	local pages = math.max(1, math.ceil(#list / per))
	local pg = math.clamp(UI.page, 1, pages)
	local lines = {}
	for i = (pg - 1) * per + 1, math.min(pg * per, #list) do
		local e = list[i]
		local st = Adapters.can(e)
		lines[#lines + 1] = string.format("%s %s %s — %s", st == "ok" and "✓" or (st == "info" and "ℹ" or "✕"),
			fmt(e.t), Registry.types[e.k].label, detailOf(e))
	end
	if #lines == 0 then lines[1] = "(sem eventos neste filtro)" end
	pcall(function()
		tlPara:Set({ Title = string.format("Eventos %d • página %d/%d", #list, pg, pages), Content = table.concat(lines, "\n") })
	end)
end

