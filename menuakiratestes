local Registry = { types = {} }
function Registry.define(k, label, cat) Registry.types[k] = { label = label, cat = cat } end
Registry.define("move", "Movimento", "mov")
Registry.define("jump", "Salto", "jump")
Registry.define("state", "Estado", "state")
Registry.define("anim", "Animação", "anim")
Registry.define("input", "Tecla", "inter")
Registry.define("prompt", "Prompt", "inter")
Registry.define("click", "Clique", "inter")
Registry.define("tool", "Ferramenta", "inter")
function Registry.validate(e)
	if type(e) ~= "table" or type(e.t) ~= "number" or e.t < 0 or type(e.k) ~= "string" then return false end
	if not Registry.types[e.k] then return false end
	if e.d ~= nil and type(e.d) ~= "table" then return false end
	if e.p ~= nil and (type(e.p) ~= "table" or #e.p ~= 3) then return false end
	if e.k == "move" and not e.p then return false end
	return true
end

------------------------------------------------------------------ OBJECT REFS
local function makeRef(inst)
	if not inst then return nil end
	local path, cur = {}, inst
	while cur and cur ~= game and cur ~= workspace do
		table.insert(path, 1, cur.Name)
		cur = cur.Parent
	end
	local base = inst:IsA("BasePart") and inst or inst:FindFirstAncestorWhichIsA("BasePart")
	local pos
	if base then pos = { r2(base.Position.X), r2(base.Position.Y), r2(base.Position.Z) } end
	return { path = path, cls = inst.ClassName, name = inst.Name, pos = pos, root = (cur == workspace) and "w" or "g" }
end
local function resolveRef(ref)
	if type(ref) ~= "table" or type(ref.path) ~= "table" then return nil end
	local cur = ref.root == "w" and workspace or game
	for _, n in ipairs(ref.path) do
		cur = cur and cur:FindFirstChild(n)
		if not cur then break end
	end
	if cur and cur.ClassName == ref.cls then return cur end
	local best, bd
	for _, d in ipairs(workspace:GetDescendants()) do
		if d.Name == ref.name and d.ClassName == ref.cls then
			local dist = 0
			if ref.pos then
				local bp = d:IsA("BasePart") and d or d:FindFirstAncestorWhichIsA("BasePart")
				if bp then dist = (bp.Position - Vector3.new(ref.pos[1], ref.pos[2], ref.pos[3])).Magnitude end
			end
			if not bd or dist < bd then best, bd = d, dist end
		end
	end
	return best
end

------------------------------------------------------------------ ADAPTERS
local Adapters = {}
-- "ok" reproduzível | "info" apenas informativo | "na" não reproduzível neste ambiente
function Adapters.can(e)
	local k, d = e.k, e.d or {}
	if k == "move" or k == "jump" or k == "tool" then return "ok" end
	if k == "state" then return "info" end
	if k == "anim" then return d.rp and "ok" or "info" end
	if k == "input" then return (Compat.vim and keyOf(d.key)) and "ok" or "na" end
	if k == "prompt" then
		if d.ph == "trigger" then return Compat.prompt and "ok" or "na" end
		return "info"
	end
	if k == "click" then return Compat.click and "ok" or "na" end
	return "na"
end

function Adapters.run(e, ctx)
	local d, k = e.d or {}, e.k
	local hum = ctx.hum
	if k == "jump" then
		if d.ph == "start" then
			hum.Jump = true
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
			return "ok"
		end
		return "info"
	elseif k == "state" then
		return "info"
	elseif k == "anim" then
		if not d.rp then return "info" end
		if d.ph == "start" then
			if not ctx.animator then return "fail", "Animator ausente" end
			local a = Instance.new("Animation")
			a.AnimationId = d.id
			local okA, tr = pcall(function() return ctx.animator:LoadAnimation(a) end)
			if not okA or not tr then return "fail", "animação inacessível" end
			pcall(function()
				tr.Priority = Enum.AnimationPriority[d.pri] or Enum.AnimationPriority.Action
				tr.Looped = d.loop and true or false
				tr:Play(0.1, 1, (d.sp or 1) * ctx.speed)
			end)
			ctx.tracks[d.id] = tr
			return "ok"
		else
			local tr = ctx.tracks[d.id]
			if tr then pcall(function() tr:Stop(0.1) end) ctx.tracks[d.id] = nil end
			return "ok"
		end
	elseif k == "input" then
		local kc = keyOf(d.key)
		if not (Compat.vim and kc) then return "fail", "teclas indisponíveis" end
		local okV = pcall(function() Compat.VIM:SendKeyEvent(d.ph == "down", kc, false, game) end)
		return okV and "ok" or "fail", "falha ao enviar tecla"
	elseif k == "prompt" then
		if d.ph ~= "trigger" then return "info" end
		if not Compat.prompt then return "fail", "fireproximityprompt indisponível" end
		local p = resolveRef(d.ref)
		if not p then return "fail", "objeto não encontrado: " .. tostring(d.ref and d.ref.name) end
		local okP = pcall(fireproximityprompt, p)
		return okP and "ok" or "fail", "falha no prompt"
	elseif k == "click" then
		if not Compat.click then return "fail", "fireclickdetector indisponível" end
		local cd = resolveRef(d.ref)
		if not cd then return "fail", "objeto não encontrado: " .. tostring(d.ref and d.ref.name) end
		local okC = pcall(fireclickdetector, cd)
		return okC and "ok" or "fail", "falha no clique"
	elseif k == "tool" then
		local char = ctx.char
		if d.ph == "equip" then
			local bp = LP:FindFirstChildOfClass("Backpack")
			local tool = (bp and bp:FindFirstChild(d.name)) or char:FindFirstChild(d.name)
			if not tool then return "fail", "ferramenta não encontrada: " .. tostring(d.name) end
			pcall(function() hum:EquipTool(tool) end)
			return "ok"
		elseif d.ph == "unequip" then
			pcall(function() hum:UnequipTools() end)
			return "ok"
		elseif d.ph == "use" then
			local tool = char:FindFirstChild(d.name)
			if not (tool and tool:IsA("Tool")) then return "fail", "ferramenta não equipada: " .. tostring(d.name) end
			pcall(function() tool:Activate() end)
			return "ok"
		end
		return "info"
	end
	return "fail", "tipo sem adaptador"
end

------------------------------------------------------------------ SERIALIZER
local Serializer = {}
function Serializer.analyze(ev)
	local c = { mov = 0, jump = 0, anim = 0, inter = 0, state = 0, ok = 0, na = 0, info = 0 }
	for _, e in ipairs(ev) do
		local ty = Registry.types[e.k]
		if ty then c[ty.cat] = (c[ty.cat] or 0) + 1 end
		local st = Adapters.can(e)
		c[st] = c[st] + 1
	end
	return c
end
function Serializer.cleanEvents(ev)
	local out, dropped = {}, 0
	if type(ev) ~= "table" then return out, 0 end
	for _, e in ipairs(ev) do
		if Registry.validate(e) and #out < CFG.maxEvents then out[#out + 1] = e else dropped += 1 end
	end
	table.sort(out, function(a, b)
		if a.t ~= b.t then return a.t < b.t end
		return (a.n or 0) < (b.n or 0)
	end)
	return out, dropped
end
function Serializer.buildMeta(id, name, session, dur, partial)
	local c = Serializer.analyze(session.events)
	return {
		id = id, name = name, created = os.time(), dur = r2(dur), n = #session.events,
		moves = c.mov, jumps = c.jump, anims = c.anim, inter = c.inter,
		ok = c.ok, na = c.na, partial = partial, place = game.PlaceId, v = CFG.version,
	}
end
function Serializer.migrate(data)
	if type(data) ~= "table" then return nil end
	if data.v == nil then data.v = 1 end -- formatos antigos sem versão tratados como v1
	if data.v > CFG.version then return nil, "versão de arquivo mais nova que o script" end
	return data
end
function Serializer.encode(t)
	local ok, s = pcall(HttpService.JSONEncode, HttpService, t)
	if not ok then return nil, "falha ao codificar" end
	if #s > CFG.maxBytes then return nil, "rota excede o limite de tamanho" end
	return s
end
function Serializer.decode(s)
	local ok, t = pcall(HttpService.JSONDecode, HttpService, s)
	if not ok or type(t) ~= "table" then return nil, "arquivo corrompido" end
	return t
end

