--[[ === POSICIONAMENTO (SEMPRE DENTRO DA TELA) === ]]
local function clampMenu()
    local vp = cam().ViewportSize
    local p = menu.Position
    menu.Position = UDim2.fromOffset(math.clamp(p.X.Offset, 0, math.max(vp.X - MENU_W, 0)),
        math.clamp(p.Y.Offset, 0, math.max(vp.Y - 60, 0)))
end

local function clampLogo()
    local vp = cam().ViewportSize
    local p = logo.Position
    local x = math.clamp(p.X.Offset, 6, math.max(vp.X - LOGO - 6, 6))
    local y = math.clamp(p.Y.Offset, 6, math.max(vp.Y - LOGO - 6, 6))
    tween(logo, 0.18, { Position = UDim2.fromOffset(x, y) })
end

local function toggleMenu(show)
    if show == nil then show = not menu.Visible end
    if show then
        menu.Visible = true
        clampMenu()
        scale.Scale = 0.9
        tween(scale, 0.15, { Scale = 1 })
    else
        menu.Visible = false
    end
end

closeBtn.Activated:Connect(function() toggleMenu(false) end) -- só esconde o menu; a logo continua

-- Arrastar o menu pela barra de título
local mDrag, mStart, mPos = false, nil, nil
header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        mDrag, mStart, mPos = true, input.Position, menu.Position
    end
end)

-- Arrastar a logo (toque simples abre/fecha o menu)
local lDrag, lMoved, lStart, lPos = false, false, nil, nil
logo.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        lDrag, lMoved, lStart, lPos = true, false, input.Position, logo.Position
    end
end)

track(UIS.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if mDrag then
        local d = input.Position - mStart
        menu.Position = UDim2.fromOffset(mPos.X.Offset + d.X, mPos.Y.Offset + d.Y)
        clampMenu()
    end
    if lDrag then
        local d = input.Position - lStart
        if d.Magnitude > 8 then lMoved = true end
        if lMoved then logo.Position = UDim2.fromOffset(lPos.X.Offset + d.X, lPos.Y.Offset + d.Y) end
    end
end))
track(UIS.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
    mDrag = false
    if lDrag then
        lDrag = false
        if lMoved then clampLogo() else toggleMenu() end
    end
end))
local c0 = cam()
if c0 then track(c0:GetPropertyChangedSignal("ViewportSize"):Connect(function() clampLogo() clampMenu() end)) end

