local function getClipboardFn()
    if type(setclipboard) == "function" then return setclipboard end
    if type(toclipboard) == "function" then return toclipboard end
    return nil
end

local notify -- declarada abaixo

local function copyText(text, okTitle)
    local fn = getClipboardFn()
    if not fn then
        notify("error", "Cópia indisponível", "O executor não suporta área de transferência. Nada foi copiado.", 4)
        return false
    end
    local ok = pcall(fn, text)
    if ok then notify("success", okTitle or "Copiado", "Texto copiado para a área de transferência.", 2)
    else notify("error", "Falha ao copiar", "O executor retornou erro.", 3) end
    return ok
end

local function sendChat(text)
    return pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local folder = TextChatService:FindFirstChild("TextChannels")
            local ch = folder and folder:FindFirstChild("RBXGeneral")
            if not ch then error("canal RBXGeneral não encontrado") end
            ch:SendAsync(text)
        else
            local ev = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            local say = ev and ev:FindFirstChild("SayMessageRequest")
            if not say then error("chat legado não encontrado") end
            say:FireServer(text, "All")
        end
    end)
end

local lastSent = 0
local function sendAction(text, what)
    if os.clock() - lastSent < 1 then return false end -- evita envio duplicado
    local ok, err = sendChat(text)
    if ok then
        lastSent = os.clock()
        notify("success", "Enviado ao chat", what .. " (a execução depende do jogo).", 2.5)
    else
        notify("error", "Falha ao enviar", tostring(err), 4)
    end
    return ok
end

local function makeDraggable(handle, target)
    local dragging, startPos, startFrame
    track(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, startPos, startFrame = true, input.Position, target.Position
            local c; c = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false; c:Disconnect() end
            end)
        end
    end))
    track(UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - startPos
            target.Position = UDim2.new(startFrame.X.Scale, startFrame.X.Offset + d.X,
                startFrame.Y.Scale, startFrame.Y.Offset + d.Y)
        end
    end))
end

local function waitAny(signals, timeout)
    local bind = Instance.new("BindableEvent")
    local cs = {}
    for _, s in ipairs(signals) do table.insert(cs, s:Connect(function() pcall(function() bind:Fire(true) end) end)) end
    task.delay(timeout, function() pcall(function() bind:Fire(false) end) end)
    local r = bind.Event:Wait()
    for _, c in ipairs(cs) do c:Disconnect() end
    bind:Destroy()
    return r
end

