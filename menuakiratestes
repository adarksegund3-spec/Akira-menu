local function ToggleMenu()
    menuOpen = not menuOpen
    if menuOpen then
        MainFrame.Visible = true
        MainFrame.Size = UDim2.fromOffset(WindowWidth, WindowHeight - 20)
        MainFrame.BackgroundTransparency = 1
        TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(WindowWidth, WindowHeight), BackgroundTransparency = 0
        }):Play()
        
        if not currentView then SwitchView("Geral") end
    else
        local tween = TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.fromOffset(WindowWidth, WindowHeight - 20), BackgroundTransparency = 1
        })
        tween.Completed:Connect(function() MainFrame.Visible = false end)
        tween:Play()
    end
end

-- Arrastar vs Clicar no Logo
local logoDragging, logoMoved, logoDragStart, logoStartPos = false, false, nil, nil
FloatingLogo.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        logoDragging = true
        logoMoved = false
        logoDragStart = input.Position
        logoStartPos = FloatingLogo.Position
    end
end)
FloatingLogo.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if logoDragging then
            local delta = input.Position - logoDragStart
            if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then logoMoved = true end
            FloatingLogo.Position = UDim2.new(logoStartPos.X.Scale, logoStartPos.X.Offset + delta.X, logoStartPos.Y.Scale, logoStartPos.Y.Offset + delta.Y)
        end
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and logoDragging then
        logoDragging = false
        if not logoMoved then ToggleMenu() end
    end
end)

CloseBtn.MouseButton1Click:Connect(function()
    if menuOpen then ToggleMenu() end
end)