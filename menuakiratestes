-- Para mudar nome, textos e duração edite SplashCfg. Enabled = false desliga.
-- ══════════════════════════════════════════════════════════
do
    local SplashCfg = {
        Enabled   = true,
        HubName   = "AKZ HUB",
        Subtitle  = "V1 • Premium Edition • by Akira / Angel",
        LoadTime  = 3,
        IntroTime = 0.5,
