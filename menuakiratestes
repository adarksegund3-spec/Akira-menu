defineFeature("orbit", function(f)
	local c = cam()
	c.CameraType = Enum.CameraType.Scriptable
	local ang = 0
	f.c(RS.RenderStepped, function(dt)
		local hrp = getHRP()
		if not hrp then return end
		local cm = cam()
		ang = ang + dt * 0.45
		local t = os.clock()
		local r = 16 + math.sin(t * 0.4) * 4
		local h = 5 + math.sin(t * 0.27) * 2.5
		local focus = hrp.Position + Vector3.new(0, 1.5, 0)
		local p = focus + Vector3.new(math.cos(ang) * r, h, math.sin(ang) * r)
		cm.CFrame = cm.CFrame:Lerp(CFrame.lookAt(p, focus), math.clamp(dt * 6, 0, 1))
	end)
	f.x(function() cam().CameraType = Enum.CameraType.Custom end)
