    local method, teams = detectTeamSystem()
    if not method or next(teams) == nil then
        TeamPanel.emptyLbl.Visible = true
        TeamPanel.emptyLbl.Text = "Nenhum time detectado neste jogo\nESP vai mostrar todos os players"
        return
    end
    TeamPanel.emptyLbl.Visible = false

    local myTeam = getPlayerTeam(LocalPlayer)
    local order = 1
    for key, data in pairs(teams) do
        local isMine = (myTeam ~= nil and tostring(myTeam) == tostring(key))
        createTeamCard(TeamPanel.scroll, order, data.name, data.players, isMine, data.color)
        order = order + 1
    end
end

