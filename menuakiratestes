		statusLabel.Text = "Falha na análise (veja detalhes abaixo)."
	end
	running = false
end)

-- Botão "Copiar diagnóstico"
local function getClipboardFn()
	local ok, fn = pcall(function()
		return setclipboard or toclipboard or (Clipboard and Clipboard.set)
	end)
	if ok and type(fn) == "function" then return fn end
	return nil
end

copyBtn.Activated:Connect(function()
	if not lastReport then
		showToast("⚠ Execute o Diagnóstico primeiro", COLORS.warn)
		return
	end
	local clipFn = getClipboardFn()
	if clipFn and pcall(clipFn, lastReport) then
		showToast("✔ Diagnóstico copiado!", COLORS.ok)
	else
		-- Roblox padrão não expõe área de transferência: libera seleção manual
		resultBox.Text = lastReport
		resultBox.TextEditable = true
		showToast("Sem acesso à área de transferência: selecione o texto", COLORS.warn)
	end
end)