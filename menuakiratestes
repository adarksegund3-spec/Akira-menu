	local r = bubbleSize / 2
	local c = bubble.AbsolutePosition + bubble.AbsoluteSize / 2
	bubble.Position = UDim2.fromOffset(cl(c.X, r, v.X - r), cl(c.Y, r, v.Y - r))
end))

---------------------------------------------------------------- Arrastar a bolinha (100% colada no dedo)
do
	local startCenter, moved = Vector2.zero, false
	dragger(bubble, function()
		startCenter = bubbleCenter()
		moved = false
	end, function(d)
		if d.Magnitude > 6 then moved = true end
		local v = viewport()
		local r = bubbleSize / 2
		-- posição = centro inicial + deslocamento exato do dedo (sem limiar, sem salto)
		bubble.Position = UDim2.fromOffset(cl(startCenter.X + d.X, r, v.X - r), cl(startCenter.Y + d.Y, r, v.Y - r))
	end, function()
		if not moved then openWindow() end
	end)
end

---------------------------------------------------------------- Inicialização
Store.load()
volFill.Size = UDim2.fromScale(Store.data.volume, 1)
Bus.fire("mode")
refreshPlay()

-- Verificação real do Spotify (só mostra "conectado" após resposta válida)
task.spawn(function()
	if not httpRequest then setConn("err", "Sem suporte HTTP") return end
	local me, e = Sp.call("GET", "/v1/me")
	if type(me) == "table" then
		setConn("ok", "Spotify · " .. tostring(me.display_name or me.id or "conectado"))
		pcall(Player.poll)
	else
		setConn("err", e == "TOKEN" and "Token expirou" or "Sem conexão")
		Toast(errText(e or "NETWORK"), true)
	end
end)

-- acompanha o Spotify (faixa, tempo, play/pausa) enquanto o script existir
task.spawn(function()
	while Player.alive do
		task.wait(windowOpen and CFG.POLL_OPEN or CFG.POLL_CLOSED)
		if not Player.alive then break end
		pcall(Player.poll)
	end
end)
