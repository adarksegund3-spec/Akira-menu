-- ================= FUNÇÕES =================
local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function resetarPosicao()
    lastSafe = nil
    prevSpeed = 0
    guardaAte = 0
    task.defer(function()
        local hrp = LocalPlayer.Character and LocalPlayer.Character:WaitForChild("HumanoidRootPart", 5)
        if hrp and iniciado then lastSafe = hrp.CFrame end
    end)
end

-- ================= REMOVER TEXTO DA PRISÃO =================
local function normalizar(s)
    s = string.gsub(tostring(s), "<[^>]+>", "")
    s = string.gsub(s, "ã", "a")
    s = string.gsub(s, "Ã", "a")
    return string.lower(s)
end

local function contem(texto, palavra)
    return string.find(texto, palavra, 1, true) ~= nil
end

local function ehMensagemDePrisao(obj)
    local t = normalizar(obj.Text)
    local prisao = contem(t, "prisao") or contem(t, "preso") or contem(t, "prison") or contem(t, "jail")
    local regra = contem(t, "polichinelo") or contem(t, "minut")
    return prisao and regra
end

local function apagar(obj)
    if textosOcultos[obj] ~= nil then return end
    textosOcultos[obj] = obj.Visible
    print("[Prisão] Texto detectado e apagado: " .. obj.Text)
    obj.Visible = false
    table.insert(textoConns, obj:GetPropertyChangedSignal("Visible"):Connect(function()
        if iniciado and obj.Visible then obj.Visible = false end
    end))
end

local function verificar(obj)
    if ehMensagemDePrisao(obj) then apagar(obj) end
end

local function observar(obj)
    if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and not obj:IsDescendantOf(ScreenGui) then
        verificar(obj)
        table.insert(textoConns, obj:GetPropertyChangedSignal("Text"):Connect(function()
            verificar(obj)
        end))
    end
end

-- ================= NOCLIP (único que o botão liga/desliga) =================
local function ligarNoclip()
    if noclipConn then return end
    noclipConn = RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)
end

local function desligarNoclip()
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end
end

-- ================= PROTEÇÕES (Anti-TP, pulo, texto) =================
-- Iniciam na primeira vez que o botão é ligado e continuam ativas depois.
local function iniciarProtecoes()
    if iniciado then return end
    iniciado = true
    resetarPosicao()

    local hum0 = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    local baseJP = hum0 and math.max(hum0.JumpPower, 50) or 50
    local baseJH = hum0 and math.max(hum0.JumpHeight, 7.2) or 7.2
    local baseWS = hum0 and math.max(hum0.WalkSpeed, 16) or 16

    local puloAte = 0      -- janela em que o pulo está liberado
    local pulandoAte = 0   -- janela em que o Anti-TP aceita a subida do pulo
    local arcoIni, arcoFim, arcoVy0 = 0, 0, 0

    local function liberarPulo(hum)
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        if hum.UseJumpPower then
            if hum.JumpPower < baseJP then hum.JumpPower = baseJP end
        else
            if hum.JumpHeight < baseJH then hum.JumpHeight = baseJH end
        end
    end

    -- Pulo: só é liberado quando o SEU clique/toque no botão de pulo é detectado
    table.insert(conns, UserInputService.JumpRequest:Connect(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = getHRP()
        if not hum or not hrp then return end

        local agora = os.clock()
        liberarPulo(hum)
        puloAte = agora + 0.35
        if agora < arcoFim then return end -- já está num pulo

        -- Arco do pulo protegido: o jogo não consegue te puxar pro chão mais rápido que a gravidade
        local g = workspace.Gravity
        local vy0 = hum.UseJumpPower and baseJP or math.sqrt(2 * g * baseJH)
        arcoIni = agora
        arcoVy0 = vy0
        arcoFim = agora + 2 * vy0 / g
        pulandoAte = arcoFim + 0.3

        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        local v = hrp.AssemblyLinearVelocity
        hrp.AssemblyLinearVelocity = Vector3.new(v.X, vy0, v.Z)
    end))

    -- Mantém velocidade, evita travas e protege o arco do pulo
    table.insert(conns, RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local agora = os.clock()

        if hum then
            if agora < puloAte then liberarPulo(hum) end
            if hum.WalkSpeed < baseWS then hum.WalkSpeed = baseWS end
            if hum.PlatformStand then hum.PlatformStand = false end
        end

        if hrp and agora < arcoFim then
            local vyEsperado = arcoVy0 - workspace.Gravity * (agora - arcoIni)
            local v = hrp.AssemblyLinearVelocity
            if v.Y < vyEsperado then
                hrp.AssemblyLinearVelocity = Vector3.new(v.X, vyEsperado, v.Z)
            end
        end
    end))

    -- Anti-TP
    table.insert(conns, RunService.Heartbeat:Connect(function(dt)
        local hrp = getHRP()
        if not hrp then return end
        if not lastSafe then lastSafe = hrp.CFrame return end

        local distH = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z)
            - Vector3.new(lastSafe.Position.X, 0, lastSafe.Position.Z)).Magnitude
        local limite = 3 + prevSpeed * dt * 2
        local agora = os.clock()

        -- vertical: após o seu clique de pulo, aceita subir até 15 studs
        local dy = math.abs(hrp.Position.Y - lastSafe.Position.Y)
        local limiteV = (agora < pulandoAte) and 15 or limite
        local teleporte = distH > limite or dy > limiteV

        if teleporte or (agora < guardaAte and distH > 5) then
            if teleporte then guardaAte = agora + 1 end
            local v = hrp.AssemblyLinearVelocity
            hrp.AssemblyLinearVelocity = Vector3.new(0, math.min(v.Y, 0), 0)
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.CFrame = lastSafe
        else
            local v = hrp.AssemblyLinearVelocity
            if v.Y <= 1 then
                lastSafe = hrp.CFrame
            else
                lastSafe = CFrame.new(hrp.Position.X, lastSafe.Position.Y, hrp.Position.Z)
                    * (hrp.CFrame - hrp.CFrame.Position)
            end
            prevSpeed = v.Magnitude
        end
    end))

    -- Respawn
    table.insert(conns, LocalPlayer.CharacterAdded:Connect(resetarPosicao))

    -- Remover texto da prisão
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    for _, d in ipairs(playerGui:GetDescendants()) do observar(d) end
    table.insert(textoConns, playerGui.DescendantAdded:Connect(observar))
end

