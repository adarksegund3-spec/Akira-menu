function GameModule.getCurrent()
    local ok, info = pcall(function()
        return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
    end)
    if not ok or not info then return nil end
    local jn = info.Name:lower()
    for _, g in ipairs(GameModule.games) do
        local shortName = g.name:split(" — ")[1]:lower()
        if jn:find(shortName, 1, true) then return g end
    end
    return nil
end

function GameModule.execute(g, onStatus)
    onStatus("⏳ Carregando...", "loading")
    local sources = {g.script}
    if g.sources then for _, s in ipairs(g.sources) do table.insert(sources, s) end end
    for i, url in ipairs(sources) do
        local ok, err = pcall(function()
            local code = game:HttpGet(url)
            if not code or #code < 20 then error("Resposta vazia") end
            loadstring(code)()
        end)
        if ok then
            onStatus("✓ Executado!", "success")
            showToast("▶ "..g.name.." executado", "success")
            return true
        else
            warn("[AKZ] Fonte "..i.." falhou: "..tostring(err))
        end
    end
    onStatus("⚠ Falhou", "error")
    showToast("⚠ Script temporariamente indisponível", "error")
    return false
end

