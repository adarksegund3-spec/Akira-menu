-- TEAM DETECTION
-- ═══════════════════════════════════════════════════════════════
local TeamDetect = { method = nil }

local function getTeamViaTeam(p)
    if not p then return nil end
    local ok, t = pcall(function() return p.Team end)
    if ok and t then return t end
    return nil
end

local function getTeamViaAttribute(p)
    if not p then return nil end
    local char = p.Character
    if not char then return nil end
    local ok, val = pcall(function() return char:GetAttribute("TeamColor") end)
    if ok and val then return tostring(val) end
    return nil
end

local function getTeamViaStringValue(p)
    if not p then return nil end
    local char = p.Character
    if not char then return nil end
    local sv = char:FindFirstChild("Team")
    if sv and (sv:IsA("StringValue") or sv:IsA("ObjectValue")) then
        return sv.Value
    end
    return nil
end

local function getPlayerTeam(p)
    if not p then return nil end
    if TeamDetect.method == "Team" then
        local t = getTeamViaTeam(p); if t then return t end
    elseif TeamDetect.method == "Attribute" then
        local s = getTeamViaAttribute(p); if s then return s end
    elseif TeamDetect.method == "StringValue" then
        local v = getTeamViaStringValue(p); if v then return v end
    end
    local t = getTeamViaTeam(p); if t then return t end
    local s = getTeamViaAttribute(p); if s then return s end
    local v = getTeamViaStringValue(p); if v then return v end
    return nil
end

local function parseRGB(s)
    if not s then return nil end
    local r, g, b = tostring(s):match("([%d%.]+),%s*([%d%.]+),%s*([%d%.]+)")
    if r and g and b then
        return Color3.new(tonumber(r) or 1, tonumber(g) or 1, tonumber(b) or 1)
    end
    return nil
end

local function getTeamColorFor(p)
    local s = getTeamViaAttribute(p)
    local cor = parseRGB(s)
    if cor then return cor end
    local t = getTeamViaTeam(p)
    if t then
        local ok, tc = pcall(function() return t.TeamColor end)
        if ok and tc and tc.Color then return tc.Color end
    end
    local ok, tc = pcall(function() return p.TeamColor end)
    if ok and tc and tc.Color then return tc.Color end
    return Color3.fromRGB(200, 200, 200)
end

local function detectTeamSystem()
    local cTeam, cAttr, cSV = 0, 0, 0
    for _, p in ipairs(Players:GetPlayers()) do
        if getTeamViaTeam(p) then cTeam = cTeam + 1 end
        if getTeamViaAttribute(p) then cAttr = cAttr + 1 end
        if getTeamViaStringValue(p) then cSV = cSV + 1 end
    end
    local method = nil
    if cTeam > 0 then method = "Team"
    elseif cAttr > 0 then method = "Attribute"
    elseif cSV > 0 then method = "StringValue"
    end
    TeamDetect.method = method

    local teams = {}
    if method then
        for _, p in ipairs(Players:GetPlayers()) do
            local key, display = nil, nil
            if method == "Team" then
                local t = getTeamViaTeam(p)
                if t then key = t.Name; display = t.Name end
            elseif method == "Attribute" then
                key = getTeamViaAttribute(p); display = "Time " .. tostring(key)
            elseif method == "StringValue" then
                key = tostring(getTeamViaStringValue(p)); display = tostring(key)
            end
            if key then
                teams[key] = teams[key] or { name = display, players = {}, color = getTeamColorFor(p) }
                table.insert(teams[key].players, p.DisplayName)
            end
        end
    end
    return method, teams
end

local function isAlly(p)
    if not p or p == LocalPlayer then return false end
    local mine = getPlayerTeam(LocalPlayer)
    local their = getPlayerTeam(p)
    if mine == nil or their == nil then return false end
    return tostring(mine) == tostring(their)
end

local function getTeamColor(p)
    if p == LocalPlayer then return Color3.fromRGB(120, 220, 140) end
    if isAlly(p) then return Color3.fromRGB(80, 170, 255) end
    local c = getTeamColorFor(p)
    if c then return c end
    return Color3.fromRGB(220, 40, 40)
end

