-- Exclusão com confirmação em 2 cliques
local pendingDelete = nil
TabHistory:CreateButton({
    Name = "🗑️ Excluir",
    Callback = function()
        local r = State.selectedRoute
        if not r then
            Rayfield:Notify({ Title = "Erro", Content = "Selecione uma rota primeiro.", Duration = 3 })
            return
        end
        if pendingDelete ~= r.id then
            pendingDelete = r.id
            Rayfield:Notify({
                Title = "Confirmar exclusão",
                Content = "Clique em Excluir de novo para confirmar.",
                Duration = 4,
            })
            task.delay(4, function()
                if pendingDelete == r.id then pendingDelete = nil end
            end)
            return
        end
        pendingDelete = nil
        Store:delete(r.id)
        State:select(nil)
        refreshHistoryList()
        Rayfield:Notify({ Title = "Excluída", Content = "Rota removida.", Duration = 3 })
    end,
})

