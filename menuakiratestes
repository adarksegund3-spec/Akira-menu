local function new(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    if parent then inst.Parent = parent end
    return inst
end

local function corner(inst, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r) }, inst)
end

local function stroke(inst, color, thick, transp)
    return new("UIStroke", {
        Color = color, Thickness = thick or 1, Transparency = transp or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, inst)
end

local function gradient(inst, c1, c2, rot)
    return new("UIGradient", {
        Color = ColorSequence.new(c1, c2),
        Rotation = rot or 90,
    }, inst)
end

local function lighten(c, amt)
    return Color3.new(math.min(c.R + amt, 1), math.min(c.G + amt, 1), math.min(c.B + amt, 1))
end

local function makeButton(parent, text, color, textColor, size, pos, textSize)
    local b = new("TextButton", {
        Size = size, Position = pos,
        BackgroundColor3 = color,
        Font = Enum.Font.GothamBold,
        Text = text,
        TextColor3 = textColor or C.Text,
        TextSize = textSize or 12,
        BorderSizePixel = 0,
        AutoButtonColor = true,
    }, parent)
    corner(b, 7)
    gradient(b, lighten(color, 0.1), color, 90)
    return b
end

