    local function getAnim()
        if not S.humanoid and S.char then S.humanoid=S.char:FindFirstChildOfClass("Humanoid") end
        if not S.humanoid then return nil end
        local a=S.humanoid:FindFirstChildOfClass("Animator"); if not a then a=Instance.new("Animator",S.humanoid) end; return a
    end
    local function prepAnims()
        if not refreshChar() then return false end
        if not S.humanoid then S.humanoid=S.char:FindFirstChildOfClass("Humanoid") end
        local an=getAnim(); if not an then return false end
        if S.animTracks then for _,t in pairs(S.animTracks) do pcall(function() t:Stop(0) end) end end
        S.animTracks={}
        local function load(id)
            if not id then return nil end
            local a=Instance.new("Animation"); a.AnimationId=id
            local ok,tr=pcall(function() return an:LoadAnimation(a) end)
            if ok and tr then tr.Priority=Enum.AnimationPriority.Movement; tr.Looped=true; return tr end
            return nil
        end
        S.animTracks.idle=load(A_IDLE); S.animTracks.walk=load(A_WALK); S.animTracks.jump=load(A_JUMP); S.animTracks.fall=load(A_FALL)
        S.animCurrent=nil; return true
    end
    local function switchAnim(n)
        if not S.animTracks or S.animCurrent==n then return end
        if S.animCurrent and S.animTracks[S.animCurrent] then pcall(function() S.animTracks[S.animCurrent]:Stop(0.15) end) end
        local t=S.animTracks[n]
        if t then pcall(function() t:Play(0.15,1,1) end); S.animCurrent=n end
    end
    local function updateAnim(sp)
        if not S.animTracks then return end
        local hum=S.humanoid
        if hum and hum.FloorMaterial==Enum.Material.Air then
            if hum:GetState()==Enum.HumanoidStateType.Freefall then switchAnim(sp>5 and "fall" or "jump") end
            return
        end
        if sp<0.5 then switchAnim("idle") return end
        switchAnim("walk")
    end
    local function stopAnims()
        if S.animTracks then for _,t in pairs(S.animTracks) do pcall(function() t:Stop(0.15) end) end end
        S.animTracks=nil; S.animCurrent=nil
    end
    local function stopPlayback(s)
        S.playing=false
        if S.playConn then S.playConn:Disconnect() S.playConn=nil end
        if S.onStopRestore then pcall(S.onStopRestore); S.onStopRestore=nil end
        stopAnims()
        if timerGui then timerGui.Enabled=false end
        setStatus("Pronto",T.green)
        if not s then notify("Reprodução interrompida") end
    end

    local function playFrames(frames,name,draw)
        if not frames or #frames<2 then notify("Trajetória inválida") return end
        if not refreshChar() then notify("Personagem não encontrado") return end
        if S.playing then stopPlayback(true) end
        if S.recording then S.recording=false; if S.recordConn then S.recordConn:Disconnect() S.recordConn=nil end end
        local cfs=frames.cfsCache
        local times=frames.timesCache
        if not cfs or not times then
            cfs={}; times={}
            for i,f in ipairs(frames) do
                local cf=f.cf or (f.p and CFrame.new(f.p[1],f.p[2],f.p[3]))
                if cf then cfs[#cfs+1]=cf; times[#times+1]=f.t or ((i-1)/RECORD_HZ) end
            end
        end
        if #cfs<2 then notify("Trajetória inválida") return end
        if #cfs>600 then
            local sk=math.ceil(#cfs/400)
            local nC,nT={},{}
            for i=1,#cfs,sk do table.insert(nC,cfs[i]); table.insert(nT,times[i]) end
            if nC[#nC]~=cfs[#cfs] then table.insert(nC,cfs[#cfs]); table.insert(nT,times[#times]) end
            cfs,times=nC,nT
        end
        local positions=table.create(#cfs)
        for i=1,#cfs do positions[i]=cfs[i].Position end
        if draw then drawLine(cfs,S.lineColor) end
        S.playing=true; S.playPositions=positions; S.playTimes=times; S.playIndex=1
        S.playStartTime=os.clock(); S.playTotal=times[#times]
        S.lastAnimSpeed=0; S.lastPlayCF=nil; S.smoothLook=nil
        if S.humanoid then pcall(function() S.humanoid.AutoRotate=false end) end
        S.onStopRestore=function() if S.humanoid then pcall(function() S.humanoid.AutoRotate=true end) end end
        notify("Reproduzindo: "..(name or "traj"))
        setStatus("Reproduzindo",T.cyan)
        if not prepAnims() then return end
        switchAnim("idle")
        if timerGui then timerRota.Text=(name or "traj"); timerTempo.Text="0.0s"; timerGui.Enabled=true end
        local pR=positions; local tR=times; local tot=#positions; local aC=0; local lVZ=0
        S.playConn=RunService.Heartbeat:Connect(function(dt)
            if not S.playing then return end
            local h=S.hrp
            if not h or not h.Parent then stopPlayback(true) return end
            local el=os.clock()-S.playStartTime
            if timerTempo then timerTempo.Text=string.format("%.1fs", el) end
            if el>=S.playTotal then
                local lP=pR[tot]
                pcall(function() h.CFrame=CFrame.new(lP)*(h.CFrame-h.CFrame.Position); h.AssemblyLinearVelocity=Vector3.zero; h.AssemblyAngularVelocity=Vector3.zero end)
                stopPlayback(true); notify("Reprodução concluída"); return
            end
            local idx=S.playIndex
            while idx<tot and tR[idx+1]<=el do idx=idx+1 end
            S.playIndex=idx
            local i1=idx; local i2=(idx<tot) and (idx+1) or idx
            local p1=pR[i1]; local p2=pR[i2]; local t1=tR[i1]; local t2=tR[i2]
            local al=(t2>t1) and ((el-t1)/(t2-t1)) or 0
            if al<0 then al=0 elseif al>1 then al=1 end
            local iP=p1+(p2-p1)*al
            local fCF
            local lI=i1+5; if lI>tot then lI=tot end
            local sE=pR[lI]; local md=sE-p1; md=Vector3.new(md.X,0,md.Z)
            if md.Magnitude>0.1 then
                md=md.Unit
                if S.smoothLook then S.smoothLook=S.smoothLook:Lerp(md,0.25); local mg=S.smoothLook.Magnitude; if mg>0.01 then S.smoothLook=S.smoothLook/mg end
                else S.smoothLook=md end
                fCF=CFrame.lookAt(iP,iP+S.smoothLook)
            else
                if S.smoothLook then fCF=CFrame.lookAt(iP,iP+S.smoothLook) else fCF=CFrame.new(iP)*(h.CFrame-h.CFrame.Position) end
            end
            if tick()-lVZ>0.05 then lVZ=tick(); h.AssemblyLinearVelocity=Vector3.zero; h.AssemblyAngularVelocity=Vector3.zero end
            h.CFrame=fCF
            aC=aC+1
            if aC>=5 then
                aC=0
                local lP=S.lastPlayCF and S.lastPlayCF.Position or iP
                local dist=(iP-lP).Magnitude
                local spd=dist/(dt*5)
                if spd>150 then spd=S.lastAnimSpeed end
                S.lastAnimSpeed=spd; updateAnim(spd)
            end
            S.lastPlayCF=fCF
        end)
    end

    local function startRecording()
        if not refreshChar() then notify("Personagem não encontrado") return end
        S.frames=table.create(MAX_FRAMES); S.recording=true; S.recordStart=os.clock()
        createTrail(); clearLine(); notify("Gravando...")
        setStatus("Gravando",T.red)
        if recBtn then recBtn.Text="Finalizar"; recBtn.BackgroundColor3=T.red end
        local lP,lD; local acc=0
        S.recordConn=RunService.Heartbeat:Connect(function(dt)
            if not S.recording then return end
            acc=acc+dt
            if acc<RECORD_INTERVAL then return end
            acc=0
            local hrp=S.hrp
            if hrp and hrp.Parent then
                local cf=hrp.CFrame; local pos,dir=cf.Position,cf.LookVector
                local sv=false
                if not lP then sv=true
                elseif (pos-lP).Magnitude>RECORD_MIN_DIST or (dir-lD).Magnitude>0.05 then sv=true end
                if sv and #S.frames<MAX_FRAMES then S.frames[#S.frames+1]={cf=cf,t=os.clock()-S.recordStart}; lP,lD=pos,dir end
            end
        end)
    end
    local function stopRecording()
        S.recording=false
        if S.recordConn then S.recordConn:Disconnect() S.recordConn=nil end
        setStatus("Pronto",T.green)
        if recBtn then recBtn.Text="Gravar"; recBtn.BackgroundColor3=T.purple end
        if #S.frames>1 then
            local cfs={}; for i,f in ipairs(S.frames) do cfs[i]=f.cf end
            drawLine(cfs,S.lineColor); notify(string.format("Gravado! %d pontos",#S.frames))
        else notify("Nada foi gravado") end
    end

    local function loadSaves()
        S.saves={}
        if not hasFS then return 0 end
        local ok,files=pcall(listfiles,SAVE_FOLDER)
        if not ok or type(files)~="table" then return 0 end
        for _,path in ipairs(files) do
            if path:lower():match("%.json$") then
                local name=path:match("([^/\\]+)%.json$") or "traj"
                local okR,content=pcall(readfile,path)
                if okR and content and #content>5 then
                    local data=nil; pcall(function() data=HttpService:JSONDecode(content) end)
                    if data and not data.deleted and type(data.frames)=="table" and #data.frames>=2 then
                        local fr={}; local valido=true
                        for i,f in ipairs(data.frames) do
                            if not f or not f.p then valido=false; break end
                            local x,y,z=tonumber(f.p[1]),tonumber(f.p[2]),tonumber(f.p[3])
                            if not x or not y or not z then valido=false; break end
                            fr[i]={cf=CFrame.new(x,y,z),t=tonumber(f.t) or ((i-1)/30)}
                        end
                        if valido and #fr>=2 then
                            local isT=name:upper():find("^TORRE")~=nil
                            local isC=name:upper():find("^CIVIL")~=nil
                            S.saves[name]={name=name,frames=prepararFrames(fr),isTorre=isT,isCivil=isC}
                        end
                    end
                end
            end
        end
        local t=0; for _ in pairs(S.saves) do t=t+1 end; return t
    end

    local function doSave(name)
        if #S.frames<2 then notify("Nada para salvar") return end
        if name=="" then name="traj_"..os.date("%Y%m%d_%H%M%S") end
        local isT=name:upper():find("^TORRE")~=nil
        local isC=name:upper():find("^CIVIL")~=nil
        local data={name=name,savedAt=os.time(),isTorre=isT,isCivil=isC,frames={}}
        for i,f in ipairs(S.frames) do data.frames[i]={p={f.cf.Position.X,f.cf.Position.Y,f.cf.Position.Z},t=f.t} end
        S.saves[name]={name=name,frames=prepararFrames(S.frames),isTorre=isT,isCivil=isC}
        local ok=saveToDisk(name,data)
        local dest=isT and "Torres 🗼" or (isC and "Civil 👮" or "Biblioteca 📚")
        notify((ok and "Salvo em " or "Salvo memória em ")..dest..": "..name)
        if not isT and not isC then
            task.spawn(function() task.wait(0.1); if refreshLib then pcall(refreshLib) end; if switchTab then pcall(switchTab,"library") end end)
        end
    end

