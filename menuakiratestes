local wasEnabled = false

RunService.RenderStepped:Connect(function(dt)
    local showFov = Config.AimbotEnabled and Config.AimbotShowFOV
    local centro = getScreenCenter()
    if AimFovDrawing then
        AimFovDrawing.Visible = showFov
        AimFovDrawing.Position = centro
        fovCircle.Visible = false
    else
        fovCircle.Visible = showFov
        if showFov then fovCircle.Position = UDim2.fromOffset(centro.X, centro.Y) end
    end

    if not Config.ESPEnabled then
        if wasEnabled then clearAllESP() end
        wasEnabled = false
    else
        wasEnabled = true
        for _, player in ipairs(Players:GetPlayers()) do
            updatePlayerESP(player)
        end
    end

    if Config.AimbotEnabled and Config.Aiming then
        local target = getAimbotTarget()
        if target then lockOn(target) end
    elseif not Config.AimbotEnabled then
        Config.LockedTarget = nil
    end

    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            if Config.SpeedEnabled then hum.WalkSpeed = Config.SpeedValue end
            if Config.JumpEnabled then
                hum.UseJumpPower = true
                hum.JumpPower = Config.JumpValue
            end
        end
    end

    weaponTick = weaponTick + dt
    if weaponTick >= 0.2 then
        weaponTick = 0
        if Config.NoRecoil or Config.NoSpread then
            applyWeaponMods()
        end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    clearESPForPlayer(p)
    espCache[p] = nil
    if Config.LockedTarget and Config.LockedTarget.Parent == p.Character then
        Config.LockedTarget = nil
    end
end)

