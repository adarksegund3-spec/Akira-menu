local function getAnimator(hum)
    return hum:FindFirstChildOfClass("Animator") or hum:FindFirstChildWhichIsA("Animator", true)
end

local function dumpAnimate(char, groupName)
    local main, all = {}, {}
    local animate = char:FindFirstChild("Animate")
    if not animate then return main, all end
    for _, group in ipairs(animate:GetChildren()) do
        for _, a in ipairs(group:GetDescendants()) do
            if a:IsA("Animation") then
                local item = { Grupo = group.Name, Nome = a.Name, Id = a.AnimationId }
                table.insert(all, item)
                if group.Name:lower() == groupName then table.insert(main, item) end
            end
        end
    end
    return main, all
end

local function q(s) return string.format("%q", tostring(s)) end

local function buildResult(tabInfo, r)
    local list = {}
    for _, s in pairs(r.stats) do table.insert(list, s) end
    table.sort(list, function(a, b) return a.count > b.count end)

    local frames = math.max(r.frames, 1)
    local duration = r.duration
    local avgSpeed = r.speedSum / frames

    local states = {}
    for name, n in pairs(r.states) do table.insert(states, { name = name, n = n }) end
    table.sort(states, function(a, b) return a.n > b.n end)
    local stateNames = {}
    for _, s in ipairs(states) do table.insert(stateNames, q(s.name)) end

    local animMain, animAll = dumpAnimate(r.char, tabInfo.animate)

    -- Texto copiado
    local L = {}
    table.insert(L, string.format("-- ANGEL ANIM ID | aba: %s | %.2fs | %d amostras", tabInfo.key, duration, r.frames))
    table.insert(L, "return {")
    table.insert(L, string.format("    Aba = %s,", q(tabInfo.key)))
    table.insert(L, string.format("    PlaceId = %d,", game.PlaceId))
    table.insert(L, string.format("    Rig = %s,", q(r.rig)))
    table.insert(L, string.format("    WalkSpeedInicio = %.2f,", r.walkStart))
    table.insert(L, string.format("    WalkSpeedMaximo = %.2f,", r.walkMax))
    table.insert(L, string.format("    VelocidadeMediaReal = %.2f,", avgSpeed))
    table.insert(L, string.format("    VelocidadeMaximaReal = %.2f,", r.speedMax))
    table.insert(L, string.format("    %s = %.2f,", r.jumpName, r.jumpValue))
    table.insert(L, string.format("    Estados = {%s},", table.concat(stateNames, ", ")))
    table.insert(L, "    Animacoes = {")
    for i, s in ipairs(list) do
        local asset = tostring(s.Id):match("%d+") or "?"
        table.insert(L, string.format(
            "        {Rank=%d, Nome=%s, NomeTrack=%s, Id=%s, AssetId=%s, Prioridade=%s, Loop=%s, Duracao=%.3f, VelMin=%.3f, VelMax=%.3f, PesoMax=%.3f, Presenca=\"%.0f%%\"},",
            i, q(s.Nome), q(s.TrackName), q(s.Id), asset, q(s.Priority), tostring(s.Looped),
            s.Length, s.minSpeed, s.maxSpeed, s.maxWeight, (s.count / frames) * 100))
    end
    table.insert(L, "    },")
    table.insert(L, "    AnimateDaAba = {")
    for _, a in ipairs(animMain) do
        table.insert(L, string.format("        {Grupo=%s, Nome=%s, Id=%s},", q(a.Grupo), q(a.Nome), q(a.Id)))
    end
    table.insert(L, "    },")
    table.insert(L, "    AnimateTodas = {")
    for _, a in ipairs(animAll) do
        table.insert(L, string.format("        {Grupo=%s, Nome=%s, Id=%s},", q(a.Grupo), q(a.Nome), q(a.Id)))
    end
    table.insert(L, "    },")
    table.insert(L, "}")
    table.insert(L, "")
    if list[1] then
        table.insert(L, "-- Para tocar a animacao principal:")
        table.insert(L, "-- local hum = game.Players.LocalPlayer.Character:FindFirstChildOfClass(\"Humanoid\")")
        table.insert(L, "-- local anim = Instance.new(\"Animation\")")
        table.insert(L, "-- anim.AnimationId = " .. q(list[1].Id))
        table.insert(L, "-- local tr = hum:FindFirstChildOfClass(\"Animator\"):LoadAnimation(anim)")
        table.insert(L, string.format("-- tr.Priority = Enum.AnimationPriority.%s", list[1].Priority))
        table.insert(L, string.format("-- tr.Looped = %s", tostring(list[1].Looped)))
        table.insert(L, "-- tr:Play()")
    end

    -- Preview na tela
    local P = {}
    table.insert(P, string.format("Vel media %.1f | WalkSpeed %.0f | %s", avgSpeed, r.walkMax, r.rig))
    table.insert(P, string.format("%d animacao(oes) em %.1fs", #list, duration))
    table.insert(P, "")
    for i, s in ipairs(list) do
        table.insert(P, string.format("%d) %s  (%.0f%%)", i, s.Nome, (s.count / frames) * 100))
        table.insert(P, "   " .. tostring(s.Id))
        table.insert(P, string.format("   %s | loop %s | %.2fs", s.Priority, tostring(s.Looped), s.Length))
        table.insert(P, string.format("   vel %.2f a %.2f", s.minSpeed, s.maxSpeed))
        table.insert(P, "")
    end
    if #list == 0 then
        table.insert(P, "Nenhuma animacao detectada.")
        table.insert(P, "O jogo pode tocar animacoes por outro Animator.")
    end

    return { text = table.concat(L, "\n"), preview = table.concat(P, "\n") }
end

local function showTab()
    local info = TABS[currentTab]
    for i, b in ipairs(tabButtons) do
        if i == currentTab then
            b.BackgroundColor3 = C.TurqDark
            b.TextColor3 = C.TurqBright
        else
            b.BackgroundColor3 = C.Bg2
            b.TextColor3 = C.TextDim
        end
    end
    local res = results[info.key]
    if res then
        PreviewText.Text = res.preview
        setStatus("Gravacao pronta: " .. info.key, "ok")
    else
        PreviewText.Text = info.hint .. "\n\nDepois toque em Parar e depois em Copiar."
        setStatus("Parado", nil)
    end
    Preview.CanvasPosition = Vector2.new(0, 0)
    TimerLabel.Text = "00:00.000"
    TimerStroke.Color = C.TurqDark
    TimerLabel.TextColor3 = C.TurqBright
end

for i, b in ipairs(tabButtons) do
    track(b.MouseButton1Click:Connect(function()
        if rec then setStatus("Pare a gravacao antes", "warn") return end
        currentTab = i
        showTab()
    end))
end

