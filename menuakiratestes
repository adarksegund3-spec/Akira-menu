		local add, clean = bag(); local r = hrp()
		local a0 = add(Instance.new("Attachment", r)); a0.Position = Vector3.new(0, 1, 0)
		local a1 = add(Instance.new("Attachment", r)); a1.Position = Vector3.new(0, -1, 0)
