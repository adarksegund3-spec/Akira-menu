		else
			dest = o + d.Unit * 120
		end
		local start = hrp.Position + hrp.CFrame.LookVector * 3 + Vector3.new(0, 0.5, 0)
		local rocket = part({
			Anchored = true, Shape = Enum.PartType.Ball, Size = Vector3.new(0.7, 0.7, 0.7),
			Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 230, 160), Position = start, Parent = FX,
		})
		local a0 = new("Attachment", {Position = Vector3.new(0, 0.2, 0)}, rocket)
		local a1 = new("Attachment", {Position = Vector3.new(0, -0.2, 0)}, rocket)
		new("Trail", {
			Attachment0 = a0, Attachment1 = a1, Lifetime = 0.5, LightEmission = 1, FaceCamera = true,
			Color = ColorSequence.new(Color3.fromRGB(255, 230, 140), Color3.fromRGB(255, 70, 0)),
			Transparency = NS(NSK(0, 0), NSK(1, 1)),
		}, rocket)
		new("ParticleEmitter", {
			Texture = SPARK, Rate = 80, Lifetime = NumberRange.new(0.3, 0.5), Speed = NumberRange.new(2, 5),
			SpreadAngle = Vector2.new(180, 180), Size = NS(NSK(0, 0.5), NSK(1, 0)), LightEmission = 1,
		}, rocket)
		local tw = TS:Create(rocket, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = dest})
		tw.Completed:Connect(function()
			rocket:Destroy()
			boom(dest, math.random(1, 2))
		end)
		tw:Play()
	end)
	return tool
end)

