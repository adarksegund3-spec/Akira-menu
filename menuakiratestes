local UI = { pages = {}, tabs = {} }

local function new(class, props, parent)
    local o = Instance.new(class)
    if props then
        for k, v in pairs(props) do o[k] = v end
    end
    if parent then o.Parent = parent end
    return o
end

local function corner(o, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o)
end

local function stroke(o, color, alpha)
    return new("UIStroke", {
        Color = color or C.stroke, Transparency = alpha or 0.7, Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, o)
end

local function tween(o, t, props, style, dir)
    local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function label(parent, text, size, pos, font, textSize, color, align)
    return new("TextLabel", {
        Text = text, Size = size, Position = pos or UDim2.new(),
        BackgroundTransparency = 1, Font = font or Enum.Font.Gotham,
        TextSize = textSize or 13, TextColor3 = color or C.text,
        TextXAlignment = align or Enum.TextXAlignment.Left, BorderSizePixel = 0,
    }, parent)
end

local function makeButton(parent, text, size, pos, color, textColor)
    local base = color or C.accent
    local b = new("TextButton", {
        Text = text, Font = Enum.Font.GothamBold, TextSize = 14,
        TextColor3 = textColor or C.text, BackgroundColor3 = base,
        AutoButtonColor = false, Size = size, Position = pos or UDim2.new(),
        BorderSizePixel = 0,
    }, parent)
    b:SetAttribute("Base", base)
    corner(b, 8)
    b.MouseEnter:Connect(function()
        tween(b, 0.12, { BackgroundColor3 = b:GetAttribute("Base"):Lerp(Color3.new(1, 1, 1), 0.14) })
    end)
    b.MouseLeave:Connect(function()
        tween(b, 0.12, { BackgroundColor3 = b:GetAttribute("Base") })
    end)
    return b
end

-- Sistema de toasts (canto inferior direito)
local Toast = { container = nil }
function Toast.show(msg, kind)
    if not Toast.container then return end
    local col = (kind == "success" and C.success) or (kind == "error" and C.danger) or C.accent
    local g = new("CanvasGroup", {
        Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = C.panel,
        GroupTransparency = 1, BorderSizePixel = 0,
    }, Toast.container)
    corner(g, 8)
    stroke(g, col, 0.4)
    new("Frame", { Size = UDim2.new(0, 4, 1, 0), BackgroundColor3 = col, BorderSizePixel = 0 }, g)
    label(g, tostring(msg), UDim2.new(1, -18, 1, 0), UDim2.new(0, 12, 0, 0), Enum.Font.GothamBold, 12, C.text)
    tween(g, 0.2, { GroupTransparency = 0 })
    task.delay(2.6, function()
        if g and g.Parent then
            local tw = tween(g, 0.3, { GroupTransparency = 1 })
            tw.Completed:Connect(function() if g then g:Destroy() end end)
        end
    end)
end

--[[ === SEÇÃO 6: MÓDULO DE DIAGNÓSTICO (OCULTO) === ]]
local Diag = { running = false, report = nil }

local function diagStep(name, fn)
    local ok, err = pcall(fn)
    if not ok then warn("[DIAG] Falha ao inspecionar " .. name .. ": " .. tostring(err)) end
end

function Diag.run()
    if Diag.running then return end
    Diag.running = true
    task.spawn(function()
        local rep = {}
        local char, hum = getChar(), getHum()

        diagStep("Character/Animator", function()
            local animator = hum and hum:FindFirstChildOfClass("Animator")
            local tracks = animator and animator:GetPlayingAnimationTracks() or {}
            local animate = char and char:FindFirstChild("Animate")
            rep.playingTracks = #tracks
            rep.walkAnim = ((animate and animate:FindFirstChild("walk")) ~= nil) or #tracks > 0
            print(rep.walkAnim and "[DIAG] Animações de caminhada detectadas: OK"
                or "[DIAG] Animações de caminhada detectadas: nenhuma")
        end)

        diagStep("Humanoid (pulo)", function()
            if not hum then error("Humanoid ausente") end
            rep.useJumpPower = hum.UseJumpPower
            rep.jumpPower = hum.JumpPower
            rep.jumpHeight = hum.JumpHeight
            rep.walkSpeed = hum.WalkSpeed
            print("[DIAG] Modo de pulo detectado: OK (" .. (hum.UseJumpPower and "JumpPower" or "JumpHeight") .. ")")
        end)

        diagStep("sprint", function()
            local found = 0
            local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
            if pg then
                for i, o in ipairs(pg:GetDescendants()) do
                    if o:IsA("GuiButton") then
                        local s = (o.Name .. " " .. (o:IsA("TextButton") and o.Text or "")):lower()
                        if s:find("sprint") or s:find("run") or s:find("correr") or s:find("corrida") then
                            found += 1
                        end
                    end
                    if i % 1500 == 0 then task.wait() end
                end
            end
            local changed = false
            local base = hum and hum.WalkSpeed or 16
            local conn
            if hum then
                conn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function() changed = true end)
            end
            task.wait(3)
            if conn then conn:Disconnect() end
            rep.sprintButtons = found
            rep.sprintByWalkSpeed = changed or base > 16
            if found > 0 or rep.sprintByWalkSpeed then
                print("[DIAG] Botão de correr (sprint) detectado: OK")
            else
                print("[DIAG] Botão de correr (sprint) detectado: nenhum")
            end
        end)

        diagStep("RemoteEvents/Prompts", function()
            local counts = { RemoteEvent = 0, RemoteFunction = 0, BindableEvent = 0,
                ProximityPrompt = 0, ClickDetector = 0, TouchTransmitter = 0 }
            local n = 0
            for _, root in ipairs({ ReplicatedStorage, ReplicatedFirst, workspace }) do
                for _, o in ipairs(root:GetDescendants()) do
                    local cn = o.ClassName
                    if counts[cn] ~= nil then counts[cn] += 1 end
                    n += 1
                    if n % 2000 == 0 then task.wait() end
                end
            end
            rep.remoteEvents = counts.RemoteEvent
            rep.remoteFunctions = counts.RemoteFunction
            rep.bindables = counts.BindableEvent
            rep.prompts = counts.ProximityPrompt
            rep.clickDetectors = counts.ClickDetector
            rep.touchInterests = counts.TouchTransmitter
            print("[DIAG] RemoteEvents de ação detectados: " .. counts.RemoteEvent)
            print("[DIAG] TouchInterest / ProximityPrompt detectados: " .. (counts.TouchTransmitter + counts.ProximityPrompt))
        end)

        diagStep("Tools", function()
            local n = 0
            local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
            if bp then for _, t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then n += 1 end end end
            if char then for _, t in ipairs(char:GetChildren()) do if t:IsA("Tool") then n += 1 end end end
            rep.tools = n
            print("[DIAG] Tools equipáveis detectadas: " .. n)
        end)

        diagStep("Toque", function()
            rep.touchEnabled = UIS.TouchEnabled
            print("[DIAG] Suporte a toque: " .. (UIS.TouchEnabled and "OK" or "não"))
        end)

        Diag.report = rep
        genv.RouteHubDiag = rep -- relatório estruturado usado pelo gravador
        Diag.running = false
    end)
end

--[[ === SEÇÃO 7: MÓDULO DE GRAVAÇÃO === ]]
local Recorder = {
    active = false, events = {}, t0 = 0, conns = {}, charConns = {},
    seen = setmetatable({}, { __mode = "k" }),
    boundTools = setmetatable({}, { __mode = "k" }),
    touches = {}, touchLast = {}, downSet = {}, keysDown = {},
    animSummary = {}, touchId = 0,
    baseWS = 16, lastWS = 16, runSpeed = 0, lastMD = Vector3.zero,
    lastMoveMs = 0, lastForceMs = 0, lastCamMs = 0, lastAnimMs = 0, lastCF = nil,
}

function Recorder.add(typ, data)
    if not Recorder.active then return nil end
    local ev = { t = math.floor((os.clock() - Recorder.t0) * 1000), type = typ, data = data }
    Recorder.events[#Recorder.events + 1] = ev
    return ev
end

local function pointerInfo(input)
    local vp = cam().ViewportSize
    local inset = GuiService:GetGuiInset()
    local px, py, sx, sy
    if input.UserInputType == Enum.UserInputType.Touch then
        px, py = input.Position.X, input.Position.Y
        sx, sy = px + inset.X, py + inset.Y
    else
        local m = UIS:GetMouseLocation()
        sx, sy = m.X, m.Y
        px, py = sx - inset.X, sy - inset.Y
    end
    return px, py, sx, sy, vp
end

-- Retorna o GuiButton do jogo sob o ponteiro, "ours" se for o hub, ou nil
local function findGuiButton(px, py, sx, sy)
    local win = UI.main
    if win and win.Parent and win.Visible then
        local ap, as = win.AbsolutePosition, win.AbsoluteSize
        if sx >= ap.X and sx <= ap.X + as.X and sy >= ap.Y and sy <= ap.Y + as.Y then
            return "ours"
        end
    end
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return nil end
    for _, pos in ipairs({ Vector2.new(px, py), Vector2.new(sx, sy) }) do
        local ok, objs = pcall(pg.GetGuiObjectsAtPosition, pg, pos.X, pos.Y)
        if ok then
            for _, o in ipairs(objs) do
                if o:IsA("GuiButton") and o.Visible and not (UI.gui and o:IsDescendantOf(UI.gui)) then
                    return o
                end
            end
        end
    end
    return nil
end

function Recorder.onInputBegan(input, gpe)
    local ut = input.UserInputType
    if ut == Enum.UserInputType.Keyboard then
        if gpe then return end -- digitando em caixa de texto/chat
        local kc = input.KeyCode
        if kc == Enum.KeyCode.D and UIS:IsKeyDown(Enum.KeyCode.LeftControl)
            and UIS:IsKeyDown(Enum.KeyCode.LeftShift) then return end
        Recorder.keysDown[kc] = os.clock()
        Recorder.add("KeyDown", { k = kc.Name, held = true })
    elseif ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.MouseButton2
        or ut == Enum.UserInputType.Touch then
        local px, py, sx, sy, vp = pointerInfo(input)
        local btn = findGuiButton(px, py, sx, sy)
        if btn == "ours" then return end
        if gpe and not btn then return end -- controles nativos (joystick/pulo) não entram
        local d = { x = r4(sx / vp.X), y = r4(sy / vp.Y), phase = "down" }
        if btn then d.btn = instPath(btn) end
        if ut == Enum.UserInputType.Touch then
            Recorder.touchId += 1
            Recorder.touches[input] = Recorder.touchId
            d.id = Recorder.touchId
            Recorder.add("Touch", d)
        else
            d.b = (ut == Enum.UserInputType.MouseButton1) and 1 or 2
            Recorder.downSet[ut] = true
            Recorder.add("Click", d)
        end
    elseif ut.Name:find("Gamepad") and input.KeyCode ~= Enum.KeyCode.Thumbstick1
        and input.KeyCode ~= Enum.KeyCode.Thumbstick2 and input.KeyCode ~= Enum.KeyCode.Unknown then
        Recorder.keysDown[input.KeyCode] = os.clock()
        Recorder.add("KeyDown", { k = input.KeyCode.Name, gp = true, held = true })
    end
end

function Recorder.onInputEnded(input, gpe)
    local ut = input.UserInputType
    if ut == Enum.UserInputType.Keyboard or ut.Name:find("Gamepad") then
        local kc = input.KeyCode
        local since = Recorder.keysDown[kc]
        if since then
            Recorder.keysDown[kc] = nil
            Recorder.add("KeyUp", { k = kc.Name, gp = ut ~= Enum.UserInputType.Keyboard or nil,
                dur = math.floor((os.clock() - since) * 1000) })
        end
    elseif ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.MouseButton2 then
        if Recorder.downSet[ut] then
            Recorder.downSet[ut] = nil
            local _, _, sx, sy, vp = pointerInfo(input)
            Recorder.add("Click", { x = r4(sx / vp.X), y = r4(sy / vp.Y), phase = "up",
                b = (ut == Enum.UserInputType.MouseButton1) and 1 or 2 })
        end
    elseif ut == Enum.UserInputType.Touch then
        local id = Recorder.touches[input]
        if id then
            Recorder.touches[input] = nil
            Recorder.touchLast[id] = nil
            local _, _, sx, sy, vp = pointerInfo(input)
            Recorder.add("Touch", { x = r4(sx / vp.X), y = r4(sy / vp.Y), phase = "up", id = id })
        end
    end
end

function Recorder.onInputChanged(input)
    if input.UserInputType ~= Enum.UserInputType.Touch then return end
    local id = Recorder.touches[input]
    if not id then return end
    local now = os.clock()
    if Recorder.touchLast[id] and now - Recorder.touchLast[id] < 0.05 then return end
    Recorder.touchLast[id] = now
    local _, _, sx, sy, vp = pointerInfo(input)
    Recorder.add("Touch", { x = r4(sx / vp.X), y = r4(sy / vp.Y), phase = "move", id = id })
end

function Recorder.logTrack(track)
    if Recorder.seen[track] then return end
    Recorder.seen[track] = true
    local anim = track.Animation
    local id = anim and anim.AnimationId or ""
    local d = { id = id, pr = track.Priority.Name, sp = r3(track.Speed),
        w = r3(track.WeightTarget), lp = track.Looped, nm = track.Name }
    local ev = Recorder.add("Animation", d)
    local s = Recorder.animSummary[id]
    if not s then
        Recorder.animSummary[id] = { id = id, t = ev and ev.t or 0, n = 1, pr = d.pr }
    else
        s.n += 1
    end
end

function Recorder.addConn(list, sig, fn)
    local c = sig:Connect(fn)
    list[#list + 1] = c
    return c
end

function Recorder.unbindChar()
    for _, c in ipairs(Recorder.charConns) do pcall(function() c:Disconnect() end) end
    Recorder.charConns = {}
end

function Recorder.bindTool(tool)
    if Recorder.boundTools[tool] then return end
    Recorder.boundTools[tool] = true
    local L = Recorder.charConns
    Recorder.addConn(L, tool.Equipped, function() Recorder.add("ToolActivated", { n = tool.Name, ev = "Equipped" }) end)
    Recorder.addConn(L, tool.Unequipped, function() Recorder.add("ToolActivated", { n = tool.Name, ev = "Unequipped" }) end)
    Recorder.addConn(L, tool.Activated, function() Recorder.add("ToolActivated", { n = tool.Name, ev = "Activated" }) end)
end

-- Conecta os hooks do personagem (reconectado automaticamente em respawn)
function Recorder.bindCharacter(char)
    Recorder.unbindChar()
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 5)
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not hum or not Recorder.active then return end
    local L = Recorder.charConns

    Recorder.addConn(L, hum.Jumping, function(active)
        if active then
            Recorder.add("Jump", { up = hum.UseJumpPower, pw = r3(hum.UseJumpPower and hum.JumpPower or hum.JumpHeight) })
        end
    end)
    Recorder.addConn(L, hum.StateChanged, function(old, new)
        Recorder.add("StateChange", { s = new.Name, o = old.Name })
    end)
    Recorder.addConn(L, hum.Running, function(speed) Recorder.runSpeed = speed end)

    local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 3)
    if animator then
        Recorder.addConn(L, animator.AnimationPlayed, function(track) Recorder.logTrack(track) end)
    end

    for _, t in ipairs(char:GetChildren()) do if t:IsA("Tool") then Recorder.bindTool(t) end end
    Recorder.addConn(L, char.ChildAdded, function(t) if t:IsA("Tool") then Recorder.bindTool(t) end end)
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then Recorder.bindTool(t) end end
        Recorder.addConn(L, bp.ChildAdded, function(t) if t:IsA("Tool") then Recorder.bindTool(t) end end)
    end

    if root then
        local lastTouch = {}
        Recorder.addConn(L, root.Touched, function(part)
            if not part:FindFirstChildOfClass("TouchTransmitter") then return end
            local now = os.clock()
            if lastTouch[part] and now - lastTouch[part] < 0.5 then return end
            lastTouch[part] = now
            Recorder.add("TouchPart", { p = instPath(part) })
        end)
    end
end

-- Amostragem por frame (movimento, câmera e polling de animações)
function Recorder.sample()
    if not Recorder.active then return end
    local nowMs = math.floor((os.clock() - Recorder.t0) * 1000)
    local hum, root = getHum(), getRoot()

    if hum and nowMs - Recorder.lastMoveMs >= S.moveSampleRateMs then
        Recorder.lastMoveMs = nowMs
        local md, ws = hum.MoveDirection, hum.WalkSpeed
        if (md - Recorder.lastMD).Magnitude > 0.02 or nowMs - Recorder.lastForceMs >= 500 then
            Recorder.lastMD = md
            Recorder.lastForceMs = nowMs
            local d = { d = { r3(md.X), r3(md.Y), r3(md.Z) }, ws = r3(ws),
                sprint = ws > Recorder.baseWS + 0.5, rs = r3(Recorder.runSpeed or 0),
                st = hum:GetState().Name }
            if root then
                local p = root.Position
                d.p = { r3(p.X), r3(p.Y), r3(p.Z) }
            end
            Recorder.add("Move", d)
        end
        if math.abs(ws - Recorder.lastWS) > 0.01 then
            Recorder.lastWS = ws
            Recorder.add("Sprint", { ws = r3(ws), on = ws > Recorder.baseWS + 0.5, base = r3(Recorder.baseWS) })
        end
    end

    local c = cam()
    if c and nowMs - Recorder.lastCamMs >= S.cameraSampleRateMs then
        Recorder.lastCamMs = nowMs
        local cf, last = c.CFrame, Recorder.lastCF
        if not last or (cf.Position - last.Position).Magnitude > 0.01
            or cf.LookVector:Dot(last.LookVector) < 0.99999 then
            Recorder.lastCF = cf
            local comps = { cf:GetComponents() }
            for i = 1, #comps do comps[i] = r4(comps[i]) end
            Recorder.add("Camera", { c = comps })
        end
    end

    if hum and nowMs - Recorder.lastAnimMs >= 500 then
        Recorder.lastAnimMs = nowMs
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do Recorder.logTrack(tr) end
        end
    end
end

-- Log de RemoteEvent/RemoteFunction chamados pelo jogador (via hook __namecall)
genv.RouteHubRemoteLogger = nil
local function remoteLogger(remote, method, args)
    if not Recorder.active or State.mode == "replay" then return end
    local ok = pcall(function()
        if typeof(remote) ~= "Instance" then return end
        if not (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then return end
        local list = {}
        for i = 1, args.n do list[i] = ser(args[i]) end
        Recorder.add("Remote", { p = instPath(remote), m = method, n = args.n, a = list, nm = remote.Name })
    end)
    return ok
end

local function installRemoteHook()
    if genv.RouteHubHookInstalled then return true end
    if not (API.hookmetamethod and API.getnamecallmethod) then return false end
    local wrap = API.newcclosure or function(f) return f end
    local old
    local ok = pcall(function()
        old = API.hookmetamethod(game, "__namecall", wrap(function(self, ...)
            local m = API.getnamecallmethod()
            if m == "FireServer" or m == "InvokeServer" then
                local lg = genv.RouteHubRemoteLogger
                if lg then
                    local args = table.pack(...)
                    task.defer(lg, self, m, args) -- fora do hook: não altera o namecall original
                end
            end
            return old(self, ...)
        end))
    end)
    if ok then genv.RouteHubHookInstalled = true end
    return ok
end

-- Fallback sem hookmetamethod: registra apenas OnClientEvent (informativo, não reproduzível)
function Recorder.bindRemoteFallback()
    task.spawn(function()
        local n = 0
        for _, o in ipairs(ReplicatedStorage:GetDescendants()) do
            if o:IsA("RemoteEvent") then
                Recorder.addConn(Recorder.conns, o.OnClientEvent, function(...)
                    local args = table.pack(...)
                    local list = {}
                    for i = 1, args.n do list[i] = ser(args[i]) end
                    Recorder.add("Remote", { p = instPath(o), m = "OnClientEvent", dir = "in", n = args.n, a = list, nm = o.Name })
                end)
            end
            n += 1
            if n % 1500 == 0 then task.wait() end
        end
    end)
end

function Recorder.bindClickDetectors()
    task.spawn(function()
        local n = 0
        local function hook(cd)
            Recorder.addConn(Recorder.conns, cd.MouseClick, function()
                Recorder.add("ClickDetector", { p = instPath(cd), ev = "MouseClick" })
            end)
        end
        for _, o in ipairs(workspace:GetDescendants()) do
            if o:IsA("ClickDetector") then pcall(hook, o) end
            n += 1
            if n % 1500 == 0 then task.wait() end
        end
        Recorder.addConn(Recorder.conns, workspace.DescendantAdded, function(o)
            if o:IsA("ClickDetector") then pcall(hook, o) end
        end)
    end)
end

function Recorder.start()
    if Recorder.active then return end
    Recorder.events = {}
    Recorder.animSummary = {}
    Recorder.seen = setmetatable({}, { __mode = "k" })
    Recorder.boundTools = setmetatable({}, { __mode = "k" })
    Recorder.touches, Recorder.touchLast, Recorder.downSet, Recorder.keysDown = {}, {}, {}, {}
    Recorder.touchId = 0
    Recorder.t0 = os.clock()
    Recorder.lastMoveMs, Recorder.lastForceMs, Recorder.lastCamMs, Recorder.lastAnimMs = -1000, -1000, -1000, -1000
    Recorder.lastCF = nil
    Recorder.lastMD = Vector3.new(9, 9, 9)
    local hum = getHum()
    local ws = hum and hum.WalkSpeed or 16
    Recorder.baseWS = math.min(ws, 16)
    Recorder.lastWS = ws
    Recorder.active = true

    genv.RouteHubRemoteLogger = remoteLogger
    local hooked = installRemoteHook()
    if not hooked then Recorder.bindRemoteFallback() end

    local rep = Diag.report or genv.RouteHubDiag
    if not (rep and rep.clickDetectors == 0) then Recorder.bindClickDetectors() end

    local L = Recorder.conns
    Recorder.addConn(L, UIS.InputBegan, Recorder.onInputBegan)
    Recorder.addConn(L, UIS.InputEnded, Recorder.onInputEnded)
    Recorder.addConn(L, UIS.InputChanged, Recorder.onInputChanged)
    Recorder.addConn(L, RunService.RenderStepped, Recorder.sample)

    -- ProximityPrompt: hold / triggered
    local holds = {}
    Recorder.addConn(L, PPS.PromptButtonHoldBegan, function(prompt, plr)
        if plr ~= LocalPlayer then return end
        holds[prompt] = Recorder.add("PromptHold", { p = instPath(prompt), dur = prompt.HoldDuration, ph = "begin" })
    end)
    Recorder.addConn(L, PPS.PromptButtonHoldEnded, function(prompt, plr)
        if plr ~= LocalPlayer then return end
        local ev = holds[prompt]
        holds[prompt] = nil
        if ev then ev.data.dur = math.max((Recorder.t0 and (math.floor((os.clock() - Recorder.t0) * 1000) - ev.t)) / 1000, 0) end
    end)
    Recorder.addConn(L, PPS.PromptTriggered, function(prompt, plr)
        if plr ~= LocalPlayer then return end
        Recorder.add("PromptTriggered", { p = instPath(prompt), hd = prompt.HoldDuration })
    end)

    task.spawn(Recorder.bindCharacter, getChar())
    return true
end

function Recorder.stop()
    if not Recorder.active then return nil end
    local duration = math.floor((os.clock() - Recorder.t0) * 1000)
    Recorder.active = false
    for _, c in ipairs(Recorder.conns) do pcall(function() c:Disconnect() end) end
    Recorder.conns = {}
    Recorder.unbindChar()
    local anims = {}
    for _, s in pairs(Recorder.animSummary) do anims[#anims + 1] = s end
    table.sort(anims, function(a, b) return (a.t or 0) < (b.t or 0) end)
    local okG, guid = pcall(HttpService.GenerateGUID, HttpService, false)
    local route = {
        id = okG and guid or tostring(os.time()),
        name = "Rota_" .. os.time(),
        created = os.time(),
        duration = duration,
        count = #Recorder.events,
        events = Recorder.events,
        animations = anims,
        baseWalkSpeed = Recorder.baseWS,
        placeId = game.PlaceId,
    }
    Recorder.events = {}
    return route
end

--[[ === SEÇÃO 8: MÓDULO DE REPLAY === ]]
local Replay = { running = false, cancel = false, route = nil }
local RS = { move = Vector3.zero, camTarget = nil, camSet = false, heldKeys = {},
    pointerDown = {}, btnPos = {}, animCache = {}, recentHold = {}, origWS = nil, origCamType = nil }
local ReplayAnimPriorities = { Action = true, Action2 = true, Action3 = true, Action4 = true }
-- Prioridades Core/Idle/Movement não são reaplicadas: o script Animate do jogo já as toca pelo Move.
local ReplayStates = { Climbing = true, Swimming = true, GettingUp = true } -- estados seguros de reaplicar
local Exec = {}

local function guiCenterScreen(obj)
    local ap, as = obj.AbsolutePosition, obj.AbsoluteSize
    local sg = obj:FindFirstAncestorOfClass("ScreenGui")
    local inset = (sg and sg.IgnoreGuiInset) and Vector2.zero or GuiService:GetGuiInset()
    return ap.X + as.X / 2 + inset.X, ap.Y + as.Y / 2 + inset.Y
end

local function fireGuiButton(obj)
    if not API.getconnections then return end -- fallback: sem getconnections, só clique virtual
    for _, sigName in ipairs({ "MouseButton1Click", "Activated", "MouseButton1Down", "MouseButton1Up" }) do
        pcall(function()
            for _, c in ipairs(API.getconnections(obj[sigName])) do c:Fire() end
        end)
    end
end

local function pointerPos(ev, key)
    local d = ev.data
    if d.phase == "down" and d.btn then
        local obj = resolvePath(d.btn)
        if obj and obj:IsA("GuiObject") then
            local x, y = guiCenterScreen(obj)
            RS.btnPos[key] = { x, y, obj }
            return x, y, obj
        end
    elseif d.phase ~= "down" and RS.btnPos[key] then
        local p = RS.btnPos[key]
        return p[1], p[2], p[3]
    end
    local vp = cam().ViewportSize
    return d.x * vp.X, d.y * vp.Y, nil
end

local function sendPointer(ev, isTouch)
    local d = ev.data
    local key = ev.type .. tostring(d.id or d.b or 0)
    local x, y, obj = pointerPos(ev, key)
    if d.phase == "up" then RS.btnPos[key] = nil; RS.pointerDown[key] = nil end
    if not VIM then
        if obj and d.phase == "down" then fireGuiButton(obj) end -- fallback sem VirtualInputManager
        return
    end
    if d.phase == "down" then RS.pointerDown[key] = { x = x, y = y, touch = isTouch, b = d.b, id = d.id } end
    if isTouch then
        local state = (d.phase == "down" and 0) or (d.phase == "move" and 1) or 2
        local ok = pcall(function() VIM:SendTouchEvent(d.id or 0, state, x, y) end)
        if ok then return end
    end
    if d.phase == "move" then
        pcall(function() VIM:SendMouseMoveEvent(x, y, game) end)
        return
    end
    pcall(function() VIM:SendMouseButtonEvent(x, y, (d.b or 1) - 1, d.phase == "down", game, 0) end)
end

function Exec.Move(ev)
    local d = ev.data
    RS.move = Vector3.new(d.d[1], d.d[2], d.d[3])
    local hum = getHum()
    if hum and d.ws and math.abs(hum.WalkSpeed - d.ws) > 0.01 then hum.WalkSpeed = d.ws end
end

function Exec.Sprint(ev)
    local hum = getHum()
    if hum then hum.WalkSpeed = ev.data.ws end
end

function Exec.Jump(ev)
    local hum = getHum()
    if hum then hum.Jump = true end
end

function Exec.Camera(ev)
    local c = cam()
    if not c then return end
    if not RS.camSet then
        RS.origCamType = c.CameraType
        c.CameraType = Enum.CameraType.Scriptable
        RS.camSet = true
        c.CFrame = CFrame.new(unpack(ev.data.c))
    end
    RS.camTarget = CFrame.new(unpack(ev.data.c))
end

function Exec.KeyDown(ev)
    if ev.data.gp or not VIM then return end -- sem VirtualInputManager: tecla não reproduzível
    local kc = Enum.KeyCode[ev.data.k]
    if not kc then return end
    RS.heldKeys[ev.data.k] = true
    VIM:SendKeyEvent(true, kc, false, game)
end

function Exec.KeyUp(ev)
    if ev.data.gp or not VIM then return end
    local kc = Enum.KeyCode[ev.data.k]
    if not kc then return end
    RS.heldKeys[ev.data.k] = nil
    VIM:SendKeyEvent(false, kc, false, game)
end

function Exec.Click(ev) sendPointer(ev, false) end
function Exec.Touch(ev) sendPointer(ev, true) end

function Exec.Animation(ev)
    local d = ev.data
    if not ReplayAnimPriorities[d.pr] or not d.id or d.id == "" then return end
    local hum = getHum()
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    local track = RS.animCache[d.id]
    if not track then
        local a = Instance.new("Animation")
        a.AnimationId = d.id
        track = animator:LoadAnimation(a)
        RS.animCache[d.id] = track
    end
    pcall(function() track.Priority = Enum.AnimationPriority[d.pr] end)
    track:Stop(0)
    track:Play(0.1, d.w or 1, d.sp or 1)
end

function Exec.Remote(ev)
    local d = ev.data
    if d.dir == "in" then return end -- evento recebido do servidor: não reproduzível
    local remote = resolvePath(d.p)
    if not remote then return end
    local args = {}
    for i = 1, d.n or 0 do args[i] = deser(d.a[i]) end
    if d.m == "InvokeServer" and remote:IsA("RemoteFunction") then
        task.spawn(function() pcall(function() remote:InvokeServer(unpack(args, 1, d.n or 0)) end) end)
    elseif remote:IsA("RemoteEvent") then
        remote:FireServer(unpack(args, 1, d.n or 0))
    end
end

function Exec.PromptHold(ev)
    local prompt = resolvePath(ev.data.p)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    RS.recentHold[prompt] = os.clock()
    local dur = (ev.data.dur or prompt.HoldDuration) / math.max(S.speedMultiplier, 0.01)
    task.spawn(function()
        local ok = pcall(function() prompt:InputHoldBegin() end)
        if not ok and API.fireproximityprompt then
            pcall(API.fireproximityprompt, prompt)
            return
        end
        task.wait(math.max(dur, 0.05))
        pcall(function() prompt:InputHoldEnd() end)
    end)
end

function Exec.PromptTriggered(ev)
    local prompt = resolvePath(ev.data.p)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    local last = RS.recentHold[prompt]
    if last and os.clock() - last < 2 + prompt.HoldDuration then return end -- o hold já dispara o prompt
    if API.fireproximityprompt then
        API.fireproximityprompt(prompt)
    else
        prompt:InputHoldBegin() -- fallback sem fireproximityprompt
        task.wait()
        prompt:InputHoldEnd()
    end
end

function Exec.ClickDetector(ev)
    local cd = resolvePath(ev.data.p)
    if cd and API.fireclickdetector then API.fireclickdetector(cd) end -- sem fireclickdetector: ignorado
end

function Exec.TouchPart(ev)
    local part, root = resolvePath(ev.data.p), getRoot()
    if part and root and API.firetouchinterest then
        API.firetouchinterest(root, part, 0)
        task.wait()
        API.firetouchinterest(root, part, 1)
    end
end

local function findTool(name)
    local char = getChar()
    local t = char and char:FindFirstChild(name)
    if t and t:IsA("Tool") then return t end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    t = bp and bp:FindFirstChild(name)
    if t and t:IsA("Tool") then return t end
    return nil
end

function Exec.ToolActivated(ev)
    local d, hum = ev.data, getHum()
    if d.ev == "Equipped" then
        local tool = findTool(d.n)
        if tool and hum then hum:EquipTool(tool) end
    elseif d.ev == "Unequipped" then
        if hum then hum:UnequipTools() end
    else
        local tool = findTool(d.n)
        if tool then tool:Activate() end
    end
end

function Exec.StateChange(ev)
    local hum = getHum()
    if hum and ReplayStates[ev.data.s] then
        hum:ChangeState(Enum.HumanoidStateType[ev.data.s])
    end
end

local function replayRelease()
    if VIM then
        for key in pairs(RS.heldKeys) do
            pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode[key], false, game) end)
        end
        for _, p in pairs(RS.pointerDown) do
            pcall(function()
                if p.touch then VIM:SendTouchEvent(p.id or 0, 2, p.x, p.y)
                else VIM:SendMouseButtonEvent(p.x, p.y, (p.b or 1) - 1, false, game, 0) end
            end)
        end
    end
    RS.heldKeys, RS.pointerDown, RS.btnPos = {}, {}, {}
    for _, tr in pairs(RS.animCache) do pcall(function() tr:Stop(0.1) end) end
    RS.animCache = {}
    RS.move = Vector3.zero
    RS.recentHold = {}
end

local function replayBegin()
    local hum = getHum()
    RS.origWS = hum and hum.WalkSpeed
    RS.camSet, RS.camTarget = false, nil
    pcall(function() RunService:UnbindFromRenderStep("RouteHubReplay") end)
    RunService:BindToRenderStep("RouteHubReplay", Enum.RenderPriority.Last.Value, function()
        local h = getHum()
        if h then pcall(function() h:Move(RS.move, false) end) end
        if RS.camTarget then
            local c = cam()
            if c then c.CFrame = c.CFrame:Lerp(RS.camTarget, 0.6) end
        end
    end)
end

local function replayEnd()
    pcall(function() RunService:UnbindFromRenderStep("RouteHubReplay") end)
    replayRelease()
    local hum = getHum()
    if hum then
        pcall(function() hum:Move(Vector3.zero, false) end)
        if RS.origWS then hum.WalkSpeed = RS.origWS end
    end
    local c = cam()
    if c and RS.camSet then
        c.CameraType = RS.origCamType or Enum.CameraType.Custom
    end
    RS.camSet, RS.camTarget = false, nil
end

-- Uma passada completa pela rota. Retorna true se terminou sem cancelar
function Replay.pass(events, duration)
    replayRelease()
    local idx, startClock, lastUI = 1, os.clock(), 0
    local errs = 0
    while not Replay.cancel do
        local now = (os.clock() - startClock) * S.speedMultiplier * 1000
        while idx <= #events and events[idx].e.t <= now do
            local ev = events[idx].e
            idx += 1
            local fn = Exec[ev.type]
            if fn then
                local ok = pcall(fn, ev)
                if not ok then errs += 1 end -- erro por evento não interrompe o replay
            end
            if S.actionDelayMs > 0 then
                local w = task.wait(S.actionDelayMs / 1000)
                startClock += w -- pausa a linha do tempo durante o delay extra
            end
        end
        if os.clock() - lastUI > 0.1 then
            lastUI = os.clock()
            UI.setProgress(duration > 0 and math.clamp(now / duration, 0, 1) or 1,
                string.format("%s / %s", fmtTime(math.min(now, duration)), fmtTime(duration)))
        end
        if idx > #events and now >= duration then break end
        RunService.Heartbeat:Wait()
    end
    return not Replay.cancel, errs
end

function Replay.run(route)
    if Replay.running or Recorder.active then return end
    if type(route) ~= "table" or type(route.events) ~= "table" then return end
    Replay.running, Replay.cancel, Replay.route = true, false, route
    UI.setMode("replay")
    UI.showProgress(true)
    local tStart = os.clock()

    local events = {}
    for i, e in ipairs(route.events) do events[i] = { i = i, e = e } end
    table.sort(events, function(a, b)
        if a.e.t == b.e.t then return a.i < b.i end
        return a.e.t < b.e.t
    end)
    local duration = route.duration or (events[#events] and events[#events].e.t) or 0

    replayBegin()
    local totalErrs = 0
    repeat
        local finished, errs = Replay.pass(events, duration)
        totalErrs += errs or 0
        if finished and S.loopReplay and not Replay.cancel then task.wait(0.25) end
    until Replay.cancel or not S.loopReplay
    replayEnd()

    warn(string.format("[REPLAY] Finalizado em %.1fs", os.clock() - tStart))
    if totalErrs > 0 then Toast.show(totalErrs .. " evento(s) falharam no replay", "error") end
    Replay.running = false
    UI.showProgress(false)
    UI.setMode("idle")
end

function Replay.start(route)
    if Replay.running then return end
    if Recorder.active then Toast.show("Pare a gravação antes de reproduzir", "error") return end
    task.spawn(Replay.run, route)
end

function Replay.stop()
    if Replay.running then Replay.cancel = true end
end

--[[ === SEÇÃO 9: CONSTRUÇÃO DA UI === ]]
local function makeToggle(parent, text, init, onChange)
