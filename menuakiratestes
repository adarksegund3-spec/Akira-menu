local views = {}
local function createView(name)
    local v = create("Frame", {
        Name = name,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Visible = false,
    }, content)
    views[name] = v
    return v
end
local function showView(name)
    for n, v in pairs(views) do
        v.Visible = (n == name)
    end
end

