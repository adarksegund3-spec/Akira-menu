local function pathGet(root, names)
    local cur = root
    for _, n in ipairs(names) do
        if not cur then return nil end
        cur = cur:FindFirstChild(n)
    end
    return cur
end

local function finishRun()
    mode.enabled = false
    diagFinish()
    refresh()
    task.spawn(function()
        task.wait(0.4)
        local pg = player:FindFirstChild("PlayerGui")
        local pause = pg and pathGet(pg, {"AtividadesFisicas", "Main", "Background", "Infos", "Pause"})
        if not (pause and pause:IsA("GuiButton")) then
            pause = findButton({target = "pausar", exact = false})
        end
        if pause then
            clickAll(pause)
            task.wait(0.5)
        end
        local closeBtn = pg and pathGet(pg, {"AtividadesFisicas", "Main", "Background", "Close"})
        if closeBtn and closeBtn:IsA("GuiButton") then
            clickAll(closeBtn)
        end
    end)
end

-- cada ciclo roda numa thread separada (nao trava o loop nem o jogo)
local lastRefresh = 0

-- Se no PC nao achar bolha nenhuma por 4s, copia um relatorio pra area de transferencia
-- (e imprime no console F9) pra colar no chat e eu ver o que o jogo mostra de verdade.
local function dumpDiagnostic()
    local U = UserInputService
    local lines = {}
    table.insert(lines, "== Atividades fisicas: diagnostico ==")
    table.insert(lines, "plataforma: " .. (IS_MOBILE and "MOBILE" or (IS_CONSOLE and "CONSOLE" or "PC"))
        .. " | touch=" .. tostring(U.TouchEnabled) .. " teclado=" .. tostring(U.KeyboardEnabled)
        .. " mouse=" .. tostring(U.MouseEnabled) .. " gamepad=" .. tostring(U.GamepadEnabled))
    table.insert(lines, "executor: getconnections=" .. tostring(getconnections ~= nil)
        .. " firesignal=" .. tostring(firesignal ~= nil)
        .. " mouse1click=" .. tostring(mouse1click ~= nil)
        .. " keypress=" .. tostring(keypress ~= nil)
        .. " setclipboard=" .. tostring(setclipboard ~= nil))
    table.insert(lines, "contador da cabeca achado: " .. tostring(findHeadLabel() ~= nil))
    local guis = {}
    local pg = player:FindFirstChild("PlayerGui")
    if pg then
        for _, g in ipairs(pg:GetChildren()) do
            if g:IsA("ScreenGui") and g ~= gui then
                table.insert(guis, g.Name .. (g.Enabled and "" or "(off)"))
            end
        end
        table.insert(lines, "ScreenGuis: " .. table.concat(guis, ", "))
        local n = 0
        for i, obj in ipairs(pg:GetDescendants()) do
            if i % 250 == 0 then task.wait() end
            if n >= 80 then break end
            if (obj:IsA("TextButton") or obj:IsA("TextLabel")) and not obj:IsDescendantOf(gui) then
                local txt = tostring(obj.Text)
                if txt ~= "" and #txt <= 24 and isVisible(obj) then
                    n = n + 1
                    local path = string.gsub(obj:GetFullName(), "^.-PlayerGui%.", "")
                    table.insert(lines, obj.ClassName .. " | " .. path .. " | '" .. txt .. "'")
                end
            end
        end
    end
    local text = table.concat(lines, "\n")
    print(text)
    local copied = false
    pcall(function()
        if setclipboard then
            setclipboard(text)
            copied = true
        elseif toclipboard then
            toclipboard(text)
            copied = true
        end
    end)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Atividades f\195\173sicas",
            Text = copied and "N\195\163o achei a bolha. Diagn\195\179stico copiado: cole no chat." or "N\195\163o achei a bolha. Veja o console (F9).",
            Duration = 8,
        })
    end)
end

local function cycle()
    -- confere (sem bloquear) se o metodo atual esta funcionando; troca apos 1s sem resultado
    judgeMethod()
    diagState.hasHead = findHeadLabel() ~= nil

    -- 0) CONFERE O ULTIMO CLIQUE: se o contador da cabeca subiu, o jogo contou e a bolha fica marcada
    --    como "contada" (nunca mais clicada). Se nao subiu, a bolha continua elegivel e e clicada de
    --    novo depois de RECLICK_AFTER, enquanto ainda estiver na tela. Isso NAO mexe no ritmo
    --    (lastClick), entao a proxima bolha nova nunca e atrasada por causa de um reteste.
    if lastClicked then
        local h = readHead()
        if h ~= nil and lastClicked.head ~= nil and h ~= lastClicked.head then
            if lastClicked.info then lastClicked.info.counted = true end
            lastClicked = nil
        elseif os.clock() - lastClicked.t > 1.5 then
            lastClicked = nil
        end
    end

    -- 1) detecta a bolha SEMPRE, antes de qualquer espera/retorno, para marcar o instante exato
    --    em que ela apareceu (PC: se nao ha "tap", procura bolha de tecla Q/E)
    local btn = getButton()
    local keyBtn, key
    if not btn and IS_PC then
        keyBtn, key = getKeyBubble()
        if keyBtn then diagState.lastPath = "tecla" end
    end
    local now = os.clock()
    local seen = btn or (keyBtn and key and keyBtn) or nil
    do
        local sObj = btn or keyBtn
        if sObj then
            local si = registerBubble(sObj)
            local okS, sz = pcall(function() return sObj.AbsoluteSize.X end)
            if okS and sz then
                if sz >= (si.sizeMax or 0) then
                    si.sizeMax = sz
                    si.tMax = now
                end
                si.size = sz
            end
            if not si.validAt then si.validAt = now end
        end
    end
    if seen ~= seenObj then
        seenObj = seen
        seenAt = now
        clickedSeen = false
    end
    if seen and bubbleInfo[seen] then bubbleInfo[seen].chosen = true end

    -- 2) depois de um clique com limite, espera o contador da cabeca mostrar o novo valor
    --    (assim nunca passa da quantidade escolhida). Espera curta: nao deixa a proxima bolha passar.
    if awaiting then
        local h = readHead()
        if h ~= nil and h ~= awaiting.head then
            awaiting = nil
        elseif now - awaiting.t > 0.35 then
            awaiting = nil
        else
            local si = seen and bubbleInfo[seen]
            if si then
                si.waitDue = 0.35 - (now - awaiting.t)
                si.waitWhy = "contador"
                si.waitUrgent = false
            end
            return
        end
    end

    -- 3) chegou na quantidade? para ANTES de clicar de novo
    local p = progress()
    if mode.limit and p >= mode.limit then
        finishRun()
        return
    end

    -- 4) RITMO DO AUTO JJs ANTIGO: depois de cada clique espera o intervalo (Delay mostrado = segundos
    --    reais entre cliques, minimo 0.6). A bolha nova e clicada assim que o intervalo termina.
    --    Se a bolha vai sumir antes disso (urgente), o clique sai antes, com intervalo minimo menor.
    local urgent = false
    if seen then
        local gap = mode.delay - SPEED_OFFSET
        -- calibrado: se as bolhas nascem mais rapido que o Delay, acompanha o nascimento (piso 0.6s)
        if calibCadence and bubbleInfo[seen] then
            gap = math.min(gap, math.max(MIN_DELAY, calibCadence - 0.05))
        end
        -- reclique (clique anterior nao contou): nao espera o Delay inteiro, a bolha esta morrendo
        local sinfo = bubbleInfo[seen]
        if sinfo and sinfo.clicks > 0 then
            gap = math.min(gap, RECLICK_AFTER)
        end
        local due = lastClick + gap
        if now < due and sinfo then
            urgent = bubbleUrgent(seen, due - now)
            if urgent then
                gap = math.min(gap, URGENT_GAP)
                due = lastClick + gap
            end
        end
        if now < due then
            if sinfo then
                sinfo.waitDue = due - now
                sinfo.waitWhy = "ritmo"
                sinfo.waitUrgent = urgent
            end
            noBubbleSince = nil
            return
        end
    end

    if not (btn or (keyBtn and key)) then
        if (not IS_MOBILE) and not dumped then
            if not noBubbleSince then
                noBubbleSince = now
            elseif now - noBubbleSince > 4 then
                dumped = true
                if DEBUG then task.spawn(dumpDiagnostic) end
            end
        end
    end
    if btn or (keyBtn and key) then
        noBubbleSince = nil
        local headBefore = readHead()
        local t0 = os.clock()
        local okClick = true
        local pre = seen and bubbleInfo[seen]
        local wasRetry = pre ~= nil and pre.clicks > 0
        local prevReal = diagState.realLast or 0
        local hasSecond = scanSecond ~= nil and scanSecond ~= btn
        if btn then
            lastMode = "tap"
            okClick = clickSmart(btn)
        else
            lastMode = "tecla"
            pressSmart(key, keyBtn)
        end
        if okClick == false then return end
        if urgent then diag.urgent = diag.urgent + 1 end
        if wasRetry then diag.retries = diag.retries + 1 end
        diagState.realLast = t0
        if DEBUG and t0 - prevReal < 0.55 then
            logEvent(string.format("CLIQUE_RAPIDO t=%.1fs intervalo=%.2fs urgente=%s reclique=%s segunda_na_tela=%s",
                t0 - diagState.t0, t0 - prevReal, tostring(urgent), tostring(wasRetry), tostring(hasSecond)))
        end
        local binfo = seen and bubbleInfo[seen]
        if binfo then
            binfo.waitDue = nil
            if not binfo.clicked then
                binfo.clicked = true
                diag.clicked = diag.clicked + 1
                local late = t0 - math.max(binfo.seenAt, lastClick + (mode.delay - SPEED_OFFSET))
                if late < 0 then late = 0 end
                diag.lateSum = diag.lateSum + late
                if late > diag.lateMax then diag.lateMax = late end
                pcall(calibNote, binfo, t0)
            end
            binfo.clicks = binfo.clicks + 1
            binfo.clickedAt = t0
        end
        lastClick = t0
        if scanSecond and scanSecond ~= btn then
            lastClick = t0 - (mode.delay - SPEED_OFFSET) + MIN_GAP
        end
        clickedSeen = true
        lastClicked = {info = binfo, t = t0, head = headBefore}
        do
            local pth = diagState.lastPath or "?"
            diagState.paths[pth] = (diagState.paths[pth] or 0) + 1
        end
        if mode.limit and headBefore ~= nil then
            awaiting = {head = headBefore, t = t0}
        end
        if lastClick - lastRefresh > 0.25 then
            lastRefresh = lastClick
            refresh()
        end
    end
end

-- DETECTOR RAPIDO: roda em todo Heartbeat e todo RenderStepped (o mais rapido que o Roblox permite,
-- 2 checagens por frame) e tambem no mesmo instante em que uma bolha nasce. So clica no ritmo do delay.
local busy = false
local lastTickAt = os.clock()
local function tick()
    local nowT = os.clock()
    local dt = nowT - lastTickAt
    lastTickAt = nowT
    -- registra travadas de frame (lag do jogo/executor) para o log
    if mode.enabled and dt > 0.25 and dt < 10 then
        diagState.stall = {at = nowT, len = dt}
        diagState.stalls = diagState.stalls + 1
        if dt > diagState.stallMax then diagState.stallMax = dt end
    end
    if busy or not running or not mode.enabled then return end
    busy = true
    pcall(cycle)
    busy = false
end
table.insert(connections, RunService.Heartbeat:Connect(function() tick() end))
pcall(function()
    table.insert(connections, RunService.RenderStepped:Connect(function() tick() end))
end)

