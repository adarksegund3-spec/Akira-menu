    RenamePopup.Visible = false
end)

RenameOK.MouseButton1Click:Connect(function()
    local name = RenameBox.Text
    if name == "" then name = "Rota_" .. os.date("%H%M%S") end
    local baseName = name
    local counter = 2
    while savedRoutes[name] do
        name = baseName .. "_" .. counter
        counter = counter + 1
    end

    savedRoutes[name] = {
        Duracao = timerFrozen,
        Pontos = #recordedData,
        Data = recordedData
    }

    RenamePopup.Visible = false
    StatusLabel.Text = "Salvo: " .. name
    switchTab("data")
end)

