local function tween(o,t,p,s,d)
    local ti = TweenInfo.new(t or 0.2, s or Enum.EasingStyle.Quad, d or Enum.EasingDirection.Out)
    local tw = TweenService:Create(o, ti, p); tw:Play(); return tw
