-- Helpers
local function getHRP()
    local c = LocalPlayer.Character
    if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local c = LocalPlayer.Character
    if not c then return nil end
    return c:FindFirstChildOfClass("Humanoid")
end

local function salvarPosicao()
    local hrp = getHRP()
    if not hrp then return false end
    posicaoSalva = hrp.Position
    return true
end

local function pararMovimento()
    andandoAtivo = false
    local hum = getHumanoid()
    if hum then
        hum.WalkSpeed = 16
        local hrp = getHRP()
        if hrp then pcall(function() hum:MoveTo(hrp.Position) end) end
    end
end

local function comecarCaminhada()
    if andandoAtivo then return end
    if not posicaoSalva then return end
    andandoAtivo = true

    task.spawn(function()
        local tempoParado = 0
        local ultimaPos = nil

        while andandoAtivo do
            local char = LocalPlayer.Character
            local hum = getHumanoid()
            local hrp = getHRP()

            if not char or not hum or not hrp or hum.Health <= 0 then
                pararMovimento()
                break
            end

            hum.WalkSpeed = speedWalk

            local posAtual = hrp.Position
            local dist = (posAtual - posicaoSalva).Magnitude

            if dist <= chegadaDist then
                pararMovimento()
                break
            end

            local direcao = (posicaoSalva - posAtual)
            local wp
            if direcao.Magnitude <= waypointDist then
                wp = posicaoSalva
            else
                wp = posAtual + direcao.Unit * waypointDist
            end

            pcall(function() hum:MoveTo(wp) end)

            if ultimaPos then
                local moveu = (posAtual - ultimaPos).Magnitude
                if moveu < 0.5 then
                    tempoParado = tempoParado + 0.1
                    if tempoParado > 2 then
                        local lat = Vector3.new(direcao.Unit.Z, 0, -direcao.Unit.X)
                        pcall(function() hum:MoveTo(posAtual + lat * 15 + direcao.Unit * 10) end)
                        tempoParado = 0
                    end
                else
                    tempoParado = 0
                end
            end
            ultimaPos = posAtual

            task.wait(0.1)
        end
    end)
end

