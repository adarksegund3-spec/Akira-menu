-- ══════════════════════════════════════════════════════════
-- UIs ALTERNATIVAS — troca o menu COMPLETO (todas as abas/funções) por
-- outra biblioteca de interface. Os itens vêm do gravador (State.spec),
-- então qualquer função nova adicionada via C.button/C.toggle/C.slider/
-- C.input/C.section aparece automaticamente em todas as UIs.
-- ══════════════════════════════════════════════════════════
do
    State.specFrozen = true
    local BRAND, BY = "AKZ HUB", "by Akira / Angel"
    local NATIVE = "AKZ HUB"
    local ext = {gui = {}, destroyers = {}, hidden = false}
    local curUI, busy = NATIVE, false

    local function stepOf(it) return ((it.max - it.min) <= 10) and 0.1 or 1 end

    -- ───────── monta a lista de abas (completa) ─────────
    local UIL = {}
    local function buildTabs(target)
        local tabs = {}
        local sw = {{k = "section", title = "Interface atual: " .. target}}
        for _, u in ipairs(UIL) do
            if u.name ~= target then
                sw[#sw + 1] = {k = "button",
                    text = (u.name == NATIVE) and "↩ Voltar ao AKZ HUB original (Jogos / Status)" or ("Trocar para " .. u.name),
                    cb = function() task.delay(0.15, function() State.uiSwitch(u.name) end) end}
            end
        end
        tabs[1] = {name = "Interface", items = sw}
        for _, name in ipairs(State.tabOrder or {}) do
            local items, clean = State.spec[name] or {}, {}
            for i, it in ipairs(items) do
                if it.k == "section" then
                    local nx = items[i + 1]
                    if nx and nx.k ~= "section" then clean[#clean + 1] = it end   -- ignora seções vazias
                else
                    clean[#clean + 1] = it
                end
            end
            if name == "Principal" then
                table.insert(clean, 1, {k = "button", text = "Entrar no Discord (convite)",
                    cb = function() if State.openDiscord then State.openDiscord() end end})
                table.insert(clean, 1, {k = "section", title = "Discord"})
            end
            if #clean > 0 then tabs[#tabs + 1] = {name = name, items = clean} end
        end
        return tabs
    end

    -- ───────── driver genérico: percorre os itens e chama o adaptador ─────────
    local function drive(h, tabs)
        local n = 0
        for _, t in ipairs(tabs) do
            local okT, tobj = pcall(h.tab, t.name)
            if okT and tobj then
                local ctx = (h.root and h.root(tobj)) or tobj
                for _, it in ipairs(t.items) do
                    local ok, e = pcall(function()
                        if it.k == "section" then
                            if h.section then ctx = h.section(tobj, it.title) or ctx end
                        elseif it.k == "button" then h.button(ctx, it)
                        elseif it.k == "toggle" then h.toggle(ctx, it)
                        elseif it.k == "slider" then h.slider(ctx, it)
                        elseif it.k == "input" then if h.input then h.input(ctx, it) end end
                    end)
                    if not ok then warn("[AKZ UI] " .. t.name .. " / " .. tostring(it.text or it.title) .. ": " .. tostring(e)) end
                    n = n + 1
                    if n % 15 == 0 then task.wait() end
                end
            else
                warn("[AKZ UI] falha ao criar aba " .. tostring(t.name) .. ": " .. tostring(tobj))
            end
        end
    end

    local function get(url) return loadstring(game:HttpGet(url, true))() end
    local uid = 0
    local function nextId(p) uid = uid + 1; return (p or "akz") .. uid end

    -- ───────── ADAPTADORES ─────────
    local function kavo(theme)
        return function(tabs)
            local Kavo = get("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua")
            local W = Kavo.CreateLib(BRAND .. " — " .. BY, theme)
            drive({
                tab = function(n) local t = W:NewTab(n); return {t = t, s = t:NewSection(n)} end,
                root = function(o) return o.s end,
                section = function(o, title) return o.t:NewSection(title) end,
                button = function(c, it) c:NewButton(it.text, "", function() it.cb() end) end,
                toggle = function(c, it) c:NewToggle(it.text, "", function(v) it.cb(v) end) end,
                slider = function(c, it)
                    local k = (stepOf(it) < 1) and 10 or 1
                    c:NewSlider(it.text, "", math.floor(it.max * k), math.floor(it.min * k), function(v) it.cb(v / k) end)
                end,
                input = function(c, it) c:NewTextBox(it.text, "", function(v) it.cb(v) end) end,
            }, tabs)
        end
    end

    UIL = {
        {name = NATIVE, tag = "padrão"},

        {name = "Rayfield", tag = "Sirius", build = function(tabs)
            local R = get("https://sirius.menu/rayfield")
            local W = R:CreateWindow({Name = BRAND, LoadingTitle = BRAND, LoadingSubtitle = BY,
                ConfigurationSaving = {Enabled = false}, KeySystem = false})
            ext.destroyers[#ext.destroyers + 1] = function() R:Destroy() end
            drive({
                tab = function(n) return W:CreateTab(n, 4483362458) end,
                section = function(t, title) t:CreateSection(title); return t end,
                button = function(t, it) t:CreateButton({Name = it.text, Callback = function() it.cb() end}) end,
                toggle = function(t, it) t:CreateToggle({Name = it.text, CurrentValue = it.state,
                    Callback = function(v) it.cb(v) end}) end,
                slider = function(t, it) t:CreateSlider({Name = it.text, Range = {it.min, it.max}, Increment = stepOf(it),
                    Suffix = "", CurrentValue = it.val, Callback = function(v) it.cb(v) end}) end,
                input = function(t, it) t:CreateInput({Name = it.text, PlaceholderText = it.text,
                    RemoveTextAfterFocusLost = false, Callback = function(v) it.cb(v) end}) end,
            }, tabs)
        end},

        {name = "Luna", tag = "Nebula", build = function(tabs)
            local Luna = get("https://raw.githubusercontent.com/Nebula-Softworks/Luna-Interface-Suite/refs/heads/main/source.lua")
            local W = Luna:CreateWindow({Name = BRAND, Subtitle = BY, LoadingEnabled = false,
                LoadingTitle = BRAND, LoadingSubtitle = BY,
                ConfigSettings = {RootFolder = nil, ConfigFolder = "AKZHub"}, KeySystem = false})
            ext.destroyers[#ext.destroyers + 1] = function() Luna:Destroy() end
            drive({
                tab = function(n) return W:CreateTab({Name = n, Icon = "build", ImageSource = "Material", ShowTitle = true}) end,
                section = function(t, title) t:CreateSection(title); return t end,
                button = function(t, it) t:CreateButton({Name = it.text, Callback = function() it.cb() end}) end,
                toggle = function(t, it) t:CreateToggle({Name = it.text, CurrentValue = it.state,
                    Callback = function(v) it.cb(v) end}) end,
                slider = function(t, it) t:CreateSlider({Name = it.text, Range = {it.min, it.max}, Increment = stepOf(it),
                    CurrentValue = it.val, Callback = function(v) it.cb(v) end}) end,
                input = function(t, it) t:CreateInput({Name = it.text, PlaceholderText = it.text, CurrentValue = it.val or "",
                    Numeric = false, Enter = true, Callback = function(v) it.cb(v) end}) end,
            }, tabs)
        end},

        {name = "Fluent", tag = "dawid-scripts", build = function(tabs)
            local Fluent = get("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua")
            local vp = getViewport()
            local W = Fluent:CreateWindow({Title = BRAND, SubTitle = BY, TabWidth = 130,
                Size = UDim2.fromOffset(math.clamp(vp.X - 60, 300, 520), math.clamp(vp.Y - 80, 220, 360)),
                Acrylic = false, Theme = "Dark", MinimizeKey = Enum.KeyCode.LeftControl})
            ext.destroyers[#ext.destroyers + 1] = function() Fluent:Destroy() end
            drive({
                tab = function(n) return W:AddTab({Title = n, Icon = ""}) end,
                section = function(t, title) return t:AddSection(title) end,
                button = function(c, it) c:AddButton({Title = it.text, Description = "", Callback = function() it.cb() end}) end,
                toggle = function(c, it) c:AddToggle(nextId("t"), {Title = it.text, Default = it.state,
                    Callback = function(v) it.cb(v) end}) end,
