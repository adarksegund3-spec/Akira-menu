    local function parseRotas(d,prefixo)
        local out={}
        local dc=d:gsub("\r\n","\n"):gsub("\r","\n")
        if not dc:find("\n") then dc=dc:gsub("("..prefixo..")","\n%1") end
        for l in dc:gmatch("[^\n]+") do
            local n,s=l:match("^([^|]+)|(.+)$")
            if n and s then
                local f={}
                for cc in s:gmatch("[^;]+") do
                    local x,y,z,t=cc:match("([^,]+),([^,]+),([^,]+),([^,]+)")
                    if x then
