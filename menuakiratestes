-- ============================================
-- 1) NOCLIP — com trava de queda
-- ============================================
local noclipConnection = nil
local colisaoOriginal = {}

local function ligarNoclip()
    if noclipConnection then return end
    noclipConnection = RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                if colisaoOriginal[p] == nil then
                    colisaoOriginal[p] = p.CanCollide
                end
                p.CanCollide = false
            end
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local v = hrp.AssemblyLinearVelocity
            if v.Y < -50 then
                hrp.AssemblyLinearVelocity = Vector3.new(v.X, -50, v.Z)
            end
        end
    end)
end

local function desligarNoclip()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    for p, valor in pairs(colisaoOriginal) do
        if p.Parent then p.CanCollide = valor end
    end
    colisaoOriginal = {}
end

-- ============================================
-- 2) ANTI-PUXÃO EXTREMO (v6)
-- ============================================
local antiTpConnections = {}
local ultimoChar = nil
local ultimaPosicao = nil
local ultimoPulo = 0
local ultimaAltura = nil
local ultimoChaoY = nil

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function chaoAbaixo(char, hrp)
    rayParams.FilterDescendantsInstances = {char}
    local r = workspace:Raycast(hrp.Position, Vector3.new(0, -60, 0), rayParams)
    return r and r.Position.Y or nil
end

local espacoConn = UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Space then
        ultimoPulo = tick()
    end
end)

local function checarPuxao(dt)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and (hum.SeatPart or hum.Health <= 0) then
        ultimoChar = char
        ultimaPosicao = hrp.CFrame
        ultimaAltura = nil
        ultimoChaoY = nil
        return
    end

    if char ~= ultimoChar or not ultimaPosicao then
        ultimoChar = char
        ultimaPosicao = hrp.CFrame
        ultimaAltura = nil
        ultimoChaoY = nil
        return
    end

    if hum then
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Jumping then
            ultimoPulo = tick()
        end
    end

    local podeSubir = (tick() - ultimoPulo) < 1.0

    local v = hrp.AssemblyLinearVelocity
    local posAtual = hrp.Position
    local posAntiga = ultimaPosicao.Position

    -- 1) Mata velocidade forçada pra cima
    if not podeSubir and v.Y > 2 then
        hrp.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
        v = hrp.AssemblyLinearVelocity
    end

    -- 2) Mata teleporte instantâneo
    local deltaY = posAtual.Y - posAntiga.Y
    if not podeSubir and deltaY > 3 then
        hrp.CFrame = hrp.CFrame - Vector3.new(0, deltaY, 0)
        posAtual = hrp.Position
    end

    -- 3) Chão + altura
    local chaoY = chaoAbaixo(char, hrp)
    if chaoY then
        local altura = posAtual.Y - chaoY

        -- 3a) Puxão violento (flutuando alto)
        if not podeSubir and altura > 6 and v.Y >= 0 then
            hrp.CFrame = hrp.CFrame - Vector3.new(0, altura - 3, 0)
            hrp.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
            posAtual = hrp.Position
            altura = posAtual.Y - chaoY
        end

        -- 3b) Pull lento (altura cresce com chão parado)
        if ultimaAltura and ultimoChaoY and not podeSubir then
            local chaoEstavel = math.abs(chaoY - ultimoChaoY) < 2
            local alturaCresceu = (altura - ultimaAltura) > 4
            if chaoEstavel and alturaCresceu and v.Y > -0.5 then
                hrp.CFrame = hrp.CFrame - Vector3.new(0, altura - 3, 0)
                hrp.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
                posAtual = hrp.Position
                altura = posAtual.Y - chaoY
            end
        end

        ultimaAltura = altura
        ultimoChaoY = chaoY
    else
        ultimaAltura = nil
        ultimoChaoY = nil
    end

    ultimaPosicao = hrp.CFrame
end

local function ligarAntiTp()
    if #antiTpConnections > 0 then return end
    ultimoChar = nil
    ultimaPosicao = nil
    ultimaAltura = nil
    ultimoChaoY = nil
    ultimoPulo = 0
    table.insert(antiTpConnections, RunService.Heartbeat:Connect(checarPuxao))
end

local function desligarAntiTp()
    for _, c in ipairs(antiTpConnections) do c:Disconnect() end
    antiTpConnections = {}
    ultimoChar = nil
    ultimaPosicao = nil
    ultimaAltura = nil
    ultimoChaoY = nil
end

-- ============================================
-- 3) REMOVER TEXTO
-- ============================================
local textoConnections = {}
local textosOcultos = {}
local textoAtivo = false

local function normalizar(s)
    s = string.gsub(tostring(s), "<[^>]+>", "")
    s = string.gsub(s, "ã", "a")
    s = string.gsub(s, "Ã", "a")
    return string.lower(s)
end

local function contem(texto, palavra)
    return string.find(texto, palavra, 1, true) ~= nil
end

local function ehMensagemDePrisao(obj)
    local t = normalizar(obj.Text)
    local prisao = contem(t, "prisao") or contem(t, "preso") or contem(t, "prison") or contem(t, "jail")
    local regra = contem(t, "polichinelo") or contem(t, "minut")
    return prisao and regra
end

local function apagar(obj)
    if textosOcultos[obj] ~= nil then return end
    textosOcultos[obj] = obj.Visible
    obj.Visible = false
    table.insert(textoConnections, obj:GetPropertyChangedSignal("Visible"):Connect(function()
        if textoAtivo and obj.Visible then obj.Visible = false end
    end))
end

local function verificar(obj)
    if ehMensagemDePrisao(obj) then apagar(obj) end
end

local function observar(obj)
    if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and not obj:IsDescendantOf(ScreenGui) then
        verificar(obj)
        table.insert(textoConnections, obj:GetPropertyChangedSignal("Text"):Connect(function()
            verificar(obj)
        end))
    end
end

local function ligarRemoverTexto()
    if textoAtivo then return end
    textoAtivo = true
    for _, d in ipairs(PlayerGui:GetDescendants()) do
        observar(d)
    end
    table.insert(textoConnections, PlayerGui.DescendantAdded:Connect(observar))
end

local function desligarRemoverTexto()
    textoAtivo = false
    for _, c in ipairs(textoConnections) do
        c:Disconnect()
    end
    textoConnections = {}
    for obj, visivelOriginal in pairs(textosOcultos) do
        if obj.Parent then obj.Visible = visivelOriginal end
    end
    textosOcultos = {}
end

