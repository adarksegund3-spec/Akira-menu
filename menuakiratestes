-- ============================================================
-- CONFIG
-- ============================================================
local CONFIG = {
    SAVE_DIR = "RouteRecorderData",
    SAMPLE_RATE = 10,
    POSITION_THRESHOLD = 0.5,
}

local HAS_FILE_API = (typeof(writefile) == "function" and typeof(readfile) == "function")
if HAS_FILE_API and not isfolder(CONFIG.SAVE_DIR) then
    makefolder(CONFIG.SAVE_DIR)
end

-- ============================================================
-- TIPOS DE EVENTO
-- ============================================================
local EventType = {
    MOVE_CFRAME  = "MOVE_CFRAME",
    JUMP_START   = "JUMP_START",
    JUMP_LAND    = "JUMP_LAND",
    STATE_CHANGE = "STATE_CHANGE",
    ANIM_START   = "ANIM_START",
    ANIM_STOP    = "ANIM_STOP",
    INPUT_BEGIN  = "INPUT_BEGIN",
    INPUT_END    = "INPUT_END",
    CLICK_DETECT = "CLICK_DETECT",
}

local NON_REPLAYABLE = {
    [EventType.INPUT_BEGIN] = true,
    [EventType.INPUT_END] = true,
    [EventType.CLICK_DETECT] = true,
}

-- ============================================================
-- ESTADO CENTRAL — fonte única de verdade
-- ============================================================
local State = {
    selectedRoute = nil,      -- referência completa da rota
    listeners = {},           -- callbacks chamadas quando muda
}

function State:onChange(fn)
    table.insert(self.listeners, fn)
end

function State:select(route)
    self.selectedRoute = route
    for _, fn in ipairs(self.listeners) do
        pcall(fn, route)
    end
end

function State:refresh()
    -- re-emite a seleção atual (pra atualizar detalhes após edição)
    if self.selectedRoute then
        local updated = Store:getById(self.selectedRoute.id)
        if updated then
            self.selectedRoute = updated
        else
            self.selectedRoute = nil
        end
    end
    for _, fn in ipairs(self.listeners) do
        pcall(fn, self.selectedRoute)
    end
end

-- ============================================================
-- RECORDER
-- ============================================================
local Recorder = {}
Recorder.__index = Recorder

function Recorder.new()
    return setmetatable({
        events = {},
        recording = false,
        startTime = 0,
        conns = {},
        lastPos = nil,
        lastSample = 0,
        charConn = nil,
    }, Recorder)
end

function Recorder:_add(evtType, data)
    if not self.recording then return end
    table.insert(self.events, {
        t = tick() - self.startTime,
        type = evtType,
        data = data or {},
    })
end

function Recorder:_bindCharacter()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not hum or not root or not animator then return end

    self.lastPos = root.Position

    table.insert(self.conns, hum.StateChanged:Connect(function(_, new)
        self:_add(EventType.STATE_CHANGE, { state = new.Name })
        if new == Enum.HumanoidStateType.Jumping then
            self:_add(EventType.JUMP_START, { pos = root.Position })
        elseif new == Enum.HumanoidStateType.Landed then
            self:_add(EventType.JUMP_LAND, { pos = root.Position })
        end
    end))

    table.insert(self.conns, animator.AnimationPlayed:Connect(function(track)
        self:_add(EventType.ANIM_START, {
            id = track.Animation.AnimationId,
            startTime = track.TimePosition,
        })
        track.Stopped:Connect(function()
            self:_add(EventType.ANIM_STOP, { id = track.Animation.AnimationId })
        end)
    end))

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ClickDetector") then
            table.insert(self.conns, obj.MouseClick:Connect(function(player)
                if player == LocalPlayer then
                    self:_add(EventType.CLICK_DETECT, {
                        path = obj:GetFullName(),
                        pos = root.Position,
                    })
                end
            end))
        end
    end
end

function Recorder:start()
    if self.recording then return end
    self.events = {}
    self.recording = true
    self.startTime = tick()
    self.lastPos = nil
    self.lastSample = 0
    self.conns = {}

    self.charConn = LocalPlayer.CharacterAdded:Connect(function()
        task.wait(1)
        if self.recording then
            for _, c in ipairs(self.conns) do
                if c.Connected then c:Disconnect() end
            end
            self.conns = {}
            self:_bindCharacter()
        end
    end)

    self:_bindCharacter()

    table.insert(self.conns, UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        self:_add(EventType.INPUT_BEGIN, {
            userInputType = input.UserInputType.Name,
            keyCode = input.KeyCode.Name,
        })
    end))

    table.insert(self.conns, UserInputService.InputEnded:Connect(function(input)
        self:_add(EventType.INPUT_END, {
            userInputType = input.UserInputType.Name,
            keyCode = input.KeyCode.Name,
        })
    end))

    task.spawn(function()
        while self.recording do
            local elapsed = tick() - self.startTime
            if elapsed - self.lastSample >= (1 / CONFIG.SAMPLE_RATE) then
                self.lastSample = elapsed
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    local pos = root.Position
                    if not self.lastPos or (pos - self.lastPos).Magnitude > CONFIG.POSITION_THRESHOLD then
                        self:_add(EventType.MOVE_CFRAME, {
                            pos = { pos.X, pos.Y, pos.Z },
                            look = { root.CFrame.LookVector.X, root.CFrame.LookVector.Y, root.CFrame.LookVector.Z },
                        })
                        self.lastPos = pos
                    end
                end
            end
            task.wait()
        end
    end)
end

function Recorder:stop()
    if not self.recording then return nil end
    self.recording = false
    for _, c in ipairs(self.conns) do
        if c.Connected then c:Disconnect() end
    end
    self.conns = {}
    if self.charConn and self.charConn.Connected then
        self.charConn:Disconnect()
    end
    return {
        events = self.events,
        duration = tick() - self.startTime,
        count = #self.events,
    }
end

function Recorder:cancel()
    self.recording = false
    for _, c in ipairs(self.conns) do
        if c.Connected then c:Disconnect() end
    end
    self.conns = {}
    if self.charConn and self.charConn.Connected then
        self.charConn:Disconnect()
    end
    self.events = {}
end

-- ============================================================
-- STORE
-- ============================================================
local Store = {}
Store.__index = Store

function Store.new()
    local self = setmetatable({ routes = {}, nextId = 1 }, Store)
    self:loadAll()
    return self
end

function Store:_path(id) return CONFIG.SAVE_DIR .. "/" .. id .. ".json" end

function Store:loadAll()
    if not HAS_FILE_API or not isfolder(CONFIG.SAVE_DIR) then return end
    local ok, files = pcall(listfiles, CONFIG.SAVE_DIR)
    if not ok then return end
    for _, file in ipairs(files) do
        if file:sub(-5) == ".json" then
            local ok2, content = pcall(readfile, file)
            if ok2 then
                local ok3, data = pcall(HttpService.JSONDecode, HttpService, content)
                if ok3 and data and data.events then
                    table.insert(self.routes, {
                        id = data.id,
                        name = data.name or "Sem nome",
                        data = data,
                        createdAt = data.createdAt or 0,
                    })
                    local numId = tonumber((data.id or ""):match("%d+"))
                    if numId and numId >= self.nextId then
                        self.nextId = numId + 1
                    end
                end
            end
        end
    end
    table.sort(self.routes, function(a, b) return a.createdAt > b.createdAt end)
end

function Store:add(routeData)
    local id = "route_" .. string.format("%03d", self.nextId)
    local name = "Rota " .. string.format("%03d", self.nextId)
    self.nextId = self.nextId + 1
    local route = {
        id = id,
        name = name,
        data = {
            id = id,
            name = name,
            version = 1,
            createdAt = tick(),
            duration = routeData.duration,
            events = routeData.events,
        },
        createdAt = tick(),
    }
    table.insert(self.routes, 1, route)
    self:save(route)
    return route
end

function Store:save(route)
    if not HAS_FILE_API then return false end
    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, route.data)
    if not ok then return false end
    return (pcall(writefile, self:_path(route.id), encoded))
end

function Store:delete(id)
    for i, r in ipairs(self.routes) do
        if r.id == id then
            table.remove(self.routes, i)
            if HAS_FILE_API then pcall(delfile, self:_path(id)) end
            return true
        end
    end
    return false
end

function Store:rename(id, newName)
    for _, r in ipairs(self.routes) do
        if r.id == id then
            r.name = newName
            r.data.name = newName
            self:save(r)
            return true
        end
    end
    return false
end

function Store:duplicate(id)
    local orig = self:getById(id)
    if not orig then return nil end
    local copy = self:add({
        events = orig.data.events,
        duration = orig.data.duration,
    })
    self:rename(copy.id, orig.name .. " (cópia)")
    return self:getById(copy.id)
end

function Store:getById(id)
    for _, r in ipairs(self.routes) do
        if r.id == id then return r end
    end
    return nil
end

-- ============================================================
-- PLAYBACK
-- ============================================================
local Playback = {}
Playback.__index = Playback

function Playback.new()
    return setmetatable({
        playing = false,
        paused = false,
        speed = 1,
        route = nil,
        thread = nil,
        startTime = 0,
        pausedAt = 0,
        onFinish = nil,
    }, Playback)
end

function Playback:load(route) self.route = route end

function Playback:play()
    if not self.route then return false end
    if self.playing and not self.paused then return false end
    if self.paused then self:resume() return true end

    self.playing = true
    self.paused = false
    self.startTime = tick()
    self.pausedAt = 0

    self.thread = task.spawn(function()
        local events = self.route.data.events
        if #events == 0 then self.playing = false return end

        for _, evt in ipairs(events) do
            if not self.playing then break end
            local targetTime = evt.t / self.speed
            while (tick() - self.startTime) < targetTime do
                if not self.playing then break end
                if self.paused then
                    task.wait(0.05)
                    self.startTime = tick() - (self.pausedAt * self.speed)
                else
                    task.wait(0.01)
                end
            end
            if not self.playing then break end
            self:_exec(evt)
        end

        self.playing = false
        self.paused = false
        if self.onFinish then self.onFinish() end
    end)
    return true
end

function Playback:_exec(evt)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    if evt.type == EventType.MOVE_CFRAME then
        local p, l = evt.data.pos, evt.data.look
        if p and l then
            pcall(function()
                local pos = Vector3.new(p[1], p[2], p[3])
                local look = Vector3.new(l[1], l[2], l[3])
                root.CFrame = CFrame.lookAt(pos, pos + look)
            end)
        end
    elseif evt.type == EventType.JUMP_START then
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
    elseif evt.type == EventType.ANIM_START then
        pcall(function()
            local animator = hum:FindFirstChildOfClass("Animator")
            if animator then
                local anim = Instance.new("Animation")
                anim.AnimationId = evt.data.id
                animator:LoadAnimation(anim):Play()
            end
        end)
    end
end

function Playback:pause()
    if not self.playing then return end
    self.paused = true
    self.pausedAt = tick() - self.startTime
end

function Playback:resume()
    if not self.paused then return end
    self.paused = false
    self.startTime = tick() - self.pausedAt
end

function Playback:stop()
    self.playing = false
    self.paused = false
    if self.thread then pcall(task.cancel, self.thread) self.thread = nil end
end

function Playback:setSpeed(s) self.speed = s end

