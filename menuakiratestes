local HitboxTab = Window:CreateTab("Hitbox Bola", 4483362458)
HitboxTab:CreateSection("Hitbox da Bola")

local BALL_NAME = "CLIENT_BALL"
local HitboxEnabled = false
local HitboxSize = 15
local MIN_SIZE, MAX_SIZE = 6, 50
local Hitboxes = {}
local TrackedBalls = {}

local function isBall(obj)
    return obj:IsA("Model") and string.find(obj.Name, BALL_NAME, 1, true) ~= nil
end

local function getBallPart(m)
    return m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true)
end

local function removeHitbox(m)
    if Hitboxes[m] and Hitboxes[m].Parent then Hitboxes[m]:Destroy() end
    Hitboxes[m] = nil
end

local function createHitbox(m)
    if not HitboxEnabled or not m or not m.Parent then return end
    local bp = getBallPart(m)
    if not bp then return end
    if Hitboxes[m] and Hitboxes[m].Parent then
        Hitboxes[m].Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
        return
    end
    local h = Instance.new("Part")
    h.Name = "AkiraBallHitbox"
    h.Shape = Enum.PartType.Ball
    h.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
    h.CFrame = bp.CFrame
    h.Color = Color3.fromRGB(50, 255, 100)
    h.Material = Enum.Material.ForceField
    h.Transparency = 0.65
    h.CanCollide = false
    h.CanTouch = true
    h.CanQuery = true
    h.CastShadow = false
    h.Massless = true
    h.Anchored = false
    h.Parent = m
    local w = Instance.new("WeldConstraint")
    w.Part0 = bp
    w.Part1 = h
    w.Parent = h
    Hitboxes[m] = h
end

local function trackBall(m)
    if TrackedBalls[m] then return end
    TrackedBalls[m] = true
    if HitboxEnabled then createHitbox(m) end
    m.AncestryChanged:Connect(function(_, p)
        if not p then
            removeHitbox(m)
            TrackedBalls[m] = nil
        end
    end)
end

local function scanForBalls()
    for _, o in ipairs(Workspace:GetDescendants()) do
        if isBall(o) then trackBall(o) end
    end
end

HitboxTab:CreateToggle({
    Name = "Ativar Hitbox da Bola",
    CurrentValue = false,
    Flag = "HitboxToggle",
    Callback = function(v)
        HitboxEnabled = v
        if v then
            for m, _ in pairs(TrackedBalls) do
                if m.Parent then createHitbox(m) end
            end
            scanForBalls()
        else
            for m, _ in pairs(Hitboxes) do removeHitbox(m) end
            table.clear(Hitboxes)
        end
    end
})

HitboxTab:CreateSlider({
    Name = "Tamanho da Hitbox",
    Range = {MIN_SIZE, MAX_SIZE},
    Increment = 1,
    CurrentValue = HitboxSize,
    Flag = "HitboxSize",
    Callback = function(v)
        HitboxSize = math.clamp(math.round(v), MIN_SIZE, MAX_SIZE)
        for m, h in pairs(Hitboxes) do
            if m.Parent and h.Parent then
                h.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
            end
        end
    end
})

Workspace.DescendantAdded:Connect(function(o)
    if isBall(o) then trackBall(o) end
end)
scanForBalls()

