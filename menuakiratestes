    holder.Size = UDim2.new(1, -118, 1, -8)
    holder.Position = UDim2.new(0, 110, 0, 4)
    holder.BackgroundTransparency = 1
    holder.Parent = row
    local layout = Instance.new("UIListLayout", holder)
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.Padding = UDim.new(0, 4)
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    local buttons = {}
    local current = initial
    local function setActive(name)
        for n, b in pairs(buttons) do
            local active = n == name
            b.BackgroundColor3 = active and Theme.Accent or OFF_CLR
            b.TextColor3 = active and Color3.fromRGB(15, 15, 18) or TEXT_DIM
        end
    end
    for _, name in ipairs(options) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, 0, 1, 0)
        b.AutomaticSize = Enum.AutomaticSize.X
        b.BackgroundColor3 = OFF_CLR
        b.Text = name
        b.Font = Enum.Font.GothamBold
        b.TextSize = 10
        b.TextColor3 = TEXT_DIM
        b.AutoButtonColor = false
        b.BorderSizePixel = 0
        b.Parent = holder
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
        local pad = Instance.new("UIPadding", b)
        pad.PaddingLeft = UDim.new(0, 8)
        pad.PaddingRight = UDim.new(0, 8)
        buttons[name] = b
        b.MouseButton1Click:Connect(function()
            current = name
            setActive(name)
            if onChange then onChange(name) end
        end)
    end
    setActive(initial)
    return { Set = function(v) current=v; setActive(v); if onChange then onChange(v) end end, Get = function() return current end }
end

