-- SISTEMA DE SEGMENTOS
-- ======================================================================== --
local segmentSpeeds = {}  -- { {Inicio, Fim, Mult} }

local SEG_COLORS = {
    [1.0] = Color3.fromRGB(80, 80, 80),
    [1.5] = Color3.fromRGB(80, 160, 60),
    [2.0] = Color3.fromRGB(200, 180, 40),
    [2.5] = Color3.fromRGB(220, 120, 30),
    [3.0] = Color3.fromRGB(200, 50, 50),
}
local SEG_STEPS = {1.0, 1.5, 2.0, 2.5, 3.0}

local function getSegColor(m)
    -- Cor mais próxima
    local closest = 1.0
    local minDiff = math.huge
    for _, v in ipairs(SEG_STEPS) do
        local d = math.abs(v - m)
        if d < minDiff then minDiff = d closest = v end
    end
    return SEG_COLORS[closest] or Color3.fromRGB(80, 80, 80)
end

local function getTotalDuration()
    if #recordedData > 0 then return recordedData[#recordedData].Time end
    return timelineTotalDuration
end

local function getSpeedAtTime(t)
    if #segmentSpeeds == 0 then return 1.0 end
    for _, seg in ipairs(segmentSpeeds) do
        if t >= seg.Inicio and t < seg.Fim then return seg.Mult end
    end
    return 1.0
end

-- Reconstrói a timeline visual
local function rebuildSegList()
    for _, c in ipairs(SegScroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    for _, c in ipairs(TimelineInner:GetChildren()) do
        c:Destroy()
    end

    local total = getTotalDuration()
    if total <= 0 then total = 1 end

    -- Timeline
    for i, seg in ipairs(segmentSpeeds) do
        local w = (seg.Fim - seg.Inicio) / total
        local x = seg.Inicio / total
        local f = Instance.new("Frame", TimelineInner)
        f.Size = UDim2.new(w, 0, 1, 0)
        f.Position = UDim2.new(x, 0, 0, 0)
        f.BackgroundColor3 = getSegColor(seg.Mult)
        f.BorderSizePixel = 0
        f.ZIndex = 2
        Instance.new("UICorner", f).CornerRadius = UDim.new(0, 3)

        -- Label da velocidade
        if w > 0.08 then
            local lbl = Instance.new("TextLabel", f)
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Font = Enum.Font.Code
            lbl.Text = string.format("%.1fx", seg.Mult)
            lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            lbl.TextSize = 8
            lbl.ZIndex = 3
        end
    end

    -- Handles (divisórias arrastáveis)
    for i = 2, #segmentSpeeds do
        local t = segmentSpeeds[i].Inicio
        local x = t / total
        local h = Instance.new("TextButton", TimelineInner)
        h.Size = UDim2.new(0, 6, 1, 4)
        h.Position = UDim2.new(x, -3, 0, -2)
        h.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        h.Text = ""
        h.BorderSizePixel = 0
        h.ZIndex = 5
        h.Name = "Handle_" .. i
        Instance.new("UICorner", h).CornerRadius = UDim.new(0, 2)

        -- Drag do handle
        local draggingH = false
        local hDragI = i  -- índice do segmento que começa nesse handle
        h.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or
               input.UserInputType == Enum.UserInputType.Touch then
                draggingH = true
                h.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
            end
        end)
        h.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or
               input.UserInputType == Enum.UserInputType.Touch then
                draggingH = false
                h.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if not draggingH then return end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement and
               input.UserInputType ~= Enum.UserInputType.Touch then return end

            local total = getTotalDuration()
            local tlAbsX = TimelineInner.AbsolutePosition.X
            local tlAbsW = TimelineInner.AbsoluteSize.X
            local mouseX = UserInputService:GetMouseLocation().X
            local rel = math.clamp((mouseX - tlAbsX) / tlAbsW, 0, 1)
            local newTime = rel * total

            -- Limita entre vizinhos
            local minT = segmentSpeeds[hDragI - 1].Inicio + 0.05
            local maxT = segmentSpeeds[hDragI].Fim - 0.05
            newTime = math.clamp(newTime, minT, maxT)

            segmentSpeeds[hDragI - 1].Fim = newTime
            segmentSpeeds[hDragI].Inicio = newTime
            rebuildSegList()
        end)
    end

    -- Lista de segmentos
    for i, seg in ipairs(segmentSpeeds) do
        local row = Instance.new("Frame", SegScroll)
        row.Size = UDim2.new(1, -2, 0, 14)
        row.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        row.BorderSizePixel = 0
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 3)

        local info = Instance.new("TextLabel", row)
        info.Size = UDim2.new(1, -40, 1, 0)
        info.Position = UDim2.new(0, 4, 0, 0)
        info.BackgroundTransparency = 1
        info.Font = Enum.Font.Code
        info.Text = string.format("%.2f→%.2f = %.1fx", seg.Inicio, seg.Fim, seg.Mult)
        info.TextColor3 = Color3.fromRGB(220, 220, 220)
        info.TextSize = 8
        info.TextXAlignment = Enum.TextXAlignment.Left

        -- Botão ciclar velocidade
        local vBtn = Instance.new("TextButton", row)
        vBtn.Size = UDim2.new(0, 22, 1, -2)
        vBtn.Position = UDim2.new(1, -46, 0, 1)
        vBtn.BackgroundColor3 = getSegColor(seg.Mult)
        vBtn.Text = string.format("%.1f", seg.Mult)
        vBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        vBtn.Font = Enum.Font.GothamBold
        vBtn.TextSize = 8
        vBtn.BorderSizePixel = 0
        Instance.new("UICorner", vBtn).CornerRadius = UDim.new(0, 3)
        vBtn.MouseButton1Click:Connect(function()
            -- Cicla: 1.0 → 1.5 → 2.0 → 2.5 → 3.0 → 1.0
            local cur = seg.Mult
            local nextIdx = 1
            for idx, v in ipairs(SEG_STEPS) do
                if math.abs(v - cur) < 0.01 then
                    nextIdx = idx + 1
                    if nextIdx > #SEG_STEPS then nextIdx = 1 end
                    break
                end
            end
            segmentSpeeds[i].Mult = SEG_STEPS[nextIdx]
            rebuildSegList()
        end)

        -- Deletar segmento (só se tiver mais de 1)
        if #segmentSpeeds > 1 then
            local dBtn = Instance.new("TextButton", row)
            dBtn.Size = UDim2.new(0, 16, 1, -2)
            dBtn.Position = UDim2.new(1, -22, 0, 1)
            dBtn.BackgroundColor3 = Color3.fromRGB(140, 40, 40)
            dBtn.Text = "🗑"
            dBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            dBtn.TextSize = 8
            dBtn.Font = Enum.Font.GothamBold
            dBtn.BorderSizePixel = 0
            Instance.new("UICorner", dBtn).CornerRadius = UDim.new(0, 3)
            dBtn.MouseButton1Click:Connect(function()
                table.remove(segmentSpeeds, i)
                -- Funde com o anterior (se houver)
                if i > 1 then
                    segmentSpeeds[i - 1].Fim = segmentSpeeds[i].Fim
                end
                rebuildSegList()
            end)
        end
    end

    SegScroll.CanvasSize = UDim2.new(0, 0, 0, #segmentSpeeds * 16)

    -- Info resumida
    if #segmentSpeeds == 0 then
        SegInfoLabel.Text = "Sem segmentos (1.0x padrão)"
    else
        local sum = 0
        local parts = {}
        for _, s in ipairs(segmentSpeeds) do
            sum = sum + (s.Fim - s.Inicio) / s.Mult
            table.insert(parts, string.format("%.1f", s.Mult))
        end
        SegInfoLabel.Text = string.format("Tempo final: %.2fs (%s)", sum, table.concat(parts, "→"))
    end
end

-- Botão ADD: divide o maior segmento no meio
AddSegBtn.MouseButton1Click:Connect(function()
    if #recordedData == 0 then
        SegInfoLabel.Text = "Grave uma rota primeiro!"
        return
    end
    local total = getTotalDuration()
    if #segmentSpeeds == 0 then
        segmentSpeeds = {{Inicio = 0, Fim = total, Mult = 1.5}}
    else
        -- Acha o maior segmento
        local biggest = 1
        local biggestLen = 0
        for i, s in ipairs(segmentSpeeds) do
            local len = s.Fim - s.Inicio
            if len > biggestLen then biggestLen = len biggest = i end
        end
        local s = segmentSpeeds[biggest]
        local mid = (s.Inicio + s.Fim) / 2
        local m = s.Mult
        -- Divide em dois
        segmentSpeeds[biggest] = {Inicio = s.Inicio, Fim = mid, Mult = m}
        table.insert(segmentSpeeds, biggest + 1, {Inicio = mid, Fim = s.Fim, Mult = m})
    end
    rebuildSegList()
end)

-- Botão LIMPAR
ResetSegBtn.MouseButton1Click:Connect(function()
    segmentSpeeds = {}
    rebuildSegList()
end)

