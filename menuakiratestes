function UI.details()
	local m = UI.sel and History.byId[UI.sel]
	if not m then
		pcall(function() detPara:Set({ Title = "Detalhes da rota", Content = "Nenhuma rota selecionada." }) end)
		return
	end
	History.getEvents(m.id) -- atualiza análise de compatibilidade
	local txt = string.format(
		"Nome: %s\nData: %s\nDuração: %s\nEventos: %d\nDeslocamentos: %d • Saltos: %d • Animações: %d • Interações: %d\nCompatibilidade: %d%% (%d incompatíveis)\nEstado: %s%s",
		m.name, os.date("%d/%m/%Y %H:%M", m.created), fmt(m.dur), m.n or 0, m.moves or 0, m.jumps or 0,
		m.anims or 0, m.inter or 0, compatPct(m), m.na or 0, statusOf(m),
