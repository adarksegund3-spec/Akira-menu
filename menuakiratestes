-- Texto: normalização, similaridade e filtro (só fica o que tem a frase ou algo parecido)
local Txt = {}
local ACC = {
	["á"]="a",["à"]="a",["â"]="a",["ã"]="a",["ä"]="a",["Á"]="a",["À"]="a",["Â"]="a",["Ã"]="a",["Ä"]="a",
	["é"]="e",["è"]="e",["ê"]="e",["ë"]="e",["É"]="e",["È"]="e",["Ê"]="e",["Ë"]="e",
	["í"]="i",["ì"]="i",["î"]="i",["ï"]="i",["Í"]="i",["Ì"]="i",["Î"]="i",["Ï"]="i",
	["ó"]="o",["ò"]="o",["ô"]="o",["õ"]="o",["ö"]="o",["Ó"]="o",["Ò"]="o",["Ô"]="o",["Õ"]="o",["Ö"]="o",
	["ú"]="u",["ù"]="u",["û"]="u",["ü"]="u",["Ú"]="u",["Ù"]="u",["Û"]="u",["Ü"]="u",
	["ç"]="c",["Ç"]="c",["ñ"]="n",["Ñ"]="n",
}
function Txt.norm(str)
	str = tostring(str or ""):gsub("[\192-\255][\128-\191]*", function(ch) return ACC[ch] or ch end)
	str = str:lower():gsub("[^%w\128-\255]+", " ")
	return (str:gsub("^%s+", ""):gsub("%s+$", ""))
end
function Txt.words(str)
	local out = {}
	for w in str:gmatch("%S+") do table.insert(out, w) end
	return out
end
function Txt.lev(a, b, maxd)
	local la, lb = #a, #b
	if math.abs(la - lb) > maxd then return maxd + 1 end
	local prev = {}
	for j = 0, lb do prev[j] = j end
	for i = 1, la do
		local cur = { [0] = i }
		local rowmin = i
		for j = 1, lb do
			local cost = a:byte(i) == b:byte(j) and 0 or 1
			local v = math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
			cur[j] = v
			if v < rowmin then rowmin = v end
		end
		if rowmin > maxd then return maxd + 1 end
		prev = cur
	end
	return prev[lb]
end
-- 0 = não combina; maior = mais parecido
function Txt.score(query, hayRaw, primaryRaw)
	local qn = Txt.norm(query)
	if qn == "" then return 1 end
	local h = Txt.norm(hayRaw)
	local pr = Txt.norm(primaryRaw or hayRaw)
	if pr == qn then return 120 end
	if pr:sub(1, #qn) == qn then return 110 end
	if h:find(qn, 1, true) then return 100 end
	local hw = Txt.words(h)
	local total, fuzzy = 0, false
	for _, t in ipairs(Txt.words(qn)) do
		local hit = false
		if #t <= 2 then
			for _, w in ipairs(hw) do if w:sub(1, #t) == t then hit = true break end end
		else
			hit = h:find(t, 1, true) ~= nil
		end
		if hit then
			total += 1
		else
			local k = #t >= 7 and 2 or (#t >= 4 and 1 or 0)
			local ok = false
			if k > 0 then
				for _, w in ipairs(hw) do if Txt.lev(t, w, k) <= k then ok = true break end end
			end
			if not ok then return 0 end
			fuzzy = true; total += 0.6
		end
	end
	return (fuzzy and 55 or 85) + total
end
function Txt.filter(list, query, hayFn, primFn)
	local arr = {}
	for i, it in ipairs(list or {}) do
		local sc = Txt.score(query, hayFn(it), primFn and primFn(it) or nil)
		if sc > 0 then table.insert(arr, { it = it, sc = sc, i = i }) end
	end
	table.sort(arr, function(x, y) if x.sc ~= y.sc then return x.sc > y.sc end return x.i < y.i end)
	local out = {}
	for _, e in ipairs(arr) do table.insert(out, e.it) end
	return out
end

