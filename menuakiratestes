local weaponTick = 0
local function applyWeaponMods()
    local ch = LocalPlayer.Character
    if not ch then return end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    local containers = { ch, bp }
    for _, cont in ipairs(containers) do
        if cont then
            for _, tool in ipairs(cont:GetChildren()) do
                if tool:IsA("Tool") then
                    for _, d in ipairs(tool:GetDescendants()) do
                        if d:IsA("NumberValue") or d:IsA("IntValue") then
                            local n = d.Name:lower()
                            if Config.NoRecoil and (n:find("recoil") or n:find("kick")) then
                                pcall(function() d.Value = 0 end)
                            end
                            if Config.NoSpread and (n:find("spread") or n:find("deviation")) then
                                pcall(function() d.Value = 0 end)
                            end
                        end
                    end
                    if Config.NoRecoil then
                        for _, prop in ipairs({"Recoil", "Kick", "CameraRecoil"}) do
                            pcall(function() tool[prop] = 0 end)
                        end
                    end
                    if Config.NoSpread then
                        for _, prop in ipairs({"Spread", "Deviation"}) do
                            pcall(function() tool[prop] = 0 end)
                        end
                    end
                end
            end
        end
    end
end

