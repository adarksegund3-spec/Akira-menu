    tr.Position = UDim2.new(0,0,0,20); tr.Size = UDim2.new(1,0,0,5)
    Instance.new("UICorner", tr).CornerRadius = UDim.new(1,0)
    local fl = Instance.new("Frame", tr)
    fl.BackgroundColor3 = Color3.fromRGB(200,35,35); fl.BorderSizePixel = 0
    fl.Size = UDim2.new(0,0,1,0)
    Instance.new("UICorner", fl).CornerRadius = UDim.new(1,0)
    local hd = Instance.new("Frame", tr)
    hd.BackgroundColor3 = Color3.fromRGB(255,255,255); hd.BorderSizePixel = 0
    hd.Size = UDim2.new(0,10,0,10); hd.Position = UDim2.new(0,-5,0,-2.5)
    Instance.new("UICorner", hd).CornerRadius = UDim.new(1,0)
    local step = ((max - min) <= 10) and 0.1 or 1
    local val, dragging = default, false
    local function setVisual(x)
        local r0 = math.clamp((x - min) / (max - min), 0, 1)
        fl.Size = UDim2.new(r0,0,1,0)
        hd.Position = UDim2.new(r0,-5,0,-2.5)
        v.Text = string.format("%g", x)
    end
    setVisual(default)
    table.insert(SliderReg, function() val = default; setVisual(default) end)
    local function lockScroll(lock)
        if parent:IsA("ScrollingFrame") then parent.ScrollingEnabled = not lock end
    end
    local function upd(i)
        local r = math.clamp((i.Position.X - tr.AbsolutePosition.X) / tr.AbsoluteSize.X, 0, 1)
        val = math.floor((min + (max-min)*r) / step + 0.5) * step
        val = math.clamp(math.floor(val*100 + 0.5)/100, min, max)
        setVisual(val)
        if cb then pcall(cb, val) end
    end
    tr.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; lockScroll(true); upd(i)
        end
    end)
    tr.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i) end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i) end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false; lockScroll(false)
        end
    end)
    State.sliderSet = State.sliderSet or {}
    State.sliderSet[f] = function(x) val = x; setVisual(x) end
    return f
end

