-- Sistema de abas
local Tabs = {}
local tabOrder = {}
local ActiveTab = nil

local function selectTab(name)
    if ActiveTab == name then return end
    if ActiveTab and Tabs[ActiveTab] then
        Tabs[ActiveTab].content.Visible = false
        TweenService:Create(Tabs[ActiveTab].indicator, TweenInfo.new(0.15), {BackgroundTransparency=1}):Play()
        TweenService:Create(Tabs[ActiveTab].button, TweenInfo.new(0.15), {TextColor3=TEXT_DIM}):Play()
    end
    ActiveTab = name
    Tabs[name].content.Visible = true
    TweenService:Create(Tabs[name].indicator, TweenInfo.new(0.15), {BackgroundTransparency=0}):Play()
    TweenService:Create(Tabs[name].button, TweenInfo.new(0.15), {TextColor3=Color3.fromRGB(255,255,255)}):Play()
end

local function createTab(name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 84, 1, 0)
    btn.Position = UDim2.new(0, #tabOrder * 86 + 4, 0, 0)
    btn.BackgroundTransparency = 1
    btn.Text = name
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.TextColor3 = TEXT_DIM
    btn.AutoButtonColor = false
    btn.ZIndex = 12
    btn.Parent = tabBar

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(1, -20, 0, 2)
    indicator.Position = UDim2.new(0, 10, 1, -2)
    indicator.BackgroundColor3 = Theme.Accent
    indicator.BorderSizePixel = 0
    indicator.BackgroundTransparency = 1
    indicator.ZIndex = 12
    indicator.Parent = btn

    local content = Instance.new("ScrollingFrame")
    content.Size = UDim2.new(1, -16, 1, -12)
    content.Position = UDim2.new(0, 8, 0, 6)
    content.BackgroundTransparency = 1
    content.BorderSizePixel = 0
    content.ScrollBarThickness = 3
    content.ScrollBarImageColor3 = Theme.Accent
    content.CanvasSize = UDim2.new(0, 0, 0, 0)
    content.AutomaticCanvasSize = Enum.AutomaticSize.Y
    content.Visible = false
    content.ZIndex = 12
    content.Parent = contentArea

    local layout = Instance.new("UIListLayout", content)
    layout.Padding = UDim.new(0, 6)
    layout.SortOrder = Enum.SortOrder.LayoutOrder

    btn.MouseButton1Click:Connect(function() selectTab(name) end)

    Tabs[name] = { button = btn, content = content, indicator = indicator }
    tabOrder[#tabOrder + 1] = name
    return Tabs[name]
end

