local slowFactor = 0.7
local SLOW_MIN, SLOW_MAX, SLOW_STEP = 0.5, 1.0, 0.05
local slowOriginals = nil

local function applySlowMotion()
    if slowFactor >= 0.99 then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if not hum then return end

    slowOriginals = {
        WalkSpeed = hum.WalkSpeed,
        JumpPower = hum.JumpPower,
        JumpHeight = hum.JumpHeight,
        UseJumpPower = hum.UseJumpPower,
        Gravity = workspace.Gravity,
    }

    hum.WalkSpeed = slowOriginals.WalkSpeed * slowFactor
    if slowOriginals.UseJumpPower then
        hum.JumpPower = slowOriginals.JumpPower * slowFactor
    end
    -- Gravity escalado por fator² → altura do pulo se mantém, tempo dobra
    workspace.Gravity = slowOriginals.Gravity * (slowFactor * slowFactor)
end

local function removeSlowMotion()
    if not slowOriginals then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if hum then
        hum.WalkSpeed = slowOriginals.WalkSpeed
        hum.JumpPower = slowOriginals.JumpPower
    end
    workspace.Gravity = slowOriginals.Gravity
    slowOriginals = nil
end

