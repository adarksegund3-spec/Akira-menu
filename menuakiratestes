track(RecordBtn.MouseButton1Click:Connect(function()
    if playbackConnection then stopPlayback() end
    isRecording = not isRecording

    if isRecording then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        if not hrp or not hum then
            isRecording = false
            setStatus("Sem personagem", "warn")
            return
        end

        recordedData = {}
        startTime = os.clock()
        startTimer()
        RecordBtn.Text = "Parar"
        RecordBtn.BackgroundColor3 = C.Red
        setStatus("Gravando...", "rec")

        local animator = hum:FindFirstChildOfClass("Animator") or char:FindFirstChildWhichIsA("Animator", true)
        local frameSeen = {}
        local lastNameTick = 0

        recordingConnection = RunService.Heartbeat:Connect(function()
            local currentTime = os.clock() - startTime
            local cf = hrp.CFrame
            local vel = hrp.AssemblyLinearVelocity
            local state = hum:GetState()
            local anims = {}

            if not animator or not animator.Parent then
                animator = hum:FindFirstChildOfClass("Animator") or char:FindFirstChildWhichIsA("Animator", true)
            end

            -- mostra no status os nomes das animações detectadas (a cada 0.25s)
            local names = nil
            if currentTime - lastNameTick >= 0.25 then
                lastNameTick = currentTime
                names = {}
            end

            if animator then
                table.clear(frameSeen)
                for _, trackObj in ipairs(animator:GetPlayingAnimationTracks()) do
                    local a = trackObj.Animation
                    if a and trackObj.WeightCurrent > 0.01 then
                        local id = a.AnimationId
                        if id ~= "" and not frameSeen[id] then
                            frameSeen[id] = true
                            table.insert(anims, {
                                Id = id,
                                Speed = trackObj.Speed,
                                Weight = trackObj.WeightCurrent,
                                Priority = trackObj.Priority.Name,
                                Looped = trackObj.Looped,
                            })
                            if names then
                                local nm = a.Name
                                if nm == "" then nm = id:match("%d+") or "?" end
                                table.insert(names, nm)
                            end
                        end
                    end
                end
            end

            table.insert(recordedData, {
                Time = currentTime,
                CF = { cf:GetComponents() },
                Velocity = { vel.X, vel.Y, vel.Z },
                State = state.Name,
                Animations = anims,
            })

            if names then
                local txt = string.format("Gravando | %d anim", #names)
                if #names > 0 then txt = txt .. ": " .. table.concat(names, ", ") end
                setStatus(txt, "rec")
            end
        end)
    else
        if recordingConnection then
            recordingConnection:Disconnect()
            recordingConnection = nil
        end
        stopTimer()
        resetRecordButton()
        setStatus(string.format("%.2fs  |  %d pts  |  %d anims", timerFrozen, #recordedData, countAnims(recordedData)), "ok")
    end
end))

