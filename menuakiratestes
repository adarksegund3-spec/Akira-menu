local Registry = { types = {} }
for k, label in pairs({ move = "Movimento", jump = "Salto", state = "Estado", anim = "Animação", input = "Tecla",
	gui = "Botão", prompt = "Prompt", click = "Clique", tool = "Ferramenta", attr = "Atributo" }) do
	Registry.types[k] = label
end
function Registry.validate(e)
	if type(e) ~= "table" or type(e.t) ~= "number" or e.t < 0 or type(e.k) ~= "string" then return false end
	if not Registry.types[e.k] then return false end
	if e.d ~= nil and type(e.d) ~= "table" then return false end
	if e.p ~= nil and (type(e.p) ~= "table" or #e.p ~= 3) then return false end
	if e.k == "move" and not e.p then return false end
	return true
end

------------------------------------------------------------------ REFS
local function makeRef(inst)
	if not inst then return nil end
	local path, cur = {}, inst
	while cur and cur ~= game and cur ~= workspace do
		table.insert(path, 1, cur.Name)
		cur = cur.Parent
	end
	local base = inst:IsA("BasePart") and inst or inst:FindFirstAncestorWhichIsA("BasePart")
	local pos
	if base then pos = { r2(base.Position.X), r2(base.Position.Y), r2(base.Position.Z) } end
	return { path = path, cls = inst.ClassName, name = inst.Name, pos = pos, root = (cur == workspace) and "w" or "g" }
end
local function resolveRef(ref)
	if type(ref) ~= "table" or type(ref.path) ~= "table" then return nil end
	local cur = ref.root == "w" and workspace or game
	for _, n in ipairs(ref.path) do
		cur = cur and cur:FindFirstChild(n)
		if not cur then break end
	end
	if cur and cur.ClassName == ref.cls then return cur end
	local pg = LP:FindFirstChildOfClass("PlayerGui")
	local rootSearch = (ref.root == "g" and pg) or workspace
	local best, bd
	for _, d in ipairs(rootSearch:GetDescendants()) do
		if d.Name == ref.name and d.ClassName == ref.cls then
			local dist = 0
			if ref.pos then
				local bp = d:IsA("BasePart") and d or d:FindFirstAncestorWhichIsA("BasePart")
				if bp then dist = (bp.Position - Vector3.new(ref.pos[1], ref.pos[2], ref.pos[3])).Magnitude end
			end
			if not bd or dist < bd then best, bd = d, dist end
		end
	end
	return best
end

local function isShown(gui)
	if not gui:IsA("GuiObject") then return false end
	if gui.AbsoluteSize.X <= 0 or gui.AbsoluteSize.Y <= 0 then return false end
	local cur = gui
	while cur and cur ~= game do
		if cur:IsA("GuiObject") and not cur.Visible then return false end
		if cur:IsA("ScreenGui") and not cur.Enabled then return false end
		cur = cur.Parent
	end
	return true
end
local function guiCenter(btn)
	local sg = btn:FindFirstAncestorWhichIsA("ScreenGui")
	local inset = (sg and not sg.IgnoreGuiInset) and GuiService:GetGuiInset().Y or 0
	local c = btn.AbsolutePosition + btn.AbsoluteSize / 2
	return c.X, c.Y + inset
end
local function fireSig(sig, ...)
	if type(firesignal) == "function" then
		if pcall(firesignal, sig, ...) then return true end
	end
	if type(getconnections) == "function" then
		local ok, conns = pcall(getconnections, sig)
		if ok and type(conns) == "table" then
			for _, c in ipairs(conns) do pcall(function() c:Fire(...) end) end
			return #conns > 0
		end
	end
	return false
end

------------------------------------------------------------------ ADAPTERS
local Adapters = {}
function Adapters.can(e)
	local k, d = e.k, e.d or {}
	if k == "move" or k == "jump" or k == "tool" then return "ok" end
	if k == "state" or k == "attr" then return "info" end
	if k == "anim" then return d.rp and "ok" or "info" end
	if k == "input" then return (Compat.vim and keyOf(d.key)) and "ok" or "na" end
	if k == "gui" then return (Compat.vim or Compat.sig) and "ok" or "na" end
	if k == "prompt" then
		if d.ph == "trigger" then return Compat.prompt and "ok" or "na" end
		return "info"
	end
	if k == "click" then return Compat.click and "ok" or "na" end
	return "na"
end

function Adapters.run(e, ctx)
	local d, k, hum, o = e.d or {}, e.k, ctx.hum, ctx.opts
	if (k == "input" or k == "gui") and d.sp and not o.sprint then return "info" end
	if k == "jump" then
		if d.ph == "start" then
			hum.Jump = true
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
			return "ok"
		end
		return "info"
	elseif k == "anim" then
		if not d.rp or not o.anims then return "info" end
		if d.ph == "start" then
			if not ctx.animator then return "fail", "Animator ausente" end
			for _, t in ipairs(ctx.animator:GetPlayingAnimationTracks()) do
				if t.Animation and t.Animation.AnimationId == d.id then return "info" end -- jogo já toca
			end
			local a = Instance.new("Animation")
			a.AnimationId = d.id
			local okA, tr = pcall(function() return ctx.animator:LoadAnimation(a) end)
			if not okA or not tr then return "fail", "animação inacessível" end
			pcall(function()
				tr.Priority = Enum.AnimationPriority[d.pri] or Enum.AnimationPriority.Action
				tr.Looped = d.loop and true or false
				tr:Play(0.1, 1, (d.sp or 1) * ctx.speed)
			end)
			ctx.tracks[d.id] = tr
			return "ok"
		end
		local tr = ctx.tracks[d.id]
		if tr then pcall(function() tr:Stop(0.1) end) ctx.tracks[d.id] = nil end
		return "ok"
	elseif k == "input" then
		local kc = keyOf(d.key)
		if not (Compat.vim and kc) then return "fail", "teclas indisponíveis" end
		local okV = pcall(function() Compat.VIM:SendKeyEvent(d.ph == "down", kc, false, game) end)
		return okV and "ok" or "fail", "falha ao enviar tecla"
	elseif k == "gui" then
		local btn = resolveRef(d.ref)
		if not btn or not btn:IsA("GuiButton") then return "fail", "botão não encontrado: " .. tostring(d.ref and d.ref.name) end
		if not isShown(btn) then return "fail", "botão não está visível: " .. btn.Name end
		if Compat.vim then
			local x, y = guiCenter(btn)
			local okV = pcall(function() Compat.VIM:SendMouseButtonEvent(x, y, 0, d.ph == "down", game, 0) end)
			return okV and "ok" or "fail", "falha ao clicar no botão"
		end
		if d.ph == "down" then fireSig(btn.MouseButton1Down)
		else
			fireSig(btn.MouseButton1Up)
			fireSig(btn.MouseButton1Click)
			fireSig(btn.Activated)
		end
		return "ok"
	elseif k == "prompt" then
		if d.ph ~= "trigger" then return "info" end
		if not Compat.prompt then return "fail", "fireproximityprompt indisponível" end
		local p = resolveRef(d.ref)
		if not p then return "fail", "objeto não encontrado: " .. tostring(d.ref and d.ref.name) end
		return pcall(fireproximityprompt, p) and "ok" or "fail", "falha no prompt"
	elseif k == "click" then
		if not Compat.click then return "fail", "fireclickdetector indisponível" end
		local cd = resolveRef(d.ref)
		if not cd then return "fail", "objeto não encontrado: " .. tostring(d.ref and d.ref.name) end
		return pcall(fireclickdetector, cd) and "ok" or "fail", "falha no clique"
	elseif k == "tool" then
		if d.ph == "equip" then
			local bp = LP:FindFirstChildOfClass("Backpack")
			local tool = (bp and bp:FindFirstChild(d.name)) or ctx.char:FindFirstChild(d.name)
			if not tool then return "fail", "ferramenta não encontrada: " .. tostring(d.name) end
			pcall(function() hum:EquipTool(tool) end)
			return "ok"
		elseif d.ph == "unequip" then
			pcall(function() hum:UnequipTools() end)
			return "ok"
		elseif d.ph == "use" then
			local tool = ctx.char:FindFirstChild(d.name)
			if not (tool and tool:IsA("Tool")) then return "fail", "ferramenta não equipada: " .. tostring(d.name) end
			pcall(function() tool:Activate() end)
			return "ok"
		end
		return "info"
	end
	return "info"
end

------------------------------------------------------------------ SERIALIZER
local Serializer = {}
function Serializer.analyze(ev)
	local c = { ok = 0, na = 0, info = 0, mov = 0, jump = 0, inter = 0, sprintEv = 0 }
	for _, e in ipairs(ev) do
		local st = Adapters.can(e)
		c[st] += 1
		if e.k == "move" then c.mov += 1 elseif e.k == "jump" then c.jump += 1
		elseif e.k ~= "anim" and e.k ~= "state" and e.k ~= "attr" then c.inter += 1 end
		if e.d and e.d.sp then c.sprintEv += 1 end
	end
	return c
end
function Serializer.cleanEvents(ev)
	local out, dropped = {}, 0
	if type(ev) ~= "table" then return out, 0 end
	for _, e in ipairs(ev) do
		if Registry.validate(e) and #out < CFG.maxEvents then out[#out + 1] = e else dropped += 1 end
	end
	table.sort(out, function(a, b)
		if a.t ~= b.t then return a.t < b.t end
		return (a.n or 0) < (b.n or 0)
	end)
	return out, dropped
end
function Serializer.buildMeta(id, name, s, dur, partial)
	local c = Serializer.analyze(s.events)
	local run = (s.wsMax and s.wsMin and s.wsMin > 0 and s.wsMax >= s.wsMin * 1.2) or c.sprintEv > 0
	return {
		id = id, name = name, created = os.time(), dur = r2(dur), n = #s.events,
		moves = c.mov, jumps = c.jump, inter = c.inter, ok = c.ok, na = c.na,
		run = run and true or false, wsMin = s.wsMin and r1(s.wsMin), wsMax = s.wsMax and r1(s.wsMax),
		loco = s.customLoco and "personalizada" or "padrão", partial = partial, place = game.PlaceId, v = CFG.version,
	}
end
function Serializer.migrate(data)
	if type(data) ~= "table" then return nil end
	if data.v == nil then data.v = 1 end
	if data.v > CFG.version then return nil, "arquivo de versão mais nova" end
	return data -- v1 → v2: eventos compatíveis (novos tipos são opcionais)
end
function Serializer.encode(t)
	local ok, s = pcall(HttpService.JSONEncode, HttpService, t)
	if not ok then return nil, "falha ao codificar" end
	if #s > CFG.maxBytes then return nil, "rota excede o limite de tamanho" end
	return s
end
function Serializer.decode(s)
	local ok, t = pcall(HttpService.JSONDecode, HttpService, s)
	if not ok or type(t) ~= "table" then return nil, "arquivo corrompido" end
	return t
end

