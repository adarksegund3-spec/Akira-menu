local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local bypassAtivo = false
local noclipConnection = nil
local antiTpConnection = nil
local ultimaPosicao = nil

-- ============================================
-- UI (TAMANHO E ESTILO DA FOTO)
-- ============================================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "BypassPrisonGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

-- Frame Principal
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 220, 0, 150) -- Tamanho da UI original
MainFrame.Position = UDim2.new(0.5, -110, 0.5, -75)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 20, 25) -- Fundo escuro
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = MainFrame

-- Borda ciano neon
local UIStroke = Instance.new("UIStroke")
UIStroke.Color = Color3.fromRGB(0, 255, 200)
UIStroke.Thickness = 1.5
UIStroke.Parent = MainFrame

-- Título no topo (só pra ficar bonito)
local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundTransparency = 1
Title.Font = Enum.Font.GothamBold
Title.Text = "BYPASS PRISON"
Title.TextColor3 = Color3.fromRGB(0, 255, 200)
Title.TextSize = 12
Title.Parent = MainFrame

-- Botão Principal (Grande)
local BypassBtn = Instance.new("TextButton")
BypassBtn.Size = UDim2.new(1, -20, 0, 50)
BypassBtn.Position = UDim2.new(0, 10, 0, 40)
BypassBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0) -- Vermelho (Desativado)
BypassBtn.Font = Enum.Font.GothamBold
BypassBtn.Text = "Desativado"
BypassBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
