local SPRAY_COLORS = {
	Color3.fromRGB(255, 255, 255), Color3.fromRGB(20, 20, 24), Color3.fromRGB(255, 59, 92),
	Color3.fromRGB(255, 150, 40), Color3.fromRGB(255, 232, 60), Color3.fromRGB(60, 230, 120),
	Color3.fromRGB(40, 210, 255), Color3.fromRGB(80, 110, 255), Color3.fromRGB(190, 90, 255),
}
local RAINBOW_SEQ = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 220, 60)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(70, 230, 100)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(50, 210, 255)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(110, 100, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 80, 220)),
})

defineTool("spray", function(f)
	local tool = new("Tool", {Name = "Spray", ToolTip = "Arraste o dedo na tela para pintar", RequiresHandle = false, CanBeDropped = false})
	local color, rainbow, size, camMode = SPRAY_COLORS[3], false, 2.4, false
	local strokes, cur, total = {}, nil, 0
	local painting, activeInput, lastPos, lastN, hueT = false, nil, nil, nil, 0
	local equipped = false

	-- painel
	local panel = f.o(new("Frame", {
		Size = UDim2.fromOffset(176, 172), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, -24),
		BackgroundColor3 = T.bg, BorderSizePixel = 0, Visible = false, Active = true,
	}, toolGui))
	corner(panel, 12); ustroke(panel, T.acc1, 1.5)
	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -20, 0, 16), Text = "SPRAY",
		Font = Enum.Font.GothamBlack, TextSize = 13, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left,
	}, panel)
	local grid = new("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 28), Size = UDim2.fromOffset(160, 62)}, panel)
	new("UIGridLayout", {CellSize = UDim2.fromOffset(28, 28), CellPadding = UDim2.fromOffset(5, 5), SortOrder = Enum.SortOrder.LayoutOrder}, grid)
	for i, c in ipairs(SPRAY_COLORS) do
		local b = new("TextButton", {Text = "", BackgroundColor3 = c, AutoButtonColor = false, LayoutOrder = i}, grid)
		corner(b, 8); ustroke(b, WHITE, 1, 0.7)
		b.Activated:Connect(function() color = c; rainbow = false end)
	end
	local rb = new("TextButton", {
		Text = "RGB", Font = Enum.Font.GothamBlack, TextSize = 10, TextColor3 = WHITE,
		BackgroundColor3 = WHITE, AutoButtonColor = false, LayoutOrder = 99,
	}, grid)
	corner(rb, 8); new("UIGradient", {Color = RAINBOW_SEQ, Rotation = 30}, rb)
	rb.Activated:Connect(function() rainbow = true end)

	local function sbtn(text, x, y, w, cb)
		local b = new("TextButton", {
			Text = text, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = T.text, BackgroundColor3 = T.card,
			AutoButtonColor = true, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, 26), BorderSizePixel = 0,
		}, panel)
		corner(b, 8)
		b.Activated:Connect(function() cb(b) end)
		return b
	end
	local sizeLbl = new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(46, 98), Size = UDim2.fromOffset(84, 26),
		Text = "Tamanho 2.4", Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = T.sub,
	}, panel)
	local function setSize(v)
		size = math.clamp(v, 0.6, 8)
		sizeLbl.Text = string.format("Tamanho %.1f", size)
	end
	sbtn("-", 8, 98, 36, function() setSize(size - 0.6) end)
	sbtn("+", 132, 98, 36, function() setSize(size + 0.6) end)

	-- overlay de pintura (so a area direita/alta, para nao bloquear analogico e pulo)
	local overlay = f.o(new("TextButton", {
		Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Active = true,
		Position = UDim2.new(0.3, 0, 0, 0), Size = UDim2.new(0.7, 0, 0.68, 0), Visible = false,
	}, toolGui))

	-- vapor do spray
	local mist = f.o(part({Anchored = true, Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2), Parent = FX}))
	local emitter = new("ParticleEmitter", {
		Texture = SMOKE, Rate = 0, Lifetime = NumberRange.new(0.3, 0.5), Speed = NumberRange.new(5, 9),
		SpreadAngle = Vector2.new(28, 28), Size = NS(NSK(0, 0.5), NSK(1, 1.6)),
		Transparency = NS(NSK(0, 0.55), NSK(1, 1)), LightEmission = 0.25,
	}, mist)

	local function stamp(p, n, col, d)
		local off = 0.02 + (total % 25) * 0.0016
		local cf = faceCF(p + n * off, n) * CFrame.Angles(0, math.pi / 2, 0)
		local dt = part({
			Anchored = true, Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.03, d, d),
			CFrame = cf, Color = col, Transparency = 0.06, Parent = FX,
		})
		table.insert(cur, dt); total = total + 1
		-- respingo (aspecto de aerosol)
		local a = math.random() * math.pi * 2
		local rr = d * (0.55 + math.random() * 0.5)
		local sp = part({
			Anchored = true, Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.03, d * 0.22, d * 0.22),
			CFrame = cf * CFrame.new(0, math.cos(a) * rr, math.sin(a) * rr), Color = col, Transparency = 0.2, Parent = FX,
		})
		table.insert(cur, sp); total = total + 1
		while total > 2400 and #strokes > 1 do
			local s = table.remove(strokes, 1)
			for _, q in ipairs(s) do q:Destroy(); total = total - 1 end
		end
	end

	local function paintAt(pos)
		local r = cam():ScreenPointToRay(pos.X, pos.Y)
		local res = cast(r.Origin, r.Direction * 90)
		if not res then lastPos = nil; emitter.Rate = 0; return end
		local p, n = res.Position, res.Normal
		local col = color
		if rainbow then hueT = (hueT + 0.012) % 1; col = Color3.fromHSV(hueT, 0.85, 1) end
		if lastPos and lastN and lastN:Dot(n) > 0.7 and (p - lastPos).Magnitude < 9 then
			local dist = (p - lastPos).Magnitude
			local step = math.max(size * 0.3, 0.25)
			local k = math.floor(dist / step)
			if k >= 1 then
				for i = 1, k do stamp(lastPos:Lerp(p, i / k), n, col, size) end
				lastPos = p
			end
		else
			stamp(p, n, col, size)
			lastPos = p
		end
		lastN = n
		emitter.Color = ColorSequence.new(col)
		emitter.Rate = 70
		mist.CFrame = faceCF(p + n * 0.2, n) * CFrame.Angles(-math.pi / 2, 0, 0)
	end

	local function endStroke()
		painting = false; activeInput = nil; lastPos = nil; emitter.Rate = 0
	end

	f.c(overlay.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
			painting = true; activeInput = i; lastPos = nil
			cur = {}; table.insert(strokes, cur)
			paintAt(i.Position)
		end
	end)
	f.c(UIS.InputChanged, function(i)
		if not painting or not activeInput then return end
		if i == activeInput or (i.UserInputType == Enum.UserInputType.MouseMovement and activeInput.UserInputType == Enum.UserInputType.MouseButton1) then
			paintAt(i.Position)
		end
	end)
	f.c(UIS.InputEnded, function(i)
		if painting and i == activeInput then endStroke() end
	end)

	sbtn("Camera", 8, 132, 50, function(b)
		camMode = not camMode
		b.Text = camMode and "Pintar" or "Camera"
		overlay.Visible = equipped and not camMode
	end)
	sbtn("Desfazer", 63, 132, 50, function()
		local s = table.remove(strokes)
		if s then for _, q in ipairs(s) do q:Destroy(); total = total - 1 end end
	end)
	sbtn("Limpar", 118, 132, 50, function()
		for _, s in ipairs(strokes) do for _, q in ipairs(s) do q:Destroy() end end
		strokes = {}; total = 0
	end)

	tool.Equipped:Connect(function()
		equipped = true
		panel.Visible = true; overlay.Visible = not camMode
	end)
	tool.Unequipped:Connect(function()
		equipped = false
		panel.Visible = false; overlay.Visible = false; endStroke()
	end)
	return tool
end)

