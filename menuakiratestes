---------------------------------------------------------------- helpers
local function char() return lp.Character end
local function hrp() local c = char() return c and c:FindFirstChild("HumanoidRootPart") end
local function hum() local c = char() return c and c:FindFirstChildOfClass("Humanoid") end
local function torsoName() return char() and char():FindFirstChild("UpperTorso") and "UpperTorso" or "Torso" end

local function notify(t)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {Title = "Angel Menu", Text = t, Duration = 2})
	end)
end

local function bag()
	local items = {}
	local function add(x) items[#items + 1] = x return x end
	local function clean()
		for i = #items, 1, -1 do
			local x, t = items[i], typeof(items[i])
			if t == "RBXScriptConnection" then x:Disconnect()
			elseif t == "Instance" then x:Destroy()
			elseif t == "function" then pcall(x) end
		end
	end
	return add, clean
end

local active = {}
local function toggle(name, start)
	if active[name] then
		pcall(active[name]); active[name] = nil
		notify(name .. " OFF") return
	end
	if not hrp() then notify("Personagem não encontrado") return end
	local ok, off = pcall(start)
	if not ok then warn(off) elseif off then active[name] = off; notify(name .. " ON") end
end
local function offAll() for k, f in pairs(active) do pcall(f); active[k] = nil end end
lp.CharacterAdded:Connect(offAll)

local function mk(parent, size, color, mat, class)
	local p = Instance.new(class or "Part")
	p.Size, p.Color = size, color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.CanCollide, p.Massless, p.CastShadow = false, true, false
	p.Parent = parent
	return p
end
local function weld(a, b, c0)
	local w = Instance.new("Weld"); w.Part0, w.Part1, w.C0 = a, b, c0; w.Parent = b
	return w
end
local function onTap(fn)
	return UIS.InputBegan:Connect(function(i, gp)
		if gp then return end
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			fn(cam:ScreenPointToRay(i.Position.X, i.Position.Y))
		end
	end)
end
local function ray(r, ignore)
	local p = RaycastParams.new(); p.FilterDescendantsInstances = ignore
	return workspace:Raycast(r.Origin, r.Direction * 300, p)
end
local function header(t) lib:AddButton("━━ " .. t .. " ━━", function() end) end

---------------------------------------------------------------- 1) ASAS
local function deltaWing()
	toggle("Asa Delta", function()
		local add, clean = bag()
		local r = hrp()
		add(weld(r, add(mk(char(), Vector3.new(0.25, 0.25, 6), Color3.fromRGB(255, 255, 255), Enum.Material.Neon)), CFrame.new(0, 0.5, 2.5)))
		for _, s in ipairs({-1, 1}) do
			local p = add(mk(char(), Vector3.new(5, 0.12, 4.5), Color3.fromRGB(255, 70, 70), Enum.Material.Fabric))
			weld(r, p, CFrame.new(s * 3, 0.8, 1.6) * CFrame.Angles(math.rad(12), 0, -s * math.rad(8)))
		end
		add(RS.Heartbeat:Connect(function()
			local h, rr = hum(), hrp()
			if not (h and rr) then return end
			local v = rr.AssemblyLinearVelocity
			if h.FloorMaterial == Enum.Material.Air and v.Y < 0 then
				local look = cam.CFrame.LookVector * Vector3.new(1, 0, 1)
				if look.Magnitude > 0 then look = look.Unit end
				rr.AssemblyLinearVelocity = Vector3.new(look.X * 55, math.max(v.Y, -7), look.Z * 55)
			end
		end))
		return clean
	end)
end

local function angelWings()
	toggle("Asas de Anjo", function()
		local add, clean = bag()
		local r, fe = hrp(), {}
		for _, s in ipairs({-1, 1}) do
			for i = 1, 6 do
				local p = add(mk(char(), Vector3.new(0.25, 3 + i * 0.5, 0.08), Color3.new(1, 1, 1), Enum.Material.Neon))
				fe[#fe + 1] = {w = weld(r, p, CFrame.new()), s = s, i = i}
			end
		end
		local t0 = os.clock()
		add(RS.RenderStepped:Connect(function()
			local f = math.sin((os.clock() - t0) * 3) * 12
			for _, d in ipairs(fe) do
				local ang = math.rad(25 + d.i * 11 + f)
				d.w.C0 = CFrame.new(d.s * 0.7, 0.8 + d.i * 0.05, 0.6) * CFrame.Angles(0, 0, -d.s * ang) * CFrame.new(0, 1.5 + d.i * 0.25, 0)
			end
		end))
		return clean
	end)
end

---------------------------------------------------------------- 2) DRONE
local function drone(view)
	toggle(view and "Drone Câmera" or "Drone Companheiro", function()
		local add, clean = bag()
		local body = add(mk(workspace, Vector3.new(1.4, 0.5, 1.4), Color3.fromRGB(30, 30, 35), Enum.Material.Metal))
		local eye = add(mk(workspace, Vector3.new(0.5, 0.5, 0.5), Color3.fromRGB(255, 0, 60), Enum.Material.Neon))
		eye.Shape = Enum.PartType.Ball
		body.Anchored, eye.Anchored = true, true
		Instance.new("PointLight", eye).Color = Color3.fromRGB(255, 0, 60)
		local props = {}
		for i = 1, 4 do
			props[i] = add(mk(workspace, Vector3.new(1.1, 0.05, 0.2), Color3.fromRGB(200, 200, 200), Enum.Material.Neon))
			props[i].Anchored = true
		end
		body.CFrame = hrp().CFrame
		if view then
			cam.CameraSubject = body
			add(function() local h = hum() if h then cam.CameraSubject = h end end)
		end
		local t0 = os.clock()
		add(RS.RenderStepped:Connect(function(dt)
			local r = hrp(); if not r then return end
			local t = os.clock() - t0
			local target = view and (r.Position + Vector3.new(0, 16, 0))
				or (r.Position + Vector3.new(math.cos(t) * 4, 4 + math.sin(t * 2) * 0.6, math.sin(t) * 4))
			body.CFrame = CFrame.new(body.Position:Lerp(target, math.clamp(dt * 6, 0, 1))) * CFrame.Angles(math.sin(t * 2) * 0.15, 0, math.cos(t * 2) * 0.15)
			eye.CFrame = body.CFrame * CFrame.new(0, -0.35, -0.5)
			for i, p in ipairs(props) do
				local a = (i - 1) * math.pi / 2 + math.pi / 4
				p.CFrame = body.CFrame * CFrame.new(math.cos(a) * 1.1, 0.3, math.sin(a) * 1.1) * CFrame.Angles(0, t * 40 + i, 0)
			end
		end))
		return clean
	end)
end

---------------------------------------------------------------- 3) SPRAY
local sprayColors = {Color3.fromRGB(255, 0, 110), Color3.fromRGB(0, 229, 255), Color3.fromRGB(255, 230, 0), Color3.fromRGB(120, 255, 60), Color3.fromRGB(170, 80, 255)}
local sprayIdx, sprayFolder = 1, nil

local function sprayAt(pos, n, tag)
	if not sprayFolder or not sprayFolder.Parent then
		sprayFolder = Instance.new("Folder", workspace); sprayFolder.Name = "AngelSprays"
	end
	local col = sprayColors[sprayIdx]
	local up = math.abs(n.Y) > 0.95 and Vector3.new(0, 0, 1) or Vector3.yAxis
	local base = CFrame.lookAt(pos + n * 0.03, pos + n * 1.03, up)
	if tag then
		local p = Instance.new("Part")
		p.Size, p.Transparency, p.Anchored, p.CanCollide, p.CFrame = Vector3.new(5, 1.8, 0.05), 1, true, false, base
		p.Parent = sprayFolder
		local sg = Instance.new("SurfaceGui", p)
		sg.Face, sg.SizingMode, sg.PixelsPerStud, sg.LightInfluence = Enum.NormalId.Front, Enum.SurfaceGuiSizingMode.PixelsPerStud, 50, 0
		local l = Instance.new("TextLabel", sg)
		l.Size, l.BackgroundTransparency, l.Text, l.Font = UDim2.fromScale(1, 1), 1, "ANGEL", Enum.Font.Bangers
		l.TextScaled, l.TextColor3, l.TextStrokeTransparency, l.Rotation = true, col, 0, -6
	else
		for i = 1, 9 do
			local s = i == 1 and math.random(30, 45) / 10 or math.random(3, 12) / 10
			local off = i == 1 and Vector3.zero or Vector3.new(math.random(-20, 20) / 10, math.random(-20, 20) / 10, 0)
			local d = Instance.new("Part")
			d.Shape, d.Size, d.Color, d.Material = Enum.PartType.Cylinder, Vector3.new(0.04, s, s), col, Enum.Material.Neon
			d.Anchored, d.CanCollide = true, false
			d.CFrame = base * CFrame.new(off.X, off.Y, -i * 0.003) * CFrame.Angles(0, math.pi / 2, 0)
			d.Parent = sprayFolder
		end
	end
end

local function sprayMode(tag)
	toggle(tag and "Spray Tag ANGEL" or "Spray Splat", function()
		local add, clean = bag()
		add(onTap(function(rayData)
			local ig = {char()}
			if sprayFolder then ig[#ig + 1] = sprayFolder end
			local res = ray(rayData, ig)
			if res then sprayAt(res.Position, res.Normal, tag) end
		end))
		return clean
	end)
end

---------------------------------------------------------------- 4) PODERES
local function webSwing()
	toggle("Teia Homem-Aranha", function()
		local add, clean = bag()
		local a0 = add(Instance.new("Attachment", hrp()))
		local anchor
		local function release() if anchor then anchor:Destroy(); anchor = nil end end
		add(release)
		add(onTap(function(rayData)
			release()
			local r = hrp(); if not r then return end
			local res = ray(rayData, {char()})
			if not res then return end
			anchor = Instance.new("Part")
			anchor.Size, anchor.Anchored, anchor.CanCollide, anchor.Transparency, anchor.Position = Vector3.one * 0.3, true, false, 1, res.Position
			anchor.Parent = workspace
			local a1 = Instance.new("Attachment", anchor)
			local b = Instance.new("Beam", anchor)
			b.Attachment0, b.Attachment1, b.Width0, b.Width1, b.LightEmission, b.FaceCamera = a0, a1, 0.12, 0.12, 1, true
		end))
		add(UIS.JumpRequest:Connect(release))
		add(RS.Heartbeat:Connect(function(dt)
			local r = hrp(); if not (anchor and r) then return end
			local d = anchor.Position - r.Position
			if d.Magnitude < 4 then release() return end
			local v = r.AssemblyLinearVelocity + d.Unit * 140 * dt
			if v.Magnitude > 90 then v = v.Unit * 90 end
			r.AssemblyLinearVelocity = v
		end))
		return clean
	end)
end

local function blink()
	local r = hrp(); if not r then return end
	local look = cam.CFrame.LookVector * Vector3.new(1, 0, 1)
	if look.Magnitude == 0 then return end
	look = look.Unit
	local res = ray({Origin = r.Position, Direction = look * 35 / 300}, {char()})
	local dist = res and math.max(res.Distance - 3, 0) or 35
	local from = r.Position
	r.CFrame = r.CFrame + look * dist
	local line = Instance.new("Part")
	line.Anchored, line.CanCollide, line.Material, line.Color = true, false, Enum.Material.Neon, Color3.fromRGB(120, 200, 255)
	line.Size = Vector3.new(0.6, 0.6, math.max(dist, 0.1))
	line.CFrame = CFrame.lookAt(from, from + look) * CFrame.new(0, 0, -dist / 2)
	line.Parent = workspace
	TS:Create(line, TweenInfo.new(0.5), {Transparency = 1, Size = Vector3.new(0, 0, math.max(dist, 0.1))}):Play()
	Debris:AddItem(line, 0.6)
end

local function slam()
	local r, h = hrp(), hum(); if not (r and h) then return end
	r.AssemblyLinearVelocity = Vector3.new(0, 80, 0)
	task.spawn(function()
		task.wait(0.5)
		r.AssemblyLinearVelocity = Vector3.new(0, -200, 0)
		local t = os.clock()
		task.wait(0.1)
		repeat task.wait() until h.FloorMaterial ~= Enum.Material.Air or os.clock() - t > 3
		local ring = Instance.new("Part")
		ring.Shape, ring.Anchored, ring.CanCollide, ring.Material, ring.Color = Enum.PartType.Cylinder, true, false, Enum.Material.Neon, Color3.fromRGB(255, 140, 0)
		ring.Size = Vector3.new(0.3, 2, 2)
		ring.CFrame = CFrame.new(r.Position - Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0, math.pi / 2)
		ring.Parent = workspace
		TS:Create(ring, TweenInfo.new(0.6), {Size = Vector3.new(0.3, 40, 40), Transparency = 1}):Play()
		Debris:AddItem(ring, 0.7)
		for _ = 1, 10 do h.CameraOffset = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0); task.wait(0.03) end
		h.CameraOffset = Vector3.zero
	end)
end

local function levitate()
	toggle("Telecinese (flutuar)", function()
		local add, clean = bag()
		local rocks = {}
		for i = 1, 7 do
			rocks[i] = add(mk(workspace, Vector3.one * (0.5 + math.random() * 0.5), Color3.fromRGB(90, 90, 100), Enum.Material.Slate))
			rocks[i].Anchored = true
		end
		local t0 = os.clock()
		add(RS.Heartbeat:Connect(function()
			local r = hrp(); if not r then return end
			local t = os.clock() - t0
			local res = ray({Origin = r.Position, Direction = Vector3.new(0, -30, 0) / 300}, {char()})
			local ground = res and res.Position.Y or r.Position.Y - 3
			local v = r.AssemblyLinearVelocity
			r.AssemblyLinearVelocity = Vector3.new(v.X, (ground + 7 + math.sin(t * 2) - r.Position.Y) * 6, v.Z)
			for i, p in ipairs(rocks) do
				local a = t * 1.5 + i * (math.pi * 2 / #rocks)
				p.CFrame = CFrame.new(r.Position + Vector3.new(math.cos(a) * 5, math.sin(t + i) * 1.5 - 1, math.sin(a) * 5)) * CFrame.Angles(t, t * i * 0.3, 0)
			end
		end))
		return clean
	end)
end

