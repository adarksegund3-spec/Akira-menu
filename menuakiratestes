            bgGrad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, T.Bg), ColorSequenceKeypoint.new(1, T.Bg2)}
            bgGrad.Rotation = 90
            local boxStroke = Instance.new("UIStroke", box)
            boxStroke.Color = T.Border; boxStroke.Thickness = 2; boxStroke.Transparency = 0.2
            boxStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

            -- logo
            local logo = Instance.new("Frame", box)
            logo.Name = "Logo"; logo.AnchorPoint = Vector2.new(0.5, 0)
            logo.Size = UDim2.new(0, 70, 0, 70); logo.Position = UDim2.new(0.5, 0, 0, 24)
            logo.BackgroundColor3 = T.Panel; logo.BorderSizePixel = 0
            Instance.new("UICorner", logo).CornerRadius = UDim.new(0, 16)
            local logoStroke = Instance.new("UIStroke", logo)
            logoStroke.Color = T.Border; logoStroke.Thickness = 1.5; logoStroke.Transparency = 0.2
            local logoImg = Instance.new("ImageLabel", logo)
            logoImg.AnchorPoint = Vector2.new(0.5, 0.5); logoImg.Position = UDim2.new(0.5, 0, 0.5, 0)
            logoImg.Size = UDim2.new(1, -10, 1, -10); logoImg.BackgroundTransparency = 1
            logoImg.Image = LOGO_ID; logoImg.ScaleType = Enum.ScaleType.Crop
            Instance.new("UICorner", logoImg).CornerRadius = UDim.new(0, 12)

            -- textos
            local function txt(text, size, color, font, y, h)
                local l = Instance.new("TextLabel", box)
                l.Size = UDim2.new(1, -40, 0, h); l.Position = UDim2.new(0, 20, 0, y)
                l.BackgroundTransparency = 1; l.Text = text; l.TextColor3 = color
                l.TextSize = size; l.Font = font; l.TextXAlignment = Enum.TextXAlignment.Center
                return l
            end
            txt(SplashCfg.HubName, 28, T.Text, Enum.Font.GothamBold, 102, 35)
            txt(SplashCfg.Subtitle, 12, T.Sub, Enum.Font.Gotham, 138, 18)

            -- barra de progresso
            local track = Instance.new("Frame", box)
            track.Name = "Track"; track.Size = UDim2.new(1, -60, 0, 6); track.Position = UDim2.new(0, 30, 0, 172)
            track.BackgroundColor3 = T.Track; track.BorderSizePixel = 0
            Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
            local glow = Instance.new("UIStroke", track)
            glow.Color = T.Accent; glow.Thickness = 4; glow.Transparency = 1

            local fill = Instance.new("Frame", track)
            fill.Name = "Fill"; fill.Size = UDim2.new(0, 0, 1, 0); fill.BackgroundColor3 = T.Accent
            fill.BorderSizePixel = 0; fill.ClipsDescendants = true
            Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
            local fillGrad = Instance.new("UIGradient", fill)
            fillGrad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, T.AccentD), ColorSequenceKeypoint.new(1, T.Accent)}

            local shine = Instance.new("Frame", fill)
            shine.Name = "progressShine"; shine.Size = UDim2.new(0.4, 0, 1, 0)
            shine.Position = UDim2.new(-1, 0, 0, 0); shine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            shine.BackgroundTransparency = 0.6; shine.BorderSizePixel = 0
            Instance.new("UICorner", shine).CornerRadius = UDim.new(1, 0)
            Instance.new("UIGradient", shine).Transparency = NumberSequence.new{
                NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1),
            }

