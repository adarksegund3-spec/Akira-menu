-- ============================================
-- FUNÇÃO COPIAR
-- ============================================

local function copiarTexto(txt)
    local ok = false
    if setclipboard then
        ok = pcall(setclipboard, txt)
    end
    if not ok and toclipboard then
        ok = pcall(toclipboard, txt)
    end
    if not ok and syn and syn.write_clipboard then
        ok = pcall(syn.write_clipboard, txt)
    end
    if not ok then
        if writeclipboard then
            ok = pcall(writeclipboard, txt)
        end
    end
    if not ok then
        if set_clipboard then
            ok = pcall(set_clipboard, txt)
        end
    end
    return ok
end

