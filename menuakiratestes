RecordBtn.MouseButton1Click:Connect(function()
    if playbackConnection then stopPlayback() end
    isRecording = not isRecording

    if isRecording then
        recordedData = {}
        startTime = os.clock()
        startTimer()
        RecordBtn.Text = "■ PARAR"
        RecordBtn.BackgroundColor3 = Color3.fromRGB(170, 0, 0)

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        if not hrp or not hum then
            isRecording = false
            stopTimer()
            RecordBtn.Text = "● GRAVAR"
            RecordBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
            StatusLabel.Text = "Sem personagem!"
            return
        end

        -- Aplica slow-motion (WalkSpeed + Gravity)
        applySlowMotion()
        if slowFactor < 0.99 then
            StatusLabel.Text = string.format("Gravando %s", SlowValue.Text)
        else
            StatusLabel.Text = "Gravando..."
        end

        recordingConnection = RunService.Heartbeat:Connect(function()
            local currentTime = os.clock() - startTime  -- tempo REAL (slow) do gravação
            local cf = hrp.CFrame
            local vel = hrp.AssemblyLinearVelocity
            local state = hum:GetState()
            local anims = {}
            local animator = hum:FindFirstChildOfClass("Animator")
            if animator then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    if track.Animation and track.WeightCurrent > 0.01 then
                        table.insert(anims, {
                            Id = track.Animation.AnimationId,
                            Speed = track.Speed,
                            Weight = track.WeightCurrent,
                            Priority = track.Priority.Name
                        })
                    end
                end
            end
            table.insert(recordedData, {
                Time = currentTime,
                CF = {cf:GetComponents()},
                Velocity = {vel.X, vel.Y, vel.Z},
                State = state,
                Animations = anims
            })
        end)
    else
        if recordingConnection then
            recordingConnection:Disconnect()
            recordingConnection = nil
        end

        -- Remove slow-motion (restaura WalkSpeed/Gravity originais)
        removeSlowMotion()

        -- Pós-processa: converte timestamps e velocidades de slow → normal
        local factor = slowFactor
        if factor < 0.99 then
            for _, node in ipairs(recordedData) do
                node.Time = node.Time * factor
                if node.Velocity then
                    node.Velocity[1] = node.Velocity[1] / factor
                    node.Velocity[2] = node.Velocity[2] / factor
                    node.Velocity[3] = node.Velocity[3] / factor
                end
            end
        end

        stopTimer()
        RecordBtn.Text = "● GRAVAR"
        RecordBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        StatusLabel.Text = string.format("OK! %.2fs (%d pts)", timerFrozen, #recordedData)
    end
end)

