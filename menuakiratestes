            for _, c in ipairs(box:GetDescendants()) do
                if c:IsA("TextLabel") then tw(c, ot * 0.8, {TextTransparency = 1})
                elseif c:IsA("ImageLabel") then tw(c, ot * 0.8, {ImageTransparency = 1})
                elseif c:IsA("Frame") then tw(c, ot * 0.8, {BackgroundTransparency = 1})
                elseif c:IsA("UIStroke") then tw(c, ot * 0.8, {Transparency = 1}) end
            end
            tw(box, ot, {Size = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back, Enum.EasingDirection.In).Completed:Wait()
