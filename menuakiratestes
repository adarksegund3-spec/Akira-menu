local function new(class,props,parent)
    local o=Instance.new(class)
    for k,v in pairs(props) do o[k]=v end
    if parent then o.Parent=parent end
    return o
end
local function corner(o,r) return new("UICorner",{CornerRadius=UDim.new(0,r or 8)},o) end
local function stroke(o,c,th,tr)
    return new("UIStroke",{Color=c,Thickness=th or 1,Transparency=tr or 0,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},o)
end
local function label(parent,props)
    props.BackgroundTransparency=1
    props.Font=props.Font or GR
    props.TextColor3=props.TextColor3 or T.text
    props.TextSize=props.TextSize or 12
    return new("TextLabel",props,parent)
end

