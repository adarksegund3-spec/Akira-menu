-- ABRIR / FECHAR MENU (animacoes)
--------------------------------------------------------------------
local isOpen = false
local animating = false
local shineStart = os.clock()

local function showLogo()
    Logo.Visible = true
    logoScale.Scale = 0
    tweenEx(logoScale, 0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, { Scale = 1 })
end

local function openMenu()
    if animating or isOpen then return end
    animating = true
    isOpen = true

    -- logo encolhe e some
    tweenEx(logoScale, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, { Scale = 0 })

    task.delay(0.12, function()
        Logo.Visible = false
        holderScale.Scale = 0.86
        Holder.GroupTransparency = 1
        Hotbar.Position = UDim2.new(0.5, 0, 0, HOTBAR_Y_HIDDEN)
        Holder.Visible = true
        shineStart = os.clock()

        tweenEx(Holder, 0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, { GroupTransparency = 0 })
        tweenEx(holderScale, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, { Scale = 1 })
        tweenEx(Hotbar, 0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0.14,
            { Position = UDim2.new(0.5, 0, 0, HOTBAR_Y) })

        task.delay(0.7, function() animating = false end)
    end)
end

local function closeMenu()
    if animating or not isOpen then return end
    animating = true
    isOpen = false


    tweenEx(Hotbar, 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0,
        { Position = UDim2.new(0.5, 0, 0, HOTBAR_Y_HIDDEN) })
    tweenEx(Holder, 0.26, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0.08, { GroupTransparency = 1 })
    tweenEx(holderScale, 0.34, Enum.EasingStyle.Back, Enum.EasingDirection.In, 0, { Scale = 0.86 })

    task.delay(0.38, function()
        Holder.Visible = false
        showLogo()
        task.delay(0.4, function() animating = false end)
    end)
end

CloseBtn.MouseButton1Click:Connect(closeMenu)

-- logo: arrasta e, se for so um toque, abre o menu
makeDrag(Logo, Logo, openMenu,
    function() if not isOpen then tween(logoScale, 0.1, { Scale = 0.94 }) end end,
    function() if not isOpen then tween(logoScale, 0.15, { Scale = 1 }) end end)

-- entrada da logo ao executar
task.delay(0.15, function()
    tweenEx(logoScale, 0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, { Scale = 1 })
end)

