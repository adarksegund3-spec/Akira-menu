-- MOVIMENTO
-- ═══════════════════════════════════════════════════════════════
local function getHum()
    local c = LocalPlayer.Character
    if not c then return nil end
    return c:FindFirstChildOfClass("Humanoid")
end

local function setSpeed(on)
    Config.SpeedEnabled = on
    local hum = getHum()
    if on then
        if hum then
            MState.SavedWalk = hum.WalkSpeed
            hum.WalkSpeed = Config.SpeedValue
        end
    else
        if hum then hum.WalkSpeed = MState.SavedWalk or DEFAULT_WALKSPEED end
        MState.SavedWalk = nil
    end
end

local function setJump(on)
    Config.JumpEnabled = on
    local hum = getHum()
    if on then
        if hum then
            MState.SavedJump = hum.JumpPower
            MState.SavedUseJump = hum.UseJumpPower
            hum.UseJumpPower = true
            hum.JumpPower = Config.JumpValue
        end
    else
        if hum then
            hum.JumpPower = MState.SavedJump or DEFAULT_JUMPPOWER
            hum.UseJumpPower = MState.SavedUseJump
        end
        MState.SavedJump = nil
    end
end

local function setInfJump(on)
    Config.InfJump = on
    if on then
        if MState.InfJumpConn then return end
        MState.InfJumpConn = UserInputService.JumpRequest:Connect(function()
            if not Config.InfJump then return end
            local hum = getHum()
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end)
    else
        if MState.InfJumpConn then MState.InfJumpConn:Disconnect(); MState.InfJumpConn = nil end
    end
end

local function setNoclip(on)
    Config.Noclip = on
    if on then
        if MState.NoclipConn then return end
        MState.NoclipConn = RunService.Stepped:Connect(function()
            if not Config.Noclip then return end
            local ch = LocalPlayer.Character
            if not ch then return end
            for _, part in ipairs(ch:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end)
    else
        if MState.NoclipConn then MState.NoclipConn:Disconnect(); MState.NoclipConn = nil end
        local ch = LocalPlayer.Character
        if ch then
            for _, part in ipairs(ch:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
        end
    end
end

