        ligarAntiTp()
        ligarRemoverTexto()
        ligarNoclip()
    else
        desligarNoclip()
    end
    atualizarBotao()
end)

-- Desliga TUDO e fecha o menu
local function desligarTudo()
    noclipAtivo = false
    desligarAntiTp()
    desligarRemoverTexto()
    desligarNoclip()
end

local function limpar()
    desligarTudo()
    if espacoConn then espacoConn:Disconnect() end
    if ScreenGui.Parent then ScreenGui:Destroy() end
end

CloseBtn.MouseButton1Click:Connect(limpar)
