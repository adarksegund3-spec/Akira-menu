nextBtn.MouseButton1Click:Connect(function() goPage(1) end)

clearBtn.MouseButton1Click:Connect(function()
    Catalog.dbToken = Catalog.dbToken + 1
    Catalog.state.query = ""; Catalog.state.page = 1
    searchInput.Text = "" -- o handler vê query igual e não dispara outra busca
    loadPage(1)
end)

