--------------------------------------------------------------------
-- HITBOX (modulo INDEPENDENTE: ScreenGui proprio, loop proprio,
-- tudo protegido com pcall. Se algo falhar, o menu principal segue ok)
--------------------------------------------------------------------
local HitboxMenu = { onStatus = nil }

do
    local cfg = { Enabled = false, Size = 6, Transparency = 0.6, Color = GREEN }
    local MIN_SIZE, MAX_SIZE = 2, 25
    local originals = {}
    local conns = {}
    local hbGui, panel, hitScale
    local alive = false
    local opened = false

    ----------------------------------------------------------------
    -- logica (leve: so escreve quando algo muda, 4x por segundo)
    ----------------------------------------------------------------
    local function signature()
        local c = cfg.Color
        return string.format("%d|%.2f|%d,%d,%d", cfg.Size, cfg.Transparency,
            math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
    end

    local function applyOne(plr)
        if plr == LocalPlayer then return end
        local char = plr.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp or not hrp:IsA("BasePart") then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then return end

        local o = originals[hrp]
        if not o then
            o = {
                Size = hrp.Size, Transparency = hrp.Transparency, Color = hrp.Color,
                CanCollide = hrp.CanCollide, Massless = hrp.Massless, sig = "",
            }
            originals[hrp] = o
        end

        local s = cfg.Size
        local target = Vector3.new(s, s, s)
        local sig = signature()
        if o.sig == sig and hrp.Size == target then return end -- nada mudou
        o.sig = sig

        hrp.Massless = true      -- nao pesa: evita bagunçar a fisica
        hrp.CanCollide = false
        hrp.Size = target
        hrp.Transparency = cfg.Transparency
        hrp.Color = cfg.Color
    end

    local function restoreAll()
        local snapshot = originals
        originals = {}
        for hrp, o in pairs(snapshot) do
            if hrp and hrp.Parent then
                pcall(function()
                    hrp.Size = o.Size
                    hrp.Transparency = o.Transparency
                    hrp.Color = o.Color
                    hrp.CanCollide = o.CanCollide
                    hrp.Massless = o.Massless
                end)
            end
        end
    end

    local function startLoop()
        task.spawn(function()
            while alive do
                task.wait(0.25)
                if cfg.Enabled then
                    for _, plr in ipairs(Players:GetPlayers()) do
                        pcall(applyOne, plr)
                    end
                    for hrp in pairs(originals) do
                        if not hrp.Parent then originals[hrp] = nil end
                    end
                end
            end
        end)
    end

    ----------------------------------------------------------------
    -- interface
    ----------------------------------------------------------------
    local function parentGui(g)
        local targets = {}
        if gethui then table.insert(targets, function() return gethui() end) end
        table.insert(targets, function() return game:GetService("CoreGui") end)
        table.insert(targets, function() return LocalPlayer:WaitForChild("PlayerGui") end)
        for _, get in ipairs(targets) do
            local ok, target = pcall(get)
            if ok and target then
                local ok2 = pcall(function() g.Parent = target end)
                if ok2 and g.Parent == target then return true end
            end
        end
        return false
    end

    local function bindSlide(hit, track, setRel)
        local dragging = false
        local function fromInput(input)
            setRel((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1))
        end
        hit.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                fromInput(input)
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then dragging = false end
                end)
            end
        end)
        table.insert(conns, UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                fromInput(input)
            end
        end))
    end

    local function makeKnob(track)
        local k = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.fromRGB(235, 255, 245),
            BorderSizePixel = 0, ZIndex = 2,
        }, track)
        corner(k, 8)
        stroke(k, GREEN, 1.5, 0)
        return k
    end

    local function build()
        local g = new("ScreenGui", {
            Name = "AngelHitboxGui", ResetOnSpawn = false, IgnoreGuiInset = true,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 1000,
        })

        local p = new("Frame", {
            Name = "HitboxPanel", AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.fromOffset(300, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BorderSizePixel = 0, ClipsDescendants = true, Active = true, Visible = false,
        }, g)
        corner(p, 18)
        new("UIGradient", {
            Rotation = 65,
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(6, 7, 7)),
                ColorSequenceKeypoint.new(0.55, Color3.fromRGB(10, 14, 12)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(34, 82, 58)),
            }),
        }, p)
        local pStroke = stroke(p, Color3.fromRGB(255, 255, 255), 1.5, 0.15)
        local pStrokeGrad = strokeGradient(pStroke)
        local pShine = addShine(p)
        local pScale = new("UIScale", { Scale = 0 }, p)

        local titleBar = new("Frame", {
            Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1,
        }, p)
        local d = new("Frame", {
            Size = UDim2.fromOffset(8, 8), Position = UDim2.new(0, 16, 0.5, -4),
            BackgroundColor3 = GREEN, BorderSizePixel = 0,
        }, titleBar)
        corner(d, 4)
        local t = label(titleBar, "HITBOX", 15, Enum.Font.GothamBold, TEXT)
        t.Position = UDim2.new(0, 32, 0, 0)
        t.Size = UDim2.new(1, -90, 1, 0)

        local closeBtn = new("TextButton", {
            Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -40, 0.5, -14),
            BackgroundColor3 = Color3.fromRGB(22, 28, 25), AutoButtonColor = false,
            Text = "X", TextSize = 13, Font = Enum.Font.GothamBold, TextColor3 = MUTED,
        }, titleBar)
        corner(closeBtn, 14)
        stroke(closeBtn, GREEN, 1, 0.8)
        closeBtn.MouseEnter:Connect(function() tween(closeBtn, 0.15, { TextColor3 = GREEN }) end)
        closeBtn.MouseLeave:Connect(function() tween(closeBtn, 0.15, { TextColor3 = MUTED }) end)
        closeBtn.MouseButton1Click:Connect(function() HitboxMenu.close() end)

        new("Frame", {
            Size = UDim2.new(1, -32, 0, 1), Position = UDim2.new(0, 16, 0, 44),
            BackgroundColor3 = GREEN, BackgroundTransparency = 0.85, BorderSizePixel = 0,
        }, p)

        makeDrag(titleBar, p, nil, nil, nil, conns)

        local list = new("Frame", {
            BackgroundTransparency = 1, Position = UDim2.new(0, 14, 0, 54),
            Size = UDim2.new(1, -28, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        }, p)
        new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, list)

        local function row(order, height)
            local r = new("Frame", {
                LayoutOrder = order, Size = UDim2.new(1, 0, 0, height),
                BackgroundColor3 = CARD, BackgroundTransparency = 0.1, BorderSizePixel = 0,
            }, list)
            corner(r, 12)
            stroke(r, GREEN, 1, 0.82)
            return r
        end

        -- 1) liga/desliga
        local tr = row(1, 44)
        local tl = label(tr, "Ativar hitbox", 13, Enum.Font.GothamMedium, TEXT)
        tl.Position = UDim2.new(0, 14, 0, 0)
        tl.Size = UDim2.new(1, -80, 1, 0)
        local sw = new("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
            Size = UDim2.fromOffset(44, 24), BackgroundColor3 = TRACK,
            AutoButtonColor = false, Text = "",
        }, tr)
        corner(sw, 12)
        local swKnob = new("Frame", {
            Size = UDim2.fromOffset(18, 18), Position = UDim2.new(0, 3, 0.5, -9),
            BackgroundColor3 = MUTED, BorderSizePixel = 0,
        }, sw)
        corner(swKnob, 9)

        local function setEnabled(v)
            cfg.Enabled = v
            tween(sw, 0.18, { BackgroundColor3 = v and GREEN or TRACK })
            tween(swKnob, 0.18, {
                Position = v and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
                BackgroundColor3 = v and Color3.fromRGB(8, 18, 12) or MUTED,
            })
            if not v then
                task.spawn(function() pcall(restoreAll) end)
            end
            if HitboxMenu.onStatus then pcall(HitboxMenu.onStatus, v) end
        end
        -- a hitbox em si e aplicada pelo loop (fora do clique), entao o clique nunca trava
        sw.MouseButton1Click:Connect(function() setEnabled(not cfg.Enabled) end)

        -- 2) sliders
        local function slider(order, name, min, max, default, decimals, suffix, onChange)
            local r = row(order, 54)
            local nl = label(r, name, 12, Enum.Font.GothamMedium, MUTED)
            nl.Position = UDim2.new(0, 14, 0, 8)
            nl.Size = UDim2.new(0.5, 0, 0, 16)
            local vl = label(r, "", 12, Enum.Font.GothamBold, GREEN)
            vl.TextXAlignment = Enum.TextXAlignment.Right
            vl.Position = UDim2.new(0.5, 0, 0, 8)
            vl.Size = UDim2.new(0.5, -14, 0, 16)

            local track = new("Frame", {
                Position = UDim2.new(0, 14, 0, 36), Size = UDim2.new(1, -28, 0, 6),
                BackgroundColor3 = TRACK, BorderSizePixel = 0,
            }, r)
            corner(track, 3)
            local fill = new("Frame", {
                Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = GREEN, BorderSizePixel = 0,
            }, track)
            corner(fill, 3)
            new("UIGradient", {
                Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(70, 200, 130)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 255, 210)),
                }),
            }, fill)
            local knob = makeKnob(track)
            local hit = new("TextButton", {
                Position = UDim2.new(0, 6, 0, 24), Size = UDim2.new(1, -12, 0, 28),
                BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 3,
            }, r)

            local fmt = "%." .. decimals .. "f"
            local function render(rel, value)
                fill.Size = UDim2.new(rel, 0, 1, 0)
                knob.Position = UDim2.new(rel, 0, 0.5, 0)
                vl.Text = string.format(fmt, value) .. suffix
            end
            render((default - min) / (max - min), default)

            bindSlide(hit, track, function(rel)
                rel = math.clamp(rel, 0, 1)
                local value = tonumber(string.format(fmt, min + (max - min) * rel))
                render(rel, value)
                onChange(value)
            end)
        end

        slider(2, "Tamanho", MIN_SIZE, MAX_SIZE, cfg.Size, 0, " studs", function(v) cfg.Size = v end)
        slider(3, "Transpar\u{00EA}ncia", 0, 1, cfg.Transparency, 2, "", function(v) cfg.Transparency = v end)

        -- 3) cor
        do
            local r = row(4, 102)
            local nl = label(r, "Cor", 12, Enum.Font.GothamMedium, MUTED)
            nl.Position = UDim2.new(0, 14, 0, 8)
            nl.Size = UDim2.new(0.5, 0, 0, 16)

            local preview = new("Frame", {
                AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 8),
                Size = UDim2.fromOffset(36, 16), BackgroundColor3 = cfg.Color, BorderSizePixel = 0,
            }, r)
            corner(preview, 8)
            stroke(preview, Color3.fromRGB(255, 255, 255), 1, 0.7)

            local track = new("Frame", {
                Position = UDim2.new(0, 14, 0, 38), Size = UDim2.new(1, -28, 0, 8),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0,
            }, r)
            corner(track, 4)
            local kp = {}
            for i = 0, 6 do
                table.insert(kp, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 0.7, 1)))
            end
            new("UIGradient", { Color = ColorSequence.new(kp) }, track)
            local knob = makeKnob(track)
            local hit = new("TextButton", {
                Position = UDim2.new(0, 6, 0, 26), Size = UDim2.new(1, -12, 0, 32),
                BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 3,
            }, r)

            local function setColor(c, moveKnob)
                cfg.Color = c
                preview.BackgroundColor3 = c
                if moveKnob then
                    local h, s = c:ToHSV()
                    if s > 0.15 then knob.Position = UDim2.new(h, 0, 0.5, 0) end
                end
            end
            setColor(cfg.Color, true)

            bindSlide(hit, track, function(rel)
                rel = math.clamp(rel, 0, 1)
                knob.Position = UDim2.new(rel, 0, 0.5, 0)
                setColor(Color3.fromHSV(rel, 0.7, 1), false)
            end)

            local presets = new("Frame", {
                Position = UDim2.new(0, 14, 0, 66), Size = UDim2.new(1, -28, 0, 26),
                BackgroundTransparency = 1,
            }, r)
            new("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal,
                Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
            }, presets)

            local colors = {
                GREEN,
                Color3.fromRGB(255, 70, 70),
                Color3.fromRGB(70, 150, 255),
                Color3.fromRGB(190, 100, 255),
                Color3.fromRGB(255, 220, 70),
                Color3.fromRGB(255, 255, 255),
            }
            for i, c in ipairs(colors) do
                local b = new("TextButton", {
                    LayoutOrder = i, Size = UDim2.fromOffset(30, 26),
                    BackgroundColor3 = c, AutoButtonColor = false, Text = "",
                }, presets)
                corner(b, 8)
                stroke(b, Color3.fromRGB(255, 255, 255), 1, 0.75)
                b.MouseButton1Click:Connect(function() setColor(c, true) end)
            end
        end

        new("Frame", {
            LayoutOrder = 99, Size = UDim2.new(1, 0, 0, 6), BackgroundTransparency = 1,
        }, list)

        -- animacao continua (so enquanto o painel esta aberto)
        table.insert(conns, RunService.Heartbeat:Connect(function()
            if not opened then return end
            local now = os.clock()
            pStrokeGrad.Rotation = (now * 50) % 360
            pShine.Offset = Vector2.new(math.min(1, -1 + ((now % 6) / 6) * 3), 0)
        end))

        if not parentGui(g) then
            g:Destroy()
            error("nao foi possivel anexar a GUI")
        end

        g.Destroying:Connect(function()
            alive = false
            cfg.Enabled = false
            pcall(restoreAll)
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            conns = {}
        end)

        -- so publica o estado quando tudo deu certo
        hbGui, panel, hitScale = g, p, pScale
        alive = true
        startLoop()
    end

    ----------------------------------------------------------------
    -- API publica
    ----------------------------------------------------------------
    function HitboxMenu.open()
        if not hbGui then
            local ok, err = pcall(build)
            if not ok then
                warn("[Hitbox] falha ao criar o menu: " .. tostring(err))
                return false
            end
        end
        if opened then return true end
        opened = true
        panel.Visible = true
        hitScale.Scale = 0.85
        tweenEx(hitScale, 0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, { Scale = 1 })
        return true
    end

    function HitboxMenu.close()
        if not opened or not hitScale then return end
        opened = false
        tweenEx(hitScale, 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, { Scale = 0 })
        task.delay(0.24, function()
            if not opened and panel then panel.Visible = false end
        end)
    end

    function HitboxMenu.toggle()
        if opened then HitboxMenu.close() else HitboxMenu.open() end
    end

    function HitboxMenu.destroy()
        alive = false
        cfg.Enabled = false
        pcall(restoreAll)
        if hbGui then pcall(function() hbGui:Destroy() end) end
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        conns = {}
    end
end

