local saved = {}
local function restoreOutfit()
	local c = char(); if not c then return end
	for _, o in ipairs(c:GetDescendants()) do if o:GetAttribute("AngelFit") then o:Destroy() end end
	local bc = c:FindFirstChildOfClass("BodyColors")
	if saved.bc and bc then for k, v in pairs(saved.bc) do bc[k] = v end end
	for _, o in ipairs(saved.cloth or {}) do o.Parent = c end
	local f = c:FindFirstChild("Head") and c.Head:FindFirstChild("face")
	if f then f.Transparency = 0 end
	saved = {}
end

local function acc(partName, size, color, mat, cf)
	local c = char(); local base = c and c:FindFirstChild(partName)
	if not base then return end
	local p = mk(c, size, color, mat); p:SetAttribute("AngelFit", true)
	weld(base, p, cf)
	return p
end

