	local t = Player.current()
	if not t then return end
	pTitle.Text, pArtist.Text = t.title, t.artist
	pCover.Image = CFG.LOGO; Img.apply(pCover, t)
	tDur.Text = fmt(t.duration); tCur.Text = "0:00"; barFill.Size = UDim2.fromScale(0, 1)
