local function jmTrack(t)
	if type(t) ~= "table" or not t.id then return nil end
	return { id = "jm" .. tostring(t.id), title = tostring(t.name or "Sem título"),
		artist = tostring(t.artist_name or "Desconhecido"), duration = tonumber(t.duration) or 0,
		art = (type(t.image) == "string" and t.image ~= "" and t.image) or (type(t.album_image) == "string" and t.album_image ~= "" and t.album_image) or nil,
		streamable = true, source = "jamendo", audio = type(t.audio) == "string" and t.audio or "" }
end
local function jmGet(endpoint, params)
	if not CFG.USE_JAMENDO then return nil, "INVALID" end
	local parts = { "client_id=" .. CFG.JAMENDO_ID, "format=json", "audioformat=mp32", "imagesize=200" }
	for k, v in pairs(params or {}) do
		table.insert(parts, HttpService:UrlEncode(tostring(k)) .. "=" .. HttpService:UrlEncode(tostring(v)))
	end
	local res, err = Http.raw("https://api.jamendo.com/v3.0/" .. endpoint .. "?" .. table.concat(parts, "&"), false)
	if not res then return nil, err end
	local code = res.StatusCode or 0
	if code == 429 then return nil, "RATE" end
	if code >= 500 then return nil, "SERVER" end
	if code < 200 or code >= 300 then return nil, "HTTP_" .. tostring(code) end
	local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body or "")
	if not ok or type(data) ~= "table" or type(data.results) ~= "table" then return nil, "INVALID" end
	if type(data.headers) == "table" and data.headers.status == "failed" then return nil, "AUTH" end
	return data.results
end
