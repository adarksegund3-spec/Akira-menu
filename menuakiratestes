--// Análise Profunda - Zona Prisional
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

local function out(t) print(t) end

local function scanProfundo()
	local relatorio = {}
	local add = function(s) table.insert(relatorio, s) end

	add("=== ANÁLISE PROFUNDA ===")

	------------------------------------------------
	-- 1. SpawnLocation "Prisão"
	------------------------------------------------
	add("\n[1] SPAWN PRISÃO")
	local spawnPrisao
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("SpawnLocation") and string.find(string.lower(d.Name), "pris") then
			spawnPrisao = d
			break
		end
	end
	if spawnPrisao then
		add(string.format("  Nome: %s", spawnPrisao.Name))
		add(string.format("  Posição: X=%.1f Y=%.1f Z=%.1f",
			spawnPrisao.Position.X, spawnPrisao.Position.Y, spawnPrisao.Position.Z))
		add(string.format("  Neutral: %s | TeamColor: %s",
			tostring(spawnPrisao.Neutral), tostring(spawnPrisao.TeamColor)))
		add(string.format("  Parent: %s", spawnPrisao.Parent and spawnPrisao.Parent:GetFullName() or "nil"))
	else
		add("  Não achou SpawnLocation 'Prisão'.")
	end

	------------------------------------------------
	-- 2. PrisonZone Folder
	------------------------------------------------
	add("\n[2] CONTEÚDO DE 'PrisonZone'")
	local pz
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("Folder") and d.Name == "PrisonZone" then pz = d break end
	end
	if pz then
		local function listar(obj, rec)
			rec = rec or 0
			for _, ch in ipairs(obj:GetChildren()) do
				local prefix = string.rep("  ", rec + 1)
				add(prefix .. "• " .. ch.Name .. " [" .. ch.ClassName .. "]")
				if ch:IsA("BasePart") then
					add(prefix .. "   pos: " .. tostring(ch.Position))
				end
				if rec < 2 and #ch:GetChildren() > 0 then
					listar(ch, rec + 1)
				end
			end
		end
		listar(pz)
	else
		add("  PrisonZone não encontrada.")
	end

	------------------------------------------------
	-- 3. RemoteEvents / RemoteFunctions suspeitos
	------------------------------------------------
	add("\n[3] REMOTES SUSPEITOS")
	local remotes = {}
	local function scanRemotes(root, path)
		for _, obj in ipairs(root:GetChildren()) do
			if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
				local n = string.lower(obj.Name)
				local palavras = {"pris","jail","cell","escape","arrest","cuff","catch","teleport","tp","respawn","kill","wanted","trap","detain","fugir","soltar","libert"}
				for _, p in ipairs(palavras) do
					if string.find(n, p, 1, true) then
						table.insert(remotes, obj:GetFullName() .. " [" .. obj.ClassName .. "]")
						break
					end
				end
			end
			pcall(function() scanRemotes(obj, path) end)
		end
	end
	scanRemotes(game:GetService("ReplicatedStorage"))
	scanRemotes(workspace)
	if #remotes == 0 then
		add("  Nenhum remote com nome suspeito.")
	else
		for _, r in ipairs(remotes) do add("  ⚠ " .. r) end
	end

	------------------------------------------------
	-- 4. ProximityPrompts na área prisional
	------------------------------------------------
	add("\n[4] PROXIMITYPROMPTS PERTO DA PRISÃO")
	if spawnPrisao then
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("ProximityPrompt") then
				local part = d.Parent
				if part and part:IsA("BasePart") then
					local dist = (part.Position - spawnPrisao.Position).Magnitude
					if dist < 200 then
						add(string.format("  • %s (%.0f studs) → Action: %s",
							part.Name, dist, d.ActionText))
					end
				end
			end
		end
	end

	------------------------------------------------
	-- 5. Estado atual do player
	------------------------------------------------
	add("\n[5] SEU ESTADO")
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		local p = char.HumanoidRootPart.Position
		add(string.format("  Posição: X=%.1f Y=%.1f Z=%.1f", p.X, p.Y, p.Z))
		if spawnPrisao then
			local dist = (p - spawnPrisao.Position).Magnitude
			add(string.format("  Distância do Spawn Prisão: %.1f studs", dist))
			if dist < 100 then
				add("  🔴 VOCÊ ESTÁ PRESO (dentro do raio)")
			else
				add("  🟢 Fora do raio prisional")
			end
		end
	end
	add(string.format("  Time: %s", LocalPlayer.Team and LocalPlayer.Team.Name or "nil"))
	add(string.format("  TeamColor: %s", tostring(LocalPlayer.TeamColor)))

	return table.concat(relatorio, "\n")
end

print(scanProfundo())