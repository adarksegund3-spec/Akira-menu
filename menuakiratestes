        Btn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        Btn.Text = "Anti-Prisão: LIGADO"
        iniciarProtecoes()
        ligarNoclip()
    else
        Btn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
        Btn.Text = "Anti-Prisão: DESLIGADO"
        desligarNoclip() -- só o noclip desliga; Anti-TP, pulo e texto continuam
    end
end)