-- ===================== DETECTOR OCULTO + DIAGNOSTICO =====================
-- Sem tela e sem mensagem. Registra TODA bolha (ImageButton em Polichinelos.Screen) no instante em
-- que ela nasce, mesmo minuscula, invisivel ou ainda sem texto, e escolhe sempre a mais antiga que
-- ainda nao foi clicada (nenhuma fica pra tras). Guarda estatisticas: quantas viu, quantas clicou,
-- quantas sumiram sem clique e o atraso real entre "podia clicar" e o clique.
local bubbleInfo = setmetatable({}, {__mode = "k"})
local learnedDanger = SAFE_WAIT -- idade (s) a partir da qual uma bolha pendente vira URGENTE (aprendida das que sumiram)
local diag = env.__AtividadesDiag or {seen = 0, clicked = 0, missed = 0, retries = 0, urgent = 0, lateSum = 0, lateMax = 0, lifeMin = nil}
env.__AtividadesDiag = diag

local lastClick = 0 -- instante do ultimo clique (declarado aqui para o log das perdas)
-- estado do log (botao COPIAR LOG): travadas de frame, pendentes na tela, eventos de perda
local diagState = env.__AtividadesState or {t0 = os.clock(), pending = 0, hasHead = false, stall = nil, stalls = 0, stallMax = 0, notCounted = 0, paths = {}, lastPath = nil}
diagState.paths = diagState.paths or {}
env.__AtividadesState = diagState
local events = env.__AtividadesEvents or {}
env.__AtividadesEvents = events

local function logEvent(s)
    table.insert(events, s)
    if #events > 40 then table.remove(events, 1) end
end

local function diagReset()
    diag.seen, diag.clicked, diag.missed, diag.retries, diag.urgent = 0, 0, 0, 0, 0
    diag.lateSum, diag.lateMax, diag.lifeMin = 0, 0, nil
    diagState.t0 = os.clock()
    diagState.pending, diagState.stall = 0, nil
    diagState.stalls, diagState.stallMax, diagState.notCounted = 0, 0, 0
    for i = #events, 1, -1 do events[i] = nil end
end

-- (silencioso) nada e copiado nem salvo; as estatisticas ficam so na memoria
local function diagFinish() end

-- texto de uma perda: mostra POR QUE a bolha passou (vida, ritmo, travada de frame, etc.)
local function lossText(kind, info)
    local now = os.clock()
    local waiting = "nao"
    if info.waitDue then
        waiting = string.format("%s faltava %.2fs (urgente=%s)", tostring(info.waitWhy or "?"),
            info.waitDue, tostring(info.waitUrgent))
    end
    local st = diagState.stall
    local stallTxt = "-"
    if st then stallTxt = string.format("%.2fs (%.1fs atras)", st.len, now - st.at) end
    return string.format(
        "%s t=%.1fs vida=%.2fs desde_ult_clique=%.2fs delay=%.2f valida=%s escolhida=%s esperando=%s pendentes=%d cliques=%d contada=%s travada=%s",
        kind, now - diagState.t0, now - info.seenAt, now - lastClick, mode.delay,
        tostring(info.validAt ~= nil), tostring(info.chosen == true), waiting,
        diagState.pending, info.clicks, tostring(info.counted), stallTxt)
end

local function registerBubble(b)
    local info = bubbleInfo[b]
    if info then return info end
    info = {seenAt = os.clock(), clicks = 0, clickedAt = 0, clicked = false, gone = false, counted = false}
    bubbleInfo[b] = info
    diag.seen = diag.seen + 1
    pcall(function()
        b.AncestryChanged:Connect(function()
            if b:IsDescendantOf(game) or info.gone or not mode.enabled then return end
            if not info.clicked then
                info.gone = true
                diag.missed = diag.missed + 1
                local life = os.clock() - info.seenAt
                if not diag.lifeMin or life < diag.lifeMin then diag.lifeMin = life end
                if life >= 0.25 then
                    local d = math.max(0.12, life * 0.5)
                    if not learnedDanger or d < learnedDanger then learnedDanger = d end
                end
                if DEBUG then logEvent(lossText("PERDIDA", info)) end
            elseif not info.counted and diagState.hasHead then
                info.gone = true
                diagState.notCounted = diagState.notCounted + 1
                if DEBUG then logEvent(lossText("CLICADA_SEM_CONTAR(pode ser so atraso do contador)", info)) end
            end
        end)
    end)
    return info
end

-- bolha ja clicada: so fica "travada" se o jogo contou o clique (contador da cabeca subiu) ou se o clique
-- e recente. Se passou RECLICK_AFTER e a bolha continua valida na tela, o clique nao pegou: clica de novo.
local function wasClicked(b)
    local info = bubbleInfo[b]
    if not info or info.clicks <= 0 then return false end
    if info.counted then return true end
    return (os.clock() - info.clickedAt) < RECLICK_AFTER
end

local NOT_BUBBLE = {Close = true, Pause = true, Minimize = true, Infos = true}
local scanSecond = nil -- 2a bolha pendente mais antiga (se houver duas ou mais na tela ao mesmo tempo)

-- URGENCIA: a bolha sobe e encolhe ate sumir. Medimos o encolhimento a cada frame e prevemos quando
-- ela some. Se ela sumiria antes do proximo clique permitido, o clique sai ja (respeitando o piso
-- minimo de 0.6s entre cliques). Tambem vale a idade aprendida das bolhas que ja passaram.
local function bubbleUrgent(b, dueIn)
    local info = bubbleInfo[b]
    if not info then return false end
    local now = os.clock()
    if learnedDanger and (now - info.seenAt) >= learnedDanger then return true end
    local smax, size = info.sizeMax, info.size
    if smax and size and smax > 0 and size < smax * 0.98 then
        local dt = now - (info.tMax or now)
        if dt > 0.05 then
            local rate = (smax - size) / dt
            if rate > 0 then
                local remaining = size / rate
                if remaining < dueIn + 0.08 then return true end
            end
        end
    end
    return false
end

local function scanScreen()
    scanSecond = nil
    local pg = player:FindFirstChild("PlayerGui")
    local pol = pg and pg:FindFirstChild("Polichinelos")
    local scr = pol and pol:FindFirstChild("Screen")
    if not scr then
        diagState.pending = 0
        return nil
    end
    local best, bestAt, second, secondAt
    local pend = 0
    for _, b in ipairs(scr:GetChildren()) do
        if b:IsA("ImageButton") and not NOT_BUBBLE[b.Name] then
            local info = registerBubble(b)
            -- texto procurado tambem dentro de filhos (bolha com o texto mais fundo nao fica de fora)
            local lbl = b:FindFirstChildWhichIsA("TextLabel", true)
            local valid = b.Visible and not b:GetAttribute("Completed") and lbl ~= nil and lbl.Text ~= ""
            if not valid then
                -- saiu de cena: se voltar a aparecer, conta como bolha nova
                info.clicks = 0
                info.counted = false
            else
                if not info.validAt then info.validAt = os.clock() end
                -- bolha reaproveitada pelo jogo (mesmo objeto, texto novo): comeca vida nova, nao herda o "ja clicada"
                local txtNow = lbl.Text
                if info.clicks > 0 and info.lastText and info.lastText ~= txtNow then
                    info.clicks = 0
                    info.counted = false
                    info.clicked = false
                    info.gone = false
                    info.seenAt = os.clock()
                    info.sizeMax, info.tMax, info.size = nil, nil, nil
                    info.chosen, info.waitDue, info.validAt = nil, nil, os.clock()
                    diag.seen = diag.seen + 1
                end
                info.lastText = txtNow
                -- amostra o tamanho (para prever quando a bolha some)
                local sz = b.AbsoluteSize.X
                if sz >= (info.sizeMax or 0) then
                    info.sizeMax = sz
                    info.tMax = os.clock()
                end
                info.size = sz
                if not wasClicked(b) then
                    local ok = IS_MOBILE
                    if not ok then
                        local txt = norm(lbl.Text)
                        for _, tg in ipairs(mode.targets) do
                            if txt == tg then ok = true break end
                        end
                    end
                    if ok then
                        pend = pend + 1
                        if not best or info.seenAt < bestAt then
                            second, secondAt = best, bestAt
                            best, bestAt = b, info.seenAt
                        elseif not second or info.seenAt < secondAt then
                            second, secondAt = b, info.seenAt
                        end
                    end
                end
            end
        end
    end
    diagState.pending = pend
    scanSecond = second
    return best
end

-- ===================== CALIBRACAO AUTOMATICA (arquivo no celular) =====================
-- Nas 3 primeiras bolinhas de cada partida o script mede quanto tempo a bolha vive e de quanto em
-- quanto tempo elas nascem, salva isso num arquivo e passa a usar (tambem na proxima vez que abrir).
-- Tudo em pcall: se o executor nao tiver writefile/readfile, simplesmente segue sem arquivo.
local CALIB_FILE = "AtividadesFisicas_calib.txt"
local calibLife, calibCadence = nil, nil
local calib = {n = 0, lifes = {}, births = {}, done = false}

local function calibApply()
    if calibLife then
        local d = math.max(0.2, calibLife * 0.5)
        if not learnedDanger or d < learnedDanger then learnedDanger = d end
    end
end

local function calibSave() end -- sem arquivo: a calibracao fica so na memoria

local function calibReset()
    calib = {n = 0, lifes = {}, births = {}, done = false}
end

local function median(list)
    table.sort(list)
    return list[math.floor((#list + 1) / 2)]
end

local function calibNote(info, tClick)
    if calib.done then return end
    calib.n = calib.n + 1
    table.insert(calib.births, info.seenAt)
    local smax, size = info.sizeMax, info.size
    if smax and size and smax > 0 and size < smax * 0.98 and info.tMax then
        local dt = tClick - info.tMax
        if dt > 0.08 then
            local rate = (smax - size) / dt
            if rate > 0 then
                local life = (info.tMax - info.seenAt) + smax / rate
                if life >= 0.2 and life <= 6 then table.insert(calib.lifes, life) end
            end
        end
    end
    if calib.n >= 3 then
        calib.done = true
        table.sort(calib.births)
        local gaps = {}
        for i = 2, #calib.births do
            local g = calib.births[i] - calib.births[i - 1]
            if g >= 0.2 and g <= 3 then table.insert(gaps, g) end
        end
        if #calib.lifes > 0 then calibLife = median(calib.lifes) end
        if #gaps > 0 then calibCadence = median(gaps) end
        calibApply()
        calibSave()
    end
end

local function getButton()
    -- 0) bolha direta do Polichinelos (mais confiavel, sem depender do texto "tap")
    local direct = scanScreen()
    if direct then
        cachedBtn = direct
        diagState.lastPath = "direta"
        return direct
    end

    -- 1) candidatas rastreadas por evento: registra TODAS e escolhe sempre a mais antiga ainda nao
    --    clicada (assim o ritmo, o urgente e o log funcionam tambem fora do caminho "direta")
    local best, bestAt, second, secondAt
    for obj in pairs(tracked) do
        if not obj.Parent then
            tracked[obj] = nil
        else
            local btn = obj
            if not obj:IsA("GuiButton") then
                btn = obj:FindFirstAncestorWhichIsA("GuiButton")
                if not btn and IS_PC then btn = obj end
            end
            if btn and isVisible(btn) and not btn:GetAttribute("Completed") then
                local info = registerBubble(btn)
                if not wasClicked(btn) then
                    if not best or info.seenAt < bestAt then
                        second, secondAt = best, bestAt
                        best, bestAt = btn, info.seenAt
                    elseif btn ~= best and (not second or info.seenAt < secondAt) then
                        second, secondAt = btn, info.seenAt
                    end
                end
            end
        end
    end
    if best then
        scanSecond = second
        cachedBtn = best
        diagState.lastPath = "rastreada"
        return best
    end

    -- 2) botao em cache ainda visivel
    if cachedBtn and cachedBtn.Parent and isVisible(cachedBtn) and not cachedBtn:GetAttribute("Completed")
    and not wasClicked(cachedBtn) then
        diagState.lastPath = "cache"
        return cachedBtn
    end
    cachedBtn = nil

    -- 3) reserva: a varredura completa roda em segundo plano (nao trava o detector rapido)
    if fallbackBtn and fallbackBtn.Parent and isVisible(fallbackBtn) and not wasClicked(fallbackBtn) then
        cachedBtn = fallbackBtn
        diagState.lastPath = "varredura"
        return fallbackBtn
    end
    fallbackBtn = nil
    return nil
end

-- ===================== BOLHA DE TECLA (PC) =====================
-- No PC o jogo mostra uma letra (Q, E...) na bolha em vez de "tap": e pra APERTAR A TECLA.
-- (mesmo metodo do script DRIP MENU AUTO JJs: acha o botao com a letra e manda a tecla)

local function keyFromText(t)
    t = string.upper((string.gsub(tostring(t or ""), "%s+", "")))
    if #t == 1 and string.match(t, "%a") and t ~= "X" then
        local ok, kc = pcall(function() return Enum.KeyCode[t] end)
        if ok then return kc end
    end
    return nil
end

local SKIP_NAMES = {Close = true, Pause = true, Minimize = true}

local function findKeyBubble()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local roots = {}
    local pol = pg:FindFirstChild("Polichinelos")
    if pol then table.insert(roots, pol:FindFirstChild("Screen") or pol) end
    local af = pg:FindFirstChild("AtividadesFisicas")
    if af then table.insert(roots, af) end
    for _, root in ipairs(roots) do
        for i, obj in ipairs(root:GetDescendants()) do
            if i % 250 == 0 then task.wait() end
            if obj.Parent and (obj:IsA("TextLabel") or obj:IsA("TextButton")) and keyFromText(obj.Text) then
                local btn = obj:IsA("GuiButton") and obj or obj:FindFirstAncestorWhichIsA("GuiButton")
                if btn and not SKIP_NAMES[btn.Name] and not btn:FindFirstAncestor("Infos")
                and not btn:GetAttribute("Completed") and isVisible(btn) then
                    return btn, obj
                end
            end
        end
    end
    return nil
end

local cachedKeyBtn, cachedKeyLabel = nil, nil
local lastKeyScan = 0

local function getKeyBubble()
    if cachedKeyBtn and cachedKeyBtn.Parent and cachedKeyLabel and cachedKeyLabel.Parent
    and isVisible(cachedKeyBtn) then
        local k = keyFromText(cachedKeyLabel.Text)
        if k then return cachedKeyBtn, k end
    end
    local now = os.clock()
    if now - lastKeyScan < 0.04 then return nil end
    lastKeyScan = now
    local btn, lbl = findKeyBubble()
    if btn then
        cachedKeyBtn, cachedKeyLabel = btn, lbl
        return btn, keyFromText(lbl.Text)
    end
    cachedKeyBtn, cachedKeyLabel = nil, nil
    return nil
end

-- ===================== CLIQUE =====================
-- MOBILE: um metodo so (dispara os eventos do botao via getconnections/firesignal). Nao move
-- mouse, nao manda tecla nem toque, entao o jogo nao troca pra "modo PC" e a bolha nao some.
-- PC / CONSOLE: cadeia de metodos. Usa o que funciona e, se o contador da cabeca nao subir,
-- passa pro proximo metodo (sem nunca disparar dois metodos no mesmo clique).

-- inset: se a ScreenGui do botao ignora o inset, nao soma (senao o clique erra ~36px)
local function insetFor(btn)
    local sg = btn:FindFirstAncestorWhichIsA("ScreenGui")
    if sg and sg.IgnoreGuiInset then return Vector2.new(0, 0) end
    return GuiService:GetGuiInset()
end

local function centerOf(btn, flip)
    local p = btn.AbsolutePosition + btn.AbsoluteSize / 2
    local inset = insetFor(btn)
    if flip then
        if inset.X == 0 and inset.Y == 0 then
            inset = GuiService:GetGuiInset()
        else
            inset = Vector2.new(0, 0)
        end
    end
    return p + inset
end

local function fireEvents(btn, age)
    if not btn:IsA("GuiButton") then return false end
    local fired = false
    if getconnections then
        for _, ev in ipairs({btn.MouseButton1Click, btn.Activated, btn.MouseButton1Down, btn.MouseButton1Up}) do
            pcall(function()
                for _, c in ipairs(getconnections(ev)) do
                    c:Fire()
                    fired = true
                end
            end)
        end
    end
    if fired then return true end
    -- bolha recem-nascida: o jogo ainda nao ligou o clique nela. Disparar agora nao pega em nada e a
    -- bolha passaria. Devolve false e o ciclo tenta de novo no proximo frame (ate 0.1s de vida).
    if getconnections and age and age < 0.1 then return false end

    if firesignal then
        local ok = pcall(function()
            firesignal(btn.MouseButton1Click)
            firesignal(btn.Activated)
        end)
        if ok then return true end
    end
    return false
end

-- reserva do reteste: chama direto a funcao ligada ao botao (sem passar pelo sinal)
local function directCall(btn)
    if not getconnections or not btn:IsA("GuiButton") then return false end
    local called = false
    for _, ev in ipairs({btn.MouseButton1Click, btn.Activated, btn.MouseButton1Down, btn.MouseButton1Up}) do
        pcall(function()
            for _, c in ipairs(getconnections(ev)) do
                if c.Function then
                    task.spawn(c.Function)
                    called = true
                end
            end
        end)
    end
    return called
end

local function vimClick(btn, flip, rep)
    local vim = game:GetService("VirtualInputManager")
    local pos = centerOf(btn, flip)
    vim:SendMouseMoveEvent(pos.X, pos.Y, game)
    vim:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, rep or 1)
    task.wait()
    vim:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, rep or 1)
end

-- usado no mobile e pra pausar/fechar
local function clickButton(btn)
    if fireEvents(btn) then return end
    if IS_PC then
        pcall(vimClick, btn, false)
    end
end

-- Metodos de clique do PC. Cada um: {nome, funcao, disponivel?}.
-- Ordem = do melhor pro pior: os 3 primeiros sao os mais compativeis e NAO mexem no cursor real
-- do usuario; os que movem o mouse de verdade ficam por ultimo. Se um metodo nao fizer o
-- contador subir em 1s (SWITCH_AFTER), o script passa sozinho pro proximo (sem travar nada).
local chain = {
    -- 1) mouse virtual (VirtualInputManager): input "de verdade" no ponto certo, cursor real intacto
    {"Mouse virtual", function(btn) vimClick(btn, false, 1) end},
    -- 2) dispara os eventos do botao (MouseButton1Click/Activated/Down/Up) via getconnections/firesignal
    {"Eventos", function(btn) fireEvents(btn) end,
        function() return getconnections ~= nil or firesignal ~= nil end},
    -- 3) mouse virtual com o inset da GUI invertido (corrige clique ~36px fora do botao)
    {"Mouse virtual alt", function(btn) vimClick(btn, true, 1) end},
    -- reservas
    {"Mouse virtual B", function(btn) vimClick(btn, false, 0) end}, -- repeatCount 0 (usado em varios scripts abertos)
    {"Funcao direta", function(btn)
        -- chama direto a funcao conectada (conn.Function), sem passar pelo sinal
        if not getconnections or not btn:IsA("GuiButton") then return end
        for _, ev in ipairs({btn.MouseButton1Click, btn.Activated, btn.MouseButton1Down, btn.MouseButton1Up}) do
            pcall(function()
                for _, c in ipairs(getconnections(ev)) do
                    if c.Function then task.spawn(c.Function) end
                end
            end)
        end
    end, function() return getconnections ~= nil end},
    {"Input falso", function(btn)
        -- jogos que leem InputBegan/InputEnded do botao em vez de Click
        local c0 = btn.AbsolutePosition + btn.AbsoluteSize / 2
        local function fake(state)
            return {
                UserInputType = Enum.UserInputType.MouseButton1, UserInputState = state,
                Position = Vector3.new(c0.X, c0.Y, 0), KeyCode = Enum.KeyCode.Unknown,
            }
        end
        for _, c in ipairs(getconnections(btn.InputBegan)) do
            pcall(function() c:Fire(fake(Enum.UserInputState.Begin)) end)
        end
        for _, c in ipairs(getconnections(btn.InputEnded)) do
            pcall(function() c:Fire(fake(Enum.UserInputState.End)) end)
        end
    end, function() return getconnections ~= nil end},
    {"Toque virtual", function(btn)
        local vim = game:GetService("VirtualInputManager")
        local p = centerOf(btn, false)
        vim:SendTouchEvent(1, 0, p.X, p.Y)
        task.wait()
        vim:SendTouchEvent(1, 2, p.X, p.Y)
    end},
    {"Controle/Enter", function(btn)
        local vim = game:GetService("VirtualInputManager")
        local old = GuiService.SelectedObject
        GuiService.SelectedObject = btn
        vim:SendKeyEvent(true, Enum.KeyCode.ButtonA, false, game)
        vim:SendKeyEvent(false, Enum.KeyCode.ButtonA, false, game)
        vim:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
        vim:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
        GuiService.SelectedObject = old
    end},
    {"VirtualUser", function(btn)
        local vu = game:GetService("VirtualUser")
        local p = centerOf(btn, false)
        vu:CaptureController()
        vu:ClickButton1(Vector2.new(p.X, p.Y))
    end},
    -- por ultimo: move o cursor REAL do usuario
    {"Mouse executor", function(btn)
        local p = centerOf(btn, false)
        mousemoveabs(p.X, p.Y)
        mouse1click()
    end, function() return mouse1click ~= nil and mousemoveabs ~= nil end},
}

-- tira da lista os metodos que este executor nao tem (nao gasta 1s testando algo impossivel)
do
    local usable = {}
    for _, m in ipairs(chain) do
        if m[3] == nil or m[3]() then table.insert(usable, m) end
    end
    chain = usable
end

-- no console o metodo de controle vem logo depois dos eventos
if IS_CONSOLE then
    for idx, m in ipairs(chain) do
        if m[1] == "Controle/Enter" then
            table.insert(chain, 2, table.remove(chain, idx))
            break
        end
    end
end

local keyChain = {
    {"Tecla virtual", function(key)
        local vim = game:GetService("VirtualInputManager")
        vim:SendKeyEvent(true, key, false, game)
        task.wait()
        vim:SendKeyEvent(false, key, false, game)
    end},
    {"Tecla virtual B", function(key)
        local vim = game:GetService("VirtualInputManager")
        vim:SendKeyEvent(true, key, false, nil)
        task.wait()
        vim:SendKeyEvent(false, key, false, nil)
    end},
    {"Tecla executor", function(key)
        local code = string.byte(key.Name)
        keypress(code)
        task.wait()
        keyrelease(code)
    end, function() return keypress ~= nil and keyrelease ~= nil end},
}
do
    local usable = {}
    for _, m in ipairs(keyChain) do
        if m[3] == nil or m[3]() then table.insert(usable, m) end
    end
    keyChain = usable
end

-- ===================== CONTADOR DA CABECA =====================
-- Le o numero que aparece em Character.Head.Overhead.AtividadeFisica.Container.Value

local headObj = nil

local function findHeadLabel()
    if headObj and headObj.Parent then return headObj end
    headObj = nil
    local ch = player.Character
    if not ch then return nil end
    local af = ch:FindFirstChild("AtividadeFisica", true)
    if not af then return nil end
    local cont = af:FindFirstChild("Container") or af
    local v = cont:FindFirstChild("Value", true)
    if v and (v:IsA("TextLabel") or v:IsA("TextBox") or v:IsA("TextButton")) then
        headObj = v
    end
    return headObj
end

local function parseNumber(text)
    local t = string.gsub(tostring(text or ""), "<[^>]->", "")
    local tok = string.match(t, "%d[%d%.,]*")
    if not tok then return nil end
    return tonumber((string.gsub(tok, "[%.,]", "")))
end

local function readHead()
    local o = findHeadLabel()
    if not o then return nil end
    local n = parseNumber(o.Text)
    if n and n > 5000 then return nil end
    return n
end

local function beginRun()
    count = 0
end

local function progress()
    local v = readHead()
    if v then return v, true end
    return count, false
end

-- ===================== CLIQUE DO CICLO =====================

local lastWorked = nil
local lastMode = "tap"
local noBubbleSince = nil
local dumped = false
local keyIdx = 1
local seenObj = nil -- bolha atual e o instante em que apareceu (tempo de reacao igual p/ todas)
local seenAt = 0
local clickedSeen = false -- ja clicou nessa bolha? (so repete se ela continuar na tela)
local lastClicked = nil -- ultimo clique: se o contador da cabeca subir, a bolha fica marcada como "contada"
local awaiting = nil -- clique feito, esperando o contador da cabeca atualizar
local chainIdx = 1

-- Troca automatica de metodo (PC/console), sem bloquear nada:
-- o clique sai na hora; a cada tick judgeMethod() confere se o contador da cabeca subiu
-- (ou, sem contador, se a bolha sumiu). Se passar SWITCH_AFTER (1s) tentando e nada
-- acontecer, passa pro proximo metodo. Qualquer sucesso zera a contagem, entao um metodo
-- que funciona nunca e trocado.
local SWITCH_AFTER = 1.0
local attempts = 0
local trialStart = 0
local attemptKind = "tap"
local clickedObj = nil
local lastHeadSeen = nil

local function noteAttempt(kind, obj)
    if attempts == 0 then trialStart = os.clock() end
    attempts = attempts + 1
    attemptKind = kind
    clickedObj = obj
end

local function clickSmart(btn)
    local binf = bubbleInfo[btn]
    -- reclique: a mesma bolha ja foi clicada e o jogo nao contou. Nao soma no contador interno.
    local isRetry = binf ~= nil and binf.clicks > 0

    -- mobile: metodo unico, sem esperas. Se nao disparou (botao ainda sem eventos), devolve false
    -- e o ciclo tenta de novo no proximo frame, sem perder a bolha.
    if IS_MOBILE then
        local age = binf and (os.clock() - binf.seenAt) or nil
        local ok = false
        -- no reclique alterna o jeito de disparar (chamada direta da funcao) para nao repetir o que falhou
        if isRetry and binf.clicks % 2 == 1 then ok = directCall(btn) end
        if not ok then ok = fireEvents(btn, age) end
        if ok then
            if not isRetry then count = count + 1 end
            return true
        end
        return false
    end
    if not isRetry then count = count + 1 end

    -- PC / console: usa o metodo atual da cadeia
    noteAttempt("tap", btn)
    lastWorked = chainIdx
    pcall(chain[chainIdx][2], btn)
    return true
end

-- PC: aperta a tecla da bolha (Q/E...). Mesma logica de troca.
local function pressSmart(key, obj)
    count = count + 1
    noteAttempt("key", obj)
    lastWorked = keyIdx
    pcall(keyChain[keyIdx][2], key)
end

local function judgeMethod()
    local h = readHead()
    local ok = false
    if h ~= nil then
        if lastHeadSeen ~= nil and h ~= lastHeadSeen then ok = true end
        lastHeadSeen = h
    elseif attempts > 0 and clickedObj
    and (not clickedObj.Parent or not isVisible(clickedObj)) then
        ok = true -- sem contador: bolha sumiu depois do clique
    end
    if attempts == 0 then return end
    if ok then
        attempts = 0
    elseif os.clock() - trialStart >= SWITCH_AFTER then
        attempts = 0
        if attemptKind == "key" then
            keyIdx = keyIdx % #keyChain + 1
        else
            chainIdx = chainIdx % #chain + 1
        end
    end
end

-- usado pra pausar/fechar
local function clickAll(btn)
    clickButton(btn)
end

